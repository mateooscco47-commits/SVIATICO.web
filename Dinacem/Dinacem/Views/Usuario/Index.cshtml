@model List<Dinacem.Models.Usuario>

@{
    ViewData["Title"] = "Gestión de Usuarios";
    Layout = "~/Views/Shared/_LayoutAdministrador.cshtml";

    var totalUsuarios = Model?.Count ?? 0;
    var usuariosActivos = Model?.Count(x => x.Estado) ?? 0;
    var usuariosInactivos = Model?.Count(x => !x.Estado) ?? 0;
}

<style>

    /* =========================================================
           CONTENEDOR PRINCIPAL
           ========================================================= */

    .usuarios-page {
        width: 100%;
        max-width: 1600px;
        margin: 0 auto;
    }


    /* =========================================================
           ENCABEZADO
           ========================================================= */

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        padding: 22px;
        margin-bottom: 24px;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        box-shadow: 0 5px 18px rgba(15, 23, 42, .05);
    }

    .page-title {
        margin: 0 0 5px;
        color: #17365d;
        font-size: 28px;
        font-weight: 800;
        letter-spacing: -0.3px;
    }

        .page-title i {
            color: #0c4a8a;
            font-size: 1.55rem;
        }

    .page-description {
        margin: 0;
        color: #64748b;
        font-size: 14px;
        font-weight: 500;
    }


    /* =========================================================
           ACCIONES DEL ENCABEZADO
           ========================================================= */

    .page-header-actions {
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .page-header-actions .btn {
            padding: 8px 15px;
            border-radius: 8px;
            font-weight: 600;
            transition: all .2s ease;
        }

            .page-header-actions .btn:hover {
                transform: translateY(-1px);
            }


    /* =========================================================
           BOTÓN NUEVO USUARIO
           ========================================================= */

    .btn-nuevo-usuario {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 10px 17px;
        border: none;
        border-radius: 8px;
        background: #0c4a8a;
        color: #ffffff;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: all .2s ease;
    }

        .btn-nuevo-usuario:hover {
            background: #083763;
            color: #ffffff;
            transform: translateY(-1px);
        }


    /* =========================================================
           INDICADORES
           ========================================================= */

    .usuarios-kpi {
        height: 100%;
        padding: 16px 18px;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        box-shadow: 0 2px 7px rgba(15, 23, 42, 0.04);
    }

    .usuarios-kpi-label {
        display: block;
        margin-bottom: 5px;
        color: #64748b;
        font-size: 12px;
    }

    .usuarios-kpi-value {
        margin: 0;
        color: #1e293b;
        font-size: 22px;
        font-weight: 700;
    }

    .usuarios-kpi-icon {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        font-size: 18px;
    }

    .kpi-blue {
        background: #eaf3fb;
        color: #0c4a8a;
    }

    .kpi-green {
        background: #ecfdf3;
        color: #15803d;
    }

    .kpi-red {
        background: #fef2f2;
        color: #b91c1c;
    }


    /* =========================================================
           FORMULARIO DE REGISTRO
           ========================================================= */

    .usuario-create-card {
        margin-bottom: 22px;
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05);
    }

    .usuario-card-header {
        padding: 15px 20px;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        color: #1e293b;
        font-size: 14px;
        font-weight: 700;
    }

    .usuario-create-body {
        padding: 22px;
    }

    .usuario-form .form-label {
        margin-bottom: 6px;
        color: #334155;
        font-size: 13px;
        font-weight: 600;
    }

    .usuario-form .form-control,
    .usuario-form .form-select {
        min-height: 42px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        font-size: 13px;
    }

        .usuario-form .form-control:focus,
        .usuario-form .form-select:focus {
            border-color: #0c4a8a;
            box-shadow: 0 0 0 3px rgba(12, 74, 138, .10);
        }

    .usuario-form .text-danger {
        margin-top: 4px;
        font-size: 12px;
    }


    /* =========================================================
           BOTÓN REGISTRAR
           ========================================================= */

    .btn-registrar {
        min-height: 42px;
        padding: 0 20px;
        border: none;
        border-radius: 8px;
        background: #0c4a8a;
        color: #ffffff;
        font-size: 13px;
        font-weight: 600;
        transition: all .2s ease;
    }

        .btn-registrar:hover {
            background: #083763;
            color: #ffffff;
            transform: translateY(-1px);
        }


    /* =========================================================
           LISTADO
           ========================================================= */

    .usuarios-list-card {
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05);
    }

    .usuarios-list-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 16px 20px;
        border-bottom: 1px solid #e2e8f0;
        flex-wrap: wrap;
    }

    .usuarios-list-title {
        margin: 0;
        color: #1e293b;
        font-size: 15px;
        font-weight: 700;
    }


    /* =========================================================
           BUSCADOR
           ========================================================= */

    .usuarios-search {
        position: relative;
        width: 320px;
        max-width: 100%;
    }

    .usuarios-search-icon {
        position: absolute;
        top: 50%;
        left: 12px;
        color: #94a3b8;
        pointer-events: none;
        transform: translateY(-50%);
    }

    .usuarios-search-input {
        width: 100%;
        height: 38px;
        padding: 0 38px 0 36px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        outline: none;
        font-size: 13px;
    }

        .usuarios-search-input:focus {
            border-color: #0c4a8a;
            box-shadow: 0 0 0 3px rgba(12, 74, 138, .08);
        }

    .usuarios-search-clear {
        position: absolute;
        top: 50%;
        right: 9px;
        width: 24px;
        height: 24px;
        display: none;
        align-items: center;
        justify-content: center;
        border: none;
        background: transparent;
        color: #94a3b8;
        cursor: pointer;
        transform: translateY(-50%);
    }

        .usuarios-search-clear:hover {
            color: #334155;
        }


    /* =========================================================
           TABLA
           ========================================================= */

    .usuarios-table-wrapper {
        overflow-x: auto;
    }

    .usuarios-table {
        width: 100%;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
    }

        .usuarios-table thead th {
            padding: 12px 14px;
            background: #f8fafc;
            border-bottom: 1px solid #cbd5e1;
            color: #475569;
            font-size: 12px;
            font-weight: 700;
            white-space: nowrap;
        }

        .usuarios-table tbody td {
            padding: 12px 14px;
            border-bottom: 1px solid #e2e8f0;
            color: #334155;
            font-size: 13px;
            vertical-align: middle;
        }

        .usuarios-table tbody tr:hover {
            background: #f8fafc;
        }

        .usuarios-table tbody tr:last-child td {
            border-bottom: none;
        }


    /* =========================================================
           INFORMACIÓN DEL USUARIO
           ========================================================= */

    .usuario-info {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .usuario-avatar {
        width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 50%;
        background: #eaf3fb;
        color: #0c4a8a;
        font-size: 15px;
    }

    .usuario-name {
        color: #1e293b;
        font-weight: 600;
    }

    .usuario-access {
        margin-top: 2px;
        color: #64748b;
        font-size: 11px;
    }


    /* =========================================================
           ESTADOS
           ========================================================= */

    .estado-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 9px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
    }

    .estado-activo {
        background: #dcfce7;
        color: #166534;
    }

    .estado-inactivo {
        background: #fee2e2;
        color: #991b1b;
    }


    /* =========================================================
           ACCIONES
           ========================================================= */

    .usuario-actions {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        flex-wrap: wrap;
    }

    .btn-accion {
        min-height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 6px 11px;
        border: 1px solid;
        border-radius: 7px;
        background: #ffffff;
        cursor: pointer;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
        text-decoration: none;
        transition: all .2s ease;
    }

        .btn-accion i {
            font-size: 13px;
        }

        .btn-accion:hover {
            transform: translateY(-1px);
        }


    /* =========================================================
           EDITAR
           ========================================================= */

    .btn-editar {
        border-color: #bfdbfe;
        background: #ffffff;
        color: #2563eb;
    }

        .btn-editar:hover {
            border-color: #93c5fd;
            background: #eff6ff;
            color: #1d4ed8;
        }


    /* =========================================================
           DESACTIVAR
           ========================================================= */

    .btn-desactivar {
        border-color: #fecaca;
        background: #ffffff;
        color: #dc2626;
    }

        .btn-desactivar:hover {
            border-color: #fca5a5;
            background: #fef2f2;
            color: #b91c1c;
        }


    /* =========================================================
           ACTIVAR
           ========================================================= */

    .btn-activar {
        border-color: #bbf7d0;
        background: #ffffff;
        color: #16a34a;
    }

        .btn-activar:hover {
            border-color: #86efac;
            background: #f0fdf4;
            color: #15803d;
        }


    /* =========================================================
           SIN REGISTROS
           ========================================================= */

    .usuarios-empty {
        padding: 50px 20px !important;
        color: #64748b !important;
        text-align: center;
    }

        .usuarios-empty i {
            display: block;
            margin-bottom: 10px;
            color: #94a3b8;
            font-size: 38px;
        }


    /* =========================================================
           SWEETALERT
           ========================================================= */

    .swal-usuario-popup {
        padding: 28px !important;
        border-radius: 16px !important;
    }

    .swal-usuario-title {
        margin-bottom: 8px !important;
        color: #17365d !important;
        font-size: 21px !important;
        font-weight: 800 !important;
    }

    .swal-usuario-text {
        color: #64748b !important;
        font-size: 14px !important;
    }

    .swal-btn-confirmar {
        min-width: 130px;
        margin: 0 4px;
        padding: 9px 17px;
        border: none !important;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: all .2s ease;
    }

    .swal-btn-desactivar {
        background: #dc2626 !important;
        color: #ffffff !important;
    }

        .swal-btn-desactivar:hover {
            background: #b91c1c !important;
            transform: translateY(-1px);
        }

    .swal-btn-activar {
        background: #16a34a !important;
        color: #ffffff !important;
    }

        .swal-btn-activar:hover {
            background: #15803d !important;
            transform: translateY(-1px);
        }

    .swal-btn-cancelar {
        min-width: 100px;
        margin: 0 4px;
        padding: 9px 17px;
        border: 1px solid #cbd5e1 !important;
        border-radius: 8px;
        background: #ffffff !important;
        color: #475569 !important;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: all .2s ease;
    }

        .swal-btn-cancelar:hover {
            border-color: #94a3b8 !important;
            background: #f8fafc !important;
        }


    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 768px) {

        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .page-header-actions {
            width: 100%;
        }

            .page-header-actions .btn {
                width: 100%;
                justify-content: center;
            }

        .btn-nuevo-usuario {
            width: 100%;
        }

        .usuarios-list-header {
            align-items: stretch;
        }

        .usuarios-search {
            width: 100%;
        }

        .usuario-create-body {
            padding: 17px;
        }

        .usuario-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .btn-accion {
            width: 100%;
        }
    }

</style>


<!-- =========================================================
     CONTENEDOR PRINCIPAL
     ========================================================= -->

<div class="usuarios-page">


    <!-- =========================================================
         ENCABEZADO
         ========================================================= -->

    <div class="page-header">

        <!-- =====================================================
             TÍTULO
             ===================================================== -->

        <div>

            <h1 class="page-title">

                <i class="bi bi-people-fill me-2"></i>

                Gestión de Usuarios

            </h1>

            <p class="page-description">

                Administre los usuarios, sus roles y el estado
                de acceso al sistema.

            </p>

        </div>


        <!-- =====================================================
             ACCIONES DEL ENCABEZADO
             ===================================================== -->

        <div class="page-header-actions">


            <!-- =================================================
                 BOTÓN VOLVER
                 ================================================= -->

            <a asp-controller="Principal"
               asp-action="Index"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left me-1"></i>

                Volver al panel

            </a>


            <!-- =================================================
                 BOTÓN NUEVO USUARIO
                 ================================================= -->

            <button type="button"
                    class="btn-nuevo-usuario"
                    id="btnMostrarRegistro">

                <i class="bi bi-person-plus-fill"></i>

                Nuevo usuario

            </button>

        </div>

    </div>

</div>

    <!-- =========================================================
         INDICADORES
         ========================================================= -->

    <div class="row g-3 mb-4">


        <!-- TOTAL -->

        <div class="col-md-4">

            <div class="usuarios-kpi">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <span class="usuarios-kpi-label">
                            Total de usuarios
                        </span>

                        <h3 class="usuarios-kpi-value">
                            @totalUsuarios
                        </h3>

                    </div>

                    <div class="usuarios-kpi-icon kpi-blue">

                        <i class="bi bi-people"></i>

                    </div>

                </div>

            </div>

        </div>


        <!-- ACTIVOS -->

        <div class="col-md-4">

            <div class="usuarios-kpi">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <span class="usuarios-kpi-label">
                            Usuarios activos
                        </span>

                        <h3 class="usuarios-kpi-value">
                            @usuariosActivos
                        </h3>

                    </div>

                    <div class="usuarios-kpi-icon kpi-green">

                        <i class="bi bi-person-check"></i>

                    </div>

                </div>

            </div>

        </div>


        <!-- INACTIVOS -->

        <div class="col-md-4">

            <div class="usuarios-kpi">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <span class="usuarios-kpi-label">
                            Usuarios inactivos
                        </span>

                        <h3 class="usuarios-kpi-value">
                            @usuariosInactivos
                        </h3>

                    </div>

                    <div class="usuarios-kpi-icon kpi-red">

                        <i class="bi bi-person-x"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         FORMULARIO REGISTRAR USUARIO
         ========================================================= -->

    <div class="usuario-create-card"
         id="formularioRegistro"
         style="display: none;">

        <div class="usuario-card-header">

            <i class="bi bi-person-plus-fill me-2"></i>

            Registrar nuevo usuario

        </div>


        <div class="usuario-create-body">

            <form asp-controller="Usuario"
                  asp-action="Create"
                  method="post"
                  class="usuario-form">

                @Html.AntiForgeryToken()


                <!-- VALIDACIONES DEL SERVIDOR -->

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <div class="row g-4">


                    <!-- USUARIO DE ACCESO -->

                    <div class="col-md-6">

                        <label class="form-label">
                            Usuario de acceso
                        </label>

                        <input name="UsuarioAcceso"
                               class="form-control"
                               placeholder="Ingrese el usuario"
                               autocomplete="username"
                               required />

                    </div>


                    <!-- ROL -->

                    <div class="col-md-6">

                        <label class="form-label">
                            Rol
                        </label>

                        <select name="IdRol"
                                class="form-select"
                                required>

                            <option value="">
                                Seleccione un rol
                            </option>

                            <option value="1">
                                Administrador
                            </option>

                            <option value="2">
                                Supervisor
                            </option>

                            <option value="3">
                                Representante
                            </option>

                        </select>

                    </div>


                    <!-- NOMBRES -->

                    <div class="col-md-6">

                        <label class="form-label">
                            Nombres
                        </label>

                        <input name="Nombres"
                               class="form-control"
                               placeholder="Ingrese los nombres"
                               required />

                    </div>


                    <!-- APELLIDOS -->

                    <div class="col-md-6">

                        <label class="form-label">
                            Apellidos
                        </label>

                        <input name="Apellidos"
                               class="form-control"
                               placeholder="Ingrese los apellidos"
                               required />

                    </div>


                    <!-- CORREO -->

                    <div class="col-md-6">

                        <label class="form-label">
                            Correo electrónico
                        </label>

                        <input name="Correo"
                               type="email"
                               class="form-control"
                               placeholder="correo@ejemplo.com"
                               autocomplete="email"
                               required />

                    </div>


                    <!-- CELULAR -->

                    <div class="col-md-6">

                        <label class="form-label">
                            Celular
                        </label>

                        <input name="Celular"
                               class="form-control celular-input"
                               placeholder="9 dígitos"
                               maxlength="9"
                               inputmode="numeric" />

                    </div>


                    <!-- ZONA -->

                    <div class="col-md-6">

                        <label class="form-label">
                            Zona
                        </label>

                        <input name="Zona"
                               class="form-control"
                               placeholder="Ingrese la zona" />

                    </div>


                    <!-- CONTRASEÑA -->

                    <div class="col-md-6">

                        <label class="form-label">
                            Contraseña
                        </label>

                        <input name="Contrasenia"
                               type="password"
                               class="form-control password-input"
                               placeholder="Ingrese la contraseña"
                               autocomplete="new-password"
                               required />

                    </div>

                </div>


                <!-- BOTONES -->

                <div class="d-flex justify-content-end gap-2 mt-4">

                    <button type="button"
                            class="btn btn-outline-secondary"
                            id="btnCancelarRegistro">

                        <i class="bi bi-x-circle me-1"></i>

                        Cancelar

                    </button>

                    <button type="submit"
                            class="btn-registrar">

                        <i class="bi bi-check-circle me-1"></i>

                        Registrar usuario

                    </button>

                </div>

            </form>

        </div>

    </div>


    <!-- =========================================================
         LISTADO DE USUARIOS
         ========================================================= -->

    <div class="usuarios-list-card">


        <!-- ENCABEZADO DEL LISTADO -->

        <div class="usuarios-list-header">

            <h2 class="usuarios-list-title">

                <i class="bi bi-list-ul me-2"></i>

                Lista de usuarios

            </h2>


            <!-- BUSCADOR -->

            <div class="usuarios-search">

                <i class="bi bi-search usuarios-search-icon"></i>

                <input type="search"
                       id="buscadorUsuarios"
                       class="usuarios-search-input"
                       placeholder="Buscar usuario, nombre o correo..."
                       autocomplete="off" />

                <button type="button"
                        id="limpiarBuscador"
                        class="usuarios-search-clear"
                        title="Limpiar búsqueda">

                    <i class="bi bi-x-lg"></i>

                </button>

            </div>

        </div>


        <!-- =====================================================
             TABLA
             ===================================================== -->

        <div class="usuarios-table-wrapper">

            <table class="usuarios-table"
                   id="tablaUsuarios">

                <thead>

                    <tr>

                        <th>
                            Usuario
                        </th>

                        <th>
                            Correo
                        </th>

                        <th>
                            Celular
                        </th>

                        <th>
                            Zona
                        </th>

                        <th>
                            Rol
                        </th>

                        <th>
                            Estado
                        </th>

                        <th class="text-center">
                            Acciones
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr class="usuario-row">


                                <!-- USUARIO -->

                                <td>

                                    <div class="usuario-info">

                                        <div class="usuario-avatar">

                                            <i class="bi bi-person"></i>

                                        </div>

                                        <div>

                                            <div class="usuario-name">

                                                @item.Nombres @item.Apellidos

                                            </div>

                                            <div class="usuario-access">

                                                @item.UsuarioAcceso

                                            </div>

                                        </div>

                                    </div>

                                </td>


                                <!-- CORREO -->

                                <td>

                                    @item.Correo

                                </td>


                                <!-- CELULAR -->

                                <td>

                                    @(string.IsNullOrWhiteSpace(item.Celular)
                                        ? "-"
                                        : item.Celular)

                                </td>


                                <!-- ZONA -->

                                <td>

                                    @(string.IsNullOrWhiteSpace(item.Zona)
                                        ? "-"
                                        : item.Zona)

                                </td>


                                <!-- ROL -->

                                <td>

                                    @if (item.Rol != null)
                                    {
                                        <span>

                                            @item.Rol.Nombre

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">

                                            Sin rol

                                        </span>
                                    }

                                </td>


                                <!-- ESTADO -->

                                <td>

                                    @if (item.Estado)
                                    {
                                        <span class="estado-badge estado-activo">

                                            <i class="bi bi-check-circle-fill"></i>

                                            Activo

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="estado-badge estado-inactivo">

                                            <i class="bi bi-x-circle-fill"></i>

                                            Inactivo

                                        </span>
                                    }

                                </td>


                                <!-- ACCIONES -->

                                <td>

                                    <div class="usuario-actions">


                                        <!-- EDITAR -->

                                        <a asp-controller="Usuario"
                                           asp-action="Edit"
                                           asp-route-id="@item.IdUsuario"
                                           class="btn-accion btn-editar"
                                           title="Editar usuario">

                                            <i class="bi bi-pencil-square"></i>

                                            <span>Editar</span>

                                        </a>


                                        @if (item.Estado)
                                        {
                                            <!-- DESACTIVAR -->

                                            <form asp-controller="Usuario"
                                                  asp-action="Desactivar"
                                                  method="post"
                                                  class="form-estado-usuario">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@item.IdUsuario" />

                                                <button type="button"
                                                        class="btn-accion btn-desactivar btn-confirmar-estado"
                                                        data-accion="desactivar"
                                                        data-id="@item.IdUsuario"
                                                        title="Desactivar usuario">

                                                    <i class="bi bi-person-x"></i>

                                                    <span>Desactivar</span>

                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            <!-- ACTIVAR -->

                                            <form asp-controller="Usuario"
                                                  asp-action="Activar"
                                                  method="post"
                                                  class="form-estado-usuario">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@item.IdUsuario" />

                                                <button type="button"
                                                        class="btn-accion btn-activar btn-confirmar-estado"
                                                        data-accion="activar"
                                                        data-id="@item.IdUsuario"
                                                        title="Activar usuario">

                                                    <i class="bi bi-person-check"></i>

                                                    <span>Activar</span>

                                                </button>

                                            </form>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="7"
                                class="usuarios-empty">

                                <i class="bi bi-people"></i>

                                No existen usuarios registrados.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

<!-- =========================================================
     NOTIFICACIÓN DE USUARIO
     ========================================================= -->
@if (TempData["mensaje"] != null)
{
    <div id="notificacionUsuario"
         data-tipo="success"
         data-mensaje="@TempData["mensaje"]">
    </div>
}

@if (TempData["error"] != null)
{
    <div id="notificacionUsuario"
         data-tipo="error"
         data-mensaje="@TempData["error"]">
    </div>
}


@section Scripts {

    <!-- =========================================================
         SWEETALERT2
         ========================================================= -->

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


    <!-- =========================================================
         JAVASCRIPT DE USUARIOS
         ========================================================= -->

    <script>


        document.addEventListener("DOMContentLoaded", function () {


            /* =====================================================
               MOSTRAR / OCULTAR FORMULARIO DE REGISTRO
               ===================================================== */

            const btnMostrarRegistro =
                document.getElementById("btnMostrarRegistro");

            const btnCancelarRegistro =
                document.getElementById("btnCancelarRegistro");

            const formularioRegistro =
                document.getElementById("formularioRegistro");


            /* =====================================================
               MOSTRAR REGISTRO
               ===================================================== */

            if (btnMostrarRegistro && formularioRegistro) {

                btnMostrarRegistro.addEventListener("click", function () {

                    formularioRegistro.style.display = "block";

                    formularioRegistro.scrollIntoView({
                        behavior: "smooth",
                        block: "start"
                    });

                });

            }


            /* =====================================================
               CANCELAR REGISTRO
               ===================================================== */

            if (btnCancelarRegistro && formularioRegistro) {

                btnCancelarRegistro.addEventListener("click", function () {

                    formularioRegistro.style.display = "none";

                });

            }


            /* =====================================================
               BUSCADOR
               ===================================================== */

            const buscador =
                document.getElementById("buscadorUsuarios");

            const limpiarBuscador =
                document.getElementById("limpiarBuscador");

            const tabla =
                document.getElementById("tablaUsuarios");


            if (buscador && tabla) {

                buscador.addEventListener("input", function () {

                    const texto =
                        this.value.toLowerCase().trim();

                    const filas =
                        tabla.querySelectorAll(
                            "tbody tr.usuario-row"
                        );


                    filas.forEach(function (fila) {

                        const contenido =
                            fila.textContent.toLowerCase();

                        fila.style.display =
                            contenido.includes(texto)
                                ? ""
                                : "none";

                    });


                    /* MOSTRAR / OCULTAR X */

                    if (limpiarBuscador) {

                        limpiarBuscador.style.display =
                            texto.length > 0
                                ? "flex"
                                : "none";

                    }

                });

            }


            /* =====================================================
               LIMPIAR BUSCADOR
               ===================================================== */

            if (limpiarBuscador && buscador) {

                limpiarBuscador.addEventListener("click", function () {

                    buscador.value = "";

                    buscador.dispatchEvent(
                        new Event("input")
                    );

                    buscador.focus();

                });

            }


            /* =====================================================
               SOLO NÚMEROS EN CELULAR
               ===================================================== */

            document
                .querySelectorAll(".celular-input")
                .forEach(function (input) {

                    input.addEventListener("input", function () {

                        this.value =
                            this.value
                                .replace(/\D/g, "")
                                .slice(0, 9);

                    });

                });


            /* =====================================================
               CONFIRMAR ACTIVAR / DESACTIVAR
               ===================================================== */

            document
                .querySelectorAll(".btn-confirmar-estado")
                .forEach(function (boton) {

                    boton.addEventListener("click", function () {

                        const formulario =
                            boton.closest(".form-estado-usuario");

                        if (!formulario) {
                            return;
                        }


                        const accion =
                            boton.dataset.accion;

                        const idUsuario =
                            boton.dataset.id;


                        /* =============================================
                           DESACTIVAR
                           ============================================= */

                        if (accion === "desactivar") {

                            Swal.fire({

                                icon: "warning",

                                title: "¿Desactivar usuario?",

                                html: `
                                            <div class="swal-usuario-text">
                                                ¿Está seguro de que desea
                                                desactivar al usuario
                                                <strong>#${idUsuario}</strong>?
                                                <br>
                                                <span>
                                                    El usuario ya no podrá
                                                    acceder al sistema.
                                                </span>
                                            </div>
                                        `,

                                showCancelButton: true,

                                confirmButtonText:
                                    "Sí, desactivar",

                                cancelButtonText:
                                    "Cancelar",

                                reverseButtons: true,

                                focusCancel: true,

                                buttonsStyling: false,

                                customClass: {

                                    popup:
                                        "swal-usuario-popup",

                                    title:
                                        "swal-usuario-title",

                                    htmlContainer:
                                        "swal-usuario-text",

                                    confirmButton:
                                        "swal-btn-confirmar swal-btn-desactivar",

                                    cancelButton:
                                        "swal-btn-cancelar"

                                }

                            }).then(function (resultado) {

                                if (resultado.isConfirmed) {

                                    formulario.submit();

                                }

                            });

                        }


                        /* =============================================
                           ACTIVAR
                           ============================================= */

                        if (accion === "activar") {

                            Swal.fire({

                                icon: "question",

                                title: "¿Activar usuario?",

                                html: `
                                            <div class="swal-usuario-text">
                                                ¿Desea activar nuevamente
                                                al usuario
                                                <strong>#${idUsuario}</strong>?
                                                <br>
                                                <span>
                                                    El usuario podrá volver
                                                    a acceder al sistema.
                                                </span>
                                            </div>
                                        `,

                                showCancelButton: true,

                                confirmButtonText:
                                    "Sí, activar",

                                cancelButtonText:
                                    "Cancelar",

                                reverseButtons: true,

                                focusCancel: true,

                                buttonsStyling: false,

                                customClass: {

                                    popup:
                                        "swal-usuario-popup",

                                    title:
                                        "swal-usuario-title",

                                    htmlContainer:
                                        "swal-usuario-text",

                                    confirmButton:
                                        "swal-btn-confirmar swal-btn-activar",

                                    cancelButton:
                                        "swal-btn-cancelar"

                                }

                            }).then(function (resultado) {

                                if (resultado.isConfirmed) {

                                    formulario.submit();

                                }

                            });

                        }

                    });

                });


            /* =====================================================
               NOTIFICACIONES DE USUARIO
               ===================================================== */

            const notificacionUsuario =
                document.getElementById("notificacionUsuario");


            if (notificacionUsuario && typeof Swal !== "undefined") {

                const tipo =
                    notificacionUsuario.dataset.tipo;

                const mensaje =
                    notificacionUsuario.dataset.mensaje;


                /* -------------------------------------------------
                   SOLO MOSTRAR SI EXISTE UN MENSAJE
                   ------------------------------------------------- */

                if (tipo && mensaje) {

                    Swal.fire({

                        icon: tipo,

                        title:
                            tipo === "success"
                                ? "Operación realizada"
                                : "Ocurrió un problema",

                        text: mensaje,

                        confirmButtonText:
                            "Aceptar",

                        timer: 3000,

                        timerProgressBar: true

                    });

                }

            }

        });

    </script>

}