@model List<Dinacem.Models.Usuario>

@{
    ViewData["Title"] = "Gestión de Usuarios";
    Layout = "~/Views/Shared/_LayoutAdministrador.cshtml";

    var totalUsuarios = Model?.Count ?? 0;
    var usuariosActivos = Model?.Count(x => x.Estado) ?? 0;
    var usuariosInactivos = Model?.Count(x => !x.Estado) ?? 0;
}

<style>
:root {
    --dinacen-azul: #0c4a8a;
    --dinacen-azul-oscuro: #083763;
    --dinacen-azul-claro: #eaf3fb;
    --dinacen-verde: #6aa84f;
    --texto: #1f2937;
    --texto-secundario: #4b5563;
    --borde: #d9e1ea;
    --fondo: #f3f7fb;
    --blanco: #ffffff;
}

.usuarios-page {
    width: 100%;
    max-width: 1600px;
    margin: 0 auto;
    padding: 22px;
    background: var(--fondo);
    color: var(--texto);
    font-family: "Segoe UI", Arial, sans-serif;
}

.page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 20px;
    padding: 22px 24px;
    background: linear-gradient(135deg, var(--dinacen-azul), #1261a5);
    border-radius: 12px;
    box-shadow: 0 5px 18px rgba(12, 74, 138, .18);
}

.page-title {
    margin: 0 0 6px;
    color: #fff;
    font-size: 28px;
    font-weight: 800;
    line-height: 1.2;
}

.page-title i {
    font-size: 25px;
}

.page-description {
    margin: 0;
    color: rgba(255,255,255,.9);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.5;
}

.page-header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
}

.page-header-actions .btn,
.btn-nuevo-usuario {
    min-height: 40px;
    padding: 9px 16px;
    border-radius: 7px;
    font-size: 13px;
    font-weight: 700;
    transition: all .2s ease;
}

.page-header-actions .btn-outline-secondary {
    border: 1px solid rgba(255,255,255,.65);
    color: #fff;
    background: transparent;
}

.page-header-actions .btn-outline-secondary:hover {
    background: #fff;
    color: var(--dinacen-azul);
    border-color: #fff;
}

.btn-nuevo-usuario {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    border: 0;
    background: #fff;
    color: var(--dinacen-azul);
    text-decoration: none;
    cursor: pointer;
}

.btn-nuevo-usuario:hover {
    background: #f1f5f9;
    color: var(--dinacen-azul-oscuro);
    transform: translateY(-1px);
}

.usuarios-kpi {
    height: 100%;
    padding: 17px 19px;
    background: var(--blanco);
    border: 1px solid var(--borde);
    border-radius: 10px;
    box-shadow: 0 3px 10px rgba(15,23,42,.05);
}

.usuarios-kpi-label {
    display: block;
    margin-bottom: 4px;
    color: var(--texto-secundario);
    font-size: 13px;
    font-weight: 600;
}

.usuarios-kpi-value {
    margin: 0;
    color: var(--texto);
    font-size: 24px;
    font-weight: 800;
}

.usuarios-kpi-icon {
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 9px;
    font-size: 19px;
}

.kpi-blue {
    background: var(--dinacen-azul-claro);
    color: var(--dinacen-azul);
}

.kpi-green {
    background: #edf7e9;
    color: #4f8d3d;
}

.kpi-red {
    background: #fef0f0;
    color: #c62828;
}

.usuario-create-card,
.usuarios-list-card {
    overflow: hidden;
    margin-bottom: 20px;
    background: var(--blanco);
    border: 1px solid var(--borde);
    border-radius: 10px;
    box-shadow: 0 3px 10px rgba(15,23,42,.05);
}

.usuario-card-header {
    padding: 14px 20px;
    background: var(--dinacen-azul);
    color: #fff;
    border-bottom: 1px solid var(--dinacen-azul-oscuro);
    font-size: 15px;
    font-weight: 700;
}

.usuario-create-body {
    padding: 22px;
}

.usuario-form .form-label {
    margin-bottom: 6px;
    color: #111827;
    font-size: 13px;
    font-weight: 700;
}

.usuario-form .form-control,
.usuario-form .form-select {
    min-height: 42px;
    padding: 8px 12px;
    border: 1px solid #cbd5e1;
    border-radius: 7px;
    color: #111827;
    background: #fff;
    font-size: 13px;
}

.usuario-form .form-control::placeholder {
    color: #9ca3af;
}

.usuario-form .form-control:focus,
.usuario-form .form-select:focus {
    border-color: var(--dinacen-azul);
    box-shadow: 0 0 0 3px rgba(12,74,138,.1);
}

.usuario-form small,
.usuario-form .text-muted {
    color: #5b6573 !important;
    font-size: 12px;
    line-height: 1.4;
}

.usuario-form .text-danger {
    margin-top: 4px;
    font-size: 12px;
    font-weight: 600;
}

.btn-registrar {
    min-height: 42px;
    padding: 9px 18px;
    border: 0;
    border-radius: 7px;
    background: var(--dinacen-azul);
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: all .2s ease;
}

.btn-registrar:hover {
    background: var(--dinacen-azul-oscuro);
    color: #fff;
    transform: translateY(-1px);
}

.usuario-create-body .btn-outline-secondary {
    min-height: 42px;
    padding: 9px 18px;
    border-radius: 7px;
    font-size: 13px;
    font-weight: 700;
}

.usuarios-list-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    padding: 15px 20px;
    background: #fff;
    border-bottom: 1px solid var(--borde);
}

.usuarios-list-title {
    margin: 0;
    color: #111827;
    font-size: 16px;
    font-weight: 800;
}

.usuarios-list-title i {
    color: var(--dinacen-azul);
}

.usuarios-search {
    position: relative;
    width: 350px;
    max-width: 100%;
}

.usuarios-search-icon {
    position: absolute;
    top: 50%;
    left: 13px;
    color: #6b7280;
    pointer-events: none;
    transform: translateY(-50%);
}

.usuarios-search-input {
    width: 100%;
    height: 40px;
    padding: 0 40px 0 37px;
    border: 1px solid #cbd5e1;
    border-radius: 7px;
    outline: none;
    color: #111827;
    background: #fff;
    font-size: 13px;
}

.usuarios-search-input::placeholder {
    color: #8a94a3;
}

.usuarios-search-input:focus {
    border-color: var(--dinacen-azul);
    box-shadow: 0 0 0 3px rgba(12,74,138,.08);
}

.usuarios-search-clear {
    position: absolute;
    top: 50%;
    right: 8px;
    width: 25px;
    height: 25px;
    display: none;
    align-items: center;
    justify-content: center;
    border: 0;
    background: transparent;
    color: #6b7280;
    cursor: pointer;
    transform: translateY(-50%);
}

.usuarios-search-clear:hover {
    color: #111827;
}

.usuarios-table-wrapper {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
}

.usuarios-table {
    width: 100%;
    min-width: 900px;
    margin: 0;
    border-collapse: separate;
    border-spacing: 0;
}

.usuarios-table thead th {
    padding: 13px 14px;
    background: var(--dinacen-azul);
    border-bottom: 2px solid var(--dinacen-azul-oscuro);
    color: #fff;
    font-size: 12px;
    font-weight: 800;
    text-align: left;
    white-space: nowrap;
}

.usuarios-table tbody td {
    padding: 12px 14px;
    border-bottom: 1px solid #e5e7eb;
    color: #1f2937;
    background: #fff;
    font-size: 13px;
    font-weight: 500;
    vertical-align: middle;
}

.usuarios-table tbody tr {
    transition: background .15s ease;
}

.usuarios-table tbody tr:hover td {
    background: #f7fbff;
}

.usuarios-table tbody tr:last-child td {
    border-bottom: 0;
}

.usuarios-table th:last-child,
.usuarios-table td:last-child {
    text-align: center;
}

.usuario-info {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 190px;
}

.usuario-avatar {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--dinacen-azul-claro);
    color: var(--dinacen-azul);
    font-size: 16px;
}

.usuario-name {
    color: #111827;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.3;
}

.usuario-access {
    margin-top: 2px;
    color: #64748b;
    font-size: 11px;
    font-weight: 500;
}

.usuarios-table .badge {
    padding: 6px 9px;
    border-radius: 6px;
    color: #344054 !important;
    background: #f3f6f9 !important;
    border: 1px solid #d8e0e8 !important;
    font-size: 11px;
    font-weight: 700;
}

.estado-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    min-width: 82px;
    padding: 5px 9px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 800;
}

.estado-activo {
    background: #e8f5e9;
    color: #2e7d32;
}

.estado-inactivo {
    background: #ffebee;
    color: #c62828;
}

.usuario-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    flex-wrap: wrap;
}

.btn-accion {
    min-height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    padding: 6px 10px;
    border: 1px solid;
    border-radius: 6px;
    background: #fff;
    font-size: 11px;
    font-weight: 800;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition: all .2s ease;
}

.btn-accion i {
    font-size: 12px;
}

.btn-accion:hover {
    transform: translateY(-1px);
}

.btn-editar {
    border-color: #9ec5fe;
    background: #f5f9ff;
    color: #1557a5;
}

.btn-editar:hover {
    border-color: #6ea8fe;
    background: #e7f0ff;
    color: #0c4a8a;
}

.btn-desactivar {
    border-color: #f3b5b5;
    background: #fff7f7;
    color: #c62828;
}

.btn-desactivar:hover {
    border-color: #e57373;
    background: #ffebee;
    color: #a91f1f;
}

.btn-activar {
    border-color: #b8dcae;
    background: #f5fbf2;
    color: #388e3c;
}

.btn-activar:hover {
    border-color: #8bc580;
    background: #e8f5e9;
    color: #2e7d32;
}

.usuarios-empty {
    padding: 55px 20px !important;
    color: #6b7280 !important;
    text-align: center;
    font-size: 13px !important;
}

.usuarios-empty i {
    display: block;
    margin-bottom: 10px;
    color: #9ca3af;
    font-size: 38px;
}

.swal-usuario-popup {
    padding: 28px !important;
    border-radius: 12px !important;
}

.swal-usuario-title {
    margin-bottom: 8px !important;
    color: #17365d !important;
    font-size: 21px !important;
    font-weight: 800 !important;
}

.swal-usuario-text {
    color: #4b5563 !important;
    font-size: 14px !important;
    line-height: 1.5;
}

.swal-btn-confirmar {
    min-width: 130px;
    margin: 0 4px;
    padding: 9px 17px;
    border: 0 !important;
    border-radius: 7px;
    font-size: 13px;
    font-weight: 800;
    cursor: pointer;
    transition: all .2s ease;
}

.swal-btn-desactivar {
    background: #c62828 !important;
    color: #fff !important;
}

.swal-btn-desactivar:hover {
    background: #a91f1f !important;
}

.swal-btn-activar {
    background: #388e3c !important;
    color: #fff !important;
}

.swal-btn-activar:hover {
    background: #2e7d32 !important;
}

.swal-btn-cancelar {
    min-width: 100px;
    margin: 0 4px;
    padding: 9px 17px;
    border: 1px solid #cbd5e1 !important;
    border-radius: 7px;
    background: #fff !important;
    color: #374151 !important;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
}

.swal-btn-cancelar:hover {
    background: #f3f4f6 !important;
}

@@media (max-width: 992px) {
    .usuarios-page {
        padding: 18px;
    }

    .page-header {
        align-items: flex-start;
    }

    .page-title {
        font-size: 24px;
    }

    .page-header-actions {
        flex-direction: column;
        align-items: stretch;
    }

    .page-header-actions .btn,
    .btn-nuevo-usuario {
        width: 100%;
    }

    .usuarios-search {
        width: 300px;
    }
}

@@media (max-width: 768px) {
    .usuarios-page {
        padding: 14px;
    }

    .page-header {
        flex-direction: column;
        padding: 18px;
        border-radius: 10px;
    }

    .page-title {
        font-size: 22px;
    }

    .page-title i {
        font-size: 20px;
    }

    .page-description {
        font-size: 13px;
    }

    .page-header-actions {
        width: 100%;
    }

    .usuarios-kpi {
        padding: 15px;
    }

    .usuario-create-body {
        padding: 17px;
    }

    .usuarios-list-header {
        align-items: stretch;
        flex-direction: column;
        padding: 14px 16px;
    }

    .usuarios-search {
        width: 100%;
    }

    .usuario-actions {
        flex-direction: column;
        align-items: stretch;
    }

    .btn-accion {
        width: 100%;
    }

    .usuario-create-body .d-flex {
        flex-direction: column-reverse;
    }

    .usuario-create-body .btn,
    .usuario-create-body .btn-registrar {
        width: 100%;
    }
}

@@media (max-width: 576px) {
    .usuarios-page {
        padding: 10px;
    }

    .page-title {
        font-size: 20px;
    }

    .page-description {
        font-size: 12px;
    }

    .usuarios-kpi-value {
        font-size: 21px;
    }

    .usuario-card-header,
    .usuarios-list-header {
        padding: 13px 14px;
    }

    .usuario-create-body {
        padding: 14px;
    }

    .usuarios-table {
        min-width: 850px;
    }
}
</style>



<div class="usuarios-page">

    <div class="page-header">
        <div>
            <h1 class="page-title">
                <i class="bi bi-people-fill me-2"></i>
                Gestión de Usuarios
            </h1>
            <p class="page-description">
                Administre los usuarios, sus roles, zonas y el estado de acceso al sistema.
            </p>
        </div>

        <div class="page-header-actions">
            <a asp-controller="Principal"
               asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Volver al panel
            </a>

            <button type="button"
                    class="btn-nuevo-usuario"
                    id="btnMostrarRegistro">
                <i class="bi bi-person-plus-fill"></i>
                Nuevo usuario
            </button>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="usuarios-kpi">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="usuarios-kpi-label">Total de usuarios</span>
                        <h3 class="usuarios-kpi-value">@totalUsuarios</h3>
                    </div>
                    <div class="usuarios-kpi-icon kpi-blue">
                        <i class="bi bi-people"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="usuarios-kpi">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="usuarios-kpi-label">Usuarios activos</span>
                        <h3 class="usuarios-kpi-value">@usuariosActivos</h3>
                    </div>
                    <div class="usuarios-kpi-icon kpi-green">
                        <i class="bi bi-person-check"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="usuarios-kpi">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="usuarios-kpi-label">Usuarios inactivos</span>
                        <h3 class="usuarios-kpi-value">@usuariosInactivos</h3>
                    </div>
                    <div class="usuarios-kpi-icon kpi-red">
                        <i class="bi bi-person-x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="usuario-create-card"
         id="formularioRegistro"
         style="display:none;">

        <div class="usuario-card-header">
            <i class="bi bi-person-plus-fill me-2"></i>
            Registrar nuevo usuario
        </div>

        <div class="usuario-create-body">
            <form asp-controller="Usuario"
                  asp-action="Create"
                  method="post"
                  class="usuario-form">

                @Html.AntiForgeryToken()

                <div class="row g-4">

                    <div class="col-md-6">
                        <label for="IdZona" class="form-label">
                            Zona
                        </label>

                        <select id="IdZona"
                                name="IdZona"
                                class="form-select"
                                required>
                            <option value="">Seleccione una zona</option>

                            @if (ViewBag.Zonas != null)
                            {
                                foreach (var zona in ViewBag.Zonas)
                                {
                                    <option value="@zona.IdZona">
                                        @zona.CodigoZona
                                    </option>
                                }
                            }
                        </select>

                        <small class="text-muted">
                            Seleccione la zona asignada al usuario.
                        </small>
                    </div>

                    <div class="col-md-6">
                        <label for="UsuarioAcceso" class="form-label">
                            Usuario de acceso
                        </label>

                        <input id="UsuarioAcceso"
                               name="UsuarioAcceso"
                               type="text"
                               class="form-control"
                               placeholder="Ingrese el usuario"
                               autocomplete="username"
                               required />
                    </div>

                    <div class="col-md-6">
                        <label for="IdRol" class="form-label">
                            Rol
                        </label>

                        <select id="IdRol"
                                name="IdRol"
                                class="form-select"
                                required>
                            <option value="">Seleccione un rol</option>
                            <option value="1">Administrador</option>
                            <option value="2">Supervisor</option>
                            <option value="3">Representante</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label for="Nombres" class="form-label">
                            Nombres
                        </label>

                        <input id="Nombres"
                               name="Nombres"
                               type="text"
                               class="form-control"
                               placeholder="Ingrese los nombres"
                               required />
                    </div>

                    <div class="col-md-6">
                        <label for="Apellidos" class="form-label">
                            Apellidos
                        </label>

                        <input id="Apellidos"
                               name="Apellidos"
                               type="text"
                               class="form-control"
                               placeholder="Ingrese los apellidos"
                               required />
                    </div>

                    <div class="col-md-6">
                        <label for="Correo" class="form-label">
                            Correo electrónico
                        </label>

                        <input id="Correo"
                               name="Correo"
                               type="email"
                               class="form-control"
                               placeholder="correo@ejemplo.com"
                               autocomplete="email"
                               required />
                    </div>

                    <div class="col-md-6">
                        <label for="Celular" class="form-label">
                            Celular
                        </label>

                        <input id="Celular"
                               name="Celular"
                               type="text"
                               class="form-control celular-input"
                               placeholder="9 dígitos"
                               maxlength="9"
                               inputmode="numeric" />
                    </div>

                    <div class="col-md-6">
                        <label for="Contrasenia" class="form-label">
                            Contraseña
                        </label>

                        <input id="Contrasenia"
                               name="Contrasenia"
                               type="password"
                               class="form-control password-input"
                               placeholder="Ingrese la contraseña"
                               autocomplete="new-password"
                               required />
                    </div>

                </div>

                <div class="mt-3">
                    <div class="alert alert-light border d-flex align-items-center mb-0">
                        <i class="bi bi-info-circle text-primary me-2"></i>
                        <small class="text-muted">
                            La zona se selecciona desde las zonas activas registradas en el sistema.
                        </small>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <button type="button"
                            class="btn btn-outline-secondary"
                            id="btnCancelarRegistro">
                        <i class="bi bi-x-circle me-1"></i>
                        Cancelar
                    </button>

                    <button type="submit"
                            class="btn-registrar">
                        <i class="bi bi-check-circle me-1"></i>
                        Registrar usuario
                    </button>
                </div>

            </form>
        </div>
    </div>

    <div class="usuarios-list-card">

        <div class="usuarios-list-header">
            <h2 class="usuarios-list-title">
                <i class="bi bi-list-ul me-2"></i>
                Lista de usuarios
            </h2>

            <div class="usuarios-search">
                <i class="bi bi-search usuarios-search-icon"></i>

                <input type="search"
                       id="buscadorUsuarios"
                       class="usuarios-search-input"
                       placeholder="Buscar usuario, nombre, correo o zona..."
                       autocomplete="off" />

                <button type="button"
                        id="limpiarBuscador"
                        class="usuarios-search-clear"
                        title="Limpiar búsqueda">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </div>

        <div class="usuarios-table-wrapper">
            <table class="usuarios-table" id="tablaUsuarios">
                <thead>
                    <tr>
                        <th>Usuario</th>
                        <th>Correo</th>
                        <th>Celular</th>
                        <th>Zona</th>
                        <th>Rol</th>
                        <th>Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr class="usuario-row">

                                <td>
                                    <div class="usuario-info">
                                        <div class="usuario-avatar">
                                            <i class="bi bi-person"></i>
                                        </div>

                                        <div>
                                            <div class="usuario-name">
                                                @item.Nombres @item.Apellidos
                                            </div>

                                            <div class="usuario-access">
                                                @item.UsuarioAcceso
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span>@item.Correo</span>
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.Celular)
                                        ? "-"
                                        : item.Celular)
                                </td>

                                <td>
                                    @if (item.Zona != null)
                                    {
                                        <span class="zona-badge">
                                            <i class="bi bi-geo-alt-fill"></i>
                                            @item.Zona.CodigoZona
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Sin zona
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (item.Rol != null)
                                    {
                                        <span class="rol-text">
                                            @item.Rol.Nombre
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Sin rol
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (item.Estado)
                                    {
                                        <span class="estado-badge estado-activo">
                                            <i class="bi bi-check-circle-fill"></i>
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="estado-badge estado-inactivo">
                                            <i class="bi bi-x-circle-fill"></i>
                                            Inactivo
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="usuario-actions">

                                        <a asp-controller="Usuario"
                                           asp-action="Edit"
                                           asp-route-id="@item.IdUsuario"
                                           class="btn-accion btn-editar"
                                           title="Editar usuario">
                                            <i class="bi bi-pencil-square"></i>
                                            <span>Editar</span>
                                        </a>

                                        @if (item.Estado)
                                        {
                                            <form asp-controller="Usuario"
                                                  asp-action="Desactivar"
                                                  method="post"
                                                  class="form-estado-usuario">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@item.IdUsuario" />

                                                <button type="button"
                                                        class="btn-accion btn-desactivar btn-confirmar-estado"
                                                        data-accion="desactivar"
                                                        data-id="@item.IdUsuario"
                                                        title="Desactivar usuario">
                                                    <i class="bi bi-person-x"></i>
                                                    <span>Desactivar</span>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-controller="Usuario"
                                                  asp-action="Activar"
                                                  method="post"
                                                  class="form-estado-usuario">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@item.IdUsuario" />

                                                <button type="button"
                                                        class="btn-accion btn-activar btn-confirmar-estado"
                                                        data-accion="activar"
                                                        data-id="@item.IdUsuario"
                                                        title="Activar usuario">
                                                    <i class="bi bi-person-check"></i>
                                                    <span>Activar</span>
                                                </button>
                                            </form>
                                        }

                                    </div>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="usuarios-empty">
                                <i class="bi bi-people"></i>
                                No existen usuarios registrados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (TempData["UsuarioMensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["UsuarioMensaje"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Cerrar"></button>
    </div>
}

@if (TempData["UsuarioError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["UsuarioError"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Cerrar"></button>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/IndexUsuario.js"></script>
}