@model Dinacem.Models.Usuario

@{
    ViewData["Title"] = "Editar Usuario";
    Layout = "~/Views/Shared/_LayoutAdministrador.cshtml";
}

<style>
:root {
    --dinacen-azul: #0c4a8a;
    --dinacen-azul-oscuro: #083763;
    --dinacen-azul-claro: #eaf3fb;
    --dinacen-verde: #6aa84f;
    --texto: #1f2937;
    --texto-secundario: #4b5563;
    --borde: #d9e1ea;
    --fondo: #f3f7fb;
    --blanco: #ffffff;
}

.usuario-edit-page {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 22px;
    background: var(--fondo);
    color: var(--texto);
    font-family: "Segoe UI", Arial, sans-serif;
}

.usuario-edit-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 20px;
    padding: 22px 24px;
    background: linear-gradient(135deg, var(--dinacen-azul), #1261a5);
    border-radius: 12px;
    box-shadow: 0 5px 18px rgba(12,74,138,.18);
}

.usuario-edit-header-content {
    min-width: 0;
}

.usuario-edit-title {
    margin: 0 0 6px;
    color: #fff;
    font-size: 28px;
    font-weight: 800;
    line-height: 1.2;
}

.usuario-edit-title i {
    font-size: 25px;
}

.usuario-edit-description {
    margin: 0;
    color: rgba(255,255,255,.9);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.5;
}

.btn-volver-usuario {
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    flex-shrink: 0;
    padding: 9px 16px;
    border: 1px solid rgba(255,255,255,.65);
    border-radius: 7px;
    background: transparent;
    color: #fff;
    text-decoration: none;
    font-size: 13px;
    font-weight: 700;
    transition: all .2s ease;
}

.btn-volver-usuario:hover {
    background: #fff;
    border-color: #fff;
    color: var(--dinacen-azul);
    transform: translateY(-1px);
}

.usuario-edit-card {
    overflow: hidden;
    margin-bottom: 20px;
    background: var(--blanco);
    border: 1px solid var(--borde);
    border-radius: 10px;
    box-shadow: 0 3px 10px rgba(15,23,42,.05);
}

.usuario-edit-card-header {
    padding: 14px 20px;
    background: var(--dinacen-azul);
    border-bottom: 1px solid var(--dinacen-azul-oscuro);
    color: #fff;
    font-size: 15px;
    font-weight: 700;
}

.usuario-edit-card-body {
    padding: 22px;
}

.usuario-edit-form .form-label {
    display: block;
    margin-bottom: 6px;
    color: #111827;
    font-size: 13px;
    font-weight: 700;
}

.usuario-edit-form .form-control,
.usuario-edit-form .form-select {
    width: 100%;
    min-height: 42px;
    padding: 8px 12px;
    border: 1px solid #cbd5e1;
    border-radius: 7px;
    color: #111827;
    background: #fff;
    font-size: 13px;
    transition: border-color .2s ease, box-shadow .2s ease;
}

.usuario-edit-form .form-control::placeholder {
    color: #9ca3af;
}

.usuario-edit-form .form-control:focus,
.usuario-edit-form .form-select:focus {
    border-color: var(--dinacen-azul);
    box-shadow: 0 0 0 3px rgba(12,74,138,.1);
    outline: none;
}

.usuario-edit-form .form-control[readonly] {
    background: #f8fafc;
    color: #475569;
    cursor: not-allowed;
}

.usuario-edit-form .input-group {
    display: flex;
}

.usuario-edit-form .input-group-text {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 42px;
    border: 1px solid #cbd5e1;
    border-right: 0;
    border-radius: 7px 0 0 7px;
    background: #f8fafc;
    color: var(--dinacen-azul);
    font-size: 14px;
}

.usuario-edit-form .input-group .form-control {
    border-radius: 0 7px 7px 0;
}

.usuario-edit-form .text-danger {
    display: block;
    margin-top: 4px;
    color: #dc2626 !important;
    font-size: 12px;
    font-weight: 600;
}

.password-help {
    margin-top: 5px;
    color: #5b6573;
    font-size: 12px;
    line-height: 1.4;
}

.usuario-edit-form .alert {
    border-radius: 7px;
}

.usuario-edit-form .alert small {
    color: #5b6573 !important;
    font-size: 12px;
    line-height: 1.4;
}

.usuario-edit-actions {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 10px;
    margin-top: 22px;
    padding-top: 20px;
    border-top: 1px solid var(--borde);
}

.btn-cancelar,
.btn-guardar {
    min-height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 9px 18px;
    border-radius: 7px;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    transition: all .2s ease;
}

.btn-cancelar {
    border: 1px solid #fecaca;
    background: #fef2f2;
    color: #dc2626;
    font-weight: 600;
    border-radius: 8px;
    padding: 0.5rem 1rem;
    transition: all 0.2s ease;
}

.btn-cancelar:hover {
    background: #dc2626;
    border-color: #dc2626;
    color: #ffffff;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(220, 38, 38, 0.25);
}

.btn-cancelar:active {
    transform: translateY(0);
}

.btn-guardar {
    border: 0;
    background: var(--dinacen-azul);
    color: #fff;
}

.btn-guardar:hover {
    background: var(--dinacen-azul-oscuro);
    color: #fff;
    transform: translateY(-1px);
}

.swal-usuario-popup {
    padding: 28px !important;
    border-radius: 12px !important;
}

.swal-usuario-title {
    margin-bottom: 8px !important;
    color: #17365d !important;
    font-size: 21px !important;
    font-weight: 800 !important;
}

.swal-usuario-text {
    color: #4b5563 !important;
    font-size: 14px !important;
    line-height: 1.5;
}

.swal-btn-confirmar {
    min-width: 130px;
    margin: 0 4px;
    padding: 9px 17px;
    border: 0 !important;
    border-radius: 7px;
    color: #fff !important;
    font-size: 13px;
    font-weight: 800;
    cursor: pointer;
    transition: all .2s ease;
}

.swal-btn-guardar {
    background: var(--dinacen-azul) !important;
}

.swal-btn-guardar:hover {
    background: var(--dinacen-azul-oscuro) !important;
}

.swal-btn-cancelar {
    min-width: 100px;
    margin: 0 4px;
    padding: 9px 17px;
    border: 1px solid #cbd5e1 !important;
    border-radius: 7px;
    background: #fff !important;
    color: #374151 !important;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
}

.swal-btn-cancelar:hover {
    background: #f3f4f6 !important;
}

@@media (max-width: 992px) {
    .usuario-edit-page {
        padding: 18px;
    }

    .usuario-edit-title {
        font-size: 24px;
    }
}

@@media (max-width: 768px) {
    .usuario-edit-page {
        padding: 14px;
    }

    .usuario-edit-header {
        flex-direction: column;
        align-items: stretch;
        padding: 18px;
        border-radius: 10px;
    }

    .usuario-edit-title {
        font-size: 22px;
    }

    .usuario-edit-title i {
        font-size: 20px;
    }

    .usuario-edit-description {
        font-size: 13px;
    }

    .btn-volver-usuario {
        width: 100%;
    }

    .usuario-edit-card-body {
        padding: 17px;
    }

    .usuario-edit-actions {
        flex-direction: column-reverse;
        align-items: stretch;
    }

    .btn-cancelar,
    .btn-guardar {
        width: 100%;
    }
}

@@media (max-width: 576px) {
    .usuario-edit-page {
        padding: 10px;
    }

    .usuario-edit-title {
        font-size: 20px;
    }

    .usuario-edit-description {
        font-size: 12px;
    }

    .usuario-edit-card-header {
        padding: 13px 14px;
    }

    .usuario-edit-card-body {
        padding: 14px;
    }
}
</style>

<div class="usuario-edit-page">

    <div class="usuario-edit-header">
        <div class="usuario-edit-header-content">
            <h1 class="usuario-edit-title">
                <i class="bi bi-person-gear me-2"></i>
                Editar usuario
            </h1>

            <p class="usuario-edit-description">
                Modifique los datos y permisos del usuario seleccionado.
            </p>
        </div>

        <a asp-controller="Usuario"
           asp-action="Index"
           class="btn-volver-usuario">
            <i class="bi bi-arrow-left"></i>
            Volver al listado
        </a>
    </div>

    <div class="usuario-edit-card">

        <div class="usuario-edit-card-header">
            <i class="bi bi-person-vcard me-2"></i>
            Información del usuario
        </div>

        <div class="usuario-edit-card-body">

            <form asp-controller="Usuario"
                  asp-action="Edit"
                  method="post"
                  class="usuario-edit-form"
                  id="formEditarUsuario">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="IdUsuario" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="row g-4">

                    <div class="col-md-6">
                        <label asp-for="UsuarioAcceso" class="form-label">
                            Usuario de acceso
                        </label>

                        <input asp-for="UsuarioAcceso"
                               class="form-control"
                               autocomplete="username"
                               required />

                        <span asp-validation-for="UsuarioAcceso"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="IdRol" class="form-label">
                            Rol
                        </label>

                        <select asp-for="IdRol"
                                class="form-select"
                                required>
                            <option value="">Seleccione un rol</option>
                            <option value="1">Administrador</option>
                            <option value="2">Supervisor</option>
                            <option value="3">Representante</option>
                        </select>

                        <span asp-validation-for="IdRol"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Nombres" class="form-label">
                            Nombres
                        </label>

                        <input asp-for="Nombres"
                               class="form-control"
                               required />

                        <span asp-validation-for="Nombres"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Apellidos" class="form-label">
                            Apellidos
                        </label>

                        <input asp-for="Apellidos"
                               class="form-control"
                               required />

                        <span asp-validation-for="Apellidos"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Correo" class="form-label">
                            Correo electrónico
                        </label>

                        <input asp-for="Correo"
                               type="email"
                               class="form-control"
                               autocomplete="email"
                               required />

                        <span asp-validation-for="Correo"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Celular" class="form-label">
                            Celular
                        </label>

                        <input asp-for="Celular"
                               type="text"
                               class="form-control celular-input"
                               maxlength="9"
                               inputmode="numeric" />

                        <span asp-validation-for="Celular"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">
                            Zona
                        </label>

                        <div class="input-group">
                            

                            <input type="text"
                                   value="@(Model.Zona != null ? Model.Zona.CodigoZona : "Sin zona asignada")"
                                   class="form-control"
                                   readonly
                                   tabindex="-1" />
                        </div>

                        <div class="password-help">
                            <i class="bi bi-lock-fill me-1"></i>
                            La zona no puede modificarse desde este formulario.
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Contrasenia" class="form-label">
                            Nueva contraseña
                        </label>

                        <input asp-for="Contrasenia"
                               type="password"
                               class="form-control"
                               autocomplete="new-password" />

                        <div class="password-help">
                            <i class="bi bi-info-circle me-1"></i>
                            Déjelo vacío si no desea cambiar la contraseña.
                        </div>

                        <span asp-validation-for="Contrasenia"
                              class="text-danger">
                        </span>
                    </div>

                </div>

                <div class="alert alert-light border mt-4 mb-0">
                    <div class="d-flex align-items-start">
                        <i class="bi bi-info-circle text-primary me-2 mt-1"></i>

                        
                    </div>
                </div>

                <div class="usuario-edit-actions">

                    <a asp-controller="Usuario"
                       asp-action="Index"
                       class="btn-cancelar">
                        <i class="bi bi-x-circle"></i>
                        Cancelar
                    </a>

                    <button type="submit"
                            class="btn-guardar"
                            id="btnGuardarCambios">
                        <i class="bi bi-check-circle"></i>
                        Guardar cambios
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const formulario = document.getElementById("formEditarUsuario");
            const btnGuardar = document.getElementById("btnGuardarCambios");

            document.querySelectorAll(".celular-input").forEach(function (input) {
                input.addEventListener("input", function () {
                    this.value = this.value.replace(/\D/g, "").slice(0, 9);
                });
            });

            if (formulario && btnGuardar) {
                formulario.addEventListener("submit", function (event) {
                    event.preventDefault();

                    if (!formulario.checkValidity()) {
                        formulario.reportValidity();
                        return;
                    }

                    Swal.fire({
                        icon: "question",
                        title: "¿Guardar cambios?",
                        html: `
                            <div style="font-size:14px;color:#4b5563;line-height:1.6;">
                                ¿Está seguro de que desea guardar
                                los cambios realizados en este usuario?
                                <br>
                                <strong style="color:#334155;">
                                    La información será actualizada.
                                </strong>
                            </div>
                        `,
                        showCancelButton: true,
                        confirmButtonText: '<i class="bi bi-check-circle me-1"></i> Sí, guardar cambios',
                        cancelButtonText: '<i class="bi bi-x-circle me-1"></i> Cancelar',
                        reverseButtons: true,
                        focusCancel: true,
                        buttonsStyling: false,
                        customClass: {
                            popup: "swal-usuario-popup",
                            title: "swal-usuario-title",
                            htmlContainer: "swal-usuario-text",
                            confirmButton: "swal-btn-confirmar swal-btn-guardar",
                            cancelButton: "swal-btn-cancelar"
                        }
                    }).then(function (resultado) {
                        if (resultado.isConfirmed) {
                            formulario.submit();
                        }
                    });
                });
            }
        });
    </script>
}