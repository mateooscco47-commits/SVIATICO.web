@model Dinacem.Models.Solicitud

@{
    ViewData["Title"] = "Nueva Solicitud de Viáticos";
    Layout = "~/Views/Shared/_LayoutEmpleado.cshtml";
}

<style>
    .solicitud-create-page{width:100%;max-width:1200px;margin:0 auto;padding:25px 30px 40px;color:#263238}
    .solicitud-create-header{display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;padding:22px 25px;margin-bottom:22px;background:#fff;border:1px solid #dce8f2;border-radius:12px;box-shadow:0 3px 12px rgba(12,74,138,.07)}
    .create-header-content{display:flex;align-items:center;gap:15px;flex:1 1 500px;min-width:250px}
    .create-header-icon{width:54px;height:54px;display:flex;align-items:center;justify-content:center;flex-shrink:0;border-radius:12px;background:#e7f2ff;color:#3186dc;font-size:26px}
    .create-header-text h1{margin:0;color:#174f7c;font-size:24px;font-weight:700;letter-spacing:-.2px}
    .create-header-text p{margin:5px 0 0;color:#71808c;font-size:13.5px;line-height:1.5}
    .btn-volver-panel{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:42px;padding:0 16px;flex-shrink:0;border:1px solid #d7e0e6;border-radius:7px;background:#fff;color:#5f6f79;font-size:13px;font-weight:600;text-decoration:none;white-space:nowrap;transition:.2s}
    .btn-volver-panel:hover{background:#f4f7f9;border-color:#c7d2d9;color:#40515b}

    .mensaje-create{display:flex;align-items:center;gap:10px;padding:12px 15px;margin-bottom:18px;border-radius:8px;font-size:13.5px;font-weight:500}
    .mensaje-create i{font-size:18px;flex-shrink:0}
    .mensaje-create .btn-close{margin-left:auto}
    .mensaje-success{background:#edf9f0;border:1px solid #c9e9d1;color:#327942}
    .mensaje-error{background:#fff0f0;border:1px solid #f0cccc;color:#b83b3b}

    .formulario-card{background:#fff;border:1px solid #dce5eb;border-radius:12px;box-shadow:0 4px 14px rgba(15,23,42,.06);overflow:hidden}
    .formulario-card-header{display:flex;align-items:center;gap:10px;padding:17px 21px;background:#f3f8fc;border-bottom:1px solid #dce8f2;color:#174f7c;font-size:15px;font-weight:700}
    .formulario-card-header i{color:#3186dc;font-size:19px}
    .formulario-card-body{padding:25px}

    .formulario-intro{display:flex;align-items:flex-start;gap:10px;margin-bottom:22px;padding:12px 14px;background:#f8fbfd;border:1px solid #e2ebf1;border-radius:8px;color:#687983;font-size:12.5px;line-height:1.55}
    .formulario-intro i{margin-top:1px;color:#3186dc;font-size:17px;flex-shrink:0}

    .campo-grupo{margin-bottom:20px}
    .campo-label{display:flex;align-items:center;gap:5px;margin-bottom:7px;color:#40535e;font-size:12.5px;font-weight:700}
    .campo-label i{color:#3186dc;font-size:14px}
    .campo-obligatorio{color:#d9534f;font-size:12px}

    .formulario-card .form-control{min-height:45px;padding:9px 12px;border:1px solid #d5dfe6;border-radius:7px;color:#34454f;background:#fff;font-size:13.5px;box-shadow:none;transition:.2s}
    .formulario-card .form-control::placeholder{color:#a2adb5}
    .formulario-card .form-control:focus{border-color:#72b1ed;box-shadow:0 0 0 3px rgba(77,157,245,.12)}
    textarea.form-control{min-height:125px;resize:vertical;line-height:1.55}
    input[type=date].form-control{color:#465761}

    .monto-group{display:flex;align-items:stretch}
    .monto-prefix{display:flex;align-items:center;justify-content:center;min-width:48px;border:1px solid #d5dfe6;border-right:none;border-radius:7px 0 0 7px;background:#f3f7fa;color:#526572;font-size:13px;font-weight:700}
    .monto-input{border-radius:0 7px 7px 0!important}

    .campo-ayuda{display:block;margin-top:5px;color:#8b989f;font-size:11px}
    .text-danger{display:block;margin-top:5px;color:#c34646!important;font-size:11.5px}
    .validation-summary-errors{margin-bottom:20px;padding:12px 15px;background:#fff0f0;border:1px solid #f0cccc;border-left:4px solid #d9534f;border-radius:7px;color:#b83b3b;font-size:13px}
    .validation-summary-errors ul{margin:0;padding-left:18px}

    .formulario-actions{display:flex;align-items:center;justify-content:flex-end;flex-wrap:wrap;gap:10px;margin-top:25px;padding-top:20px;border-top:1px solid #e7edf1}
    .btn-regresar,.btn-enviar{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:43px;border-radius:7px;font-size:13px;font-weight:600;text-decoration:none;transition:.2s}
    .btn-regresar{padding:0 17px;border:1px solid #d5dfe5;background:#fff;color:#5f6f79}
    .btn-regresar:hover{background:#f4f7f9;border-color:#c6d1d8;color:#40515b}
    .btn-enviar{padding:0 20px;border:none;background:#4d9df5;color:#fff}
    .btn-enviar:hover{background:#3186dc;color:#fff;transform:translateY(-1px)}
    .btn-enviar i{font-size:15px}

    .formulario-footer{display:flex;align-items:center;gap:7px;margin-top:17px;color:#89969e;font-size:11.5px}
    .formulario-footer i{color:#68b878;font-size:14px}

    @@media(max-width:767.98px){
        .solicitud-create-page{padding:18px 15px 30px}
        .solicitud-create-header{flex-direction:column;align-items:flex-start;padding:18px}
        .create-header-content{width:100%}
        .create-header-icon{width:46px;height:46px;font-size:21px}
        .create-header-text h1{font-size:21px}
        .create-header-text p{font-size:12.5px}
        .btn-volver-panel{width:100%}
        .formulario-card-header{padding:15px 16px}
        .formulario-card-body{padding:18px 15px}
        .formulario-actions{display:grid;grid-template-columns:1fr}
        .btn-regresar,.btn-enviar{width:100%}
    }
</style>

<div class="solicitud-create-page">

    <div class="solicitud-create-header">
        <div class="create-header-content">
            <div class="create-header-icon">
                <i class="bi bi-file-earmark-plus-fill"></i>
            </div>
            <div class="create-header-text">
                <h1>Nueva Solicitud de Viáticos</h1>
                <p>Complete los datos del viaje y envíe la solicitud para su revisión y aprobación.</p>
            </div>
        </div>

        <a asp-controller="Empleado"
           asp-action="Index"
           class="btn-volver-panel">
            <i class="bi bi-arrow-left"></i>
            Volver al panel
        </a>
    </div>

    

    <div class="formulario-card">

        <div class="formulario-card-header">
            <i class="bi bi-card-checklist"></i>
            Datos de la solicitud
        </div>

        <div class="formulario-card-body">

            <div class="formulario-intro">
                <i class="bi bi-info-circle-fill"></i>
                <span>
                    Ingrese la información correspondiente al viaje.
                    Verifique las fechas, destino, motivo y monto antes de enviar la solicitud.
                </span>
            </div>

            <form asp-controller="Solicitud"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary-valid">
                </div>

                <div class="row">

                    <div class="col-12 col-md-6 campo-grupo">
                        <label asp-for="FechaInicio" class="campo-label">
                            <i class="bi bi-calendar-event"></i>
                            Fecha de inicio
                            <span class="campo-obligatorio">*</span>
                        </label>

                        <!-- Se agregó el atributo min con la fecha actual del servidor -->
                        <input asp-for="FechaInicio"
                               type="date"
                               class="form-control"
                               min="@DateTime.Now.ToString("yyyy-MM-dd")"
                               required />

                        <span asp-validation-for="FechaInicio"
                              class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6 campo-grupo">
                        <label asp-for="FechaFin" class="campo-label">
                            <i class="bi bi-calendar-check"></i>
                            Fecha de fin
                            <span class="campo-obligatorio">*</span>
                        </label>

                        <!-- Se agregó el atributo min con la fecha actual del servidor -->
                        <input asp-for="FechaFin"
                               type="date"
                               class="form-control"
                               min="@DateTime.Now.ToString("yyyy-MM-dd")"
                               required />

                        <span asp-validation-for="FechaFin"
                              class="text-danger"></span>
                    </div>

                </div>

                <div class="campo-grupo">
                    <label asp-for="Destino" class="campo-label">
                        <i class="bi bi-geo-alt"></i>
                        Destino
                        <span class="campo-obligatorio">*</span>
                    </label>

                    <input asp-for="Destino"
                           class="form-control"
                           maxlength="200"
                           placeholder="Ejemplo: Lima"
                           required />

                    <span class="campo-ayuda">
                        Indique la ciudad, localidad o lugar donde realizará la actividad.
                    </span>

                    <span asp-validation-for="Destino"
                          class="text-danger"></span>
                </div>

                <div class="campo-grupo">
                    <label asp-for="Motivo" class="campo-label">
                        <i class="bi bi-chat-left-text"></i>
                        Motivo del viaje
                        <span class="campo-obligatorio">*</span>
                    </label>

                    <textarea asp-for="Motivo"
                              class="form-control"
                              rows="5"
                              maxlength="500"
                              placeholder="Describa claramente el motivo y finalidad del viaje..."
                              required></textarea>

                    <span class="campo-ayuda">
                        Explique brevemente la actividad que realizará durante el viaje.
                    </span>

                    <span asp-validation-for="Motivo"
                          class="text-danger"></span>
                </div>

                <div class="campo-grupo">
                    <label asp-for="Monto" class="campo-label">
                        <i class="bi bi-cash-stack"></i>
                        Monto solicitado
                        <span class="campo-obligatorio">*</span>
                    </label>

                    <div class="monto-group">
                        <span class="monto-prefix">S/</span>

                        <input asp-for="Monto"
                               type="number"
                               min="0.01"
                               step="0.01"
                               class="form-control monto-input"
                               placeholder="0.00"
                               required />
                    </div>

                    <span class="campo-ayuda">
                        Ingrese el monto total de viáticos solicitado.
                    </span>

                    <span asp-validation-for="Monto"
                          class="text-danger"></span>
                </div>

                <div class="formulario-actions">
                    <a asp-controller="Solicitud"
                       asp-action="MisSolicitudes"
                       class="btn-regresar">
                        <i class="bi bi-arrow-left"></i>
                        Regresar
                    </a>

                    <button type="submit"
                            class="btn-enviar">
                        <i class="bi bi-send-fill"></i>
                        Enviar solicitud
                    </button>
                </div>

                <div class="formulario-footer">
                    <i class="bi bi-shield-check"></i>
                    <span>Revise la información antes de enviar la solicitud.</span>
                </div>

            </form>

        </div>
    </div>
</div>

<!-- Script opcional para asegurar lógica cruzada entre FechaInicio y FechaFin -->
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const inputFechaInicio = document.getElementById("FechaInicio");
            const inputFechaFin = document.getElementById("FechaFin");

            if (inputFechaInicio && inputFechaFin) {
                inputFechaInicio.addEventListener("change", function () {
                    // Si la fecha de fin es menor a la nueva fecha de inicio, actualizarla
                    inputFechaFin.min = this.value;
                    if (inputFechaFin.value && inputFechaFin.value < this.value) {
                        inputFechaFin.value = this.value;
                    }
                });
            }
        });
    </script>
}