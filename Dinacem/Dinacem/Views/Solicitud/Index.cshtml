@model List<Dinacem.Models.Solicitud>

@{
    ViewData["Title"] = "Solicitudes de Viáticos";
    Layout = "~/Views/Shared/_LayoutAdministrador.cshtml";
    var totalSolicitudes = Model?.Count ?? 0;
    var pendientes = Model?.Count(x => x.IdEstadoSolicitud == 1) ?? 0;
    var aprobadas = Model?.Count(x => x.IdEstadoSolicitud == 2) ?? 0;
    var rechazadas = Model?.Count(x => x.IdEstadoSolicitud == 3) ?? 0;
}

<style>
:root{
    --dinacen-azul:#0c4a8a;
    --dinacen-azul-oscuro:#083763;
    --dinacen-azul-claro:#eaf3fb;
    --texto:#1f2937;
    --texto-secundario:#4b5563;
    --borde:#d9e1ea;
    --fondo:#f3f7fb;
    --blanco:#fff;
}
.solicitudes-page{
    width:100%;
    max-width:1600px;
    margin:0 auto;
    padding:22px;
    background:var(--fondo);
    color:var(--texto);
    font-family:"Segoe UI",Arial,sans-serif;
}
.page-header{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:20px;
    margin-bottom:20px;
    padding:22px 24px;
    background:linear-gradient(135deg,var(--dinacen-azul),#1261a5);
    border-radius:12px;
    box-shadow:0 5px 18px rgba(12,74,138,.18);
}
.page-title{
    margin:0 0 6px;
    color:#fff;
    font-size:28px;
    font-weight:800;
    line-height:1.2;
}
.page-title i{font-size:25px}
.page-description{
    margin:0;
    color:rgba(255,255,255,.9);
    font-size:14px;
    line-height:1.5;
}
.page-header-actions{
    display:flex;
    align-items:center;
    flex-shrink:0;
}
.btn-volver{
    min-height:40px;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:7px;
    padding:9px 16px;
    border:1px solid rgba(255,255,255,.65);
    border-radius:7px;
    background:transparent;
    color:#fff;
    text-decoration:none;
    font-size:13px;
    font-weight:700;
    transition:all .2s ease;
}
.btn-volver:hover{
    background:#fff;
    border-color:#fff;
    color:var(--dinacen-azul);
    transform:translateY(-1px);
}
.resumen-card{
    height:100%;
    padding:17px 19px;
    background:var(--blanco);
    border:1px solid var(--borde);
    border-radius:10px;
    box-shadow:0 3px 10px rgba(15,23,42,.05);
}
.resumen-label{
    display:block;
    margin-bottom:4px;
    color:var(--texto-secundario);
    font-size:13px;
    font-weight:600;
}
.resumen-value{
    margin:0;
    color:var(--texto);
    font-size:24px;
    font-weight:800;
}
.resumen-icon{
    width:42px;
    height:42px;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:9px;
    font-size:19px;
}
.resumen-blue{background:var(--dinacen-azul-claro);color:var(--dinacen-azul)}
.resumen-yellow{background:#fff8e1;color:#b77900}
.resumen-green{background:#edf7e9;color:#4f8d3d}
.resumen-red{background:#fef0f0;color:#c62828}
.alerta-solicitud{
    display:flex;
    align-items:center;
    gap:10px;
    margin-bottom:20px;
    padding:12px 15px;
    border-radius:8px;
    font-size:13px;
    font-weight:600;
}
.alerta-success{
    color:#256b32;
    background:#edf7e9;
    border:1px solid #b8dcae;
}
.alerta-error{
    color:#a91f1f;
    background:#fff0f0;
    border:1px solid #f3b5b5;
}
.alerta-solicitud .btn-close{margin-left:auto}
.filtros-card{
    display:flex;
    align-items:flex-end;
    gap:14px;
    margin-bottom:20px;
    padding:16px 18px;
    background:var(--blanco);
    border:1px solid var(--borde);
    border-radius:10px;
    box-shadow:0 3px 10px rgba(15,23,42,.05);
}
.search-box{
    position:relative;
    width:50%;
}
.search-icon{
    position:absolute;
    top:50%;
    left:13px;
    color:#6b7280;
    pointer-events:none;
    transform:translateY(-50%);
}
.search-input{
    width:100%;
    height:40px;
    padding:0 40px 0 37px;
    border:1px solid #cbd5e1;
    border-radius:7px;
    outline:none;
    color:#111827;
    background:#fff;
    font-size:13px;
}
.search-input::placeholder{color:#8a94a3}
.search-input:focus{
    border-color:var(--dinacen-azul);
    box-shadow:0 0 0 3px rgba(12,74,138,.08);
}
.search-clear{
    position:absolute;
    top:50%;
    right:8px;
    width:25px;
    height:25px;
    display:none;
    align-items:center;
    justify-content:center;
    border:0;
    background:transparent;
    color:#6b7280;
    cursor:pointer;
    transform:translateY(-50%);
}
.search-clear:hover{color:#111827}
.date-filter{width:170px}
.date-label{
    display:block;
    margin-bottom:6px;
    color:#111827;
    font-size:12px;
    font-weight:700;
}
.date-filter .form-control{
    height:40px;
    border:1px solid #cbd5e1;
    border-radius:7px;
    color:#111827;
    font-size:13px;
}
.date-filter .form-control:focus{
    border-color:var(--dinacen-azul);
    box-shadow:0 0 0 3px rgba(12,74,138,.08);
}
.btn-limpiar{
    height:40px;
    padding:0 15px;
    border:1px solid #cbd5e1;
    border-radius:7px;
    background:#fff;
    color:#475569;
    font-size:13px;
    font-weight:700;
}
.btn-limpiar:hover{
    background:#f8fafc;
    border-color:#94a3b8;
    color:#1e293b;
}
.solicitudes-card{
    overflow:hidden;
    background:var(--blanco);
    border:1px solid var(--borde);
    border-radius:10px;
    box-shadow:0 3px 10px rgba(15,23,42,.05);
}
.solicitudes-card-header{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:15px;
    padding:15px 20px;
    background:#fff;
    border-bottom:1px solid var(--borde);
}
.solicitudes-card-title{
    margin:0;
    color:#111827;
    font-size:16px;
    font-weight:800;
}
.solicitudes-card-title i{color:var(--dinacen-azul)}
.table-wrapper{
    width:100%;
    overflow-x:auto;
    -webkit-overflow-scrolling:touch;
}
.solicitudes-table{
    width:100%;
    min-width:1050px;
    margin:0;
    border-collapse:separate;
    border-spacing:0;
}
.solicitudes-table thead th{
    padding:13px 14px;
    background:var(--dinacen-azul);
    border-bottom:2px solid var(--dinacen-azul-oscuro);
    color:#fff;
    font-size:12px;
    font-weight:800;
    text-align:left;
    white-space:nowrap;
}
.solicitudes-table tbody td{
    padding:12px 14px;
    border-bottom:1px solid #e5e7eb;
    color:#1f2937;
    background:#fff;
    font-size:13px;
    font-weight:500;
    vertical-align:middle;
}
.solicitudes-table tbody tr{transition:background .15s ease}
.solicitudes-table tbody tr:hover td{background:#f7fbff}
.solicitudes-table tbody tr:last-child td{border-bottom:0}
.empleado-nombre{
    color:#111827;
    font-size:13px;
    font-weight:700;
}
.empleado-correo{
    color:#64748b;
    font-size:11px;
}
.periodo{white-space:nowrap}
.periodo small{
    color:#64748b;
    font-size:11px;
}
.monto{
    color:#111827;
    font-size:13px;
    font-weight:800;
    white-space:nowrap;
}
.estado{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:5px;
    min-width:85px;
    padding:5px 9px;
    border-radius:20px;
    font-size:11px;
    font-weight:800;
    white-space:nowrap;
}
.estado-pendiente{background:#fff8e1;color:#a16207}
.estado-aprobado{background:#e8f5e9;color:#2e7d32}
.estado-rechazado{background:#ffebee;color:#c62828}
.observacion-rechazo{
    max-width:220px;
    color:#991b1b;
    font-size:12px;
    line-height:1.4;
}
.acciones{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:6px;
    flex-wrap:wrap;
}
.acciones-procesada {
    display: flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
}

.btn-voucher {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 8px;
    border: 1px solid #0d6efd;
    border-radius: 5px;
    background: #fff;
    color: #0d6efd;
    text-decoration: none;
    font-size: 11px;
    font-weight: 600;
    line-height: 1.2;
    transition: all 0.2s ease;
}

.btn-voucher:hover {
    background: #0d6efd;
    color: #fff;
}
.btn-accion{
    min-height:34px;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:5px;
    padding:6px 10px;
    border:1px solid;
    border-radius:6px;
    font-size:11px;
    font-weight:800;
    line-height:1;
    white-space:nowrap;
    cursor:pointer;
    transition:all .2s ease;
}
.btn-accion:hover{transform:translateY(-1px)}
.btn-aprobar{
    border-color:#b8dcae;
    background:#f5fbf2;
    color:#388e3c;
}
.btn-aprobar:hover{
    border-color:#8bc580;
    background:#e8f5e9;
    color:#2e7d32;
}
.btn-rechazar{
    border-color:#f3b5b5;
    background:#fff7f7;
    color:#c62828;
}
.btn-rechazar:hover{
    border-color:#e57373;
    background:#ffebee;
    color:#a91f1f;
}
.procesada{
    color:#64748b;
    font-size:11px;
    font-weight:600;
    white-space:nowrap;
}
.sin-resultados{
    padding:55px 20px!important;
    color:#6b7280!important;
    text-align:center;
    font-size:13px!important;
}
.sin-resultados i{
    display:block;
    margin-bottom:10px;
    color:#9ca3af;
    font-size:38px;
}
.modal-content{
    border:0;
    border-radius:12px;
    overflow:hidden;
}
.modal-header-rechazo{
    padding:15px 20px;
    background:#c62828;
    color:#fff;
}
.modal-header-rechazo .modal-title{
    font-size:15px;
    font-weight:700;
}
.modal-body{padding:20px}
.modal-body .form-label{
    margin-bottom:6px;
    color:#111827;
    font-size:13px;
    font-weight:700;
}
.modal-body .form-control{
    border:1px solid #cbd5e1;
    border-radius:7px;
    font-size:13px;
}
.modal-body .form-control:focus{
    border-color:var(--dinacen-azul);
    box-shadow:0 0 0 3px rgba(12,74,138,.08);
}
.modal-body small{
    color:#64748b!important;
    font-size:11px;
}
.modal-footer{
    padding:14px 20px;
    border-top:1px solid var(--borde);
}
.modal-aprobacion-content{
    border-radius:12px;
    border:none;
    box-shadow:0 10px 30px rgba(0,0,0,.15);
}
.modal-aprobacion-header{
    background:#f3f8fc;
    border-bottom:1px solid #dce8f2;
    padding:18px 25px;
}
.modal-aprobacion-title{
    color:#174f7c;
    font-weight:700;
    font-size:18px;
}
.modal-aprobacion-body{padding:25px}
.columna-izquierda{border-right:1px solid #e7edf1}
.seccion-titulo{
    color:#174f7c;
    font-weight:700;
    margin-bottom:15px;
}
.form-label-custom{
    font-size:13px;
    font-weight:600;
    color:#40535e;
}
.form-control-custom{
    min-height:45px;
    padding:9px 12px;
    border:1px solid #d5dfe6;
    border-radius:7px;
}
.form-text-custom{font-size:11.5px}
.tabla-depositos-container{
    max-height:250px;
    overflow-y:auto;
    border:1px solid #e2ebf1;
    border-radius:8px;
}
.tabla-depositos{font-size:12.5px}
.tabla-depositos thead{
    position:sticky;
    top:0;
    background:#f8fbfd;
}
.btn-ver-voucher {
    font-size: 11px;
    padding: 3px 8px;
    line-height: 1.2;
    white-space: nowrap;
}
.btn-ver-comprobante{font-size:11px}
.modal-aprobacion-footer{
    background:#f8fbfd;
    border-top:1px solid #dce8f2;
    padding:15px 25px;
}
.btn-cancelar-custom{
    border-radius:7px;
    font-size:13px;
}
.btn-confirmar-custom{
    background:#327942;
    border:none;
    border-radius:7px;
    font-size:13px;
    font-weight:600;
    padding:8px 20px;
}
@@media(max-width:992px){
    .solicitudes-page{padding:18px}
    .page-header{align-items:flex-start}
    .page-title{font-size:24px}
    .filtros-card{flex-wrap:wrap}
    .search-box{width:100%}
    .date-filter{
        flex:1;
        min-width:160px;
    }
}
@@media(max-width:768px){
    .solicitudes-page{padding:14px}
    .page-header{
        flex-direction:column;
        padding:18px;
        border-radius:10px;
    }
    .page-title{font-size:22px}
    .page-title i{font-size:20px}
    .page-description{font-size:13px}
    .page-header-actions{width:100%}
    .btn-volver{width:100%}
    .filtros-card{
        flex-direction:column;
        align-items:stretch;
        gap:12px;
        padding:14px;
    }
    .search-box,.date-filter{
        width:100%;
        min-width:100%;
    }
    .btn-limpiar{width:100%}
    .solicitudes-card-header{padding:14px 16px}
    .table-wrapper{overflow-x:auto}
    .acciones{
        flex-direction:column;
        align-items:stretch;
    }
    .btn-accion{width:100%}
    .columna-izquierda{
        border-right:0;
        border-bottom:1px solid #e7edf1;
        padding-bottom:20px;
    }
}
@@media(max-width:576px){
    .solicitudes-page{padding:10px}
    .page-title{font-size:20px}
    .page-description{font-size:12px}
    .resumen-value{font-size:21px}
    .solicitudes-table{min-width:1000px}
    .modal-dialog{margin:10px}
    .modal-aprobacion-header{padding:15px}
    .modal-aprobacion-body{padding:18px}
    .modal-aprobacion-footer{padding:12px 18px}
}
</style>

<div class="solicitudes-page">
    <div class="page-header">
        <div>
            <h1 class="page-title">
                <i class="bi bi-file-earmark-text-fill me-2"></i>
                Solicitudes de Viáticos
            </h1>
            <p class="page-description">
                Revise, apruebe o rechace las solicitudes registradas por los empleados.
            </p>
        </div>
        <div class="page-header-actions">
            <a asp-controller="Principal" asp-action="Index" class="btn-volver">
                <i class="bi bi-arrow-left"></i>
                Volver al panel
            </a>
        </div>
    </div>

    @if (TempData["mensajeSolicitud"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show alerta-solicitud alerta-success" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["mensajeSolicitud"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @if (TempData["errorSolicitud"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show alerta-solicitud alerta-error" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @Html.Raw(TempData["errorSolicitud"])
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-6 col-xl-3">
            <div class="resumen-card">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="resumen-label">Total de solicitudes</span>
                        <h3 class="resumen-value">@totalSolicitudes</h3>
                    </div>
                    <div class="resumen-icon resumen-blue">
                        <i class="bi bi-file-earmark-text"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="resumen-card">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="resumen-label">Solicitudes pendientes</span>
                        <h3 class="resumen-value">@pendientes</h3>
                    </div>
                    <div class="resumen-icon resumen-yellow">
                        <i class="bi bi-clock"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="resumen-card">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="resumen-label">Solicitudes aprobadas</span>
                        <h3 class="resumen-value">@aprobadas</h3>
                    </div>
                    <div class="resumen-icon resumen-green">
                        <i class="bi bi-check-circle"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="resumen-card">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="resumen-label">Solicitudes rechazadas</span>
                        <h3 class="resumen-value">@rechazadas</h3>
                    </div>
                    <div class="resumen-icon resumen-red">
                        <i class="bi bi-x-circle"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="filtros-card">
        <div class="search-box">
            <i class="bi bi-search search-icon"></i>
            <input type="search" id="buscadorSolicitudes" class="search-input" placeholder="Buscar empleado, zona, destino, motivo o estado..." autocomplete="off">
            <button type="button" id="limpiarBusqueda" class="search-clear" title="Limpiar búsqueda">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <div class="date-filter">
            <label for="fechaDesde" class="date-label">Fecha desde</label>
            <input type="date" id="fechaDesde" class="form-control">
        </div>
        <div class="date-filter">
            <label for="fechaHasta" class="date-label">Fecha hasta</label>
            <input type="date" id="fechaHasta" class="form-control">
        </div>
        <button type="button" id="limpiarFiltros" class="btn-limpiar">
            <i class="bi bi-arrow-counterclockwise me-1"></i>
            Limpiar
        </button>
    </div>

    <div class="solicitudes-card">
        <div class="solicitudes-card-header">
            <h2 class="solicitudes-card-title">
                <i class="bi bi-list-ul me-2"></i>
                Lista de solicitudes
            </h2>
        </div>

        <div class="table-wrapper">
            <table class="solicitudes-table" id="tablaSolicitudes">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Empleado</th>
                        <th>Periodo</th>
                        <th>Destino</th>
                        <th>Motivo</th>
                        <th>Monto</th>
                        <th>Estado</th>
                        <th>Observación</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                   @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            var zona = item.Usuario?.Zona?.CodigoZona ?? "";
                            var estadoTexto = item.IdEstadoSolicitud == 1
                                ? "Pendiente"
                                : item.IdEstadoSolicitud == 2
                                    ? "Aprobada"
                                    : item.IdEstadoSolicitud == 3
                                        ? "Rechazada"
                                        : "Sin estado";

                            <tr data-fecha="@item.Fecha.ToString("yyyy-MM-dd")" data-zona="@zona" data-estado="@estadoTexto">
                                <td>
                                    <strong>#@item.IdSolicitud</strong>
                                </td>
                                <td>
                                    <div class="empleado-nombre">
                                        @item.Usuario?.Nombres @item.Usuario?.Apellidos
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(item.Usuario?.Correo))
                                    {
                                        <div class="empleado-correo">@item.Usuario.Correo</div>
                                    }
                                </td>
                                <td>
                                    <div class="periodo">
                                        @item.FechaInicio.ToString("dd/MM/yyyy")
                                        <br>
                                        <small>hasta @item.FechaFin.ToString("dd/MM/yyyy")</small>
                                    </div>
                                </td>
                                <td>@item.Destino</td>
                                <td>@item.Motivo</td>
                                <td>
                                    <span class="monto">S/ @item.Monto.ToString("N2")</span>
                                </td>
                                <td>
                                    @if (item.IdEstadoSolicitud == 1)
                                    {
                                        <span class="estado estado-pendiente">
                                            <i class="bi bi-clock-fill"></i>
                                            Pendiente
                                        </span>
                                    }
                                    else if (item.IdEstadoSolicitud == 2)
                                    {
                                        <span class="estado estado-aprobado">
                                            <i class="bi bi-check-circle-fill"></i>
                                            Aprobada
                                        </span>
                                    }
                                    else if (item.IdEstadoSolicitud == 3)
                                    {
                                        <span class="estado estado-rechazado">
                                            <i class="bi bi-x-circle-fill"></i>
                                            Rechazada
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="estado bg-secondary text-white">Sin estado</span>
                                    }
                                </td>
                                <td>
                                    @if (item.IdEstadoSolicitud == 3 && !string.IsNullOrWhiteSpace(item.Observaciones))
                                    {
                                        <div class="observacion-rechazo">@item.Observaciones</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                               <td>
    <div class="acciones">

        @if (item.IdEstadoSolicitud == 1)
        {
            <button type="button"
                    class="btn-accion btn-aprobar"
                    data-bs-toggle="modal"
                    data-bs-target="#modalAprobar-@item.IdSolicitud">
                <i class="bi bi-check-circle"></i>
                Aprobar
            </button>

            <button type="button"
                    class="btn-accion btn-rechazar"
                    data-bs-toggle="modal"
                    data-bs-target="#modalRechazar-@item.IdSolicitud">
                <i class="bi bi-x-circle"></i>
                Rechazar
            </button>
        }
        else
        {
            <div class="acciones-procesada">

                <span class="procesada">
                    <i class="bi bi-lock-fill"></i>
                    Procesada
                </span>

                @if (item.IdEstadoSolicitud == 2 &&
                     !string.IsNullOrWhiteSpace(item.RutaComprobante))
                {
                    <a href="@item.RutaComprobante"
                       target="_blank"
                       class="btn-voucher"
                       title="Ver voucher">
                        <i class="bi bi-file-earmark-text"></i>
                        Voucher
                    </a>
                }

            </div>
        }

    </div>
</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="sin-resultados">
                                <i class="bi bi-inbox"></i>
                                No hay solicitudes registradas.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (Model != null && Model.Any(x => x.IdEstadoSolicitud == 1))
{
    foreach (var item in Model.Where(x => x.IdEstadoSolicitud == 1))
    {
        <div class="modal fade" id="modalAprobar-@item.IdSolicitud" tabindex="-1" aria-labelledby="modalAprobarLabel-@item.IdSolicitud" aria-hidden="true">
            <div class="modal-dialog modal-xl modal-dialog-centered">
                <div class="modal-content modal-aprobacion-content">
                    <div class="modal-header modal-aprobacion-header">
                        <h5 class="modal-title modal-aprobacion-title" id="modalAprobarLabel-@item.IdSolicitud">
                            <i class="bi bi-cash-coin me-2"></i>
                            Aprobar Solicitud y Registrar Comprobante
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <form asp-controller="Solicitud" asp-action="Aprobar" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.IdSolicitud">
                        <div class="modal-body modal-aprobacion-body">
                            <div class="row g-4">
                                <div class="col-12 col-lg-6 columna-izquierda">
                                    <h6 class="seccion-titulo">
                                        <i class="bi bi-upload me-1"></i>
                                        Subir Comprobante de Depósito
                                    </h6>
                                    <div class="mb-3">
                                        <label class="form-label form-label-custom">
                                            Seleccionar archivo (Imagen o PDF) <span class="text-danger">*</span>
                                        </label>
                                        <input type="file" name="comprobante" class="form-control form-control-custom" accept=".jpg,.jpeg,.png,.pdf" required>
                                        <small class="text-muted d-block mt-1 form-text-custom">
                                            Formatos permitidos: JPG, PNG o PDF (Máx. 5MB).
                                        </small>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label form-label-custom">
                                            Observaciones o detalles de la transferencia (Opcional)
                                        </label>
                                        <textarea name="observacionAprobacion" class="form-control" rows="3" placeholder="Número de operación, banco emisor, etc..."></textarea>
                                    </div>
                                </div>
                                <div class="col-12 col-lg-6">
                                    <h6 class="seccion-titulo">
                                        <i class="bi bi-clock-history me-1"></i>
                                        Historial de Depósitos / Pagos
                                    </h6>
                                    <div class="table-responsive tabla-depositos-container">
                                        <table class="table table-sm table-striped mb-0 tabla-depositos">
                                            <thead>
                                                <tr>
                                                    <th>Fecha</th>
                                                    <th>Monto</th>
                                                    <th>Comprobante</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td>15/05/2026</td>
                                                    <td>S/ 450.00</td>
                                                    <td>
                                                        <a href="#" target="_blank" class="btn btn-sm btn-outline-primary py-0 px-1 btn-ver-comprobante">
                                                            <i class="bi bi-file-earmark-pdf"></i> Ver
                                                        </a>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>10/04/2026</td>
                                                    <td>S/ 300.00</td>
                                                    <td>
                                                        <a href="#" target="_blank" class="btn btn-sm btn-outline-primary py-0 px-1 btn-ver-comprobante">
                                                            <i class="bi bi-file-earmark-image"></i> Ver
                                                        </a>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                    <small class="text-muted d-block mt-2 form-text-custom">
                                        * Muestra los depósitos previos realizados asociados a este usuario/solicitud.
                                    </small>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer modal-aprobacion-footer">
                            <button type="button" class="btn btn-secondary btn-cancelar-custom" data-bs-dismiss="modal">
                                Cancelar
                            </button>
                            <button type="submit" class="btn btn-success btn-confirmar-custom">
                                <i class="bi bi-check2-all me-1"></i>
                                Confirmar Aprobación y Guardar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="modal fade" id="modalRechazar-@item.IdSolicitud" tabindex="-1" aria-labelledby="tituloRechazar-@item.IdSolicitud" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <form asp-controller="Solicitud" asp-action="Rechazar" method="post">
                        @Html.AntiForgeryToken()
                        <div class="modal-header modal-header-rechazo">
                            <h5 class="modal-title" id="tituloRechazar-@item.IdSolicitud">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                Rechazar solicitud #@item.IdSolicitud
                            </h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                        </div>
                        <div class="modal-body">
                            <input type="hidden" name="id" value="@item.IdSolicitud">
                            <div class="alert alert-warning">
                                <strong>Empleado:</strong>
                                @item.Usuario?.Nombres @item.Usuario?.Apellidos
                                <br>
                                <strong>Zona:</strong>
                                @item.Usuario?.Zona?.CodigoZona
                                <br>
                                <strong>Destino:</strong>
                                @item.Destino
                            </div>
                            <div class="mb-3">
                                <label for="observaciones-@item.IdSolicitud" class="form-label">
                                    Motivo del rechazo
                                </label>
                                <textarea id="observaciones-@item.IdSolicitud" name="observaciones" class="form-control" rows="5" maxlength="1000" placeholder="Explique claramente por qué se rechaza la solicitud..." required></textarea>
                                <small class="text-muted">
                                    Esta observación será visible para el empleado.
                                </small>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                                Cancelar
                            </button>
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-x-circle me-1"></i>
                                Confirmar rechazo
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}

@section Scripts {
    <script src="~/js/IndexSolicitud.js"></script>
}