@model List<Dinacem.Models.Solicitud>

@{
    ViewData["Title"] = "Solicitudes de Viáticos";
    Layout = "~/Views/Shared/_LayoutAdministrador.cshtml";

    var totalSolicitudes = Model?.Count ?? 0;
    var pendientes = Model?.Count(x => x.IdEstadoSolicitud == 1) ?? 0;
    var aprobadas = Model?.Count(x => x.IdEstadoSolicitud == 2) ?? 0;
    var rechazadas = Model?.Count(x => x.IdEstadoSolicitud == 3) ?? 0;
}

<style>

    /* ============================================================
           CONTENEDOR PRINCIPAL
           ============================================================ */

    .page-wrapper {
        width: 100%;
        max-width: 1600px;
        margin: 0 auto;
        padding: 0;
    }


    /* ============================================================
           ENCABEZADO
           ============================================================ */

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        padding: 22px;
        margin-bottom: 24px;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        box-shadow: 0 5px 18px rgba(15, 23, 42, .05);
    }

    .page-title {
        margin: 0 0 5px;
        color: #17365d;
        font-size: 28px;
        font-weight: 800;
        letter-spacing: -0.3px;
    }

        .page-title i {
            color: #0c4a8a;
            font-size: 1.55rem;
        }

    .page-description {
        margin: 0;
        color: #64748b;
        font-size: 14px;
        font-weight: 500;
    }


    /* ============================================================
           BOTÓN VOLVER
           ============================================================ */

    .page-header-actions {
        display: flex;
        align-items: center;
    }

        .page-header-actions .btn {
            padding: 8px 15px;
            border-radius: 8px;
            font-weight: 600;
            transition: all .2s ease;
        }

            .page-header-actions .btn:hover {
                transform: translateY(-1px);
            }


    /* ============================================================
           TARJETAS RESUMEN
           ============================================================ */

    .summary-card {
        height: 100%;
        padding: 17px 18px;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 13px;
        box-shadow: 0 4px 12px rgba(15, 23, 42, .04);
    }

    .summary-label {
        color: #64748b;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
    }

    .summary-value {
        margin-top: 4px;
        color: #0f172a;
        font-size: 26px;
        font-weight: 800;
    }


    /* ============================================================
           PANEL
           ============================================================ */

    .panel {
        background: #ffffff;
        border: 1px solid #dbe1ea;
        border-radius: 15px;
        box-shadow: 0 5px 18px rgba(15, 23, 42, .05);
        overflow: hidden;
    }

    .panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding: 18px 20px;
        border-bottom: 1px solid #e2e8f0;
    }

    .panel-title {
        margin: 0;
        color: #0f172a;
        font-size: 18px;
        font-weight: 800;
    }

    .panel-body {
        padding: 20px;
    }


    /* ============================================================
           TABLA
           ============================================================ */

    .table {
        min-width: 1100px;
        font-size: 14px;
    }

        .table thead th {
            color: #64748b;
            background: #f8fafc;
            font-size: 12px;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .table td {
            vertical-align: middle;
        }


    /* ============================================================
           ESTADOS
           ============================================================ */

    .estado {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 7px 11px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .estado-pendiente {
        color: #92400e;
        background: #fef3c7;
        border: 1px solid #fcd34d;
    }

    .estado-aprobado {
        color: #166534;
        background: #dcfce7;
        border: 1px solid #86efac;
    }

    .estado-rechazado {
        color: #991b1b;
        background: #fee2e2;
        border: 1px solid #fca5a5;
    }


    /* ============================================================
           ACCIONES
           ============================================================ */

    .acciones {
        display: flex;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: 6px;
    }


    /* ============================================================
           BUSCADOR Y FILTROS
           ============================================================ */

    .solicitudes-search {
        width: 100%;
        display: flex;
        align-items: flex-end;
        gap: 14px;
        margin-bottom: 22px;
        padding: 16px 18px;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(15, 23, 42, .05);
    }


    /* ============================================================
           BUSCADOR
           ============================================================ */

    .search-box {
        position: relative;
        width: 50%;
        min-width: 300px;
    }

    .search-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #64748b;
        font-size: 1rem;
        pointer-events: none;
    }

    .search-input {
        width: 100%;
        height: 42px;
        padding: 8px 42px 8px 40px;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        background: #ffffff;
        color: #1e293b;
        font-size: .92rem;
        outline: none;
        transition: border-color .2s ease, box-shadow .2s ease;
    }

        .search-input::placeholder {
            color: #94a3b8;
        }

        .search-input:focus {
            border-color: #0c4a8a;
            box-shadow: 0 0 0 3px rgba(12, 74, 138, .10);
        }


    /* ============================================================
           BOTÓN X
           ============================================================ */

    .search-clear {
        position: absolute;
        right: 8px;
        top: 50%;
        transform: translateY(-50%);
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: none;
        border-radius: 6px;
        background: transparent;
        color: #94a3b8;
        cursor: pointer;
        transition: background .2s ease, color .2s ease;
    }

        .search-clear:hover {
            background: #f1f5f9;
            color: #dc2626;
        }


    /* ============================================================
           FILTROS DE FECHA
           ============================================================ */

    .date-filter {
        width: 170px;
    }

    .date-label {
        display: block;
        margin-bottom: 6px;
        color: #475569;
        font-size: .78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .3px;
    }

    .date-filter .form-control {
        height: 42px;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        color: #334155;
        font-size: .88rem;
        outline: none;
        transition: border-color .2s ease, box-shadow .2s ease;
    }

        .date-filter .form-control:focus {
            border-color: #0c4a8a;
            box-shadow: 0 0 0 3px rgba(12, 74, 138, .10);
        }


    /* ============================================================
           BOTÓN LIMPIAR
           ============================================================ */

    #limpiarFiltros {
        height: 42px;
        padding: 0 15px;
        border-radius: 8px;
        font-size: .86rem;
        font-weight: 600;
        white-space: nowrap;
    }


    /* ============================================================
           MODALES
           ============================================================ */

    .modal-content {
        border: 0;
        border-radius: 15px;
        overflow: hidden;
    }

    .modal-header-rechazo {
        color: #ffffff;
        background: #dc3545;
    }

    .observacion-rechazo {
        max-width: 260px;
        color: #991b1b;
        font-size: 13px;
    }


    /* ============================================================
           RESPONSIVE - TABLET
           ============================================================ */

    @@media screen and (max-width: 991.98px) {

        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .page-header-actions {
            width: 100%;
        }

            .page-header-actions .btn {
                width: 100%;
            }

        .panel-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .solicitudes-search {
            flex-wrap: wrap;
        }

        .search-box {
            width: 100%;
            min-width: 100%;
        }

        .date-filter {
            flex: 1;
            min-width: 160px;
        }
    }


    /* ============================================================
           RESPONSIVE - CELULAR
           ============================================================ */

    @@media screen and (max-width: 767.98px) {

        .page-wrapper {
            padding: 0 12px;
        }

        .page-header {
            padding: 18px;
            border-radius: 13px;
        }

        .page-title {
            font-size: 23px;
        }

        .summary-value {
            font-size: 23px;
        }

        .panel-body {
            padding: 14px;
        }

        .modal-dialog {
            margin: 12px;
        }

        .modal-footer {
            display: grid;
            grid-template-columns: 1fr;
        }

            .modal-footer .btn {
                width: 100%;
            }

        .solicitudes-search {
            flex-direction: column;
            align-items: stretch;
            gap: 12px;
            padding: 14px;
        }

        .search-box {
            width: 100%;
            min-width: 100%;
        }

        .date-filter {
            width: 100%;
            min-width: 100%;
        }

        #limpiarFiltros {
            width: 100%;
        }
    }


    /* ============================================================
           RESPONSIVE - CELULAR PEQUEÑO
           ============================================================ */

    @@media screen and (max-width: 480px) {

        .page-title {
            font-size: 20px;
        }

        .page-description {
            font-size: 13px;
        }

        .page-header {
            padding: 15px;
        }

        .panel-body {
            padding: 10px;
        }

        .search-input {
            font-size: 14px;
        }
    }

</style>

<div class="page-wrapper">

    <!--
        La barra de navegación del administrador
        se carga desde _LayoutAdministrador.cshtml
    -->

    <div class="page-header">

        <div>
            <h1 class="page-title">
                <i class="bi bi-file-earmark-text-fill me-2"></i>
                Solicitudes de Viáticos
            </h1>

            <p class="page-description">
                Revise, apruebe o rechace las solicitudes registradas por los empleados.
            </p>
        </div>

        <a asp-controller="Principal"
           asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left"></i>
            Volver al panel

        </a>

    </div>

    @if (TempData["mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            @TempData["mensaje"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>

        </div>
    }

    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            @Html.Raw(TempData["error"])

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>

        </div>
    }

   <!-- RESUMEN -->

<div class="row g-3 mb-4">

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="summary-card">

            <div class="summary-label">
                Total de solicitudes
            </div>

            <div class="summary-value">
                @totalSolicitudes
            </div>

        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="summary-card">

            <div class="summary-label text-warning">
                Pendientes
            </div>

            <div class="summary-value">
                @pendientes
            </div>

        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="summary-card">

            <div class="summary-label text-success">
                Aprobadas
            </div>

            <div class="summary-value">
                @aprobadas
            </div>

        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="summary-card">

            <div class="summary-label text-danger">
                Rechazadas
            </div>

            <div class="summary-value">
                @rechazadas
            </div>

        </div>
    </div>

</div>

        <!-- ============================================================
     BUSCADOR Y FILTROS
     ============================================================ -->

        <div class="solicitudes-search">

            <!-- BUSCADOR GENERAL -->

            <div class="search-box">

                <i class="bi bi-search search-icon"></i>

                <input type="search"
                       id="buscadorSolicitudes"
                       class="search-input"
                       placeholder="Buscar solicitudes ..."
                       autocomplete="off" />

                <button type="button"
                        id="limpiarBusqueda"
                        class="search-clear"
                        aria-label="Limpiar búsqueda">

                    <i class="bi bi-x-lg"></i>

                </button>

            </div>


            <!-- FECHA DESDE -->

            <div class="date-filter">

                <label for="fechaDesde" class="date-label">
                    <i class="bi bi-calendar3 me-1"></i>
                    Desde
                </label>

                <input type="date"
                       id="fechaDesde"
                       class="form-control" />

            </div>


            <!-- FECHA HASTA -->

            <div class="date-filter">

                <label for="fechaHasta" class="date-label">
                    <i class="bi bi-calendar3 me-1"></i>
                    Hasta
                </label>

                <input type="date"
                       id="fechaHasta"
                       class="form-control" />

            </div>


            <!-- LIMPIAR FILTROS -->

            <button type="button"
                    id="limpiarFiltros"
                    class="btn btn-outline-secondary">

                <i class="bi bi-arrow-counterclockwise me-1"></i>

                Limpiar

            </button>

        </div>
    <!-- =================================================
     TABLA DE SOLICITUDES
     ================================================= -->

<div class="panel-body">

    <div class="table-responsive">

        <table id="tablaSolicitudes"
               class="table table-hover table-bordered align-middle mb-0">

            <!-- =================================================
                 CABECERA
                 ================================================= -->

            <thead>

                <tr>

                    <th>#</th>

                    <th>Empleado</th>

                    <th>Fecha</th>

                    <th>Periodo</th>

                    <th>Destino</th>

                    <th>Motivo</th>

                    <th>Monto</th>

                    <th>Estado</th>

                    <th>Observación</th>

                    <th class="text-end">
                        Acciones
                    </th>

                </tr>

            </thead>


            <!-- =================================================
                 CUERPO
                 ================================================= -->

            <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr data-fecha="@item.Fecha.ToString("yyyy-MM-dd")">

                                <td>

                                    <strong>
                                        #@item.IdSolicitud
                                    </strong>

                                </td>


                            <!-- =================================
                                 EMPLEADO
                                 ================================= -->

                            <td>

                                <strong>

                                    @item.Usuario?.Nombres
                                    @item.Usuario?.Apellidos

                                </strong>

                                @if (!string.IsNullOrWhiteSpace(item.Usuario?.Correo))
                                {
                                    <br />

                                    <small class="text-muted">

                                        @item.Usuario.Correo

                                    </small>
                                }

                            </td>


                            <!-- =================================
                                 FECHA
                                 ================================= -->

                            <td>

                                @item.Fecha.ToString("dd/MM/yyyy")

                            </td>


                            <!-- =================================
                                 PERIODO
                                 ================================= -->

                            <td>

                                @item.FechaInicio.ToString("dd/MM/yyyy")

                                <br />

                                <small class="text-muted">

                                    hasta
                                    @item.FechaFin.ToString("dd/MM/yyyy")

                                </small>

                            </td>


                            <!-- =================================
                                 DESTINO
                                 ================================= -->

                            <td>

                                @item.Destino

                            </td>


                            <!-- =================================
                                 MOTIVO
                                 ================================= -->

                            <td>

                                @item.Motivo

                            </td>


                            <!-- =================================
                                 MONTO
                                 ================================= -->

                            <td>

                                <strong>

                                    S/ @item.Monto.ToString("N2")

                                </strong>

                            </td>


                            <!-- =================================
                                 ESTADO
                                 ================================= -->

                            <td>

                                @if (item.IdEstadoSolicitud == 1)
                                {
                                    <span class="estado estado-pendiente">

                                        <i class="bi bi-clock-fill"></i>

                                        Pendiente

                                    </span>
                                }
                                else if (item.IdEstadoSolicitud == 2)
                                {
                                    <span class="estado estado-aprobado">

                                        <i class="bi bi-check-circle-fill"></i>

                                        Aprobada

                                    </span>
                                }
                                else if (item.IdEstadoSolicitud == 3)
                                {
                                    <span class="estado estado-rechazado">

                                        <i class="bi bi-x-circle-fill"></i>

                                        Rechazada

                                    </span>
                                }
                                else
                                {
                                    <span class="estado bg-secondary text-white">

                                        Sin estado

                                    </span>
                                }

                            </td>


                            <!-- =================================
                                 OBSERVACIÓN
                                 ================================= -->

                            <td>

                                @if (item.IdEstadoSolicitud == 3 &&
                               !string.IsNullOrWhiteSpace(item.Observaciones))
                                {
                                    <div class="observacion-rechazo">

                                        @item.Observaciones

                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">

                                        —

                                    </span>
                                }

                            </td>


                            <!-- =================================
                                 ACCIONES
                                 ================================= -->

                            <td>

                                <div class="acciones">

                                    @if (item.IdEstadoSolicitud == 1)
                                    {
                                        <!-- APROBAR -->

                                        <form asp-controller="Solicitud"
                                              asp-action="Aprobar"
                                              method="post"
                                              class="d-inline">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@item.IdSolicitud" />

                                            <button type="submit"
                                                    class="btn btn-success btn-sm"
                                                    onclick="return confirm('¿Desea aprobar esta solicitud?');">

                                                <i class="bi bi-check-circle"></i>

                                                Aprobar

                                            </button>

                                        </form>


                                        <!-- RECHAZAR -->

                                        <button type="button"
                                                class="btn btn-danger btn-sm"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalRechazar-@item.IdSolicitud">

                                            <i class="bi bi-x-circle"></i>

                                            Rechazar

                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">

                                            <i class="bi bi-lock-fill"></i>

                                            Procesada

                                        </span>
                                    }

                                </div>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <!-- =============================================
                         SIN SOLICITUDES
                         ============================================= -->

                    <tr>

                        <td colspan="10"
                            class="text-center text-muted py-5">

                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>

                            No hay solicitudes registradas.

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

    <!-- BOTÓN INFERIOR -->

    <div class="mt-4">

        <a asp-controller="Principal"
           asp-action="Index"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left"></i>
            Regresar

        </a>

    </div>

</div>

<!--
    Los modales se colocan fuera de la tabla para mantener
    una estructura HTML válida y evitar problemas en celulares.
-->
@if (Model != null && Model.Any())
{
    foreach (var item in Model.Where(x => x.IdEstadoSolicitud == 1))
    {
        <div class="modal fade"
             id="modalRechazar-@item.IdSolicitud"
             tabindex="-1"
             aria-labelledby="tituloRechazar-@item.IdSolicitud"
             aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered">

                <div class="modal-content">

                    <form asp-controller="Solicitud"
                          asp-action="Rechazar"
                          method="post">

                        <div class="modal-header modal-header-rechazo">

                            <h5 class="modal-title"
                                id="tituloRechazar-@item.IdSolicitud">

                                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                Rechazar solicitud #@item.IdSolicitud

                            </h5>

                            <button type="button"
                                    class="btn-close btn-close-white"
                                    data-bs-dismiss="modal"
                                    aria-label="Cerrar">
                            </button>

                        </div>

                        <div class="modal-body">

                            <input type="hidden"
                                   name="id"
                                   value="@item.IdSolicitud" />

                            <div class="alert alert-warning">

                                <strong>Empleado:</strong>

                                @item.Usuario?.Nombres
                                @item.Usuario?.Apellidos

                                <br />

                                <strong>Destino:</strong>
                                @item.Destino

                            </div>

                            <div class="mb-3">

                                <label for="observaciones-@item.IdSolicitud"
                                       class="form-label">

                                    Motivo del rechazo

                                </label>

                                <textarea id="observaciones-@item.IdSolicitud"
                                          name="observaciones"
                                          class="form-control"
                                          rows="5"
                                          maxlength="1000"
                                          placeholder="Explique claramente por qué se rechaza la solicitud..."
                                          required></textarea>

                                <small class="text-muted">
                                    Esta observación será visible para el empleado.
                                </small>

                            </div>

                        </div>

                        <div class="modal-footer">

                            <button type="button"
                                    class="btn btn-secondary"
                                    data-bs-dismiss="modal">

                                Cancelar

                            </button>

                            <button type="submit"
                                    class="btn btn-danger">

                                <i class="bi bi-x-circle"></i>
                                Confirmar rechazo

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>
    }
}
@section Scripts {

    <script src="~/js/IndexSolicitud.js"></script>

}