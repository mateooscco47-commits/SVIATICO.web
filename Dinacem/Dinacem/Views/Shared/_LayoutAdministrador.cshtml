<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />


    <title>
        @ViewData["Title"] - DINACEN
    </title>


    <!-- Bootstrap -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />


    <!-- Bootstrap Icons -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />


    <!-- CSS DINACEN -->

    <link rel="stylesheet"
          href="~/css/layout.css"
          asp-append-version="true" />

</head>


<body>


<div class="layout">



    <!-- ===================================
         MENU LATERAL
    ==================================== -->

    <aside class="sidebar">



        <!-- LOGO -->

        <div class="sidebar-logo">

            <img src="~/images/logo-dinacen.png"
                 alt="DINACEN Logo" />

        </div>





        <!-- MENU PRINCIPAL -->

        <nav class="sidebar-menu">


            <ul>



                <!-- INICIO -->

                <li>


                    <a asp-controller="Principal"
                       asp-action="Index"
                       class="@(ViewContext.RouteData.Values["controller"]?.ToString()=="Principal" ? "active" : "")">


                        <i class="bi bi-house-door-fill"></i>


                        <span>
                            Inicio
                        </span>


                    </a>


                </li>










                <!-- USUARIOS -->

                <li>


                    <a asp-controller="Usuario"
                       asp-action="Index"
                       class="@(ViewContext.RouteData.Values["controller"]?.ToString()=="Usuario" ? "active" : "")">


                        <i class="bi bi-people-fill"></i>


                        <span>
                            Usuarios
                        </span>


                    </a>


                </li>





                <!-- SOLICITUDES -->

                <li>


                    <a asp-controller="Solicitud"
                       asp-action="Index"
                       class="@(ViewContext.RouteData.Values["controller"]?.ToString()=="Solicitud" ? "active" : "")">


                        <i class="bi bi-file-earmark-text-fill"></i>


                        <span>
                            Solicitudes
                        </span>


                    </a>


                </li>





                <!-- LIQUIDACIONES -->

                <li>


                    <a asp-controller="Rendicion"
                       asp-action="IndexAdmin"
                       class="@(ViewContext.RouteData.Values["controller"]?.ToString()=="Rendicion" ? "active" : "")">


                        <i class="bi bi-wallet2"></i>


                        <span>
                            Liquidaciones
                        </span>


                    </a>


                </li>





                <!-- REPORTES -->

                <li>


                    <a asp-controller="Reporte"
                       asp-action="Index"
                       class="@(ViewContext.RouteData.Values["controller"]?.ToString()=="Reporte" ? "active" : "")">


                        <i class="bi bi-bar-chart-line-fill"></i>


                        <span>
                            Reportes
                        </span>


                    </a>


                </li>



            </ul>


        </nav>





        <!-- CERRAR SESIÓN -->

        <div class="sidebar-footer">


            <form asp-controller="Home"
                  asp-action="Logout"
                  method="get">


                <button type="submit"
                        class="btn-logout">


                    <i class="bi bi-box-arrow-right"></i>


                    <span>
                        Cerrar sesión
                    </span>


                </button>


            </form>


        </div>



    </aside>





    <!-- ==========================================
         CONTENIDO PRINCIPAL
    =========================================== -->


    <div class="main-content">



        <!-- TOPBAR -->

        <header class="topbar">


            <div class="topbar-actions">


                <i class="bi bi-person-circle"></i>



                <div class="user-info">


                    <span class="user-name">

                        @Context.Session.GetString("NombreUsuario")

                    </span>



                    <small class="user-role">

                        @Context.Session.GetString("RolUsuario")

                    </small>


                </div>


            </div>


        </header>





        <!-- CONTENIDO DE LAS VISTAS -->


        <main class="content">


            @RenderBody()


        </main>



    </div>



</div>






<!-- Bootstrap JS -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">

</script>




@await RenderSectionAsync("Scripts", required: false)



</body>


</html>