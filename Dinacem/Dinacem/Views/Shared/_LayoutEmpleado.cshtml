<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - DINACEN
    </title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />

    <!-- CSS GENERAL -->
    <link rel="stylesheet"
          href="~/css/layout.css"
          asp-append-version="true" />

</head>

<body>

    <div class="layout">

        <!-- ==========================================
                    SIDEBAR
        =========================================== -->

        <aside class="sidebar">

            <!-- LOGO -->

            <div class="sidebar-logo">

                <img src="~/images/logo-dinacen.png"
                     alt="DINACEN" />

            </div>

            <!-- ==========================================
                        MENÚ
            =========================================== -->

            <nav class="sidebar-menu">

                <ul>

                    <!-- INICIO -->

                    <li>

                        <a asp-controller="Empleado"
                           asp-action="Index"
                           class="@(ViewContext.RouteData.Values["controller"]?.ToString()=="Empleado" &&
                                    ViewContext.RouteData.Values["action"]?.ToString()=="Index"
                                    ? "active" : "")">

                            <i class="bi bi-house-door-fill"></i>

                            <span>
                                Inicio
                            </span>

                        </a>

                    </li>

                    <!-- NUEVA SOLICITUD -->

                    <li>

                        <a asp-controller="Solicitud"
                           asp-action="Create"
                           class="@(ViewContext.RouteData.Values["controller"]?.ToString()=="Solicitud" &&
                                    ViewContext.RouteData.Values["action"]?.ToString()=="Create"
                                    ? "active" : "")">

                            <i class="bi bi-file-earmark-plus-fill"></i>

                            <span>
                                Nueva solicitud
                            </span>

                        </a>

                    </li>

                    <!-- MIS SOLICITUDES -->

                    <li>

                        <a asp-controller="Solicitud"
                           asp-action="MisSolicitudes"
                           class="@(ViewContext.RouteData.Values["controller"]?.ToString()=="Solicitud" &&
                                    ViewContext.RouteData.Values["action"]?.ToString()=="MisSolicitudes"
                                    ? "active" : "")">

                            <i class="bi bi-list-check"></i>

                            <span>
                                Mis solicitudes
                            </span>

                        </a>

                    </li>

                    <!-- RENDICIONES -->

                    <li>

                        <a asp-controller="Rendicion"
                           asp-action="Index"
                           class="@(ViewContext.RouteData.Values["controller"]?.ToString()=="Rendicion" &&
                                    ViewContext.RouteData.Values["action"]?.ToString()=="Index"
                                    ? "active" : "")">

                            <i class="bi bi-wallet2"></i>

                            <span>
                                Rendiciones
                            </span>

                        </a>

                    </li>

                    <!-- HISTORIAL -->

                    <li>

                        <a asp-controller="Rendicion"
                           asp-action="MisRendiciones"
                           class="@(ViewContext.RouteData.Values["controller"]?.ToString()=="Rendicion" &&
                                    ViewContext.RouteData.Values["action"]?.ToString()=="MisRendiciones"
                                    ? "active" : "")">

                            <i class="bi bi-clock-history"></i>

                            <span>
                                Historial
                            </span>

                        </a>

                    </li>
                       <!-- CERRAR SESIÓN -->
                    <div class="sidebar-footer">

                        <form asp-controller="Home" asp-action="Logout" method="get">

                            <button type="submit" class="btn-logout">

                                <i class="bi bi-box-arrow-right"></i>

                                <span>
                                    Cerrar sesión
                                </span>

                            </button>

                        </form>

                    </div>

        </aside>

        <!-- ==========================================
                    CONTENIDO PRINCIPAL
        =========================================== -->

        <div class="main-content">

            <!-- TOPBAR -->

            <header class="topbar">

                <div class="topbar-actions">

                    <i class="bi bi-person-circle"></i>

                    <div class="user-info">

                        <span class="user-name">
                            @Context.Session.GetString("NombreUsuario")
                        </span>

                        <small class="user-role">
                            @Context.Session.GetString("RolUsuario")
                        </small>

                    </div>

                </div>

            </header>

            <!-- CONTENIDO -->

            <main class="content">

                @RenderBody()

            </main>

        </div>

    </div>

    <!-- Bootstrap -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>