@inject AplicacionDbContexto _context

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DINACEN</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
        :root {
            --sidebar-width: 270px;
            --topbar-height: 75px;
            
            /* Colorimetría Oficial DINACEN */
            --dinacen-blue: #0C4A8A;        /* Azul corporativo DINACEN */
            --dinacen-blue-dark: #083663;   /* Azul noche */
            --dinacen-blue-light: #EBF3FA;  /* Fondo azul claro para ítems activos */
            
            --bg-main: #F8FAFC;
            --white: #FFFFFF;
            
            /* Contraste & Tipografía */
            --text-primary: #0F172A;
            --text-secondary: #334155;
            --text-light: #64748B;
            
            --border-light: #E2E8F0;
            --border: #CBD5E1;
            
            /* Estado Peligro / Cerrar Sesión */
            --danger: #DC2626;
            --danger-dark: #B91C1C;
            
            /* Elevación & Sombras */
            --shadow-sidebar: 2px 0 16px rgba(15, 23, 42, 0.04);
            --shadow-topbar: 0 2px 8px rgba(15, 23, 42, 0.04);
            --shadow-card: 0 4px 12px rgba(12, 74, 138, 0.08), 0 1px 3px rgba(0, 0, 0, 0.03);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Plus Jakarta Sans', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: var(--bg-main);
            color: var(--text-primary);
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            position: relative;
        }

        .layout-wrapper {
            display: flex;
            min-height: 100vh;
            width: 100%;
        }

        /* --- SIDEBAR --- */
        .sidebar {
            width: var(--sidebar-width);
            background-color: var(--white);
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            z-index: 1040;
            border-right: 1px solid var(--border-light);
            box-shadow: var(--shadow-sidebar);
            transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .sidebar-header {
            width: 100%;
            min-height: 140px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem 1.25rem;
            background-color: var(--white);
            border-bottom: 1px solid var(--border-light);
        }

        .sidebar-logo {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            padding: 0.35rem 0 0.9rem;
        }

        .sidebar-logo::after {
            content: "";
            position: absolute;
            bottom: 0;
            left: 50%;
            width: 48px;
            height: 3px;
            transform: translateX(-50%);
            background-color: var(--dinacen-blue);
            border-radius: 10px;
        }

        .sidebar-logo a {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
        }

        .sidebar-logo img {
            display: block;
            width: 195px;
            height: 105px;
            object-fit: contain;
            transition: transform 0.25s ease;
        }

        .sidebar-logo img:hover {
            transform: scale(1.02);
        }

        /* Menú de Navegación */
        .sidebar-menu {
            flex: 1;
            padding: 1.25rem 0.85rem;
            overflow-y: auto;
            overflow-x: hidden;
            scrollbar-width: thin;
            scrollbar-color: #CBD5E1 transparent;
        }

        .sidebar-menu::-webkit-scrollbar {
            width: 5px;
        }

        .sidebar-menu::-webkit-scrollbar-thumb {
            background-color: #CBD5E1;
            border-radius: 10px;
        }

        .sidebar-menu ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .sidebar-menu li {
            margin-bottom: 0.35rem;
        }

        .sidebar-menu a {
            min-height: 44px;
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0.65rem 0.85rem;
            position: relative;
            color: var(--text-secondary);
            text-decoration: none;
            font-weight: 600;
            font-size: 0.92rem;
            border-radius: 8px;
            transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .sidebar-menu a i {
            width: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.15rem;
            color: var(--text-light);
            transition: color 0.2s ease, transform 0.2s ease;
        }

        .sidebar-menu a:hover {
            color: var(--dinacen-blue-dark);
            background-color: var(--dinacen-blue-light);
        }

        .sidebar-menu a:hover i {
            color: var(--dinacen-blue);
            transform: scale(1.1);
        }

        .sidebar-menu a.active {
            color: var(--dinacen-blue-dark);
            background-color: var(--dinacen-blue-light);
            font-weight: 700;
            box-shadow: var(--shadow-card);
        }

        .sidebar-menu a.active i {
            color: var(--dinacen-blue);
        }

        .sidebar-menu a.active::before {
            content: "";
            position: absolute;
            left: -0.85rem;
            top: 8px;
            bottom: 8px;
            width: 4px;
            background-color: var(--dinacen-blue);
            border-radius: 0 4px 4px 0;
        }

        /* Footer Sidebar */
        .sidebar-footer {
            padding: 1rem;
            border-top: 1px solid var(--border-light);
            background-color: var(--white);
        }

        .btn-logout {
            width: 100%;
            min-height: 44px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            padding: 0.65rem 1rem;
            background-color: var(--danger);
            border: 1px solid var(--danger);
            color: var(--white);
            border-radius: 8px;
            font-family: inherit;
            font-size: 0.9rem;
            font-weight: 600;
            cursor: pointer;
            box-shadow: 0 2px 6px rgba(220, 38, 38, 0.2);
            transition: all 0.2s ease;
        }

        .btn-logout i {
            font-size: 1.1rem;
            color: var(--white);
        }

        .btn-logout:hover {
            background-color: var(--danger-dark);
            border-color: var(--danger-dark);
            box-shadow: 0 4px 12px rgba(185, 28, 28, 0.3);
            transform: translateY(-1px);
        }

        /* --- MAIN WRAPPER --- */
        .main-wrapper {
            flex: 1;
            margin-left: var(--sidebar-width);
            display: flex;
            flex-direction: column;
            min-width: 0;
            background-color: var(--bg-main);
            transition: margin-left 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        /* --- TOPBAR --- */
        .topbar {
            height: var(--topbar-height);
            background-color: var(--white);
            border-bottom: 1px solid var(--border-light);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 1.75rem;
            position: sticky;
            top: 0;
            z-index: 1030;
            box-shadow: var(--shadow-topbar);
        }

        .topbar-left {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .sidebar-toggler {
            display: none;
            background: none;
            border: none;
            font-size: 1.4rem;
            color: var(--text-primary);
            cursor: pointer;
            padding: 0.4rem;
            border-radius: 8px;
            transition: background-color 0.2s ease;
        }

        .sidebar-toggler:hover {
            background-color: var(--dinacen-blue-light);
            color: var(--dinacen-blue);
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .user-profile {
            min-height: 42px;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0.35rem 0.85rem;
            background-color: var(--white);
            border: 1px solid var(--border-light);
            border-radius: 8px;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.02);
            transition: border-color 0.2s ease;
        }

        .user-profile:hover {
            border-color: var(--dinacen-blue);
        }

        .user-avatar {
            font-size: 1.65rem;
            color: var(--dinacen-blue);
            line-height: 1;
        }

        .user-details {
            min-width: 90px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            line-height: 1.25;
        }

        .user-name {
            color: var(--text-primary);
            font-size: 0.85rem;
            font-weight: 700;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 190px;
        }

        .user-role {
            color: var(--text-light);
            font-size: 0.75rem;
            font-weight: 600;
        }

        /* --- BODY CONTENT --- */
        .content {
            padding: 1.75rem;
            flex: 1;
            background-color: var(--bg-main);
        }

        /* --- OVERLAY MÓVIL --- */
        .sidebar-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: rgba(15, 23, 42, 0.4);
            z-index: 1035;
            backdrop-filter: blur(4px);
            -webkit-backdrop-filter: blur(4px);
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .sidebar-overlay.show {
            display: block;
            opacity: 1;
        }

        /* --- RESPONSIVE --- */
        @@media (max-width: 991.98px) {
            .sidebar {
                transform: translateX(-100%);
            }
            .sidebar.show {
                transform: translateX(0);
            }
            .main-wrapper {
                margin-left: 0 !important;
            }
            .sidebar-toggler {
                display: flex;
            }
            .topbar {
                padding: 0 1.15rem;
            }
            .content {
                padding: 1.25rem;
            }
        }

        @@media (max-width: 575.98px) {
            .topbar {
                padding: 0 0.85rem;
                height: 64px;
            }
            .content {
                padding: 1rem 0.85rem;
            }
            .user-details {
                display: none !important;
            }
            .user-profile {
                padding: 0.3rem;
                border: none;
                background: transparent;
                box-shadow: none;
            }
            .user-avatar {
                font-size: 1.85rem;
            }
        }

        @@media (min-width: 1400px) {
            .content {
                padding: 2rem 2.25rem;
            }
        }
    </style>

</head>
<body>

    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <div class="layout-wrapper">

        <aside class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <div class="sidebar-logo">
                    <a asp-controller="Empleado" asp-action="Index" aria-label="Ir al inicio">
                        <img src="~/images/logo-dinacen.png" alt="DINACEN Logo" />
                    </a>
                </div>
            </div>

            <nav class="sidebar-menu" aria-label="Menú principal">
                <ul>
                    <li>
                        <a asp-controller="Empleado"
                           asp-action="Index"
                           class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Empleado" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                            <i class="bi bi-house-door-fill"></i>
                            <span>Inicio</span>
                        </a>
                    </li>

                    <li>
                        @{
                            var idUsuarioLayout = Context.Session.GetInt32("IdUsuario");
                            bool tieneBloqueoLayout = false;
                            if (idUsuarioLayout != null)
                            {
                                tieneBloqueoLayout = _context.Rendiciones.Any(r => r.IdUsuario == idUsuarioLayout && r.IdEstadoRendicion == 1) ||
                                                     _context.Solicitudes.Any(s => s.IdUsuario == idUsuarioLayout && (s.IdEstadoSolicitud == 1 || (s.IdEstadoSolicitud == 2 && !_context.Rendiciones.Any(r => r.IdSolicitud == s.IdSolicitud))));
                            }
                        }

                        @if (tieneBloqueoLayout)
                        {
                            <a href="javascript:void(0);" class="text-muted" style="pointer-events: none; opacity: 0.6;" title="Tiene una solicitud o rendición pendiente">
                                <i class="bi bi-file-earmark-plus-fill"></i>
                                <span>Nueva solicitud</span>
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Solicitud"
                               asp-action="Create"
                               class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Solicitud" && ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "active" : "")">
                                <i class="bi bi-file-earmark-plus-fill"></i>
                                <span>Nueva solicitud</span>
                            </a>
                        }
                    </li>

                    <li>
                        <a asp-controller="Solicitud"
                           asp-action="MisSolicitudes"
                           class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Solicitud" && ViewContext.RouteData.Values["action"]?.ToString() == "MisSolicitudes" ? "active" : "")">
                            <i class="bi bi-list-check"></i>
                            <span>Mis solicitudes</span>
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Rendicion"
                           asp-action="Index"
                           class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Rendicion" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                            <i class="bi bi-wallet2"></i>
                            <span>Rendiciones</span>
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Rendicion"
                           asp-action="MisRendiciones"
                           class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Rendicion" && ViewContext.RouteData.Values["action"]?.ToString() == "MisRendiciones" ? "active" : "")">
                            <i class="bi bi-clock-history"></i>
                            <span>Historial</span>
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Empleado"
                           asp-action="Perfil"
                           class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Empleado" && ViewContext.RouteData.Values["action"]?.ToString() == "Perfil" ? "active" : "")">
                            <i class="bi bi-person-gear"></i>
                            <span>Mi Perfil</span>
                        </a>
                    </li>
                </ul>
            </nav>

            <div class="sidebar-footer">
                <form asp-controller="Home" asp-action="Logout" method="get">
                    <button type="submit" class="btn-logout">
                        <i class="bi bi-box-arrow-right"></i>
                        <span>Cerrar sesión</span>
                    </button>
                </form>
            </div>
        </aside>

        <div class="main-wrapper" id="mainWrapper">

            <header class="topbar">
                <div class="topbar-left">
                    <button class="sidebar-toggler" id="sidebarToggler" aria-label="Alternar menú lateral">
                        <i class="bi bi-list"></i>
                    </button>
                </div>

                <div class="topbar-right">
                    <div class="user-profile">
                        <i class="bi bi-person-circle user-avatar"></i>
                        <div class="user-details">
                            <span class="user-name">
                                @(Context.Session.GetString("NombreUsuario") ?? "Usuario")
                            </span>
                            <small class="user-role">
                                @(Context.Session.GetString("RolUsuario") ?? "Empleado")
                            </small>
                        </div>
                    </div>
                </div>
            </header>

            <main class="content">
                <!-- Contenedor global para alertas y notificaciones -->
                @if (TempData["errorSolicitud"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["errorSolicitud"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["mensajeSolicitud"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i> @TempData["mensajeSolicitud"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </main>

        </div>
    </div>

    <script>
    document.addEventListener('DOMContentLoaded', function () {

        const sidebar = document.getElementById('sidebar');
        const sidebarToggler = document.getElementById('sidebarToggler');
        const sidebarOverlay = document.getElementById('sidebarOverlay');

        // =========================================
        // ABRIR / CERRAR SIDEBAR
        // =========================================
        function toggleSidebar() {

            if (!sidebar || !sidebarOverlay) {
                return;
            }

            sidebar.classList.toggle('show');
            sidebarOverlay.classList.toggle('show');

            if (sidebar.classList.contains('show')) {
                document.body.style.overflow = 'hidden';
            } else {
                document.body.style.overflow = '';
            }
        }

        // =========================================
        // BOTÓN MENÚ MÓVIL
        // =========================================
        if (sidebarToggler) {
            sidebarToggler.addEventListener('click', toggleSidebar);
        }

        // =========================================
        // CERRAR AL TOCAR EL OVERLAY
        // =========================================
        if (sidebarOverlay) {
            sidebarOverlay.addEventListener('click', toggleSidebar);
        }

        // =========================================
        // AL CAMBIAR EL TAMAÑO DE LA VENTANA
        // =========================================
        window.addEventListener('resize', function () {

            if (window.innerWidth > 991.98) {

                if (sidebar) {
                    sidebar.classList.remove('show');
                }

                if (sidebarOverlay) {
                    sidebarOverlay.classList.remove('show');
                }

                document.body.style.overflow = '';
            }
        });

        // =========================================
        // CERRAR MENÚ AL SELECCIONAR UNA OPCIÓN
        // EN DISPOSITIVOS MÓVILES
        // =========================================
        if (sidebar) {

            const menuLinks = sidebar.querySelectorAll('.sidebar-menu a');

            menuLinks.forEach(function (link) {

                link.addEventListener('click', function () {

                    if (window.innerWidth <= 991.98) {

                        sidebar.classList.remove('show');

                        if (sidebarOverlay) {
                            sidebarOverlay.classList.remove('show');
                        }

                        document.body.style.overflow = '';
                    }
                });
            });
        }

    });
</script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/Layout.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>