@model List<Dinacem.Models.BitacoraVehiculo>

@{
    ViewData["Title"] = "Bitácora de Vehículo";

    var rendicion = ViewBag.Rendicion as Dinacem.Models.Rendicion;
    var tarifaKilometro = ViewBag.TarifaKilometro != null
        ? (decimal)ViewBag.TarifaKilometro
        : 0m;

    var puntos = ViewBag.Puntos as List<string>
        ?? new List<string>();

    var totalDistancia = Model.Sum(x => x.DistanciaKm);
    var totalVehiculo = Model.Sum(x => x.MontoAsignado);
    var cantidadRecorridos = Model.Count;

    bool rendicionEditable =
        rendicion != null &&
        rendicion.IdEstadoRendicion == 1;
}

<link rel="stylesheet"
      href="~/css/BitacoraVehiculo.css"
      asp-append-version="true" />

<div class="bitacora-wrapper">

    <!-- ===================================================== -->
    <!-- ENCABEZADO -->
    <!-- ===================================================== -->

    <div class="page-header">

        <div class="page-header-left">

            <div class="page-icon">
                <i class="bi bi-car-front-fill"></i>
            </div>

            <div>
                <h1 class="page-title">
                    Bitácora de Vehículo
                </h1>

                <p class="page-description">
                    Registre los recorridos realizados durante la comisión.
                </p>
            </div>

        </div>

        <a asp-controller="Rendicion"
           asp-action="Index"
           class="btn btn-outline-secondary btn-back">

            <i class="bi bi-arrow-left me-1"></i>

            Volver a rendiciones

        </a>

    </div>


    <!-- ===================================================== -->
    <!-- INFORMACIÓN DE LA RENDICIÓN -->
    <!-- ===================================================== -->

    @if (rendicion != null)
    {
        <div class="rendicion-info-card">

            <div class="rendicion-info-item">

                <span class="info-label">
                    Rendición
                </span>

                <strong>
                    #@rendicion.IdRendicion
                </strong>

            </div>

            <div class="rendicion-info-item">

                <span class="info-label">
                    Fecha inicio
                </span>

                <strong>
                    @rendicion.FechaInicio.ToString("dd/MM/yyyy")
                </strong>

            </div>

            <div class="rendicion-info-item">

                <span class="info-label">
                    Fecha fin
                </span>

                <strong>
                    @rendicion.FechaFin.ToString("dd/MM/yyyy")
                </strong>

            </div>

            <div class="rendicion-info-item">

                <span class="info-label">
                    Estado
                </span>

                @if (rendicion.IdEstadoRendicion == 1)
                {
                    <span class="status-badge status-editable">
                        <i class="bi bi-pencil-square"></i>
                        En proceso
                    </span>
                }
                else
                {
                    <span class="status-badge status-locked">
                        <i class="bi bi-lock-fill"></i>
                        No editable
                    </span>
                }

            </div>

        </div>
    }


    <!-- ===================================================== -->
    <!-- ALERTAS -->
    <!-- ===================================================== -->

    @if (TempData["mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show custom-alert"
             role="alert">

            <i class="bi bi-check-circle-fill me-2"></i>

            @Html.Raw(TempData["mensaje"])

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show custom-alert"
             role="alert">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            @Html.Raw(TempData["error"])

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ===================================================== -->
    <!-- RESUMEN -->
    <!-- ===================================================== -->

    <div class="summary-grid">

        <div class="summary-card">

            <div class="summary-icon blue">
                <i class="bi bi-signpost-2-fill"></i>
            </div>

            <div class="summary-content">

                <span>
                    Recorridos registrados
                </span>

                <strong>
                    @cantidadRecorridos
                </strong>

            </div>

        </div>


        <div class="summary-card">

            <div class="summary-icon green">
                <i class="bi bi-speedometer2"></i>
            </div>

            <div class="summary-content">

                <span>
                    Distancia total
                </span>

                <strong>
                    @totalDistancia.ToString("N2") km
                </strong>

            </div>

        </div>


        <div class="summary-card">

            <div class="summary-icon orange">
                <i class="bi bi-cash-coin"></i>
            </div>

            <div class="summary-content">

                <span>
                    Tarifa por kilómetro
                </span>

                <strong>
                    S/ @tarifaKilometro.ToString("N2")
                </strong>

            </div>

        </div>


        <div class="summary-card">

            <div class="summary-icon purple">
                <i class="bi bi-wallet2"></i>
            </div>

            <div class="summary-content">

                <span>
                    Total vehículo
                </span>

                <strong>
                    S/ @totalVehiculo.ToString("N2")
                </strong>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- FORMULARIO -->
    <!-- ===================================================== -->

    @if (rendicionEditable)
    {
        <div class="form-card">

            <div class="section-header">

                <div class="section-title-wrapper">

                    <div class="section-icon">
                        <i class="bi bi-plus-lg"></i>
                    </div>

                    <div>
                        <h2>
                            Registrar recorrido
                        </h2>

                        <p>
                            Seleccione el origen y destino para obtener
                            automáticamente la distancia y el monto.
                        </p>
                    </div>

                </div>

            </div>


            <form asp-controller="BitacoraVehiculo"
                  asp-action="Create"
                  method="post"
                  id="formBitacora">

                @Html.AntiForgeryToken()

                <!-- ID RENDICIÓN -->

                <input type="hidden"
                       name="IdRendicion"
                       value="@rendicion.IdRendicion" />


                <!-- ORIGEN REAL QUE RECIBIRÁ EL CONTROLLER -->

                <input type="hidden"
                       name="Origen"
                       id="Origen"
                       value="" />


                <!-- DESTINO REAL QUE RECIBIRÁ EL CONTROLLER -->

                <input type="hidden"
                       name="Destino"
                       id="Destino"
                       value="" />


                <!-- DISTANCIA CALCULADA -->

                <input type="hidden"
                       name="DistanciaKm"
                       id="DistanciaKm"
                       value="" />


                <div class="form-grid">


                    <!-- ================================================= -->
                    <!-- FECHA -->
                    <!-- ================================================= -->

                    <div class="form-group">

                        <label for="Fecha">
                            <i class="bi bi-calendar3"></i>
                            Fecha
                        </label>

                        <input type="date"
                               class="form-control"
                               id="Fecha"
                               name="Fecha"
                               min="@rendicion.FechaInicio.ToString("yyyy-MM-dd")"
                               max="@rendicion.FechaFin.ToString("yyyy-MM-dd")"
                               required />

                        <small class="form-help">
                            Fecha del recorrido realizado.
                        </small>

                    </div>


                    <!-- ================================================= -->
                    <!-- ORIGEN -->
                    <!-- ================================================= -->

                    <div class="form-group">

                        <label for="origenInput">
                            <i class="bi bi-geo-alt-fill"></i>
                            Origen
                        </label>

                        <div class="combo-wrapper">

                            <input type="text"
                                   id="origenInput"
                                   class="form-control combo-input"
                                   placeholder="Buscar origen..."
                                   autocomplete="off"
                                   required />

                            <button type="button"
                                    class="combo-clear"
                                    id="clearOrigen"
                                    title="Limpiar">

                                <i class="bi bi-x-lg"></i>

                            </button>

                            <div class="combo-dropdown"
                                 id="origenDropdown">

                                @foreach (var punto in puntos)
                                {
                                    <div class="combo-option origen-option"
                                         data-value="@punto">

                                        <i class="bi bi-geo-alt"></i>

                                        <span>
                                            @punto
                                        </span>

                                    </div>
                                }

                                @if (!puntos.Any())
                                {
                                    <div class="combo-empty">
                                        No hay puntos registrados.
                                    </div>
                                }

                            </div>

                        </div>

                        <small class="form-help">
                            Escriba para buscar el punto de origen.
                        </small>

                    </div>


                    <!-- ================================================= -->
                    <!-- DESTINO -->
                    <!-- ================================================= -->

                    <div class="form-group">

                        <label for="destinoInput">
                            <i class="bi bi-geo-alt-fill"></i>
                            Destino
                        </label>

                        <div class="combo-wrapper">

                            <input type="text"
                                   id="destinoInput"
                                   class="form-control combo-input"
                                   placeholder="Primero seleccione el origen"
                                   autocomplete="off"
                                   disabled
                                   required />

                            <button type="button"
                                    class="combo-clear"
                                    id="clearDestino"
                                    title="Limpiar">

                                <i class="bi bi-x-lg"></i>

                            </button>

                            <div class="combo-dropdown"
                                 id="destinoDropdown">
                            </div>

                        </div>

                        <small class="form-help">
                            Solo se mostrarán destinos disponibles para
                            el origen seleccionado.
                        </small>

                    </div>


                    <!-- ================================================= -->
                    <!-- DISTANCIA -->
                    <!-- ================================================= -->

                    <div class="form-group">

                        <label for="distanciaVisual">
                            <i class="bi bi-signpost-split-fill"></i>
                            Distancia
                        </label>

                        <div class="input-group">

                            <input type="text"
                                   class="form-control"
                                   id="distanciaVisual"
                                   value=""
                                   placeholder="Se calculará automáticamente"
                                   readonly />

                            <span class="input-group-text">
                                km
                            </span>

                        </div>

                        <small class="form-help">
                            Distancia registrada para la ruta seleccionada.
                        </small>

                    </div>


                    <!-- ================================================= -->
                    <!-- TARIFA -->
                    <!-- ================================================= -->

                    <div class="form-group">

                        <label for="tarifaVisual">
                            <i class="bi bi-currency-exchange"></i>
                            Tarifa por kilómetro
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                S/
                            </span>

                            <input type="text"
                                   class="form-control"
                                   id="tarifaVisual"
                                   value="@tarifaKilometro.ToString("N2")"
                                   readonly />

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- MONTO -->
                    <!-- ================================================= -->

                    <div class="form-group">

                        <label for="montoVisual">
                            <i class="bi bi-cash-stack"></i>
                            Monto asignado
                        </label>

                        <div class="input-group monto-input">

                            <span class="input-group-text">
                                S/
                            </span>

                            <input type="text"
                                   class="form-control"
                                   id="montoVisual"
                                   value=""
                                   placeholder="0.00"
                                   readonly />

                        </div>

                        <small class="form-help">
                            Calculado automáticamente según la ruta.
                        </small>

                    </div>


                    <!-- ================================================= -->
                    <!-- OBSERVACIONES -->
                    <!-- ================================================= -->

                    <div class="form-group form-group-full">

                        <label for="Observaciones">

                            <i class="bi bi-chat-left-text"></i>

                            Observaciones

                            <span class="optional">
                                (opcional)
                            </span>

                        </label>

                        <textarea class="form-control"
                                  id="Observaciones"
                                  name="Observaciones"
                                  rows="3"
                                  maxlength="500"
                                  placeholder="Ingrese alguna observación si es necesario..."></textarea>

                        <div class="character-counter">

                            <span id="contadorObservaciones">
                                0
                            </span>
                            / 500

                        </div>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- MENSAJE DE RUTA -->
                <!-- ================================================= -->

                <div id="rutaMensaje"
                     class="route-message"
                     style="display:none;">

                    <i class="bi bi-info-circle-fill"></i>

                    <span id="rutaMensajeTexto"></span>

                </div>


                <!-- ================================================= -->
                <!-- BOTONES -->
                <!-- ================================================= -->

                <div class="form-actions">

                    <button type="button"
                            class="btn btn-light"
                            id="btnLimpiar">

                        <i class="bi bi-arrow-counterclockwise me-1"></i>

                        Limpiar

                    </button>


                    <button type="submit"
                            class="btn btn-primary"
                            id="btnRegistrar"
                            disabled>

                        <i class="bi bi-check-circle-fill me-1"></i>

                        Registrar recorrido

                    </button>

                </div>

            </form>

        </div>
    }


    <!-- ===================================================== -->
    <!-- TABLA DE RECORRIDOS -->
    <!-- ===================================================== -->

    <div class="table-card">

        <div class="section-header">

            <div class="section-title-wrapper">

                <div class="section-icon">
                    <i class="bi bi-list-ul"></i>
                </div>

                <div>

                    <h2>
                        Recorridos registrados
                    </h2>

                    <p>
                        Detalle de los recorridos incluidos en esta rendición.
                    </p>

                </div>

            </div>

        </div>


        @if (Model.Any())
        {
            <div class="table-responsive">

                <table class="table bitacora-table">

                    <thead>

                        <tr>

                            <th>
                                Fecha
                            </th>

                            <th>
                                Origen
                            </th>

                            <th>
                                Destino
                            </th>

                            <th class="text-end">
                                Distancia
                            </th>

                            <th class="text-end">
                                Tarifa/km
                            </th>

                            <th class="text-end">
                                Monto
                            </th>

                            <th>
                                Observaciones
                            </th>

                            @if (rendicionEditable)
                            {
                                <th class="text-center">
                                    Acción
                                </th>
                            }

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    <span class="date-value">
                                        <i class="bi bi-calendar3"></i>
                                        @item.Fecha.ToString("dd/MM/yyyy")
                                    </span>
                                </td>

                                <td>
                                    <span class="location-value">
                                        <i class="bi bi-geo-alt"></i>
                                        @item.Origen
                                    </span>
                                </td>

                                <td>
                                    <span class="location-value">
                                        <i class="bi bi-geo-alt-fill"></i>
                                        @item.Destino
                                    </span>
                                </td>

                                <td class="text-end">

                                    <strong>
                                        @item.DistanciaKm.ToString("N2")
                                    </strong>

                                    <span class="unit">
                                        km
                                    </span>

                                </td>

                                <td class="text-end">

                                    S/
                                    @item.TarifaKilometro.ToString("N2")

                                </td>

                                <td class="text-end">

                                    <strong class="amount-value">
                                        S/
                                        @item.MontoAsignado.ToString("N2")
                                    </strong>

                                </td>

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(item.Observaciones))
                                    {
                                        <span class="observation-text"
                                              title="@item.Observaciones">

                                            @item.Observaciones

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="no-observation">
                                            —
                                        </span>
                                    }

                                </td>


                                @if (rendicionEditable)
                                {
                                    <td class="text-center">

                                        <form asp-controller="BitacoraVehiculo"
                                              asp-action="Delete"
                                              method="post"
                                              class="form-eliminar-recorrido">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@item.IdBitacoraVehiculo" />

                                            <input type="hidden"
                                                   name="idRendicion"
                                                   value="@item.IdRendicion" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger btn-delete"
                                                    title="Eliminar recorrido">

                                                <i class="bi bi-trash3"></i>

                                            </button>

                                        </form>

                                    </td>
                                }

                            </tr>
                        }

                    </tbody>

                    <tfoot>

                        <tr>

                            <td colspan="3">
                                <strong>
                                    TOTAL
                                </strong>
                            </td>

                            <td class="text-end">

                                <strong>
                                    @totalDistancia.ToString("N2") km
                                </strong>

                            </td>

                            <td></td>

                            <td class="text-end">

                                <strong class="total-amount">
                                    S/
                                    @totalVehiculo.ToString("N2")
                                </strong>

                            </td>

                            <td colspan="2"></td>

                        </tr>

                    </tfoot>

                </table>

            </div>
        }
        else
        {
            <div class="empty-state">

                <div class="empty-icon">
                    <i class="bi bi-car-front"></i>
                </div>

                <h3>
                    No hay recorridos registrados
                </h3>

                <p>
                    @if (rendicionEditable)
                    {
                        <span>
                            Utilice el formulario superior para registrar
                            el primer recorrido.
                        </span>
                    }
                    else
                    {
                        <span>
                            Esta rendición no tiene recorridos registrados.
                        </span>
                    }
                </p>

            </div>
        }

    </div>

</div>


@section Scripts {

<script>

    document.addEventListener("DOMContentLoaded", function () {

        // ============================================================
        // ELEMENTOS
        // ============================================================

        const form = document.getElementById("formBitacora");

        if (!form) {
            return;
        }

        const origenInput =
            document.getElementById("origenInput");

        const destinoInput =
            document.getElementById("destinoInput");

        const origenHidden =
            document.getElementById("Origen");

        const destinoHidden =
            document.getElementById("Destino");

        const distanciaHidden =
            document.getElementById("DistanciaKm");

        const distanciaVisual =
            document.getElementById("distanciaVisual");

        const tarifaVisual =
            document.getElementById("tarifaVisual");

        const montoVisual =
            document.getElementById("montoVisual");

        const origenDropdown =
            document.getElementById("origenDropdown");

        const destinoDropdown =
            document.getElementById("destinoDropdown");

        const btnRegistrar =
            document.getElementById("btnRegistrar");

        const btnLimpiar =
            document.getElementById("btnLimpiar");

        const clearOrigen =
            document.getElementById("clearOrigen");

        const clearDestino =
            document.getElementById("clearDestino");

        const rutaMensaje =
            document.getElementById("rutaMensaje");

        const rutaMensajeTexto =
            document.getElementById("rutaMensajeTexto");

        const observaciones =
            document.getElementById("Observaciones");

        const contadorObservaciones =
            document.getElementById("contadorObservaciones");


        // ============================================================
        // VARIABLES
        // ============================================================

        let origenSeleccionado = "";

        let destinoSeleccionado = "";

        let rutaValida = false;


        // ============================================================
        // URL DEL CONTROLADOR
        // ============================================================

        const obtenerRutaUrl =
            '@Url.Action("ObtenerRuta", "BitacoraVehiculo")';


        // ============================================================
        // MOSTRAR MENSAJE
        // ============================================================

        function mostrarMensaje(texto, tipo = "info") {

            rutaMensaje.style.display = "flex";

            rutaMensajeTexto.textContent = texto;

            rutaMensaje.classList.remove(
                "route-success",
                "route-error",
                "route-info"
            );

            if (tipo === "success") {

                rutaMensaje.classList.add("route-success");

            }
            else if (tipo === "error") {

                rutaMensaje.classList.add("route-error");

            }
            else {

                rutaMensaje.classList.add("route-info");

            }

        }


        // ============================================================
        // OCULTAR MENSAJE
        // ============================================================

        function ocultarMensaje() {

            rutaMensaje.style.display = "none";

            rutaMensajeTexto.textContent = "";

        }


        // ============================================================
        // ESTADO DEL BOTÓN
        // ============================================================

        function actualizarBoton() {

            btnRegistrar.disabled =
                !rutaValida ||
                !origenHidden.value ||
                !destinoHidden.value ||
                !distanciaHidden.value;

        }


        // ============================================================
        // REINICIAR DATOS DE RUTA
        // ============================================================

        function limpiarRuta() {

            rutaValida = false;

            distanciaHidden.value = "";

            distanciaVisual.value = "";

            montoVisual.value = "";

            actualizarBoton();

        }


        // ============================================================
        // ABRIR DROPDOWN ORIGEN
        // ============================================================

        function abrirOrigen() {

            origenDropdown.classList.add("show");

        }


        // ============================================================
        // CERRAR DROPDOWN ORIGEN
        // ============================================================

        function cerrarOrigen() {

            origenDropdown.classList.remove("show");

        }


        // ============================================================
        // ABRIR DROPDOWN DESTINO
        // ============================================================

        function abrirDestino() {

            destinoDropdown.classList.add("show");

        }


        // ============================================================
        // CERRAR DROPDOWN DESTINO
        // ============================================================

        function cerrarDestino() {

            destinoDropdown.classList.remove("show");

        }


        // ============================================================
        // FILTRAR ORIGEN
        // ============================================================

        origenInput.addEventListener("input", function () {

            const texto =
                this.value
                    .toLowerCase()
                    .trim();

            const opciones =
                origenDropdown.querySelectorAll(".origen-option");

            let encontrados = 0;

            opciones.forEach(function (opcion) {

                const valor =
                    opcion.dataset.value
                        .toLowerCase();

                if (valor.includes(texto)) {

                    opcion.style.display = "flex";

                    encontrados++;

                }
                else {

                    opcion.style.display = "none";

                }

            });

            abrirOrigen();

        });


        // ============================================================
        // CLICK EN ORIGEN
        // ============================================================

        origenDropdown
            .querySelectorAll(".origen-option")
            .forEach(function (opcion) {

                opcion.addEventListener("click", function () {

                    const valor =
                        this.dataset.value;

                    seleccionarOrigen(valor);

                });

            });


        // ============================================================
        // SELECCIONAR ORIGEN
        // ============================================================

        function seleccionarOrigen(valor) {

            origenSeleccionado = valor;

            origenInput.value = valor;

            origenHidden.value = valor;

            cerrarOrigen();

            // Reiniciar destino

            destinoSeleccionado = "";

            destinoInput.value = "";

            destinoHidden.value = "";

            destinoInput.disabled = false;

            destinoInput.placeholder =
                "Buscar destino...";

            limpiarRuta();

            ocultarMensaje();

            cargarDestinos(valor);

        }


        // ============================================================
        // CARGAR DESTINOS
        // ============================================================

        function cargarDestinos(origen) {

            destinoDropdown.innerHTML = "";

            const origenNormalizado =
                origen.trim().toLowerCase();

            const opcionesOrigen =
                origenDropdown.querySelectorAll(
                    ".origen-option"
                );

            /*
             * Como el controlador entrega los puntos disponibles,
             * aquí se muestran inicialmente todos los puntos distintos
             * al origen.
             *
             * La validación definitiva de la ruta se realiza mediante
             * ObtenerRuta() en el servidor.
             */

            let cantidad = 0;

            opcionesOrigen.forEach(function (opcion) {

                const destino =
                    opcion.dataset.value;

                if (
                    destino.trim().toLowerCase()
                    === origenNormalizado
                ) {
                    return;
                }

                const elemento =
                    document.createElement("div");

                elemento.className =
                    "combo-option destino-option";

                elemento.dataset.value =
                    destino;

                elemento.innerHTML = `
                    <i class="bi bi-geo-alt-fill"></i>
                    <span>${escapeHtml(destino)}</span>
                `;

                elemento.addEventListener(
                    "click",
                    function () {

                        seleccionarDestino(destino);

                    }
                );

                destinoDropdown.appendChild(elemento);

                cantidad++;

            });


            if (cantidad === 0) {

                destinoDropdown.innerHTML = `
                    <div class="combo-empty">
                        No existen destinos disponibles.
                    </div>
                `;

            }

        }


        // ============================================================
        // ESCAPAR HTML
        // ============================================================

        function escapeHtml(text) {

            const div =
                document.createElement("div");

            div.textContent = text;

            return div.innerHTML;

        }


        // ============================================================
        // FILTRAR DESTINO
        // ============================================================

        destinoInput.addEventListener("input", function () {

            const texto =
                this.value
                    .toLowerCase()
                    .trim();

            const opciones =
                destinoDropdown.querySelectorAll(
                    ".destino-option"
                );

            opciones.forEach(function (opcion) {

                const valor =
                    opcion.dataset.value
                        .toLowerCase();

                if (valor.includes(texto)) {

                    opcion.style.display = "flex";

                }
                else {

                    opcion.style.display = "none";

                }

            });

            abrirDestino();

        });


        // ============================================================
        // SELECCIONAR DESTINO
        // ============================================================

        async function seleccionarDestino(valor) {

            destinoSeleccionado = valor;

            destinoInput.value = valor;

            destinoHidden.value = valor;

            cerrarDestino();

            limpiarRuta();

            mostrarMensaje(
                "Consultando la ruta registrada...",
                "info"
            );

            await obtenerRuta();

        }


        // ============================================================
        // CONSULTAR RUTA AL SERVIDOR
        // ============================================================

        async function obtenerRuta() {

            if (
                !origenHidden.value ||
                !destinoHidden.value
            ) {

                limpiarRuta();

                return;

            }


            try {

                const url =
                    obtenerRutaUrl
                    + "?origen="
                    + encodeURIComponent(
                        origenHidden.value
                    )
                    + "&destino="
                    + encodeURIComponent(
                        destinoHidden.value
                    );


                const response =
                    await fetch(url, {

                        method: "GET",

                        headers: {
                            "X-Requested-With":
                                "XMLHttpRequest"
                        }

                    });


                if (!response.ok) {

                    throw new Error(
                        "No se pudo consultar la ruta."
                    );

                }


                const data =
                    await response.json();


                // ====================================================
                // RUTA NO ENCONTRADA
                // ====================================================

                if (!data.success) {

                    limpiarRuta();

                    mostrarMensaje(
                        data.mensaje ||
                        "No existe una ruta registrada.",
                        "error"
                    );

                    return;

                }


                // ====================================================
                // RUTA ENCONTRADA
                // ====================================================

                const distancia =
                    Number(data.distanciaKm);

                const tarifa =
                    Number(data.tarifaKilometro);

                const monto =
                    Number(data.montoAsignado);


                if (
                    !Number.isFinite(distancia) ||
                    distancia <= 0
                ) {

                    limpiarRuta();

                    mostrarMensaje(
                        "La distancia obtenida no es válida.",
                        "error"
                    );

                    return;

                }


                distanciaHidden.value =
                    distancia.toFixed(2);


                distanciaVisual.value =
                    distancia.toFixed(2);


                tarifaVisual.value =
                    tarifa.toFixed(2);


                montoVisual.value =
                    monto.toFixed(2);


                rutaValida = true;


                mostrarMensaje(
                    `Ruta válida: ${distancia.toFixed(2)} km. Monto asignado: S/ ${monto.toFixed(2)}.`,
                    "success"
                );


                actualizarBoton();

            }
            catch (error) {

                console.error(error);

                limpiarRuta();

                mostrarMensaje(
                    "Ocurrió un error al consultar la ruta.",
                    "error"
                );

            }

        }


        // ============================================================
        // FOCUS ORIGEN
        // ============================================================

        origenInput.addEventListener(
            "focus",
            function () {

                abrirOrigen();

            }
        );


        // ============================================================
        // FOCUS DESTINO
        // ============================================================

        destinoInput.addEventListener(
            "focus",
            function () {

                if (!destinoInput.disabled) {

                    abrirDestino();

                }

            }
        );


        // ============================================================
        // LIMPIAR ORIGEN
        // ============================================================

        clearOrigen.addEventListener(
            "click",
            function () {

                origenSeleccionado = "";

                origenInput.value = "";

                origenHidden.value = "";

                destinoSeleccionado = "";

                destinoInput.value = "";

                destinoHidden.value = "";

                destinoInput.disabled = true;

                destinoInput.placeholder =
                    "Primero seleccione el origen";

                destinoDropdown.innerHTML = "";

                limpiarRuta();

                ocultarMensaje();

                origenInput.focus();

            }
        );


        // ============================================================
        // LIMPIAR DESTINO
        // ============================================================

        clearDestino.addEventListener(
            "click",
            function () {

                destinoSeleccionado = "";

                destinoInput.value = "";

                destinoHidden.value = "";

                limpiarRuta();

                ocultarMensaje();

                destinoInput.focus();

            }
        );


        // ============================================================
        // CLIC FUERA DE LOS COMBOS
        // ============================================================

        document.addEventListener(
            "click",
            function (event) {

                if (
                    !event.target.closest(
                        ".combo-wrapper"
                    )
                ) {

                    cerrarOrigen();

                    cerrarDestino();

                }

            }
        );


        // ============================================================
        // CONTADOR OBSERVACIONES
        // ============================================================

        if (observaciones) {

            observaciones.addEventListener(
                "input",
                function () {

                    contadorObservaciones.textContent =
                        this.value.length;

                }
            );

        }


        // ============================================================
        // LIMPIAR FORMULARIO
        // ============================================================

        btnLimpiar.addEventListener(
            "click",
            function () {

                form.reset();

                origenSeleccionado = "";

                destinoSeleccionado = "";

                origenHidden.value = "";

                destinoHidden.value = "";

                distanciaHidden.value = "";

                origenInput.value = "";

                destinoInput.value = "";

                destinoInput.disabled = true;

                destinoInput.placeholder =
                    "Primero seleccione el origen";

                distanciaVisual.value = "";

                tarifaVisual.value =
                    "@tarifaKilometro.ToString("N2")";

                montoVisual.value = "";

                rutaValida = false;

                destinoDropdown.innerHTML = "";

                ocultarMensaje();

                actualizarBoton();

                contadorObservaciones.textContent =
                    "0";

            }
        );


        // ============================================================
        // VALIDACIÓN FINAL ANTES DE ENVIAR
        // ============================================================

        form.addEventListener(
            "submit",
            function (event) {

                if (!origenHidden.value) {

                    event.preventDefault();

                    mostrarMensaje(
                        "Debe seleccionar el origen.",
                        "error"
                    );

                    origenInput.focus();

                    return;

                }


                if (!destinoHidden.value) {

                    event.preventDefault();

                    mostrarMensaje(
                        "Debe seleccionar el destino.",
                        "error"
                    );

                    destinoInput.focus();

                    return;

                }


                if (!rutaValida) {

                    event.preventDefault();

                    mostrarMensaje(
                        "La ruta seleccionada no es válida o no está registrada.",
                        "error"
                    );

                    return;

                }


                if (!distanciaHidden.value) {

                    event.preventDefault();

                    mostrarMensaje(
                        "No se pudo obtener la distancia de la ruta.",
                        "error"
                    );

                    return;

                }


                btnRegistrar.disabled = true;

                btnRegistrar.innerHTML = `
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    Registrando...
                `;

            }
        );


        // ============================================================
        // ELIMINAR RECORRIDO
        // ============================================================

        document
            .querySelectorAll(".form-eliminar-recorrido")
            .forEach(function (formEliminar) {

                formEliminar.addEventListener(
                    "submit",
                    function (event) {

                        const confirmar =
                            confirm(
                                "¿Está seguro de eliminar este recorrido?"
                            );

                        if (!confirmar) {

                            event.preventDefault();

                        }

                    }
                );

            });


        // ============================================================
        // INICIALIZAR
        // ============================================================

        actualizarBoton();

    });

</script>

}

