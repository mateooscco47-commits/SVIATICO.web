@model List<Dinacem.Models.BitacoraVehiculo>

@{
    ViewData["Title"] = "Bitácora de Vehículo";
    Layout = "~/Views/Shared/_LayoutEmpleado.cshtml";

    var rendicion = ViewBag.Rendicion as Dinacem.Models.Rendicion;

    decimal totalKm = Model?.Sum(x => x.DistanciaKm) ?? 0;
    decimal totalAsignado = Model?.Sum(x => x.MontoAsignado) ?? 0;
}

<style>

    .bitacora-wrapper {
        width: 100%;
        max-width: 1500px;
        margin: 0 auto;
        padding-bottom: 35px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 22px 24px;
        margin-bottom: 20px;
        box-shadow: 0 3px 12px rgba(15,23,42,.04);
    }

    .page-header-content {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .page-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eaf2fb;
        color: #0c4a8a;
        border-radius: 12px;
        font-size: 22px;
    }

    .page-title {
        margin: 0;
        color: #172033;
        font-size: 25px;
        font-weight: 800;
    }

    .page-description {
        margin: 4px 0 0;
        color: #64748b;
        font-size: 13px;
    }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
        margin-bottom: 20px;
    }

    .summary-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 16px 18px;
        position: relative;
        overflow: hidden;
    }

        .summary-card::before {
            content: "";
            position: absolute;
            top: 0;
            bottom: 0;
            left: 0;
            width: 4px;
            background: #0c4a8a;
        }

        .summary-card.green::before {
            background: #198754;
        }

        .summary-card.orange::before {
            background: #f59e0b;
        }

    .summary-label {
        display: block;
        color: #64748b;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        margin-bottom: 6px;
    }

    .summary-value {
        color: #172033;
        font-size: 22px;
        font-weight: 800;
    }

    .panel {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        box-shadow: 0 3px 12px rgba(15,23,42,.04);
        overflow: hidden;
        margin-bottom: 20px;
    }

    .panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 20px;
        border-bottom: 1px solid #e8edf3;
        color: #172033;
        font-size: 14px;
        font-weight: 800;
    }

    .panel-body {
        padding: 20px;
    }

    .form-label {
        color: #334155;
        font-size: 12px;
        font-weight: 700;
        margin-bottom: 6px;
    }

    .form-control {
        min-height: 42px;
        border-color: #d7dee8;
        border-radius: 8px;
        font-size: 13px;
    }

        .form-control:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 .15rem rgba(13,110,253,.1);
        }

    .btn-primary-custom {
        background: #0c4a8a;
        border-color: #0c4a8a;
        color: white;
        font-weight: 700;
    }

        .btn-primary-custom:hover {
            background: #083b70;
            border-color: #083b70;
            color: white;
        }

    .table-bitacora {
        margin: 0;
        min-width: 900px;
    }

        .table-bitacora thead th {
            background: #f8fafc;
            color: #64748b;
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
            padding: 13px 12px;
            white-space: nowrap;
        }

        .table-bitacora tbody td {
            padding: 13px 12px;
            color: #334155;
            font-size: 13px;
            vertical-align: middle;
        }

    .monto-pendiente {
        display: inline-block;
        background: #fff4d6;
        color: #9a6700;
        padding: 5px 9px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 700;
    }

    .monto-asignado {
        display: inline-block;
        background: #e8f7ef;
        color: #198754;
        padding: 5px 9px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 700;
    }

    .empty-state {
        text-align: center;
        padding: 45px 20px;
        color: #94a3b8;
    }

        .empty-state i {
            display: block;
            font-size: 35px;
            margin-bottom: 10px;
        }

    @@media(max-width: 767px) {

        .page-header {
            flex-direction: column;
            align-items: stretch;
        }

        .summary-grid {
            grid-template-columns: 1fr;
        }

        .page-title {
            font-size: 21px;
        }

        .page-header .btn {
            width: 100%;
        }
    }

</style>


<div class="bitacora-wrapper">

    <!-- =========================================
         ENCABEZADO
    ========================================== -->

    <div class="page-header">

        <div class="page-header-content">

            <div class="page-icon">
                <i class="bi bi-car-front-fill"></i>
            </div>

            <div>

                <h1 class="page-title">
                    Bitácora de vehículo
                </h1>

                <p class="page-description">
                    Registre los recorridos realizados con su vehículo durante la comisión.
                </p>

            </div>

        </div>

        @if (rendicion != null)
        {
            <a asp-controller="Gasto"
               asp-action="Index"
               asp-route-idRendicion="@rendicion.IdRendicion"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left me-1"></i>
                Volver a la rendición

            </a>
        }

    </div>


    <!-- =========================================
         MENSAJES
    ========================================== -->
    @if (TempData["mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            <i class="bi bi-check-circle me-1"></i>

            @TempData["mensaje"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            <i class="bi bi-exclamation-circle me-1"></i>

            @Html.Raw(TempData["error"])

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- =========================================
         RESUMEN
    ========================================== -->

    <div class="summary-grid">

        <div class="summary-card">

            <span class="summary-label">
                Recorridos registrados
            </span>

            <div class="summary-value">
                @(Model?.Count ?? 0)
            </div>

        </div>


        <div class="summary-card orange">

            <span class="summary-label">
                Distancia total
            </span>

            <div class="summary-value">
                @totalKm.ToString("N2") km
            </div>

        </div>


        <div class="summary-card green">

            <span class="summary-label">
                Monto asignado
            </span>

            <div class="summary-value">
                S/ @totalAsignado.ToString("N2")
            </div>

        </div>

    </div>


    <!-- =========================================
         REGISTRAR RECORRIDO
    ========================================== -->
    @if (rendicion != null &&
    rendicion.IdEstadoRendicion == 1)
    {

        <div class="panel">

            <div class="panel-header">

                <span>
                    <i class="bi bi-plus-circle me-2 text-primary"></i>
                    Registrar recorrido
                </span>

            </div>


            <div class="panel-body">

                <form asp-controller="BitacoraVehiculo"
                      asp-action="Create"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="IdRendicion"
                           value="@rendicion.IdRendicion" />


                    <div class="row g-3">

                        <!-- FECHA -->

                        <div class="col-md-3">

                            <label class="form-label">
                                Fecha
                            </label>

                            <input type="date"
                                   name="Fecha"
                                   class="form-control"
                                   min="@rendicion.FechaInicio.ToString("yyyy-MM-dd")"
                                   max="@rendicion.FechaFin.ToString("yyyy-MM-dd")"
                                   required />

                        </div>


                        <!-- ORIGEN -->

                        <div class="col-md-4">

                            <label class="form-label">
                                Origen
                            </label>

                            <input type="text"
                                   name="Origen"
                                   class="form-control"
                                   maxlength="200"
                                   placeholder="Ej. Oficina DINACEN"
                                   required />

                        </div>


                        <!-- DESTINO -->

                        <div class="col-md-5">

                            <label class="form-label">
                                Destino
                            </label>

                            <input type="text"
                                   name="Destino"
                                   class="form-control"
                                   maxlength="200"
                                   placeholder="Ej. Planta Huancayo"
                                   required />

                        </div>


                        <!-- DISTANCIA -->

                        <div class="col-md-3">

                            <label class="form-label">
                                Distancia recorrida (km)
                            </label>

                            <div class="input-group">

                                <input type="number"
                                       name="DistanciaKm"
                                       class="form-control"
                                       min="0.01"
                                       step="0.01"
                                       placeholder="0.00"
                                       required />

                                <span class="input-group-text">
                                    km
                                </span>

                            </div>

                        </div>


                        <!-- OBSERVACIONES -->

                        <div class="col-md-9">

                            <label class="form-label">
                                Observaciones
                            </label>

                            <input type="text"
                                   name="Observaciones"
                                   class="form-control"
                                   maxlength="500"
                                   placeholder="Información adicional del recorrido" />

                        </div>


                        <!-- INFORMACIÓN -->

                        <div class="col-12">

                            <div class="alert alert-info mb-0">

                                <i class="bi bi-info-circle me-1"></i>

                                El monto correspondiente al recorrido será
                                asignado posteriormente por el administrador.

                            </div>

                        </div>


                        <!-- BOTÓN -->

                        <div class="col-12">

                            <button type="submit"
                                    class="btn btn-primary-custom px-4">

                                <i class="bi bi-plus-circle me-1"></i>

                                Registrar recorrido

                            </button>

                        </div>

                    </div>

                </form>

            </div>

        </div>

    }


    <!-- =========================================
         RECORRIDOS REGISTRADOS
    ========================================== -->

    <div class="panel">

        <div class="panel-header">

            <span>

                <i class="bi bi-list-ul me-2 text-primary"></i>

                Recorridos registrados

            </span>

        </div>


        <div class="table-responsive">

            <table class="table table-bitacora align-middle">

                <thead>

                    <tr>

                        <th>Fecha</th>

                        <th>Origen</th>

                        <th>Destino</th>

                        <th>Distancia</th>

                        <th>Monto</th>

                        <th>Observaciones</th>

                        <th>Acciones</th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model != null && Model.Any())
                    {

                        foreach (var item in Model)
                        {

                            <tr>

                                <!-- FECHA -->

                                <td>

                                    @item.Fecha.ToString("dd/MM/yyyy")

                                </td>


                                <!-- ORIGEN -->

                                <td>

                                    @item.Origen

                                </td>


                                <!-- DESTINO -->

                                <td>

                                    @item.Destino

                                </td>


                                <!-- DISTANCIA -->

                                <td>

                                    <strong>
                                        @item.DistanciaKm.ToString("N2") km
                                    </strong>

                                </td>


                                <!-- MONTO -->

                                <td>

                                    @if (item.MontoAsignado > 0)
                                    {

                                        <span class="monto-asignado">

                                            S/ @item.MontoAsignado.ToString("N2")

                                        </span>

                                    }
                                    else
                                    {

                                        <span class="monto-pendiente">

                                            Pendiente

                                        </span>

                                    }

                                </td>


                                <!-- OBSERVACIONES -->

                                <td>

                                    @(string.IsNullOrWhiteSpace(item.Observaciones)
                                        ? "-"
                                        : item.Observaciones)

                                </td>


                                <!-- ACCIONES -->

                                <td>

                                    @if (rendicion != null &&
                                   rendicion.IdEstadoRendicion == 1)
                                    {

                                        <form asp-controller="BitacoraVehiculo"
                                              asp-action="Delete"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@item.IdBitacoraVehiculo" />

                                            <input type="hidden"
                                                   name="idRendicion"
                                                   value="@rendicion.IdRendicion" />

                                            <button type="submit"
                                                    class="btn btn-outline-danger btn-sm"
                                                    onclick="return confirm('¿Desea eliminar este recorrido?');">

                                                <i class="bi bi-trash"></i>

                                            </button>

                                        </form>

                                    }
                                    else
                                    {

                                        <span class="text-muted small">
                                            Bloqueado
                                        </span>

                                    }

                                </td>

                            </tr>

                        }

                    }
                    else
                    {

                        <tr>

                            <td colspan="7">

                                <div class="empty-state">

                                    <i class="bi bi-car-front"></i>

                                    <div>
                                        No hay recorridos registrados.
                                    </div>

                                    <small>
                                        Los recorridos realizados aparecerán aquí.
                                    </small>

                                </div>

                            </td>

                        </tr>

                    }

                </tbody>

            </table>

        </div>

    </div>

</div>