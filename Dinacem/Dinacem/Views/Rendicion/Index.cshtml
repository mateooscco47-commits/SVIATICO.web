@model List<Dinacem.Models.Solicitud>

@{
    ViewData["Title"] = "Rendición de Gastos";
    Layout = "~/Views/Shared/_LayoutEmpleado.cshtml";

    var rendiciones = ViewBag.Rendiciones as List<Dinacem.Models.Rendicion>
        ?? new List<Dinacem.Models.Rendicion>();

    var totalSolicitudes = Model?.Count ?? 0;

    var sinRendicion = Model?.Count(x =>
        !rendiciones.Any(r => r.IdSolicitud == x.IdSolicitud)) ?? 0;

    var enProceso = rendiciones.Count(x => x.IdEstadoRendicion == 1);
    var pendientes = rendiciones.Count(x => x.IdEstadoRendicion == 2);
    var aprobadas = rendiciones.Count(x => x.IdEstadoRendicion == 3);
    var rechazadas = rendiciones.Count(x => x.IdEstadoRendicion == 4);
}

<style>
    :root {
        --azul: #0c4a8a;
        --azul-oscuro: #083763;
        --azul-claro: #eaf3fb;
        --verde: #6aa84f;
        --texto: #263238;
        --texto-secundario: #71808a;
        --borde: #dce5eb;
        --fondo: #f5f8fa;
        --blanco: #ffffff;
    }

    .page-wrapper {
        width: 100%;
        max-width: 1600px;
        margin: 0 auto;
        padding: 0;
        color: var(--texto);
    }

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 22px 25px;
        margin-bottom: 22px;
        background: #fff;
        border: 1px solid var(--borde);
        border-radius: 12px;
        box-shadow: 0 4px 14px rgba(15,23,42,.05);
    }

    .page-header-content {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .page-header-icon {
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 12px;
        background: var(--azul-claro);
        color: #3186dc;
        font-size: 25px;
    }

    .page-title {
        margin: 0;
        color: #174f7c;
        font-size: 24px;
        font-weight: 700;
    }

    .page-description {
        margin: 5px 0 0;
        color: #7b8992;
        font-size: 13px;
    }

    .page-header-actions {
        display: flex;
        align-items: center;
    }

    .btn-volver {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 43px;
        padding: 0 18px;
        border: 1px solid #d8e0e5;
        border-radius: 7px;
        background: #fff;
        color: #5f6f79;
        font-size: 13.5px;
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
        transition: .2s;
    }

    .btn-volver:hover {
        background: #f4f7f9;
        border-color: #c7d1d8;
        color: #40515b;
    }

    .mensaje-sistema {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 18px;
        padding: 12px 15px;
        border-radius: 8px;
        font-size: 13.5px;
        font-weight: 500;
    }

    .mensaje-sistema .btn-close {
        margin-left: auto;
    }

    .mensaje-exito {
        background: #edf9f0;
        border: 1px solid #c9e9d1;
        color: #327942;
    }

    .mensaje-error {
        background: #fff0f0;
        border: 1px solid #f0cccc;
        color: #b83b3b;
    }

    .summary-card {
        height: 100%;
        padding: 17px 18px;
        background: #fff;
        border: 1px solid var(--borde);
        border-radius: 12px;
        box-shadow: 0 4px 14px rgba(15,23,42,.05);
        transition: .2s;
    }

    .summary-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 7px 18px rgba(15,23,42,.08);
    }

    .summary-content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }

    .summary-label {
        display: block;
        color: #87939c;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .3px;
    }

    .summary-value {
        margin: 4px 0 0;
        color: #263238;
        font-size: 25px;
        font-weight: 800;
    }

    .summary-icon {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 10px;
        font-size: 19px;
    }

    .icon-total {
        background: #e7f2ff;
        color: #3186dc;
    }

    .icon-proceso {
        background: #e8f0ff;
        color: #315fd4;
    }

    .icon-pendiente {
        background: #fff5d6;
        color: #a97808;
    }

    .icon-aprobada {
        background: #e8f7ec;
        color: #3d8a51;
    }

    .icon-rechazada {
        background: #ffebeb;
        color: #c34646;
    }

    .filtros-card {
        display: flex;
        align-items: flex-end;
        gap: 14px;
        margin-bottom: 18px;
        padding: 16px 18px;
        background: #fff;
        border: 1px solid var(--borde);
        border-radius: 12px;
        box-shadow: 0 3px 10px rgba(15,23,42,.04);
    }

    .search-box {
        position: relative;
        width: 50%;
        min-width: 300px;
    }

    .search-icon {
        position: absolute;
        top: 50%;
        left: 14px;
        color: #87939c;
        font-size: 15px;
        pointer-events: none;
        transform: translateY(-50%);
    }

    .search-input {
        width: 100%;
        height: 42px;
        padding: 8px 42px 8px 40px;
        border: 1px solid #d1d9df;
        border-radius: 8px;
        outline: none;
        background: #fff;
        color: #263238;
        font-size: 13px;
    }

    .search-input:focus {
        border-color: var(--azul);
        box-shadow: 0 0 0 3px rgba(12,74,138,.1);
    }

    .search-clear {
        position: absolute;
        top: 50%;
        right: 8px;
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 0;
        border-radius: 6px;
        background: transparent;
        color: #94a3b8;
        cursor: pointer;
        transform: translateY(-50%);
    }

    .search-clear:hover {
        background: #f1f5f9;
        color: #dc2626;
    }

    .date-filter {
        width: 170px;
    }

    .date-label {
        display: block;
        margin-bottom: 6px;
        color: #66747d;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .3px;
    }

    .date-filter input {
        width: 100%;
        height: 42px;
        padding: 8px 10px;
        border: 1px solid #d1d9df;
        border-radius: 8px;
        outline: none;
        color: #40515b;
        font-size: 13px;
    }

    .date-filter input:focus {
        border-color: var(--azul);
        box-shadow: 0 0 0 3px rgba(12,74,138,.1);
    }

    .btn-limpiar {
        height: 42px;
        padding: 0 15px;
        border: 1px solid #d8e0e5;
        border-radius: 8px;
        background: #fff;
        color: #5f6f79;
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
    }

    .btn-limpiar:hover {
        background: #f4f7f9;
        color: #40515b;
    }

    .panel {
        overflow: hidden;
        background: #fff;
        border: 1px solid var(--borde);
        border-radius: 12px;
        box-shadow: 0 4px 14px rgba(15,23,42,.05);
    }

    .panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 17px 20px;
        border-bottom: 1px solid #e4ebf0;
    }

    .panel-title {
        display: flex;
        align-items: center;
        gap: 9px;
        margin: 0;
        color: #174f7c;
        font-size: 15px;
        font-weight: 700;
    }

    .panel-title i {
        color: #3186dc;
        font-size: 18px;
    }

    .panel-count {
        color: #87939c;
        font-size: 12px;
        font-weight: 600;
    }

    .table-responsive {
        width: 100%;
        overflow-x: auto;
    }

    .tabla-rendiciones {
        width: 100%;
        min-width: 950px;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
    }

    .tabla-rendiciones thead th {
        padding: 13px 14px;
        background: #f3f7fa;
        border-bottom: 1px solid #dfe7ed;
        color: #526572;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .35px;
        white-space: nowrap;
    }

    .tabla-rendiciones tbody td {
        padding: 14px;
        border-bottom: 1px solid #edf1f4;
        background: #fff;
        color: #465660;
        font-size: 13px;
        vertical-align: middle;
    }

    .tabla-rendiciones tbody tr {
        transition: background .15s;
    }

    .tabla-rendiciones tbody tr:hover td {
        background: #f8fbfd;
    }

    .tabla-rendiciones tbody tr:last-child td {
        border-bottom: 0;
    }

    .id-solicitud {
        color: #174f7c;
        font-weight: 700;
        white-space: nowrap;
    }

    .fecha {
        color: #5c6b74;
        white-space: nowrap;
    }

    .fecha-secundaria {
        display: block;
        margin-top: 3px;
        color: #929da5;
        font-size: 11.5px;
    }

    .destino {
        max-width: 220px;
        color: #263238;
        font-weight: 600;
    }

    .monto {
        color: #174f7c;
        font-weight: 700;
        white-space: nowrap;
    }

    .estado {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 11.5px;
        font-weight: 700;
        white-space: nowrap;
    }

    .estado-sin {
        background: #eef1f3;
        border: 1px solid #dce2e6;
        color: #64727b;
    }

    .estado-proceso {
        background: #e7f2ff;
        border: 1px solid #c9e0f7;
        color: #3186dc;
    }

    .estado-pendiente {
        background: #fff5d6;
        border: 1px solid #f3dfa0;
        color: #a97808;
    }

    .estado-aprobada {
        background: #e8f7ec;
        border: 1px solid #c9e8d1;
        color: #3d8a51;
    }

    .estado-rechazada {
        background: #ffebeb;
        border: 1px solid #f0cccc;
        color: #c34646;
    }

    .acciones {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 6px;
        flex-wrap: wrap;
    }

    .btn-accion {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        min-height: 34px;
        padding: 6px 10px;
        border: 1px solid;
        border-radius: 7px;
        font-size: 11.5px;
        font-weight: 600;
        line-height: 1;
        text-decoration: none;
        white-space: nowrap;
        transition: .2s;
    }

    .btn-accion:hover {
        transform: translateY(-1px);
    }

    .btn-crear {
        background: #f5fbf2;
        border-color: #b8dcae;
        color: #388e3c;
    }

    .btn-crear:hover {
        background: #e8f5e9;
        border-color: #8bc580;
        color: #2e7d32;
    }

    .btn-continuar {
        background: #f1f7fd;
        border-color: #b7d4f5;
        color: #0c4a8a;
    }

    .btn-continuar:hover {
        background: #eaf3fb;
        border-color: #7eaddd;
        color: #083763;
    }

    .btn-detalle {
        background: #fff;
        border-color: #d8e0e5;
        color: #5f6f79;
    }

    .btn-detalle:hover {
        background: #f4f7f9;
        color: #40515b;
    }

    .btn-pdf {
        background: #fff7f7;
        border-color: #e0aaaa;
        color: #c34646;
    }

    .btn-pdf:hover {
        background: #ffebeb;
        color: #b83b3b;
    }

    .sin-registros {
        padding: 55px 20px !important;
        text-align: center;
        color: #929da5 !important;
    }

    .sin-registros i {
        display: block;
        margin-bottom: 10px;
        color: #b8c5ce;
        font-size: 38px;
    }

    .sin-registros strong {
        display: block;
        margin-bottom: 4px;
        color: #596a75;
        font-size: 14px;
    }

    .sin-registros span {
        font-size: 12.5px;
    }

    @@media (max-width: 991.98px) {
        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .page-header-actions,
        .btn-volver {
            width: 100%;
        }

        .filtros-card {
            flex-wrap: wrap;
        }

        .search-box {
            width: 100%;
            min-width: 100%;
        }

        .date-filter {
            flex: 1;
            min-width: 160px;
        }
    }

    @@media (max-width: 767.98px) {
        .page-wrapper {
            padding: 0 12px;
        }

        .page-header {
            padding: 18px;
        }

        .page-title {
            font-size: 21px;
        }

        .page-description {
            font-size: 12.5px;
        }

        .page-header-icon {
            width: 46px;
            height: 46px;
            font-size: 21px;
        }

        .summary-value {
            font-size: 22px;
        }

        .filtros-card {
            flex-direction: column;
            align-items: stretch;
            padding: 14px;
        }

        .search-box,
        .date-filter,
        .btn-limpiar {
            width: 100%;
            min-width: 100%;
        }

        .panel-header {
            padding: 15px;
        }

        .panel-count {
            display: none;
        }

        .acciones {
            justify-content: flex-start;
        }
    }

    @@media (max-width: 480px) {
        .page-wrapper {
            padding: 0 8px;
        }

        .page-title {
            font-size: 19px;
        }

        .page-header-icon {
            width: 42px;
            height: 42px;
            font-size: 19px;
        }

        .summary-value {
            font-size: 20px;
        }
    }
</style>

<div class="page-wrapper">

    <div class="page-header">

        <div class="page-header-content">

            <div class="page-header-icon">
                <i class="bi bi-receipt-cutoff"></i>
            </div>

            <div>
                <h1 class="page-title">
                    Rendición de Gastos
                </h1>

                <p class="page-description">
                    Consulte sus solicitudes aprobadas y gestione la rendición de los gastos realizados.
                </p>
            </div>

        </div>

        <div class="page-header-actions">

            <a asp-controller="Empleado"
               asp-action="Index"
               class="btn-volver">

                <i class="bi bi-arrow-left"></i>
                Volver al panel

            </a>

        </div>

    </div>

    @if (TempData["mensaje"] != null)
    {
        <div class="mensaje-sistema mensaje-exito">

            <i class="bi bi-check-circle-fill"></i>

            <span>
                @TempData["mensaje"]
            </span>

            <button type="button"
                    class="btn-close"
                    onclick="this.parentElement.remove()"
                    aria-label="Cerrar">
            </button>

        </div>
    }

    @if (TempData["error"] != null)
    {
        <div class="mensaje-sistema mensaje-error">

            <i class="bi bi-exclamation-triangle-fill"></i>

            <span>
                @Html.Raw(TempData["error"])
            </span>

            <button type="button"
                    class="btn-close"
                    onclick="this.parentElement.remove()"
                    aria-label="Cerrar">
            </button>

        </div>
    }

    <div class="row g-3 mb-4">

        <div class="col-6 col-xl-3">

            <div class="summary-card">

                <div class="summary-content">

                    <div>
                        <span class="summary-label">
                            Solicitudes aprobadas
                        </span>

                        <div class="summary-value">
                            @totalSolicitudes
                        </div>
                    </div>

                    <div class="summary-icon icon-total">
                        <i class="bi bi-file-earmark-check"></i>
                    </div>

                </div>

            </div>

        </div>

        <div class="col-6 col-xl-3">

            <div class="summary-card">

                <div class="summary-content">

                    <div>
                        <span class="summary-label">
                            Sin rendición
                        </span>

                        <div class="summary-value">
                            @sinRendicion
                        </div>
                    </div>

                    <div class="summary-icon icon-pendiente">
                        <i class="bi bi-clock"></i>
                    </div>

                </div>

            </div>

        </div>

        <div class="col-6 col-xl-3">

            <div class="summary-card">

                <div class="summary-content">

                    <div>
                        <span class="summary-label">
                            En proceso
                        </span>

                        <div class="summary-value">
                            @enProceso
                        </div>
                    </div>

                    <div class="summary-icon icon-proceso">
                        <i class="bi bi-pencil-square"></i>
                    </div>

                </div>

            </div>

        </div>

        <div class="col-6 col-xl-3">

            <div class="summary-card">

                <div class="summary-content">

                    <div>
                        <span class="summary-label">
                            Pendientes de revisión
                        </span>

                        <div class="summary-value">
                            @pendientes
                        </div>
                    </div>

                    <div class="summary-icon icon-pendiente">
                        <i class="bi bi-hourglass-split"></i>
                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="filtros-card">

        <div class="search-box">

            <i class="bi bi-search search-icon"></i>

            <input type="search"
                   class="search-input"
                   placeholder="Buscar solicitud, destino, fecha o estado..."
                   autocomplete="off" />

            <button type="button"
                    class="search-clear"
                    aria-label="Limpiar búsqueda">

                <i class="bi bi-x-lg"></i>

            </button>

        </div>

        <div class="date-filter">

            <label class="date-label">
                Desde
            </label>

            <input type="date" />

        </div>

        <div class="date-filter">

            <label class="date-label">
                Hasta
            </label>

            <input type="date" />

        </div>

        <button type="button"
                class="btn-limpiar">

            <i class="bi bi-arrow-counterclockwise me-1"></i>
            Limpiar

        </button>

    </div>

    <div class="panel">

        <div class="panel-header">

            <h2 class="panel-title">

                <i class="bi bi-list-ul"></i>

                Solicitudes aprobadas

            </h2>

            <span class="panel-count">
                @totalSolicitudes registro(s)
            </span>

        </div>

        <div class="table-responsive">

            <table class="tabla-rendiciones">

                <thead>

                    <tr>
                        <th>#</th>
                        <th>Fecha</th>
                        <th>Periodo</th>
                        <th>Destino</th>
                        <th>Monto aprobado</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>

                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            var rendicionExistente = rendiciones.FirstOrDefault(r =>
                                r.IdSolicitud == item.IdSolicitud);

                            <tr>

                                <td>
                                    <span class="id-solicitud">
                                        #@item.IdSolicitud
                                    </span>
                                </td>

                                <td>
                                    <span class="fecha">
                                        @item.Fecha.ToString("dd/MM/yyyy")
                                    </span>
                                </td>

                                <td>
                                    <span class="fecha">
                                        @item.FechaInicio.ToString("dd/MM/yyyy")
                                    </span>

                                    <span class="fecha-secundaria">
                                        hasta @item.FechaFin.ToString("dd/MM/yyyy")
                                    </span>
                                </td>

                                <td>
                                    <span class="destino">
                                        @item.Destino
                                    </span>
                                </td>

                                <td>
                                    <span class="monto">
                                        S/ @item.Monto.ToString("N2")
                                    </span>
                                </td>

                                <td>

                                    @if (rendicionExistente == null)
                                    {
                                        <span class="estado estado-sin">
                                            <i class="bi bi-dash-circle"></i>
                                            Sin rendición
                                        </span>
                                    }
                                    else if (rendicionExistente.IdEstadoRendicion == 1)
                                    {
                                        <span class="estado estado-proceso">
                                            <i class="bi bi-pencil-square"></i>
                                            En proceso
                                        </span>
                                    }
                                    else if (rendicionExistente.IdEstadoRendicion == 2)
                                    {
                                        <span class="estado estado-pendiente">
                                            <i class="bi bi-clock-fill"></i>
                                            Pendiente de revisión
                                        </span>
                                    }
                                    else if (rendicionExistente.IdEstadoRendicion == 3)
                                    {
                                        <span class="estado estado-aprobada">
                                            <i class="bi bi-check-circle-fill"></i>
                                            Aprobada
                                        </span>
                                    }
                                    else if (rendicionExistente.IdEstadoRendicion == 4)
                                    {
                                        <span class="estado estado-rechazada">
                                            <i class="bi bi-x-circle-fill"></i>
                                            Rechazada
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="estado estado-sin">
                                            <i class="bi bi-question-circle"></i>
                                            Sin estado
                                        </span>
                                    }

                                </td>

                                <td>

                                    <div class="acciones">

                                        @if (rendicionExistente == null)
                                        {
                                            <a asp-controller="Rendicion"
                                               asp-action="Create"
                                               asp-route-idSolicitud="@item.IdSolicitud"
                                               class="btn-accion btn-crear">

                                                <i class="bi bi-plus-circle"></i>
                                                Crear rendición

                                            </a>
                                        }
                                        else if (rendicionExistente.IdEstadoRendicion == 1)
                                        {
                                            <a asp-controller="Gasto"
                                               asp-action="Index"
                                               asp-route-idRendicion="@rendicionExistente.IdRendicion"
                                               class="btn-accion btn-continuar">

                                                <i class="bi bi-pencil-square"></i>
                                                Continuar

                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-controller="Rendicion"
                                               asp-action="DetalleEmpleado"
                                               asp-route-id="@rendicionExistente.IdRendicion"
                                               class="btn-accion btn-detalle">

                                                <i class="bi bi-eye"></i>
                                                Ver detalle

                                            </a>
                                        }

                                        @if (rendicionExistente != null &&
                                             !string.IsNullOrWhiteSpace(rendicionExistente.ArchivoPdf))
                                        {
                                            <a href="@rendicionExistente.ArchivoPdf"
                                               target="_blank"
                                               rel="noopener"
                                               class="btn-accion btn-pdf">

                                                <i class="bi bi-file-earmark-pdf"></i>
                                                PDF

                                            </a>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="7"
                                class="sin-registros">

                                <i class="bi bi-inbox"></i>

                                <strong>
                                    No tienes solicitudes aprobadas
                                </strong>

                                <span>
                                    Las solicitudes disponibles para rendición aparecerán aquí.
                                </span>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>