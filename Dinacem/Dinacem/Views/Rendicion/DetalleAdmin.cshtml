@model List<Dinacem.Models.Gasto>

@{
    ViewData["Title"] = "Revisión de Rendición";
    Layout = "~/Views/Shared/_LayoutAdministrador.cshtml";

    var rendicion = ViewBag.Rendicion as Dinacem.Models.Rendicion;
    var devolucion = ViewBag.DevolucionSaldo as Dinacem.Models.DevolucionSaldo;
    var reembolso = ViewBag.Reembolso as Dinacem.Models.Reembolso;

    var montoAprobado = rendicion?.Solicitud?.Monto ?? 0;
    var totalValorVenta = Model?.Sum(x => x.ValorVenta) ?? 0;
    var totalIgv = Model?.Sum(x => x.IGV) ?? 0;
    var totalRendido = Model?.Sum(x => x.MontoTotal) ?? 0;
}

<style>
    .revision-page {
        width: 100%;
        max-width: 1600px;
        margin: 0 auto;
        padding: 25px 30px 40px;
        color: #263238;
    }

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 22px 25px;
        margin-bottom: 22px;
        background: #fff;
        border: 1px solid #dce8f2;
        border-radius: 12px;
        box-shadow: 0 3px 12px rgba(12,74,138,.07);
    }

    .header-content {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .header-icon {
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 12px;
        background: #e7f2ff;
        color: #3186dc;
        font-size: 25px;
    }

    .page-title {
        margin: 0;
        color: #174f7c;
        font-size: 24px;
        font-weight: 700;
    }

    .page-description {
        margin: 4px 0 0;
        color: #71808a;
        font-size: 13px;
    }

    .header-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .header-actions .btn,
    .acciones .btn {
        min-height: 38px;
        padding: 7px 13px;
        border-radius: 7px;
        font-size: 12.5px;
        font-weight: 600;
    }

    .btn-dinacen {
        background: #0c4a8a;
        border: 1px solid #0c4a8a;
        color: #fff;
    }

    .btn-dinacen:hover {
        background: #093b70;
        border-color: #093b70;
        color: #fff;
    }

    .btn-aprobar {
        background: #198754;
        border-color: #198754;
        color: #fff;
    }

    .btn-aprobar:hover {
        background: #157347;
        border-color: #157347;
        color: #fff;
    }

    .panel {
        margin-bottom: 20px;
        overflow: hidden;
        background: #fff;
        border: 1px solid #dce5eb;
        border-radius: 12px;
        box-shadow: 0 4px 14px rgba(15,23,42,.06);
    }

    .panel-header {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 17px 20px;
        background: #fff;
        border-bottom: 1px solid #e4ebf0;
        color: #174f7c;
        font-size: 15px;
        font-weight: 700;
    }

    .panel-header i {
        color: #3186dc;
        font-size: 18px;
    }

    .panel-body {
        padding: 20px;
    }

    .table-responsive {
        width: 100%;
        overflow-x: auto;
    }

    .info-table,
    .tabla-gastos,
    .tabla-devolucion {
        margin: 0;
        border-color: #e1e8ed;
    }

    .info-table th,
    .tabla-devolucion th {
        width: 18%;
        background: #f3f7fa;
        color: #526572;
        border-color: #e1e8ed;
        padding: 12px 14px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .3px;
        white-space: nowrap;
    }

    .info-table td,
    .tabla-devolucion td {
        color: #465660;
        border-color: #e1e8ed;
        padding: 12px 14px;
        font-size: 13px;
        vertical-align: middle;
    }

    .tabla-gastos {
        min-width: 1200px;
    }

    .tabla-devolucion {
        min-width: 650px;
    }

    .tabla-gastos thead th {
        background: #f3f7fa;
        color: #526572;
        border-color: #e1e8ed;
        padding: 12px 13px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .3px;
        white-space: nowrap;
    }

    .tabla-gastos tbody td {
        padding: 12px 13px;
        color: #465660;
        border-color: #edf1f4;
        font-size: 12.5px;
        vertical-align: middle;
    }

    .tabla-gastos tbody tr:hover {
        background: #f8fbfd;
    }

    .tabla-gastos strong {
        color: #263238;
        font-weight: 600;
    }

    .codigo {
        color: #174f7c;
        font-weight: 700;
    }

    .estado {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

    .estado-proceso {
        background: #e7f2ff;
        border: 1px solid #c9e0f7;
        color: #3186dc;
    }

    .estado-pendiente {
        background: #fff5d6;
        border: 1px solid #f3dfa0;
        color: #a97808;
    }

    .estado-aprobada {
        background: #e8f7ec;
        border: 1px solid #c9e8d1;
        color: #3d8a51;
    }

    .estado-rechazada {
        background: #ffebeb;
        border: 1px solid #f0cccc;
        color: #c34646;
    }

    .resumen-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
        margin-bottom: 20px;
    }

    .summary-card {
        min-height: 105px;
        padding: 17px;
        background: #fff;
        border: 1px solid #dce5eb;
        border-radius: 12px;
        box-shadow: 0 3px 10px rgba(15,23,42,.04);
    }

    .summary-label {
        display: block;
        margin-bottom: 7px;
        color: #71808a;
        font-size: 10.5px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .3px;
    }

    .summary-value {
        color: #174f7c;
        font-size: 21px;
        font-weight: 700;
    }

    .summary-primary {
        border-left: 4px solid #0c4a8a;
    }

    .summary-purple {
        border-left: 4px solid #7c3aed;
    }

    .summary-orange {
        border-left: 4px solid #f59e0b;
    }

    .summary-green {
        border-left: 4px solid #198754;
    }

    .summary-danger {
        border-left: 4px solid #dc3545;
    }

    .reembolso-panel {
        border-left: 4px solid #3186dc;
    }

    .reembolso-monto {
        color: #c34646;
        font-size: 22px;
        font-weight: 700;
    }

    .archivo-btn {
        white-space: nowrap;
    }

    .acciones {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 7px;
    }

    .acciones form {
        margin: 0;
    }

    .bloque-reembolso {
        margin-top: 20px;
        padding-top: 20px;
        border-top: 1px solid #e4ebf0;
    }

    .bloque-reembolso h5 {
        margin: 0 0 5px;
        color: #174f7c;
        font-size: 15px;
        font-weight: 700;
    }

    .bloque-reembolso p {
        margin-bottom: 18px;
        color: #71808a;
        font-size: 12.5px;
    }

    .form-label {
        margin-bottom: 6px;
        color: #526572;
        font-size: 12px;
        font-weight: 700;
    }

    .form-control {
        min-height: 42px;
        border: 1px solid #cfd9df;
        border-radius: 7px;
        color: #263238;
        font-size: 13px;
    }

    .form-control:focus {
        border-color: #3186dc;
        box-shadow: 0 0 0 .15rem rgba(49,134,220,.12);
    }

    .rechazo-alert,
    .info-alert,
    .warning-alert {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 13px 15px;
        margin-bottom: 20px;
        border-radius: 8px;
        font-size: 13px;
    }

    .info-alert {
        color: #075985;
        background: #f0f9ff;
        border: 1px solid #bae6fd;
    }

    .warning-alert {
        color: #8a6500;
        background: #fff8df;
        border: 1px solid #f1dfa0;
    }

    .rechazo-alert {
        color: #a83d3d;
        background: #fff1f1;
        border: 1px solid #efcaca;
    }

    .empty-state {
        padding: 35px 20px !important;
        text-align: center;
        color: #929da5;
    }

    .empty-state i {
        display: block;
        margin-bottom: 8px;
        color: #bdc9d1;
        font-size: 32px;
    }

    .empty-state strong {
        display: block;
        margin-bottom: 4px;
        color: #596a75;
        font-size: 13px;
    }

    .modal-content {
        overflow: hidden;
        border: 0;
        border-radius: 12px;
        box-shadow: 0 15px 40px rgba(15,23,42,.18);
    }

    .modal-header {
        padding: 15px 18px;
    }

    .modal-body {
        padding: 20px;
    }

    .modal-footer {
        padding: 13px 18px;
        background: #f8fafc;
        border-top: 1px solid #e2e8f0;
    }

    .swal2-popup {
        border-radius: 14px !important;
    }

    @@media (max-width: 1100px) {
        .resumen-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 767.98px) {
        .revision-page {
            padding: 18px 15px 30px;
        }

        .page-header {
            flex-direction: column;
            align-items: flex-start;
            padding: 18px;
        }

        .header-content {
            width: 100%;
        }

        .header-actions {
            width: 100%;
            display: grid;
            grid-template-columns: 1fr;
        }

        .header-actions .btn {
            width: 100%;
        }

        .header-icon {
            width: 46px;
            height: 46px;
            font-size: 21px;
        }

        .page-title {
            font-size: 21px;
        }

        .page-description {
            font-size: 12px;
        }

        .panel {
            border-radius: 10px;
        }

        .panel-header {
            padding: 14px 16px;
            font-size: 13.5px;
        }

        .panel-body {
            padding: 14px;
        }

        .resumen-grid {
            grid-template-columns: 1fr;
        }

        .acciones {
            display: grid;
            grid-template-columns: 1fr;
            width: 100%;
        }

        .acciones form,
        .acciones .btn {
            width: 100%;
        }

        .acciones form .btn {
            width: 100%;
        }

        .modal-dialog {
            margin: 12px;
        }

        .modal-footer {
            display: grid;
            grid-template-columns: 1fr;
            gap: 7px;
        }

        .modal-footer .btn {
            width: 100%;
        }
    }
</style>

<div class="revision-page">

    <div class="page-header">

        <div class="header-content">

            <div class="header-icon">
                <i class="bi bi-receipt-cutoff"></i>
            </div>

            <div>
                <h1 class="page-title">
                    Revisión de Rendición
                </h1>

                <p class="page-description">
                    Revise la información, gastos y comprobantes de la rendición.
                </p>
            </div>

        </div>

        <div class="header-actions">

            @if (!string.IsNullOrWhiteSpace(rendicion?.ArchivoPdf))
            {
                <a href="@rendicion.ArchivoPdf"
                   target="_blank"
                   rel="noopener"
                   class="btn btn-outline-danger">

                    <i class="bi bi-file-earmark-pdf me-1"></i>
                    Ver PDF

                </a>
            }

            <a asp-controller="Rendicion"
               asp-action="IndexAdmin"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left me-1"></i>
                Volver

            </a>

        </div>

    </div>

    @if (TempData["mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["mensaje"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @Html.Raw(TempData["error"])

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (rendicion == null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            No se encontró la información de la rendición.
        </div>
    }
    else
    {
        <div class="panel">

            <div class="panel-header">
                <i class="bi bi-info-circle-fill"></i>
                Información general
            </div>

            <div class="panel-body">

                <div class="table-responsive">

                    <table class="table table-bordered info-table">

                        <tbody>

                            <tr>
                                <th>Rendición</th>
                                <td>
                                    <span class="codigo">
                                        #@rendicion.IdRendicion
                                    </span>
                                </td>

                                <th>Solicitud</th>
                                <td>
                                    <span class="codigo">
                                        #@rendicion.IdSolicitud
                                    </span>
                                </td>
                            </tr>

                            <tr>
                                <th>Empleado</th>
                                <td>
                                    @rendicion.Usuario?.Nombres
                                    @rendicion.Usuario?.Apellidos
                                </td>

                                <th>Correo</th>
                                <td>
                                    @(rendicion.Usuario?.Correo ?? "-")
                                </td>
                            </tr>

                            <tr>
                                <th>Destino</th>
                                <td>
                                    @(rendicion.Solicitud?.Destino ?? "-")
                                </td>

                                <th>Motivo</th>
                                <td>
                                    @(rendicion.Solicitud?.Motivo ?? "-")
                                </td>
                            </tr>

                            <tr>
                                <th>Fecha inicio</th>
                                <td>
                                    @rendicion.FechaInicio.ToString("dd/MM/yyyy")
                                </td>

                                <th>Fecha fin</th>
                                <td>
                                    @rendicion.FechaFin.ToString("dd/MM/yyyy")
                                </td>
                            </tr>

                            <tr>
                                <th>Fecha de envío</th>
                                <td>
                                    @(rendicion.FechaEnvioRevision.HasValue
                                        ? rendicion.FechaEnvioRevision.Value.ToString("dd/MM/yyyy HH:mm")
                                        : "-")
                                </td>

                                <th>Estado</th>
                                <td>

                                    @switch (rendicion.IdEstadoRendicion)
                                    {
                                        case 1:
                                            <span class="estado estado-proceso">
                                                <i class="bi bi-pencil-square"></i>
                                                En proceso
                                            </span>
                                            break;

                                        case 2:
                                            <span class="estado estado-pendiente">
                                                <i class="bi bi-clock-fill"></i>
                                                Pendiente de revisión
                                            </span>
                                            break;

                                        case 3:
                                            <span class="estado estado-aprobada">
                                                <i class="bi bi-check-circle-fill"></i>
                                                Aprobada
                                            </span>
                                            break;

                                        case 4:
                                            <span class="estado estado-rechazada">
                                                <i class="bi bi-x-circle-fill"></i>
                                                Rechazada
                                            </span>
                                            break;

                                        default:
                                            <span class="estado estado-proceso">
                                                Sin estado
                                            </span>
                                            break;
                                    }

                                </td>
                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

        <div class="panel">

            <div class="panel-header">
                <i class="bi bi-cash-stack"></i>
                Gastos registrados
            </div>

            <div class="panel-body">

                <div class="table-responsive">

                    <table class="table tabla-gastos">

                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Tipo</th>
                                <th>Proveedor</th>
                                <th>Comprobante</th>
                                <th>Detalle</th>
                                <th>Base</th>
                                <th>IGV</th>
                                <th>Total</th>
                                <th>Archivo</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (Model != null && Model.Any())
                            {
                                foreach (var item in Model)
                                {
                                    <tr>

                                        <td>
                                            @item.Fecha.ToString("dd/MM/yyyy")
                                        </td>

                                        <td>
                                            @(item.TipoGasto?.Nombre ?? "-")
                                        </td>

                                        <td>
                                            <strong>
                                                @(item.RazonSocial ?? "-")
                                            </strong>

                                            @if (!string.IsNullOrWhiteSpace(item.Ruc))
                                            {
                                                <br />
                                                <small class="text-muted">
                                                    RUC: @item.Ruc
                                                </small>
                                            }
                                        </td>

                                        <td>
                                            @(item.TipoComprobante?.Nombre ?? "-")

                                            <br />

                                            <small class="text-muted">
                                                @item.Serie - @item.Numero
                                            </small>
                                        </td>

                                        <td>
                                            @(item.Detalle ?? "-")
                                        </td>

                                        <td>
                                            S/ @item.ValorVenta.ToString("N2")

                                            @if (item.ExoneracionIGV)
                                            {
                                                <br />
                                                <span class="badge bg-info text-dark">
                                                    Exonerado
                                                </span>
                                            }
                                        </td>

                                        <td>
                                            S/ @item.IGV.ToString("N2")
                                        </td>

                                        <td>
                                            <strong>
                                                S/ @item.MontoTotal.ToString("N2")
                                            </strong>
                                        </td>

                                        <td>

                                            @if (!string.IsNullOrWhiteSpace(item.Comprobante))
                                            {
                                                <a href="@item.Comprobante"
                                                   target="_blank"
                                                   rel="noopener"
                                                   class="btn btn-outline-primary btn-sm archivo-btn">

                                                    <i class="bi bi-paperclip me-1"></i>
                                                    Ver

                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted">
                                                    Sin archivo
                                                </span>
                                            }

                                        </td>

                                        <td>

                                            @if (rendicion.IdEstadoRendicion == 2)
                                            {
                                                <a asp-controller="Gasto"
                                                   asp-action="EditAdmin"
                                                   asp-route-id="@item.IdGasto"
                                                   class="btn btn-outline-warning btn-sm">

                                                    <i class="bi bi-pencil-square me-1"></i>
                                                    Editar

                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted">
                                                    <i class="bi bi-lock me-1"></i>
                                                    Bloqueado
                                                </span>
                                            }

                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="10" class="empty-state">

                                        <i class="bi bi-receipt"></i>

                                        <strong>
                                            No hay gastos registrados
                                        </strong>

                                        <span>
                                            Esta rendición todavía no contiene gastos.
                                        </span>

                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

        <div class="resumen-grid">

            <div class="summary-card summary-primary">
                <span class="summary-label">
                    Monto aprobado
                </span>

                <div class="summary-value">
                    S/ @montoAprobado.ToString("N2")
                </div>
            </div>

            <div class="summary-card summary-purple">
                <span class="summary-label">
                    Valor de venta
                </span>

                <div class="summary-value">
                    S/ @totalValorVenta.ToString("N2")
                </div>
            </div>

            <div class="summary-card summary-orange">
                <span class="summary-label">
                    IGV total
                </span>

                <div class="summary-value">
                    S/ @totalIgv.ToString("N2")
                </div>
            </div>

            <div class="summary-card summary-green">
                <span class="summary-label">
                    Total rendido
                </span>

                <div class="summary-value">
                    S/ @totalRendido.ToString("N2")
                </div>
            </div>

        </div>

        @if (rendicion.Saldo > 0 || devolucion != null)
        {
            <div class="panel">

                <div class="panel-header">
                    <i class="bi bi-arrow-return-left"></i>
                    Devolución de saldo
                </div>

                <div class="panel-body">

                    @if (devolucion == null)
                    {
                        <div class="warning-alert">

                            <i class="bi bi-exclamation-triangle-fill"></i>

                            <div>
                                Existe un saldo pendiente de devolución de
                                <strong>
                                    S/ @rendicion.Saldo.ToString("N2")
                                </strong>,
                                pero no se encontró una devolución registrada.
                            </div>

                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">

                            <table class="table table-bordered tabla-devolucion">

                                <tbody>

                                    <tr>
                                        <th>Monto devuelto</th>
                                        <td>
                                            S/ @devolucion.Monto.ToString("N2")
                                        </td>
                                    </tr>

                                    <tr>
                                        <th>Fecha</th>
                                        <td>
                                            @devolucion.Fecha.ToString("dd/MM/yyyy")
                                        </td>
                                    </tr>

                                    <tr>
                                        <th>Banco</th>
                                        <td>
                                            @(devolucion.Banco ?? "-")
                                        </td>
                                    </tr>

                                    <tr>
                                        <th>Número de operación</th>
                                        <td>
                                            @(devolucion.NumeroOperacion ?? "-")
                                        </td>
                                    </tr>

                                    <tr>
                                        <th>Observaciones</th>
                                        <td>
                                            @(string.IsNullOrWhiteSpace(devolucion.Observaciones)
                                                ? "-"
                                                : devolucion.Observaciones)
                                        </td>
                                    </tr>

                                    <tr>
                                        <th>Voucher</th>
                                        <td>

                                            @if (!string.IsNullOrWhiteSpace(devolucion.Voucher))
                                            {
                                                <a href="@devolucion.Voucher"
                                                   target="_blank"
                                                   rel="noopener"
                                                   class="btn btn-outline-primary btn-sm">

                                                    <i class="bi bi-file-earmark-image me-1"></i>
                                                    Ver voucher

                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-danger">
                                                    Sin voucher
                                                </span>
                                            }

                                        </td>
                                    </tr>

                                </tbody>

                            </table>

                        </div>
                    }

                </div>

            </div>
        }

        @if (rendicion.Saldo < 0)
        {
            <div class="panel reembolso-panel">

                <div class="panel-header">
                    <i class="bi bi-cash-coin"></i>
                    Reembolso al empleado
                </div>

                <div class="panel-body">

                    <div class="info-alert">

                        <i class="bi bi-info-circle-fill"></i>

                        <div>
                            El total rendido supera el monto aprobado en
                            <strong>
                                S/ @Math.Abs(rendicion.Saldo).ToString("N2")
                            </strong>.
                            Este importe deberá ser reembolsado al empleado cuando la rendición sea aprobada.
                        </div>

                    </div>

                    @if (reembolso == null)
                    {
                        <div class="warning-alert">

                            <i class="bi bi-exclamation-triangle-fill"></i>

                            <div>
                                No se encontró el registro de reembolso asociado a esta rendición.
                            </div>

                        </div>
                    }
                    else
                    {
                        <div class="resumen-grid">

                            <div class="summary-card summary-danger">

                                <span class="summary-label">
                                    Monto por reembolsar
                                </span>

                                <div class="reembolso-monto">
                                    S/ @reembolso.Monto.ToString("N2")
                                </div>

                            </div>

                            <div class="summary-card">

                                <span class="summary-label">
                                    Fecha de solicitud
                                </span>

                                <div class="summary-value">
                                    @reembolso.FechaSolicitud.ToString("dd/MM/yyyy")
                                </div>

                                <small class="text-muted">
                                    @reembolso.FechaSolicitud.ToString("HH:mm")
                                </small>

                            </div>

                            <div class="summary-card">

                                <span class="summary-label">
                                    Estado del reembolso
                                </span>

                                <div class="mt-2">

                                    @switch (reembolso.IdEstadoReembolso)
                                    {
                                        case 1:
                                            <span class="estado estado-pendiente">
                                                Pendiente de aprobación
                                            </span>
                                            break;

                                        case 2:
                                            <span class="estado estado-proceso">
                                                Aprobado, pendiente de pago
                                            </span>
                                            break;

                                        case 3:
                                            <span class="estado estado-aprobada">
                                                Pagado
                                            </span>
                                            break;

                                        case 4:
                                            <span class="estado estado-rechazada">
                                                Rechazado
                                            </span>
                                            break;

                                        default:
                                            <span class="estado estado-proceso">
                                                Sin estado
                                            </span>
                                            break;
                                    }

                                </div>

                            </div>

                        </div>

                        <div class="table-responsive">

                            <table class="table table-bordered tabla-devolucion">

                                <tbody>

                                    <tr>
                                        <th>Fecha de aprobación</th>
                                        <td>
                                            @(reembolso.FechaAprobacion.HasValue
                                                ? reembolso.FechaAprobacion.Value.ToString("dd/MM/yyyy HH:mm")
                                                : "-")
                                        </td>
                                    </tr>

                                    <tr>
                                        <th>Fecha de pago</th>
                                        <td>
                                            @(reembolso.FechaPago.HasValue
                                                ? reembolso.FechaPago.Value.ToString("dd/MM/yyyy")
                                                : "-")
                                        </td>
                                    </tr>

                                    <tr>
                                        <th>Banco</th>
                                        <td>
                                            @(string.IsNullOrWhiteSpace(reembolso.Banco)
                                                ? "-"
                                                : reembolso.Banco)
                                        </td>
                                    </tr>

                                    <tr>
                                        <th>Número de operación</th>
                                        <td>
                                            @(string.IsNullOrWhiteSpace(reembolso.NumeroOperacion)
                                                ? "-"
                                                : reembolso.NumeroOperacion)
                                        </td>
                                    </tr>

                                    <tr>
                                        <th>Observaciones</th>
                                        <td>
                                            @(string.IsNullOrWhiteSpace(reembolso.Observaciones)
                                                ? "-"
                                                : reembolso.Observaciones)
                                        </td>
                                    </tr>

                                    <tr>
                                        <th>Comprobante</th>
                                        <td>

                                            @if (!string.IsNullOrWhiteSpace(reembolso.ComprobantePago))
                                            {
                                                <a href="@reembolso.ComprobantePago"
                                                   target="_blank"
                                                   rel="noopener"
                                                   class="btn btn-outline-primary btn-sm">

                                                    <i class="bi bi-paperclip me-1"></i>
                                                    Ver comprobante

                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted">
                                                    Sin comprobante
                                                </span>
                                            }

                                        </td>
                                    </tr>

                                </tbody>

                            </table>

                        </div>

                        @if (reembolso.IdEstadoReembolso == 2)
                        {
                            <div class="bloque-reembolso">

                                <h5>
                                    <i class="bi bi-bank me-1"></i>
                                    Registrar pago del reembolso
                                </h5>

                                <p>
                                    Complete la información de la transferencia realizada al empleado.
                                </p>

                                <form asp-controller="Reembolso"
                                      asp-action="RegistrarPago"
                                      method="post"
                                      enctype="multipart/form-data"
                                      id="formRegistrarPago">

                                    <input type="hidden"
                                           name="idReembolso"
                                           value="@reembolso.IdReembolso" />

                                    <div class="row g-3">

                                        <div class="col-12 col-md-6">

                                            <label for="bancoReembolso"
                                                   class="form-label">
                                                Banco
                                            </label>

                                            <input type="text"
                                                   id="bancoReembolso"
                                                   name="banco"
                                                   class="form-control"
                                                   maxlength="100"
                                                   placeholder="Ej. BCP, BBVA, Interbank"
                                                   required />

                                        </div>

                                        <div class="col-12 col-md-6">

                                            <label for="numeroOperacionReembolso"
                                                   class="form-label">
                                                Número de operación
                                            </label>

                                            <input type="text"
                                                   id="numeroOperacionReembolso"
                                                   name="numeroOperacion"
                                                   class="form-control"
                                                   maxlength="100"
                                                   placeholder="Ingrese el número de operación"
                                                   required />

                                        </div>

                                        <div class="col-12 col-md-6">

                                            <label for="fechaPagoReembolso"
                                                   class="form-label">
                                                Fecha de pago
                                            </label>

                                            <input type="date"
                                                   id="fechaPagoReembolso"
                                                   name="fechaPago"
                                                   class="form-control"
                                                   value="@DateTime.Now.ToString("yyyy-MM-dd")"
                                                   max="@DateTime.Now.ToString("yyyy-MM-dd")"
                                                   required />

                                        </div>

                                        <div class="col-12 col-md-6">

                                            <label for="comprobanteReembolso"
                                                   class="form-label">
                                                Comprobante de pago
                                            </label>

                                            <input type="file"
                                                   id="comprobanteReembolso"
                                                   name="comprobante"
                                                   class="form-control"
                                                   accept=".pdf,.jpg,.jpeg,.png"
                                                   required />

                                            <small class="text-muted">
                                                PDF, JPG, JPEG o PNG. Máximo 5 MB.
                                            </small>

                                        </div>

                                        <div class="col-12">

                                            <label for="observacionesReembolso"
                                                   class="form-label">
                                                Observaciones
                                            </label>

                                            <textarea id="observacionesReembolso"
                                                      name="observaciones"
                                                      class="form-control"
                                                      rows="3"
                                                      maxlength="1000"
                                                      placeholder="Ingrese alguna observación sobre el pago"></textarea>

                                        </div>

                                    </div>

                                    <div class="d-flex justify-content-end mt-4">

                                        <button type="submit"
                                                class="btn btn-dinacen"
                                                id="btnRegistrarPago">

                                            <i class="bi bi-cash-coin me-1"></i>
                                            Registrar pago

                                        </button>

                                    </div>

                                </form>

                            </div>
                        }
                    }

                </div>

            </div>
        }

        @if (rendicion.IdEstadoRendicion == 4 &&
             !string.IsNullOrWhiteSpace(rendicion.Observaciones))
        {
            <div class="rechazo-alert">

                <i class="bi bi-exclamation-triangle-fill"></i>

                <div>

                    <strong>
                        Motivo del rechazo
                    </strong>

                    <div class="mt-1">
                        @rendicion.Observaciones
                    </div>

                </div>

            </div>
        }

        <div class="panel">

            <div class="panel-header">
                <i class="bi bi-check2-square"></i>
                Acciones
            </div>

            <div class="panel-body">

                <div class="acciones">

                    @if (rendicion.IdEstadoRendicion == 2)
                    {
                        <form asp-controller="Rendicion"
                              asp-action="Aprobar"
                              method="post"
                              class="form-aprobar-rendicion">

                            <input type="hidden"
                                   name="id"
                                   value="@rendicion.IdRendicion" />

                            <button type="submit"
                                    class="btn btn-aprobar">

                                <i class="bi bi-check-circle me-1"></i>
                                Aprobar rendición

                            </button>

                        </form>

                        <button type="button"
                                class="btn btn-outline-danger"
                                data-bs-toggle="modal"
                                data-bs-target="#modalRechazarRendicion">

                            <i class="bi bi-x-circle me-1"></i>
                            Rechazar rendición

                        </button>
                    }
                    else
                    {
                        <span class="text-muted align-self-center">
                            <i class="bi bi-lock me-1"></i>
                            Esta rendición ya fue procesada.
                        </span>
                    }

                    @if (!string.IsNullOrWhiteSpace(rendicion.ArchivoPdf))
                    {
                        <a href="@rendicion.ArchivoPdf"
                           target="_blank"
                           rel="noopener"
                           class="btn btn-outline-danger">

                            <i class="bi bi-file-earmark-pdf me-1"></i>
                            Ver liquidación PDF

                        </a>
                    }

                    <a asp-controller="Rendicion"
                       asp-action="IndexAdmin"
                       class="btn btn-outline-secondary">

                        <i class="bi bi-arrow-left me-1"></i>
                        Regresar a liquidaciones

                    </a>

                </div>

            </div>

        </div>

        @if (rendicion.IdEstadoRendicion == 2)
        {
            <div class="modal fade"
                 id="modalRechazarRendicion"
                 tabindex="-1"
                 aria-labelledby="tituloModalRechazo"
                 aria-hidden="true">

                <div class="modal-dialog modal-dialog-centered">

                    <div class="modal-content">

                        <form asp-controller="Rendicion"
                              asp-action="Rechazar"
                              method="post"
                              id="formRechazarRendicion">

                            <div class="modal-header bg-danger text-white">

                                <h5 class="modal-title"
                                    id="tituloModalRechazo">

                                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                    Rechazar rendición

                                </h5>

                                <button type="button"
                                        class="btn-close btn-close-white"
                                        data-bs-dismiss="modal"
                                        aria-label="Cerrar">
                                </button>

                            </div>

                            <div class="modal-body">

                                <input type="hidden"
                                       name="id"
                                       value="@rendicion.IdRendicion" />

                                <label for="observaciones"
                                       class="form-label">
                                    Motivo del rechazo
                                </label>

                                <textarea id="observaciones"
                                          name="observaciones"
                                          class="form-control"
                                          rows="5"
                                          maxlength="1000"
                                          placeholder="Explique las correcciones que debe realizar el empleado..."
                                          required></textarea>

                                <small class="text-muted">
                                    Esta observación será visible para el empleado.
                                </small>

                            </div>

                            <div class="modal-footer">

                                <button type="button"
                                        class="btn btn-outline-secondary"
                                        data-bs-dismiss="modal">

                                    Cancelar

                                </button>

                                <button type="submit"
                                        class="btn btn-danger"
                                        id="btnConfirmarRechazo">

                                    <i class="bi bi-x-circle me-1"></i>
                                    Confirmar rechazo

                                </button>

                            </div>

                        </form>

                    </div>

                </div>

            </div>
        }
    }

</div>

@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const formAprobar = document.querySelector(".form-aprobar-rendicion");
            const formRechazar = document.getElementById("formRechazarRendicion");
            const formPago = document.getElementById("formRegistrarPago");

            const alertaExito = '@Html.Raw(TempData["mensaje"] ?? "")';
            const alertaError = '@Html.Raw(TempData["error"] ?? "")';

            if (alertaExito) {
                Swal.fire({
                    icon: "success",
                    title: "Operación realizada",
                    text: alertaExito,
                    confirmButtonText: "Aceptar",
                    confirmButtonColor: "#0c4a8a"
                });
            }

            if (alertaError) {
                Swal.fire({
                    icon: "error",
                    title: "No se pudo completar",
                    html: alertaError,
                    confirmButtonText: "Aceptar",
                    confirmButtonColor: "#0c4a8a"
                });
            }

            if (formAprobar) {

                formAprobar.addEventListener("submit", function (e) {

                    e.preventDefault();

                    Swal.fire({
                        title: "¿Aprobar rendición?",
                        text: "La rendición será marcada como aprobada.",
                        icon: "question",
                        showCancelButton: true,
                        confirmButtonText: "Sí, aprobar",
                        cancelButtonText: "Cancelar",
                        confirmButtonColor: "#198754",
                        cancelButtonColor: "#6c757d",
                        reverseButtons: true
                    }).then(function (result) {

                        if (result.isConfirmed) {

                            const boton = formAprobar.querySelector("button");

                            if (boton) {
                                boton.disabled = true;
                                boton.innerHTML =
                                    '<span class="spinner-border spinner-border-sm me-1"></span>Aprobando...';
                            }

                            formAprobar.submit();
                        }

                    });

                });
            }

            if (formRechazar) {

                formRechazar.addEventListener("submit", function (e) {

                    e.preventDefault();

                    const observaciones =
                        document.getElementById("observaciones");

                    if (!observaciones ||
                        observaciones.value.trim() === "") {

                        Swal.fire({
                            title: "Motivo requerido",
                            text: "Debe indicar el motivo del rechazo.",
                            icon: "warning",
                            confirmButtonText: "Entendido",
                            confirmButtonColor: "#0c4a8a"
                        });

                        return;
                    }

                    Swal.fire({
                        title: "¿Rechazar rendición?",
                        text: "El empleado podrá visualizar el motivo del rechazo.",
                        icon: "warning",
                        showCancelButton: true,
                        confirmButtonText: "Sí, rechazar",
                        cancelButtonText: "Cancelar",
                        confirmButtonColor: "#dc3545",
                        cancelButtonColor: "#6c757d",
                        reverseButtons: true
                    }).then(function (result) {

                        if (result.isConfirmed) {

                            const boton =
                                document.getElementById("btnConfirmarRechazo");

                            if (boton) {
                                boton.disabled = true;
                                boton.innerHTML =
                                    '<span class="spinner-border spinner-border-sm me-1"></span>Rechazando...';
                            }

                            formRechazar.submit();
                        }

                    });

                });
            }

            if (formPago) {

                formPago.addEventListener("submit", function (e) {

                    e.preventDefault();

                    const banco =
                        document.getElementById("bancoReembolso");

                    const numeroOperacion =
                        document.getElementById("numeroOperacionReembolso");

                    const fechaPago =
                        document.getElementById("fechaPagoReembolso");

                    const archivo =
                        document.getElementById("comprobanteReembolso");

                    if (!banco.value.trim()) {

                        Swal.fire({
                            icon: "warning",
                            title: "Banco requerido",
                            text: "Ingrese el banco donde realizó la transferencia.",
                            confirmButtonColor: "#0c4a8a"
                        });

                        banco.focus();
                        return;
                    }

                    if (!numeroOperacion.value.trim()) {

                        Swal.fire({
                            icon: "warning",
                            title: "Número de operación requerido",
                            text: "Ingrese el número de operación de la transferencia.",
                            confirmButtonColor: "#0c4a8a"
                        });

                        numeroOperacion.focus();
                        return;
                    }

                    if (!fechaPago.value) {

                        Swal.fire({
                            icon: "warning",
                            title: "Fecha requerida",
                            text: "Seleccione la fecha del pago.",
                            confirmButtonColor: "#0c4a8a"
                        });

                        fechaPago.focus();
                        return;
                    }

                    if (!archivo || archivo.files.length === 0) {

                        Swal.fire({
                            icon: "warning",
                            title: "Comprobante requerido",
                            text: "Debe adjuntar el comprobante del pago.",
                            confirmButtonColor: "#0c4a8a"
                        });

                        return;
                    }

                    const archivoSeleccionado = archivo.files[0];
                    const maximo = 5 * 1024 * 1024;

                    if (archivoSeleccionado.size > maximo) {

                        Swal.fire({
                            icon: "warning",
                            title: "Archivo demasiado grande",
                            text: "El comprobante no puede superar los 5 MB.",
                            confirmButtonColor: "#0c4a8a"
                        });

                        archivo.value = "";
                        return;
                    }

                    Swal.fire({
                        title: "¿Registrar pago?",
                        text: "Se registrará el pago del reembolso.",
                        icon: "question",
                        showCancelButton: true,
                        confirmButtonText: "Sí, registrar",
                        cancelButtonText: "Cancelar",
                        confirmButtonColor: "#0c4a8a",
                        cancelButtonColor: "#6c757d",
                        reverseButtons: true
                    }).then(function (result) {

                        if (result.isConfirmed) {

                            const boton =
                                document.getElementById("btnRegistrarPago");

                            if (boton) {
                                boton.disabled = true;
                                boton.innerHTML =
                                    '<span class="spinner-border spinner-border-sm me-1"></span>Registrando...';
                            }

                            formPago.submit();
                        }

                    });

                });
            }

        });
    </script>
}