@model List<Dinacem.Models.Gasto>

@{
    ViewData["Title"] = "Detalle de Rendición";
    Layout = "~/Views/Shared/_LayoutEmpleado.cshtml";

    var rendicion = ViewBag.Rendicion as Dinacem.Models.Rendicion;
    var montoAprobado = rendicion?.Solicitud?.Monto ?? 0;
    var totalRendido = Model?.Sum(x => x.MontoTotal) ?? 0;
    var saldo = rendicion?.Saldo ?? 0;
}

<style>
    .rendicion-page {
        width: 100%;
        max-width: 1400px;
        margin: 0 auto;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        padding: 22px;
        margin-bottom: 22px;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        box-shadow: 0 5px 18px rgba(15,23,42,.05);
    }

    .page-title {
        margin: 0 0 5px;
        color: #0f172a;
        font-size: 28px;
        font-weight: 800;
    }

    .page-description {
        margin: 0;
        color: #64748b;
        font-size: 14px;
    }

    .panel {
        margin-bottom: 22px;
        overflow: hidden;
        background: #fff;
        border: 1px solid #dbe1ea;
        border-radius: 16px;
        box-shadow: 0 5px 18px rgba(15,23,42,.05);
    }

    .panel-header {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 17px 20px;
        color: #0f172a;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        font-size: 15px;
        font-weight: 800;
    }

    .panel-header i {
        color: #0c4a8a;
        font-size: 18px;
    }

    .panel-body {
        padding: 20px;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 14px;
    }

    .info-card {
        height: 100%;
        padding: 16px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        transition: .2s ease;
    }

    .info-card:hover {
        border-color: #cbd5e1;
        box-shadow: 0 3px 10px rgba(15,23,42,.04);
    }

    .info-label {
        display: block;
        margin-bottom: 6px;
        color: #64748b;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: .3px;
        text-transform: uppercase;
    }

    .info-value {
        color: #0f172a;
        font-size: 15px;
        font-weight: 700;
        word-break: break-word;
    }

    .status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-proceso {
        color: #1d4ed8;
        background: #dbeafe;
        border: 1px solid #93c5fd;
    }

    .status-pendiente {
        color: #92400e;
        background: #fef3c7;
        border: 1px solid #fcd34d;
    }

    .status-aprobada {
        color: #166534;
        background: #dcfce7;
        border: 1px solid #86efac;
    }

    .status-rechazada {
        color: #991b1b;
        background: #fee2e2;
        border: 1px solid #fca5a5;
    }

    .table-container {
        overflow-x: auto;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
    }

    .gastos-table {
        min-width: 950px;
        margin: 0;
    }

    .gastos-table th {
        padding: 13px 12px;
        color: #64748b;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .gastos-table td {
        padding: 13px 12px;
        color: #334155;
        border-bottom: 1px solid #e2e8f0;
        font-size: 14px;
        vertical-align: middle;
    }

    .gastos-table tbody tr:last-child td {
        border-bottom: 0;
    }

    .gastos-table tbody tr:hover {
        background: #f8fafc;
    }

    .amount {
        font-weight: 700;
        white-space: nowrap;
    }

    .empty-state {
        padding: 40px 20px !important;
        color: #64748b !important;
        text-align: center;
    }

    .empty-state i {
        display: block;
        margin-bottom: 9px;
        color: #94a3b8;
        font-size: 32px;
    }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
        margin-bottom: 22px;
    }

    .summary-card {
        height: 100%;
        padding: 18px;
        background: #fff;
        border: 1px solid #dbe1ea;
        border-radius: 14px;
        box-shadow: 0 4px 14px rgba(15,23,42,.04);
    }

    .summary-label {
        color: #64748b;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: .3px;
        text-transform: uppercase;
    }

    .summary-value {
        margin-top: 7px;
        color: #0f172a;
        font-size: 23px;
        font-weight: 800;
    }

    .summary-primary {
        border-left: 5px solid #0c4a8a;
    }

    .summary-warning {
        border-left: 5px solid #f59e0b;
    }

    .summary-success {
        border-left: 5px solid #198754;
    }

    .summary-danger {
        border-left: 5px solid #dc3545;
    }

    .page-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 4px;
    }

    .mobile-hint {
        display: none;
        margin-left: auto;
        color: #94a3b8;
        font-size: 11px;
        font-weight: 500;
    }

    .swal2-popup {
        border-radius: 16px !important;
    }

    @@media (max-width: 991.98px) {
        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .page-header .btn {
            width: 100%;
        }

        .panel-body {
            padding: 17px;
        }

        .mobile-hint {
            display: block;
        }
    }

    @@media (max-width: 767.98px) {
        .page-header {
            padding: 18px;
            border-radius: 14px;
        }

        .page-title {
            font-size: 23px;
        }

        .panel {
            margin-bottom: 18px;
            border-radius: 14px;
        }

        .panel-header {
            padding: 15px 16px;
            font-size: 14px;
        }

        .panel-body {
            padding: 14px;
        }

        .info-grid,
        .summary-grid {
            grid-template-columns: 1fr;
        }

        .summary-value {
            font-size: 20px;
        }

        .mobile-hint {
            display: none;
        }

        .page-actions {
            display: grid;
            grid-template-columns: 1fr;
            width: 100%;
        }

        .page-actions .btn {
            width: 100%;
        }
    }
</style>

<div class="rendicion-page">

    <div class="page-header">
        <div>
            <h1 class="page-title">
                <i class="bi bi-receipt-cutoff me-2"></i>
                Detalle de Rendición
            </h1>

            <p class="page-description">
                Consulte la información de su rendición y los gastos registrados.
            </p>
        </div>

        <a asp-controller="Rendicion"
           asp-action="MisRendiciones"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Volver
        </a>
    </div>

    @if (rendicion == null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            No se encontró la información de la rendición.
        </div>
    }
    else
    {
        <div class="panel">

            <div class="panel-header">
                <i class="bi bi-info-circle-fill"></i>
                Información general

                <span class="mobile-hint">
                    Información de la rendición
                </span>
            </div>

            <div class="panel-body">

                <div class="info-grid">

                    <div class="info-card">
                        <span class="info-label">Rendición</span>
                        <div class="info-value">
                            <i class="bi bi-file-earmark-text text-primary me-1"></i>
                            #@rendicion.IdRendicion
                        </div>
                    </div>

                    <div class="info-card">
                        <span class="info-label">Solicitud</span>
                        <div class="info-value">
                            <i class="bi bi-file-earmark-check text-primary me-1"></i>
                            #@rendicion.IdSolicitud
                        </div>
                    </div>

                    <div class="info-card">
                        <span class="info-label">Destino</span>
                        <div class="info-value">
                            @if (string.IsNullOrWhiteSpace(rendicion.Solicitud?.Destino))
                            {
                                <span class="text-muted">
                                    Sin destino registrado
                                </span>
                            }
                            else
                            {
                                <i class="bi bi-geo-alt-fill text-primary me-1"></i>
                                @rendicion.Solicitud.Destino
                            }
                        </div>
                    </div>

                    <div class="info-card">
                        <span class="info-label">Motivo</span>
                        <div class="info-value">
                            @if (string.IsNullOrWhiteSpace(rendicion.Solicitud?.Motivo))
                            {
                                <span class="text-muted">
                                    Sin motivo registrado
                                </span>
                            }
                            else
                            {
                                @rendicion.Solicitud.Motivo
                            }
                        </div>
                    </div>

                    <div class="info-card">
                        <span class="info-label">Fecha de inicio</span>
                        <div class="info-value">
                            <i class="bi bi-calendar-event text-primary me-1"></i>
                            @rendicion.FechaInicio.ToString("dd/MM/yyyy")
                        </div>
                    </div>

                    <div class="info-card">
                        <span class="info-label">Fecha de fin</span>
                        <div class="info-value">
                            <i class="bi bi-calendar-check text-primary me-1"></i>
                            @rendicion.FechaFin.ToString("dd/MM/yyyy")
                        </div>
                    </div>

                    <div class="info-card">
                        <span class="info-label">Estado</span>
                        <div class="info-value">

                            @switch (rendicion.IdEstadoRendicion)
                            {
                                case 1:
                                    <span class="status status-proceso">
                                        <i class="bi bi-pencil-square"></i>
                                        En proceso
                                    </span>
                                    break;

                                case 2:
                                    <span class="status status-pendiente">
                                        <i class="bi bi-clock-fill"></i>
                                        Pendiente de revisión
                                    </span>
                                    break;

                                case 3:
                                    <span class="status status-aprobada">
                                        <i class="bi bi-check-circle-fill"></i>
                                        Aprobada
                                    </span>
                                    break;

                                case 4:
                                    <span class="status status-rechazada">
                                        <i class="bi bi-x-circle-fill"></i>
                                        Rechazada
                                    </span>
                                    break;

                                default:
                                    <span class="status bg-secondary text-white">
                                        <i class="bi bi-question-circle"></i>
                                        Sin estado
                                    </span>
                                    break;
                            }

                        </div>
                    </div>

                    <div class="info-card">
                        <span class="info-label">Monto aprobado</span>
                        <div class="info-value text-success">
                            S/ @montoAprobado.ToString("N2")
                        </div>
                    </div>

                </div>

            </div>
        </div>

        <div class="panel">

            <div class="panel-header">
                <i class="bi bi-cash-stack"></i>
                Gastos registrados

                <span class="mobile-hint">
                    Deslice horizontalmente para consultar las columnas.
                </span>
            </div>

            <div class="panel-body">

                <div class="table-container">

                    <table class="table gastos-table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Tipo</th>
                                <th>Comprobante</th>
                                <th>Serie</th>
                                <th>Número</th>
                                <th>Detalle</th>
                                <th>IGV</th>
                                <th>Total</th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (Model != null && Model.Any())
                            {
                                foreach (var item in Model)
                                {
                                    <tr>

                                        <td>
                                            <i class="bi bi-calendar3 text-muted me-1"></i>
                                            @item.Fecha.ToString("dd/MM/yyyy")
                                        </td>

                                        <td>
                                            @(item.TipoGasto?.Nombre ?? "-")
                                        </td>

                                        <td>
                                            @(item.TipoComprobante?.Nombre ?? "-")
                                        </td>

                                        <td>
                                            @(string.IsNullOrWhiteSpace(item.Serie)
                                                ? "-"
                                                : item.Serie)
                                        </td>

                                        <td>
                                            @(string.IsNullOrWhiteSpace(item.Numero)
                                                ? "-"
                                                : item.Numero)
                                        </td>

                                        <td>
                                            @(string.IsNullOrWhiteSpace(item.Detalle)
                                                ? "-"
                                                : item.Detalle)
                                        </td>

                                        <td class="amount">
                                            S/ @item.IGV.ToString("N2")
                                        </td>

                                        <td class="amount">
                                            S/ @item.MontoTotal.ToString("N2")
                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="empty-state">
                                        <i class="bi bi-receipt-cutoff"></i>
                                        No hay gastos registrados en esta rendición.
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        </div>

        <div class="summary-grid">

            <div class="summary-card summary-primary">
                <div class="summary-label">
                    Monto aprobado
                </div>

                <div class="summary-value">
                    S/ @montoAprobado.ToString("N2")
                </div>
            </div>

            <div class="summary-card summary-warning">
                <div class="summary-label">
                    Total rendido
                </div>

                <div class="summary-value">
                    S/ @totalRendido.ToString("N2")
                </div>
            </div>

            <div class="summary-card @(saldo < 0 ? "summary-danger" : "summary-success")">

                <div class="summary-label">
                    Saldo
                </div>

                <div class="summary-value @(saldo < 0 ? "text-danger" : "text-success")">
                    S/ @saldo.ToString("N2")
                </div>

            </div>

        </div>

        <div class="page-actions">

            <a asp-controller="Rendicion"
               asp-action="MisRendiciones"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Regresar a mis rendiciones
            </a>

        </div>
    }

</div>

@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @if (TempData["error"] != null)
    {
        <script>
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["error"].ToString())),
                confirmButtonText: 'Entendido',
                confirmButtonColor: '#0c4a8a'
            });
        </script>
    }

    @if (TempData["success"] != null)
    {
        <script>
            Swal.fire({
                icon: 'success',
                title: 'Operación realizada',
                text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["success"].ToString())),
                confirmButtonText: 'Aceptar',
                confirmButtonColor: '#0c4a8a'
            });
        </script>
    }

}