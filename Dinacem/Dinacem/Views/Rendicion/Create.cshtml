@model Dinacem.Models.Rendicion

@{
    ViewData["Title"] = "Crear Rendición";
    Layout = "~/Views/Shared/_LayoutEmpleado.cshtml";
}

<style>

    .page-wrapper {
        width: 100%;
        max-width: 900px;
        margin: 0 auto;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        padding: 22px;
        margin-bottom: 22px;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        box-shadow: 0 5px 18px rgba(15, 23, 42, .05);
    }

    .page-title {
        margin: 0 0 5px;
        color: #0f172a;
        font-size: 28px;
        font-weight: 800;
    }

    .page-description {
        margin: 0;
        color: #64748b;
        font-size: 14px;
    }

    .form-card {
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #dbe1ea;
        border-radius: 16px;
        box-shadow: 0 5px 18px rgba(15, 23, 42, .06);
    }

    .form-card-header {
        padding: 18px 22px;
        color: #ffffff;
        background: #198754;
        font-size: 18px;
        font-weight: 800;
    }

    .form-card-body {
        padding: 24px;
    }

    .info-card {
        height: 100%;
        padding: 16px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
    }

    .info-label {
        color: #64748b;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
    }

    .info-value {
        margin-top: 5px;
        color: #0f172a;
        font-size: 18px;
        font-weight: 800;
    }

    .action-buttons {
        display: flex;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 24px;
    }

    @@media (max-width: 767.98px) {

        .page-header {
            flex-direction: column;
            align-items: flex-start;
            padding: 18px;
        }

        .page-header .btn {
            width: 100%;
        }

        .page-title {
            font-size: 23px;
        }

        .form-card-body {
            padding: 17px;
        }

        .action-buttons {
            display: grid;
            grid-template-columns: 1fr;
        }

        .action-buttons .btn {
            width: 100%;
        }
    }

</style>


<!-- =========================================================
     CONTENEDOR PRINCIPAL
     ========================================================= -->
<div class="page-wrapper">

    <!-- =========================================================
         ENCABEZADO
         ========================================================= -->
    <div class="page-header">
        <div>
            <h1 class="page-title">
                <i class="bi bi-wallet2 me-2"></i> Crear Rendición de Gastos
            </h1>
            <p class="page-description">
                Confirme los datos de la solicitud antes de iniciar el registro de gastos.
            </p>
        </div>

        <a asp-controller="Rendicion" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Volver a rendiciones
        </a>
    </div>

    <!-- =========================================================
         MENSAJE DE ERROR
         ========================================================= -->
    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @Html.Raw(TempData["error"])
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <!-- =========================================================
         TARJETA PRINCIPAL
         ========================================================= -->
    <div class="form-card">

        <!-- CABECERA -->
        <div class="form-card-header">
            <i class="bi bi-check2-square me-2"></i> Confirmación de la rendición
        </div>

        <!-- CUERPO -->
        <div class="form-card-body">
            <form asp-controller="Rendicion" asp-action="Create" method="post" id="formCrearRendicion">

                <!-- CAMPOS OCULTOS -->
                <input type="hidden" asp-for="IdSolicitud" />
                <input type="hidden" asp-for="IdUsuario" />
                <input type="hidden" asp-for="Fecha" />
                <input type="hidden" asp-for="FechaInicio" />
                <input type="hidden" asp-for="FechaFin" />
                <input type="hidden" asp-for="Total" />
                <input type="hidden" asp-for="Saldo" />
                <input type="hidden" asp-for="IdEstadoRendicion" />

                <!-- INFORMACIÓN -->
                <div class="alert alert-info" role="alert">
                    <i class="bi bi-info-circle-fill me-1"></i>
                    Al confirmar, se creará la rendición y podrá comenzar a registrar sus gastos.
                </div>

                <!-- DATOS DE LA RENDICIÓN -->
                <div class="row g-3">

                    <!-- SOLICITUD -->
                    <div class="col-12 col-sm-6">
                        <div class="info-card">
                            <div class="info-label">Solicitud</div>
                            <div class="info-value">
                                @if (Model.IdSolicitud > 0)
                                {
                                    <span>#@Model.IdSolicitud</span>
                                }
                                else
                                {
                                    <span class="text-danger">
                                        <i class="bi bi-exclamation-circle-fill"></i> Solicitud no válida
                                    </span>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- SALDO INICIAL -->
                    <div class="col-12 col-sm-6">
                        <div class="info-card">
                            <div class="info-label">Saldo inicial</div>
                            <div class="info-value text-success">
                                @if (Model.Saldo >= 0)
                                {
                                    <span>S/ @Model.Saldo.ToString("N2")</span>
                                }
                                else
                                {
                                    <span class="text-danger">S/ @Model.Saldo.ToString("N2")</span>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- FECHA DE INICIO -->
                    <div class="col-12 col-sm-6">
                        <div class="info-card">
                            <div class="info-label">Fecha de inicio</div>
                            <div class="info-value">
                                @if (Model.FechaInicio != default)
                                {
                                    @Model.FechaInicio.ToString("dd/MM/yyyy")
                                }
                                else
                                {
                                    <span class="text-danger">
                                        <i class="bi bi-exclamation-circle-fill"></i> Fecha no registrada
                                    </span>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- FECHA DE FIN -->
                    <div class="col-12 col-sm-6">
                        <div class="info-card">
                            <div class="info-label">Fecha de fin</div>
                            <div class="info-value">
                                @if (Model.FechaFin != default)
                                {
                                    @Model.FechaFin.ToString("dd/MM/yyyy")
                                }
                                else
                                {
                                    <span class="text-danger">
                                        <i class="bi bi-exclamation-circle-fill"></i> Fecha no registrada
                                    </span>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- DESTINO -->
                    <div class="col-12 col-sm-6">
                        <div class="info-card">
                            <div class="info-label">Destino</div>
                            <div class="info-value">
                                @if (Model.Solicitud != null && !string.IsNullOrWhiteSpace(Model.Solicitud.Destino))
                                {
                                    @Model.Solicitud.Destino
                                }
                                else
                                {
                                    <span class="text-muted">
                                        <i class="bi bi-dash-circle"></i> Sin destino registrado
                                    </span>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- MONTO DE LA SOLICITUD -->
                    <div class="col-12 col-sm-6">
                        <div class="info-card">
                            <div class="info-label">Monto aprobado</div>
                            <div class="info-value">
                                @if (Model.Solicitud != null && Model.Solicitud.Monto >= 0)
                                {
                                    <span class="text-success">S/ @Model.Solicitud.Monto.ToString("N2")</span>
                                }
                                else
                                {
                                    <span class="text-muted">Sin monto registrado</span>
                                }
                            </div>
                        </div>
                    </div>

                </div>

                <!-- VALIDACIÓN GENERAL -->
                @if (Model.IdSolicitud <= 0 || Model.FechaInicio == default || Model.FechaFin == default)
                {
                    <div class="alert alert-warning mt-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <strong>No se puede confirmar la rendición.</strong><br />
                        Algunos datos obligatorios de la rendición están incompletos o no son válidos.
                    </div>
                }

                <!-- BOTONES -->
                <div class="action-buttons">
                    <a asp-controller="Rendicion" asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Cancelar y regresar
                    </a>

                    <button type="submit" 
                            class="btn btn-success" 
                            id="btnConfirmarRendicion"
                            @(Model.IdSolicitud <= 0 || Model.FechaInicio == default || Model.FechaFin == default ? "disabled" : null)>
                        <i class="bi bi-check-circle-fill"></i> Confirmar rendición
                    </button>
                </div>

            </form>
        </div>

    </div>

</div>

<!-- =========================================================
     SCRIPTS DE CONFIRMACIÓN
     ========================================================= -->
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const formulario = document.getElementById("formCrearRendicion");
            const boton = document.getElementById("btnConfirmarRendicion");

            if (!formulario || !boton) return;

            formulario.addEventListener("submit", function (event) {
                const confirmar = confirm(
                    "¿Está seguro de que desea crear esta rendición?\n\n" +
                    "Una vez creada podrá comenzar a registrar los gastos."
                );

                if (!confirmar) {
                    event.preventDefault();
                    return;
                }

                boton.disabled = true;
                boton.innerHTML = 
                    '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>' +
                    'Creando rendición...';
            });
        });
    </script>
}