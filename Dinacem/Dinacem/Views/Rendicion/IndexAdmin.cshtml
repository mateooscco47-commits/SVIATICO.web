@model List<Dinacem.Models.Rendicion>

@{
    ViewData["Title"] = "Liquidaciones";
    Layout = "~/Views/Shared/_LayoutAdministrador.cshtml";

    var totalLiquidaciones = Model?.Count ?? 0;
    var enProcesoLiquidaciones = Model?.Count(x => x.IdEstadoRendicion == 1) ?? 0;
    var pendientesLiquidaciones = Model?.Count(x => x.IdEstadoRendicion == 2) ?? 0;
    var aprobadasLiquidaciones = Model?.Count(x => x.IdEstadoRendicion == 3) ?? 0;
    var rechazadasLiquidaciones = Model?.Count(x => x.IdEstadoRendicion == 4) ?? 0;

    var listaReembolsos = ViewBag.Reembolsos as List<Dinacem.Models.Reembolso>
        ?? new List<Dinacem.Models.Reembolso>();

    var reembolsosPendientesLiquidaciones = listaReembolsos.Count(x => x.IdEstadoReembolso == 2);
}

<style>
:root{
    --dinacen-azul:#0c4a8a;
    --dinacen-azul-oscuro:#083763;
    --dinacen-azul-claro:#eaf3fb;
    --dinacen-verde:#6aa84f;
    --texto:#1f2937;
    --texto-secundario:#4b5563;
    --borde:#d9e1ea;
    --fondo:#f3f7fb;
    --blanco:#fff;
}

.liquidaciones-page{
    width:100%;
    max-width:1600px;
    margin:0 auto;
    padding:22px;
    background:var(--fondo);
    color:var(--texto);
    font-family:"Segoe UI",Arial,sans-serif;
}

.page-header{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:20px;
    margin-bottom:20px;
    padding:22px 24px;
    background:linear-gradient(135deg,var(--dinacen-azul),#1261a5);
    border-radius:12px;
    box-shadow:0 5px 18px rgba(12,74,138,.18);
}

.page-header-content{
    min-width:0;
}

.page-title{
    margin:0 0 6px;
    color:#fff;
    font-size:28px;
    font-weight:800;
    line-height:1.2;
}

.page-title i{
    font-size:25px;
}

.page-description{
    margin:0;
    color:rgba(255,255,255,.9);
    font-size:14px;
    font-weight:400;
    line-height:1.5;
}

.page-header-actions{
    display:flex;
    align-items:center;
    gap:10px;
    flex-shrink:0;
}

.btn-volver{
    min-height:40px;
    padding:9px 16px;
    border:1px solid rgba(255,255,255,.65);
    border-radius:7px;
    background:transparent;
    color:#fff;
    font-size:13px;
    font-weight:700;
    text-decoration:none;
    transition:all .2s ease;
}

.btn-volver:hover{
    background:#fff;
    color:var(--dinacen-azul);
    border-color:#fff;
}

.mensaje-sistema{
    display:flex;
    align-items:center;
    gap:10px;
    margin-bottom:20px;
    padding:12px 15px;
    border-radius:8px;
    font-size:13px;
    font-weight:600;
}

.mensaje-sistema .btn-close{
    margin-left:auto;
}

.mensaje-exito{
    background:#edf7e9;
    border:1px solid #c9e3bf;
    color:#397631;
}

.mensaje-error{
    background:#fef0f0;
    border:1px solid #f1c7c7;
    color:#b42323;
}

.liquidaciones-kpi{
    height:100%;
    padding:17px 19px;
    background:var(--blanco);
    border:1px solid var(--borde);
    border-radius:10px;
    box-shadow:0 3px 10px rgba(15,23,42,.05);
    transition:all .2s ease;
}

.liquidaciones-kpi:hover{
    transform:translateY(-1px);
    box-shadow:0 5px 14px rgba(15,23,42,.08);
}

.kpi-label{
    display:block;
    margin-bottom:4px;
    color:var(--texto-secundario);
    font-size:12px;
    font-weight:700;
}

.kpi-value{
    margin:0;
    color:var(--texto);
    font-size:24px;
    font-weight:800;
}

.kpi-icon{
    width:42px;
    height:42px;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:9px;
    font-size:19px;
}

.kpi-blue{
    background:var(--dinacen-azul-claro);
    color:var(--dinacen-azul);
}

.kpi-process{
    background:#eef3ff;
    color:#315fd4;
}

.kpi-warning{
    background:#fff6dc;
    color:#a97808;
}

.kpi-green{
    background:#edf7e9;
    color:#4f8d3d;
}

.kpi-red{
    background:#fef0f0;
    color:#c62828;
}

.kpi-purple{
    background:#f3eafa;
    color:#7c3aed;
}

.filtros-card{
    display:flex;
    align-items:flex-end;
    gap:14px;
    margin-bottom:18px;
    padding:16px 18px;
    background:#fff;
    border:1px solid var(--borde);
    border-radius:10px;
    box-shadow:0 3px 10px rgba(15,23,42,.05);
}

.search-box{
    position:relative;
    width:50%;
    min-width:300px;
}

.search-icon{
    position:absolute;
    top:50%;
    left:13px;
    color:#6b7280;
    pointer-events:none;
    transform:translateY(-50%);
}

.search-input{
    width:100%;
    height:40px;
    padding:0 40px 0 37px;
    border:1px solid #cbd5e1;
    border-radius:7px;
    outline:none;
    color:#111827;
    background:#fff;
    font-size:13px;
}

.search-input::placeholder{
    color:#8a94a3;
}

.search-input:focus{
    border-color:var(--dinacen-azul);
    box-shadow:0 0 0 3px rgba(12,74,138,.08);
}

.search-clear{
    position:absolute;
    top:50%;
    right:8px;
    width:25px;
    height:25px;
    display:none;
    align-items:center;
    justify-content:center;
    border:0;
    background:transparent;
    color:#6b7280;
    cursor:pointer;
    transform:translateY(-50%);
}

.search-clear:hover{
    color:#111827;
}

.date-filter{
    width:170px;
}

.date-label{
    display:block;
    margin-bottom:6px;
    color:#111827;
    font-size:12px;
    font-weight:700;
}

.date-filter input{
    width:100%;
    height:40px;
    padding:8px 10px;
    border:1px solid #cbd5e1;
    border-radius:7px;
    color:#111827;
    background:#fff;
    font-size:13px;
    outline:none;
}

.date-filter input:focus{
    border-color:var(--dinacen-azul);
    box-shadow:0 0 0 3px rgba(12,74,138,.08);
}

.btn-limpiar-filtros{
    height:40px;
    padding:0 15px;
    border:1px solid #cbd5e1;
    border-radius:7px;
    background:#fff;
    color:#4b5563;
    font-size:13px;
    font-weight:700;
    white-space:nowrap;
    cursor:pointer;
    transition:all .2s ease;
}

.btn-limpiar-filtros:hover{
    background:#f3f4f6;
    color:#111827;
}

.estado-filtros-container{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:15px;
    margin-bottom:18px;
    padding:14px 16px;
    background:#fff;
    border:1px solid var(--borde);
    border-radius:10px;
    box-shadow:0 3px 10px rgba(15,23,42,.05);
}

.filters{
    display:flex;
    flex-wrap:wrap;
    gap:7px;
}

.filtro-btn{
    border-radius:7px!important;
    font-size:12px!important;
    font-weight:700!important;
}

.filtro-btn.active{
    background:var(--dinacen-azul)!important;
    border-color:var(--dinacen-azul)!important;
    color:#fff!important;
}

.result-count{
    color:#64748b;
    font-size:12px;
    white-space:nowrap;
}

.result-count strong{
    color:#1f2937;
}

.liquidaciones-list-card{
    overflow:hidden;
    background:var(--blanco);
    border:1px solid var(--borde);
    border-radius:10px;
    box-shadow:0 3px 10px rgba(15,23,42,.05);
}

.liquidaciones-list-header{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:15px;
    padding:15px 20px;
    background:#fff;
    border-bottom:1px solid var(--borde);
}

.liquidaciones-list-title{
    margin:0;
    color:#111827;
    font-size:16px;
    font-weight:800;
}

.liquidaciones-list-title i{
    color:var(--dinacen-azul);
}

.liquidaciones-list-count{
    color:#64748b;
    font-size:12px;
    font-weight:600;
}

.table-wrapper{
    width:100%;
    overflow-x:auto;
    -webkit-overflow-scrolling:touch;
}

.tabla-liquidaciones{
    width:100%;
    min-width:1050px;
    margin:0;
    border-collapse:separate;
    border-spacing:0;
}

.tabla-liquidaciones thead th{
    padding:13px 14px;
    background:var(--dinacen-azul);
    border-bottom:2px solid var(--dinacen-azul-oscuro);
    color:#fff;
    font-size:12px;
    font-weight:800;
    text-align:left;
    white-space:nowrap;
}

.tabla-liquidaciones tbody td{
    padding:12px 14px;
    border-bottom:1px solid #e5e7eb;
    color:#1f2937;
    background:#fff;
    font-size:13px;
    font-weight:500;
    vertical-align:middle;
}

.tabla-liquidaciones tbody tr{
    transition:background .15s ease;
}

.tabla-liquidaciones tbody tr:hover td{
    background:#f7fbff;
}

.tabla-liquidaciones tbody tr:last-child td{
    border-bottom:0;
}

.id-liquidacion{
    color:var(--dinacen-azul);
    font-size:13px;
    font-weight:800;
}

.empleado-info{
    display:flex;
    align-items:center;
    gap:10px;
    min-width:190px;
}

.empleado-avatar{
    width:36px;
    height:36px;
    display:flex;
    align-items:center;
    justify-content:center;
    flex-shrink:0;
    border-radius:50%;
    background:var(--dinacen-azul-claro);
    color:var(--dinacen-azul);
    font-size:16px;
}

.empleado-nombre{
    color:#111827;
    font-size:13px;
    font-weight:700;
    line-height:1.3;
}

.empleado-correo{
    margin-top:2px;
    color:#64748b;
    font-size:11px;
    font-weight:500;
}

.destino{
    color:#1f2937;
    font-weight:600;
}

.fecha{
    color:#374151;
    font-size:12px;
    font-weight:600;
    white-space:nowrap;
}

.fecha-hasta{
    display:block;
    margin-top:3px;
    color:#64748b;
    font-size:11px;
    font-weight:500;
}

.monto{
    color:var(--dinacen-azul);
    font-weight:800;
    white-space:nowrap;
}

.saldo{
    color:#374151;
    font-weight:700;
    white-space:nowrap;
}

.estado{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:5px;
    min-width:82px;
    padding:5px 9px;
    border-radius:20px;
    font-size:11px;
    font-weight:800;
    white-space:nowrap;
}

.estado-proceso{
    background:#eaf3fb;
    color:#1557a5;
}

.estado-pendiente{
    background:#fff6dc;
    color:#a97808;
}

.estado-aprobada{
    background:#e8f5e9;
    color:#2e7d32;
}

.estado-rechazada{
    background:#ffebee;
    color:#c62828;
}

.estado-reembolso{
    background:#f3eafa;
    color:#7c3aed;
}

.estado-pagado{
    background:#e8f7f2;
    color:#08745a;
}

.estado-sin{
    background:#f3f6f9;
    color:#64748b;
}

.acciones{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:6px;
    flex-wrap:wrap;
}

.btn-accion{
    min-height:34px;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:5px;
    padding:6px 10px;
    border:1px solid;
    border-radius:6px;
    background:#fff;
    font-size:11px;
    font-weight:800;
    line-height:1;
    text-decoration:none;
    white-space:nowrap;
    cursor:pointer;
    transition:all .2s ease;
}

.btn-accion i{
    font-size:12px;
}

.btn-accion:hover{
    transform:translateY(-1px);
}

.btn-revisar{
    border-color:#f3b5b5;
    background:#fffaf0;
    color:#a97808;
}

.btn-revisar:hover{
    border-color:#e4c66c;
    background:#fff5d6;
    color:#8e6505;
}

.btn-reembolso{
    border-color:#b8d3ef;
    background:#f5f9ff;
    color:#1557a5;
}

.btn-reembolso:hover{
    border-color:#8eb8e4;
    background:#e7f0ff;
    color:#0c4a8a;
}

.btn-detalle{
    border-color:#cbd5e1;
    background:#fff;
    color:#4b5563;
}

.btn-detalle:hover{
    border-color:#94a3b8;
    background:#f3f4f6;
    color:#111827;
}

.btn-pdf{
    border-color:#f3b5b5;
    background:#fff7f7;
    color:#c62828;
}

.btn-pdf:hover{
    border-color:#e57373;
    background:#ffebee;
    color:#a91f1f;
}

.sin-registros{
    padding:55px 20px!important;
    color:#6b7280!important;
    text-align:center;
}

.sin-registros i{
    display:block;
    margin-bottom:10px;
    color:#9ca3af;
    font-size:38px;
}

.sin-registros strong{
    display:block;
    margin-bottom:4px;
    color:#4b5563;
    font-size:14px;
}

.sin-registros span{
    color:#6b7280;
    font-size:12px;
}

@@media(max-width:992px){
    .liquidaciones-page{
        padding:18px;
    }

    .page-header{
        align-items:flex-start;
    }

    .page-title{
        font-size:24px;
    }

    .page-header-actions{
        width:auto;
    }

    .btn-volver{
        width:100%;
    }

    .filtros-card{
        flex-wrap:wrap;
    }

    .search-box{
        width:100%;
        min-width:100%;
    }

    .date-filter{
        flex:1;
        min-width:160px;
    }

    .estado-filtros-container{
        align-items:flex-start;
        flex-direction:column;
    }

    .result-count{
        width:100%;
    }
}

@@media(max-width:768px){
    .liquidaciones-page{
        padding:14px;
    }

    .page-header{
        flex-direction:column;
        padding:18px;
        border-radius:10px;
    }

    .page-title{
        font-size:22px;
    }

    .page-title i{
        font-size:20px;
    }

    .page-description{
        font-size:13px;
    }

    .page-header-actions{
        width:100%;
    }

    .btn-volver{
        width:100%;
    }

    .liquidaciones-kpi{
        padding:15px;
    }

    .filtros-card{
        flex-direction:column;
        align-items:stretch;
        padding:14px;
    }

    .search-box,
    .date-filter,
    .btn-limpiar-filtros{
        width:100%;
        min-width:100%;
    }

    .filters{
        width:100%;
    }

    .filters .btn{
        flex:1 1 calc(50% - 7px);
    }

    .liquidaciones-list-header{
        align-items:stretch;
        flex-direction:column;
        padding:14px 16px;
    }

    .liquidaciones-list-count{
        display:none;
    }

    .acciones{
        flex-direction:column;
        align-items:stretch;
    }

    .btn-accion{
        width:100%;
    }
}

@@media(max-width:576px){
    .liquidaciones-page{
        padding:10px;
    }

    .page-title{
        font-size:20px;
    }

    .page-description{
        font-size:12px;
    }

    .kpi-value{
        font-size:21px;
    }

    .filters .btn{
        flex:1 1 100%;
    }

    .liquidaciones-list-header{
        padding:13px 14px;
    }

    .tabla-liquidaciones{
        min-width:1000px;
    }
}
</style>

<div class="liquidaciones-page">

    <div class="page-header">
        <div class="page-header-content">
            <h1 class="page-title">
                <i class="bi bi-receipt-cutoff me-2"></i>
                Liquidaciones
            </h1>

            <p class="page-description">
                Consulte, revise y gestione las rendiciones registradas por los empleados.
            </p>
        </div>

        <div class="page-header-actions">
            <a asp-controller="Principal"
               asp-action="Index"
               class="btn-volver">
                <i class="bi bi-arrow-left me-1"></i>
                Volver al panel
            </a>
        </div>
    </div>


    <div class="row g-3 mb-4">

        <div class="col-6 col-xl-2">
            <div class="liquidaciones-kpi">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="kpi-label">Total</span>
                        <h3 class="kpi-value">@totalLiquidaciones</h3>
                    </div>

                    <div class="kpi-icon kpi-blue">
                        <i class="bi bi-receipt"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-2">
            <div class="liquidaciones-kpi">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="kpi-label">En proceso</span>
                        <h3 class="kpi-value">@enProcesoLiquidaciones</h3>
                    </div>

                    <div class="kpi-icon kpi-process">
                        <i class="bi bi-pencil-square"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-2">
            <div class="liquidaciones-kpi">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="kpi-label">Pendientes</span>
                        <h3 class="kpi-value">@pendientesLiquidaciones</h3>
                    </div>

                    <div class="kpi-icon kpi-warning">
                        <i class="bi bi-clock"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-2">
            <div class="liquidaciones-kpi">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="kpi-label">Aprobadas</span>
                        <h3 class="kpi-value">@aprobadasLiquidaciones</h3>
                    </div>

                    <div class="kpi-icon kpi-green">
                        <i class="bi bi-person-check"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-2">
            <div class="liquidaciones-kpi">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="kpi-label">Rechazadas</span>
                        <h3 class="kpi-value">@rechazadasLiquidaciones</h3>
                    </div>

                    <div class="kpi-icon kpi-red">
                        <i class="bi bi-person-x"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-2">
            <div class="liquidaciones-kpi">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="kpi-label">Reembolso pendiente</span>
                        <h3 class="kpi-value">@reembolsosPendientesLiquidaciones</h3>
                    </div>

                    <div class="kpi-icon kpi-purple">
                        <i class="bi bi-cash-coin"></i>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="filtros-card">

        <div class="search-box">
            <i class="bi bi-search search-icon"></i>

            <input type="search"
                   id="buscarLiquidacion"
                   class="search-input"
                   placeholder="Buscar empleado, correo, destino o número..."
                   autocomplete="off" />

            <button type="button"
                    id="limpiarBusquedaLiquidacion"
                    class="search-clear"
                    aria-label="Limpiar búsqueda">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <div class="date-filter">
            <label for="fechaDesdeRendicion" class="date-label">
                Desde
            </label>

            <input type="date"
                   id="fechaDesdeRendicion" />
        </div>

        <div class="date-filter">
            <label for="fechaHastaRendicion" class="date-label">
                Hasta
            </label>

            <input type="date"
                   id="fechaHastaRendicion" />
        </div>

        <button type="button"
                id="limpiarFiltrosRendicion"
                class="btn-limpiar-filtros">
            <i class="bi bi-arrow-counterclockwise me-1"></i>
            Limpiar
        </button>

    </div>

    <div class="estado-filtros-container">

        <div class="filters">

            <button type="button"
                    class="btn btn-outline-secondary btn-sm filtro-btn active"
                    data-estado="todos">
                Todos
            </button>

            <button type="button"
                    class="btn btn-outline-primary btn-sm filtro-btn"
                    data-estado="1">
                En proceso
            </button>

            <button type="button"
                    class="btn btn-outline-warning btn-sm filtro-btn"
                    data-estado="2">
                Pendientes
            </button>

            <button type="button"
                    class="btn btn-outline-success btn-sm filtro-btn"
                    data-estado="3">
                Aprobadas
            </button>

            <button type="button"
                    class="btn btn-outline-danger btn-sm filtro-btn"
                    data-estado="4">
                Rechazadas
            </button>

            <button type="button"
                    class="btn btn-outline-secondary btn-sm filtro-btn"
                    data-estado="reembolso">
                Reembolso pendiente
            </button>

        </div>

        <div class="result-count">
            Mostrando
            <strong id="cantidadVisible">@totalLiquidaciones</strong>
            de
            <strong>@totalLiquidaciones</strong>
            liquidación(es)
        </div>

    </div>

    <div class="liquidaciones-list-card">

        <div class="liquidaciones-list-header">

            <h2 class="liquidaciones-list-title">
                <i class="bi bi-list-ul me-2"></i>
                Lista de liquidaciones
            </h2>

            <span class="liquidaciones-list-count">
                @totalLiquidaciones registro(s)
            </span>

        </div>

        <div class="table-wrapper">

            <table id="tablaLiquidaciones"
                   class="tabla-liquidaciones">

                <thead>
                    <tr>
                        <th>#</th>
                        <th>Empleado</th>
                        <th>Destino</th>
                        <th>Periodo</th>
                        <th>Total</th>
                        <th>Saldo</th>
                        <th>Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            var nombreCompletoLiquidacion =
                                $"{item.Usuario?.Nombres} {item.Usuario?.Apellidos}".Trim();

                            var correoLiquidacion =
                                item.Usuario?.Correo ?? string.Empty;

                            var destinoLiquidacion =
                                item.Solicitud?.Destino ?? string.Empty;

                            var reembolsoLiquidacion =
                                listaReembolsos.FirstOrDefault(x =>
                                    x.IdRendicion == item.IdRendicion);

                            var tieneReembolsoPendienteLiquidacion =
                                reembolsoLiquidacion != null &&
                                reembolsoLiquidacion.IdEstadoReembolso == 2;

                            var reembolsoPagadoLiquidacion =
                                reembolsoLiquidacion != null &&
                                reembolsoLiquidacion.IdEstadoReembolso == 3;

                            var textoBusquedaLiquidacion =
                                $"{item.IdRendicion} " +
                                $"{item.IdSolicitud} " +
                                $"{nombreCompletoLiquidacion} " +
                                $"{correoLiquidacion} " +
                                $"{destinoLiquidacion} " +
                                $"{(tieneReembolsoPendienteLiquidacion ? "reembolso pendiente" : "")}";

                            <tr data-estado="@item.IdEstadoRendicion"
                                data-reembolso="@(tieneReembolsoPendienteLiquidacion ? "true" : "false")"
                                data-fecha="@item.Fecha.ToString("yyyy-MM-dd")"
                                data-busqueda="@textoBusquedaLiquidacion">

                                <td>
                                    <span class="id-liquidacion">
                                        #@item.IdRendicion
                                    </span>
                                </td>

                                <td>
                                    <div class="empleado-info">

                                        <div class="empleado-avatar">
                                            <i class="bi bi-person"></i>
                                        </div>

                                        <div>
                                            <div class="empleado-nombre">
                                                @(string.IsNullOrWhiteSpace(nombreCompletoLiquidacion)
                                                    ? "Sin empleado"
                                                    : nombreCompletoLiquidacion)
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(correoLiquidacion))
                                            {
                                                <div class="empleado-correo">
                                                    @correoLiquidacion
                                                </div>
                                            }
                                        </div>

                                    </div>
                                </td>

                                <td>
                                    <span class="destino">
                                        @(string.IsNullOrWhiteSpace(destinoLiquidacion)
                                            ? "-"
                                            : destinoLiquidacion)
                                    </span>
                                </td>

                                <td>
                                    <span class="fecha">
                                        @item.FechaInicio.ToString("dd/MM/yyyy")
                                    </span>

                                    <span class="fecha-hasta">
                                        hasta @item.FechaFin.ToString("dd/MM/yyyy")
                                    </span>
                                </td>

                                <td>
                                    <span class="monto">
                                        S/ @item.Total.ToString("N2")
                                    </span>
                                </td>

                                <td>
                                    <span class="saldo">
                                        S/ @item.Saldo.ToString("N2")
                                    </span>
                                </td>

                                <td>

                                    @switch (item.IdEstadoRendicion)
                                    {
                                        case 1:
                                            <span class="estado estado-proceso">
                                                <i class="bi bi-pencil-square"></i>
                                                En proceso
                                            </span>
                                            break;

                                        case 2:
                                            <span class="estado estado-pendiente">
                                                <i class="bi bi-clock-fill"></i>
                                                Pendiente
                                            </span>
                                            break;

                                        case 3:

                                            if (tieneReembolsoPendienteLiquidacion)
                                            {
                                                <span class="estado estado-reembolso">
                                                    <i class="bi bi-cash-coin"></i>
                                                    Reembolso pendiente
                                                </span>
                                            }
                                            else if (reembolsoPagadoLiquidacion)
                                            {
                                                <span class="estado estado-pagado">
                                                    <i class="bi bi-check-circle-fill"></i>
                                                    Reembolso pagado
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="estado estado-aprobada">
                                                    <i class="bi bi-check-circle-fill"></i>
                                                    Aprobada
                                                </span>
                                            }

                                            break;

                                        case 4:
                                            <span class="estado estado-rechazada">
                                                <i class="bi bi-x-circle-fill"></i>
                                                Rechazada
                                            </span>
                                            break;

                                        default:
                                            <span class="estado estado-sin">
                                                <i class="bi bi-question-circle"></i>
                                                Sin estado
                                            </span>
                                            break;
                                    }

                                </td>

                                <td>

                                    <div class="acciones">

                                        @if (item.IdEstadoRendicion == 1)
                                        {
                                            <span class="text-muted small">
                                                <i class="bi bi-hourglass-split"></i>
                                                En elaboración
                                            </span>
                                        }
                                        else if (item.IdEstadoRendicion == 2)
                                        {
                                            <a asp-controller="Rendicion"
                                               asp-action="DetalleAdmin"
                                               asp-route-id="@item.IdRendicion"
                                               class="btn-accion btn-revisar">
                                                <i class="bi bi-search"></i>
                                                <span>Revisar</span>
                                            </a>
                                        }
                                        else if (tieneReembolsoPendienteLiquidacion)
                                        {
                                            <a asp-controller="Rendicion"
                                               asp-action="DetalleAdmin"
                                               asp-route-id="@item.IdRendicion"
                                               class="btn-accion btn-reembolso">
                                                <i class="bi bi-cash-coin"></i>
                                                <span>Registrar reembolso</span>
                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-controller="Rendicion"
                                               asp-action="DetalleAdmin"
                                               asp-route-id="@item.IdRendicion"
                                               class="btn-accion btn-detalle">
                                                <i class="bi bi-eye"></i>
                                                <span>Ver detalle</span>
                                            </a>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(item.ArchivoPdf))
                                        {
                                            <a href="@item.ArchivoPdf"
                                               target="_blank"
                                               rel="noopener"
                                               class="btn-accion btn-pdf">
                                                <i class="bi bi-file-earmark-pdf"></i>
                                                <span>PDF</span>
                                            </a>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr id="filaSinRegistros">
                            <td colspan="8" class="sin-registros">

                                <i class="bi bi-inbox"></i>

                                <strong>
                                    No hay liquidaciones registradas
                                </strong>

                                <span>
                                    Las rendiciones registradas aparecerán aquí.
                                </span>

                            </td>
                        </tr>
                    }

                    <tr id="filaSinResultados" style="display:none;">
                        <td colspan="8" class="sin-registros">

                            <i class="bi bi-search"></i>

                            <strong>
                                No se encontraron resultados
                            </strong>

                            <span>
                                Pruebe modificando los criterios de búsqueda o filtros.
                            </span>

                        </td>
                    </tr>

                </tbody>

            </table>

        </div>

    </div>

</div>

@section Scripts {
    <script src="~/js/IndexLiquidacion.js"
            asp-append-version="true"></script>
}
