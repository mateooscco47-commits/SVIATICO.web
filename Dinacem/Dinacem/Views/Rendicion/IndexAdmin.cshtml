@model List<Dinacem.Models.Rendicion>

@{
    ViewData["Title"] = "Liquidaciones";
    Layout = "~/Views/Shared/_LayoutAdministrador.cshtml";

    var totalLiquidaciones = Model?.Count ?? 0;
    var enProceso = Model?.Count(x => x.IdEstadoRendicion == 1) ?? 0;
    var pendientes = Model?.Count(x => x.IdEstadoRendicion == 2) ?? 0;
    var aprobadas = Model?.Count(x => x.IdEstadoRendicion == 3) ?? 0;
    var rechazadas = Model?.Count(x => x.IdEstadoRendicion == 4) ?? 0;

    var reembolsos =
        ViewBag.Reembolsos as List<Dinacem.Models.Reembolso>
        ?? new List<Dinacem.Models.Reembolso>();

    var reembolsosPendientes =
        reembolsos.Count(x => x.IdEstadoReembolso == 2);

    var reembolsosPagados =
        reembolsos.Count(x => x.IdEstadoReembolso == 3);
}

<style>
    /* ============================================================
       CONTENEDOR PRINCIPAL
       ============================================================ */

    .page-wrapper {
        width: 100%;
        max-width: 1600px;
        margin: 0 auto;
        padding: 0;
    }


    /* ============================================================
           ENCABEZADO
           ============================================================ */

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        padding: 22px;
        margin-bottom: 24px;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        box-shadow: 0 5px 18px rgba(15, 23, 42, .05);
    }

    .page-title {
        margin: 0 0 5px;
        color: #17365d;
        font-size: 28px;
        font-weight: 800;
        letter-spacing: -0.3px;
    }

        .page-title i {
            color: #0c4a8a;
            font-size: 1.55rem;
        }

    .page-description {
        margin: 0;
        color: #64748b;
        font-size: 14px;
        font-weight: 500;
    }


    /* ============================================================
           BOTÓN VOLVER
           ============================================================ */

    .page-header-actions {
        display: flex;
        align-items: center;
    }

        .page-header-actions .btn {
            padding: 8px 15px;
            border-radius: 8px;
            font-weight: 600;
            transition: all .2s ease;
        }

            .page-header-actions .btn:hover {
                transform: translateY(-1px);
            }

    /* ============================================================
       TARJETAS RESUMEN
       ============================================================ */

    .summary-card {
        height: 100%;
        padding: 17px 18px;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 13px;
        box-shadow: 0 4px 12px rgba(15, 23, 42, .04);
        transition: transform .2s ease, box-shadow .2s ease;
    }

    .summary-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 7px 18px rgba(15, 23, 42, .07);
    }

    .summary-label {
        color: #64748b;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .3px;
    }

    .summary-value, .summary-number {
        margin-top: 4px;
        color: #0f172a;
        font-size: 26px;
        font-weight: 800;
    }


    /* ============================================================
       PANEL
       ============================================================ */

    .panel, .panel-card {
        background: #ffffff;
        border: 1px solid #dbe1ea;
        border-radius: 15px;
        box-shadow: 0 5px 18px rgba(15, 23, 42, .05);
        overflow: hidden;
    }

    .panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding: 18px 20px;
        border-bottom: 1px solid #e2e8f0;
    }

    .panel-title {
        margin: 0;
        color: #0f172a;
        font-size: 18px;
        font-weight: 800;
    }

    .panel-body {
        padding: 20px;
    }


    /* ============================================================
       BUSCADOR Y FILTROS EN LÍNEA
       ============================================================ */

    .liquidaciones-search, .solicitudes-search {
        width: 100%;
        display: flex;
        align-items: flex-end;
        gap: 14px;
        margin-bottom: 22px;
        padding: 16px 18px;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(15, 23, 42, .05);
    }

    .search-box {
        position: relative;
        width: 50%;
        min-width: 300px;
    }

    .search-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #64748b;
        font-size: 1rem;
        pointer-events: none;
    }

    .search-input {
        width: 100%;
        height: 42px;
        padding: 8px 42px 8px 40px;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        background: #ffffff;
        color: #1e293b;
        font-size: .92rem;
        outline: none;
        transition: border-color .2s ease, box-shadow .2s ease;
    }

    .search-input::placeholder {
        color: #94a3b8;
    }

    .search-input:focus {
        border-color: #0c4a8a;
        box-shadow: 0 0 0 3px rgba(12, 74, 138, .10);
    }

    .search-clear {
        position: absolute;
        right: 8px;
        top: 50%;
        transform: translateY(-50%);
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: none;
        border-radius: 6px;
        background: transparent;
        color: #94a3b8;
        cursor: pointer;
        transition: background .2s ease, color .2s ease;
    }

    .search-clear:hover {
        background: #f1f5f9;
        color: #dc2626;
    }

    .date-filter {
        width: 170px;
    }

    .date-label {
        display: block;
        margin-bottom: 6px;
        color: #475569;
        font-size: .78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .3px;
    }

    .date-filter .form-control, .date-filter input {
        height: 42px;
        width: 100%;
        padding: 8px 10px;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        color: #334155;
        font-size: .88rem;
        outline: none;
        transition: border-color .2s ease, box-shadow .2s ease;
    }

    .date-filter .form-control:focus, .date-filter input:focus {
        border-color: #0c4a8a;
        box-shadow: 0 0 0 3px rgba(12, 74, 138, .10);
    }

    .btn-limpiar-filtros, #limpiarFiltros {
        height: 42px;
        padding: 0 15px;
        border-radius: 8px;
        font-size: .86rem;
        font-weight: 600;
        white-space: nowrap;
        transition: background .2s ease, transform .2s ease;
    }

    .btn-limpiar-filtros:hover, #limpiarFiltros:hover {
        transform: translateY(-1px);
    }


    /* ============================================================
       PESTAÑAS DE FILTRO POR ESTADO (PILLS)
       ============================================================ */

    .estado-filtros-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-bottom: 18px;
    }

    .filters {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .filtro-btn.active {
        color: #fff;
        background: #0c4a8a;
        border-color: #0c4a8a;
    }

    .result-count {
        color: #64748b;
        font-size: 13px;
        white-space: nowrap;
    }

    .result-count strong {
        color: #334155;
    }


    /* ============================================================
       TABLA
       ============================================================ */

    .table {
        min-width: 1100px;
        font-size: 14px;
    }

    .table thead th, .table th {
        color: #64748b;
        background: #f8fafc;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        white-space: nowrap;
        vertical-align: middle;
    }

    .table td {
        vertical-align: middle;
    }


    /* ============================================================
       ESTADOS
       ============================================================ */

    .estado {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 7px 11px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .estado-proceso {
        color: #1d4ed8;
        background: #dbeafe;
        border: 1px solid #93c5fd;
    }

    .estado-pendiente {
        color: #92400e;
        background: #fef3c7;
        border: 1px solid #fcd34d;
    }

    .estado-aprobada, .estado-aprobado {
        color: #166534;
        background: #dcfce7;
        border: 1px solid #86efac;
    }

    .estado-rechazada, .estado-rechazado {
        color: #991b1b;
        background: #fee2e2;
        border: 1px solid #fca5a5;
    }

    .estado-reembolso {
        color: #6b21a8;
        background: #f3e8ff;
        border: 1px solid #d8b4fe;
    }

    .estado-pagado {
        color: #065f46;
        background: #d1fae5;
        border: 1px solid #6ee7b7;
    }


    /* ============================================================
       ACCIONES
       ============================================================ */

    .acciones {
        display: flex;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: 6px;
    }

    .acciones .btn {
        border-radius: 7px;
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
    }


    /* ============================================================
       RESPONSIVE
       ============================================================ */

    @@media screen and (max-width: 991.98px) {
        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .page-header-actions, .page-header .btn {
            width: 100%;
        }

        .panel-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .liquidaciones-search, .solicitudes-search {
            flex-wrap: wrap;
        }

        .search-box {
            width: 100%;
            min-width: 100%;
        }

        .date-filter {
            flex: 1;
            min-width: 160px;
        }
    }

    @@media screen and (max-width: 767.98px) {
        .page-wrapper {
            padding: 0 12px;
        }

        .page-header {
            padding: 18px;
            border-radius: 13px;
        }

        .page-title {
            font-size: 23px;
        }

        .summary-value, .summary-number {
            font-size: 23px;
        }

        .panel-body {
            padding: 14px;
        }

        .liquidaciones-search, .solicitudes-search {
            flex-direction: column;
            align-items: stretch;
            gap: 12px;
            padding: 14px;
        }

        .search-box, .date-filter, .btn-limpiar-filtros, #limpiarFiltros {
            width: 100%;
            min-width: 100%;
        }

        .estado-filtros-container {
            flex-direction: column;
            align-items: stretch;
        }

        .filters .btn {
            flex: 1 1 calc(50% - 8px);
        }

        .acciones {
            justify-content: flex-start;
        }
    }

    @@media screen and (max-width: 480px) {
        .page-title {
            font-size: 20px;
        }

        .page-description {
            font-size: 13px;
        }

        .page-header {
            padding: 15px;
        }

        .panel-body {
            padding: 10px;
        }

        .filters .btn {
            flex: 1 1 100%;
        }
    }
</style>

<div class="page-wrapper">

    <!-- =========================================================
         CABECERA
         ========================================================= -->

    <div class="page-header">

        <div>

            <h1 class="page-title">
                <i class="bi bi-receipt-cutoff me-2"></i>
                Liquidaciones
            </h1>

            <p class="page-description">
                Consulte todas las rendiciones, filtre por estado y busque por empleado, correo, destino o número.
            </p>

        </div>

        <div class="page-header-actions">

            <a asp-controller="Principal"
               asp-action="Index"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left me-1"></i>
                Volver al panel

            </a>

        </div>

    </div>


    <!-- =========================================================
         MENSAJES
         ========================================================= -->

    @if (TempData["mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            @TempData["mensaje"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>

        </div>
    }

    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            @Html.Raw(TempData["error"])

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>

        </div>
    }


    <!-- =========================================================
         TARJETAS RESUMEN
         ========================================================= -->

    <div class="row g-3 mb-4">

        <div class="col-12 col-sm-6 col-xl-2">

            <div class="summary-card">

                <div class="summary-label">
                    Total
                </div>

                <div class="summary-number">
                    @totalLiquidaciones
                </div>

            </div>

        </div>


        <div class="col-12 col-sm-6 col-xl-2">

            <div class="summary-card">

                <div class="summary-label text-primary">
                    En proceso
                </div>

                <div class="summary-number">
                    @enProceso
                </div>

            </div>

        </div>


        <div class="col-12 col-sm-6 col-xl-2">

            <div class="summary-card">

                <div class="summary-label text-warning">
                    Pendientes
                </div>

                <div class="summary-number">
                    @pendientes
                </div>

            </div>

        </div>


        <div class="col-12 col-sm-6 col-xl-2">

            <div class="summary-card">

                <div class="summary-label text-success">
                    Aprobadas
                </div>

                <div class="summary-number">
                    @aprobadas
                </div>

            </div>

        </div>


        <div class="col-12 col-sm-6 col-xl-2">

            <div class="summary-card">

                <div class="summary-label text-danger">
                    Rechazadas
                </div>

                <div class="summary-number">
                    @rechazadas
                </div>

            </div>

        </div>


        <div class="col-12 col-sm-6 col-xl-2">

            <div class="summary-card">

                <div class="summary-label"
                     style="color:#7c3aed;">

                    Reembolsos pendientes

                </div>

                <div class="summary-number">
                    @reembolsosPendientes
                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         BUSCADOR Y FILTROS
         ========================================================= -->

    <div class="solicitudes-search">

        <!-- BUSCADOR -->

        <div class="search-box">

            <i class="bi bi-search search-icon"></i>

            <input type="search"
                   id="buscarLiquidacion"
                   class="search-input"
                   placeholder="Buscar liquidaciones..."
                   autocomplete="off" />

            <button type="button"
                    id="limpiarBusquedaLiquidacion"
                    class="search-clear"
                    aria-label="Limpiar búsqueda">

                <i class="bi bi-x-lg"></i>

            </button>

        </div>


        <!-- FECHA DESDE -->

        <div class="date-filter">

            <label for="fechaDesdeRendicion"
                   class="date-label">

                <i class="bi bi-calendar3 me-1"></i>
                Desde

            </label>

            <input type="date"
                   id="fechaDesdeRendicion"
                   class="form-control" />

        </div>


        <!-- FECHA HASTA -->

        <div class="date-filter">

            <label for="fechaHastaRendicion"
                   class="date-label">

                <i class="bi bi-calendar3 me-1"></i>
                Hasta

            </label>

            <input type="date"
                   id="fechaHastaRendicion"
                   class="form-control" />

        </div>


        <!-- LIMPIAR -->

        <button type="button"
                id="limpiarFiltrosRendicion"
                class="btn btn-outline-secondary btn-limpiar-filtros">

            <i class="bi bi-arrow-counterclockwise me-1"></i>

            Limpiar

        </button>

    </div>


    <!-- =========================================================
         FILTROS DE ESTADO
         ========================================================= -->

    <div class="panel mb-4">

        <div class="panel-body">

            <div class="estado-filtros-container mb-0">

                <div class="filters">

                    <button type="button"
                            class="btn btn-outline-secondary btn-sm filtro-btn active"
                            data-estado="todos">

                        Todos

                    </button>


                    <button type="button"
                            class="btn btn-outline-primary btn-sm filtro-btn"
                            data-estado="1">

                        En proceso

                    </button>


                    <button type="button"
                            class="btn btn-outline-warning btn-sm filtro-btn"
                            data-estado="2">

                        Pendientes

                    </button>


                    <button type="button"
                            class="btn btn-outline-success btn-sm filtro-btn"
                            data-estado="3">

                        Aprobadas

                    </button>


                    <button type="button"
                            class="btn btn-outline-danger btn-sm filtro-btn"
                            data-estado="4">

                        Rechazadas

                    </button>


                    <button type="button"
                            class="btn btn-outline-secondary btn-sm filtro-btn"
                            data-estado="reembolso">

                        Reembolso pendiente

                    </button>

                </div>


                <div class="result-count">

                    Mostrando

                    <strong id="cantidadVisible">
                        @totalLiquidaciones
                    </strong>

                    de

                    <strong>
                        @totalLiquidaciones
                    </strong>

                    liquidación(es)

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         TABLA
         ========================================================= -->

    <div class="panel">

        


        <!-- CUERPO -->

        <div class="panel-body p-0">

            <div class="table-responsive">

                <table id="tablaLiquidaciones"
                       class="table table-hover table-bordered align-middle mb-0">

                    <!-- =================================================
                         CABECERA TABLA
                         ================================================= -->

                    <thead>

                        <tr>

                            <th>#</th>

                            <th>Empleado</th>

                            <th>Solicitud</th>

                            <th>Destino</th>

                            <th>Periodo</th>

                            <th>Fecha de creación</th>

                            <th>Total</th>

                            <th>Saldo</th>

                            <th>Estado</th>

                            <th class="text-end">
                                Acciones
                            </th>

                        </tr>

                    </thead>


                    <!-- =================================================
                         CUERPO TABLA
                         ================================================= -->

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                var nombreCompleto =
                                    $"{item.Usuario?.Nombres} {item.Usuario?.Apellidos}".Trim();

                                var correo =
                                    item.Usuario?.Correo ?? string.Empty;

                                var destino =
                                    item.Solicitud?.Destino ?? string.Empty;

                                var reembolso =
                                    reembolsos.FirstOrDefault(r =>
                                        r.IdRendicion == item.IdRendicion);

                                var tieneReembolsoPendiente =
                                    reembolso != null &&
                                    reembolso.IdEstadoReembolso == 2;

                                var reembolsoPagado =
                                    reembolso != null &&
                                    reembolso.IdEstadoReembolso == 3;

                                var textoBusqueda =
                                    $"{item.IdRendicion} " +
                                    $"{item.IdSolicitud} " +
                                    $"{nombreCompleto} " +
                                    $"{correo} " +
                                    $"{destino} " +
                                    $"{(tieneReembolsoPendiente ? "reembolso pendiente" : "")}";

                                <tr data-estado="@item.IdEstadoRendicion"
                                    data-reembolso="@(tieneReembolsoPendiente ? "true" : "false")"
                                    data-fecha="@item.Fecha.ToString("yyyy-MM-dd")"
                                    data-busqueda="@textoBusqueda">

                                    <!-- =================================
                                         ID
                                         ================================= -->

                                    <td>

                                        <strong>
                                            #@item.IdRendicion
                                        </strong>

                                    </td>


                                    <!-- =================================
                                         EMPLEADO
                                         ================================= -->

                                    <td>

                                        <strong>
                                            @(string.IsNullOrWhiteSpace(nombreCompleto)
                                                ? "Sin empleado"
                                                : nombreCompleto)
                                        </strong>

                                        @if (!string.IsNullOrWhiteSpace(correo))
                                        {
                                            <br />

                                            <small class="text-muted">
                                                @correo
                                            </small>
                                        }

                                    </td>


                                    <!-- =================================
                                         SOLICITUD
                                         ================================= -->

                                    <td>
                                        #@item.IdSolicitud
                                    </td>


                                    <!-- =================================
                                         DESTINO
                                         ================================= -->

                                    <td>

                                        @(string.IsNullOrWhiteSpace(destino)
                                            ? "-"
                                            : destino)

                                    </td>


                                    <!-- =================================
                                         PERIODO
                                         ================================= -->

                                    <td>

                                        @item.FechaInicio.ToString("dd/MM/yyyy")

                                        <br />

                                        <small class="text-muted">
                                            hasta @item.FechaFin.ToString("dd/MM/yyyy")
                                        </small>

                                    </td>


                                    <!-- =================================
                                         FECHA
                                         ================================= -->

                                    <td>

                                        @item.Fecha.ToString("dd/MM/yyyy")

                                    </td>


                                    <!-- =================================
                                         TOTAL
                                         ================================= -->

                                    <td>

                                        <strong>
                                            S/ @item.Total.ToString("N2")
                                        </strong>

                                    </td>


                                    <!-- =================================
                                         SALDO
                                         ================================= -->

                                    <td>

                                        S/ @item.Saldo.ToString("N2")

                                    </td>


                                    <!-- =================================
                                         ESTADO
                                         ================================= -->

                                    <td>

                                        @switch (item.IdEstadoRendicion)
                                        {
                                            case 1:

                                                <span class="estado estado-proceso">

                                                    <i class="bi bi-pencil-square"></i>

                                                    En proceso

                                                </span>

                                                break;


                                            case 2:

                                                <span class="estado estado-pendiente">

                                                    <i class="bi bi-clock-fill"></i>

                                                    Pendiente de revisión

                                                </span>

                                                break;


                                            case 3:

                                                @if (tieneReembolsoPendiente)
                                                {
                                                    <span class="estado estado-reembolso">

                                                        <i class="bi bi-cash-coin"></i>

                                                        Aprobada - reembolso pendiente

                                                    </span>
                                                }
                                                else if (reembolsoPagado)
                                                {
                                                    <span class="estado estado-pagado">

                                                        <i class="bi bi-check-circle-fill"></i>

                                                        Aprobada - reembolso pagado

                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="estado estado-aprobada">

                                                        <i class="bi bi-check-circle-fill"></i>

                                                        Aprobada

                                                    </span>
                                                }

                                                break;


                                            case 4:

                                                <span class="estado estado-rechazada">

                                                    <i class="bi bi-x-circle-fill"></i>

                                                    Rechazada

                                                </span>

                                                break;


                                            default:

                                                <span class="estado bg-secondary text-white">

                                                    Sin estado

                                                </span>

                                                break;
                                        }

                                    </td>


                                    <!-- =================================
                                         ACCIONES
                                         ================================= -->

                                    <td>

                                        <div class="acciones">

                                            @if (item.IdEstadoRendicion == 1)
                                            {
                                                <span class="text-muted small">

                                                    <i class="bi bi-hourglass-split"></i>

                                                    En elaboración

                                                </span>
                                            }
                                            else if (item.IdEstadoRendicion == 2)
                                            {
                                                <a asp-controller="Rendicion"
                                                   asp-action="DetalleAdmin"
                                                   asp-route-id="@item.IdRendicion"
                                                   class="btn btn-warning btn-sm">

                                                    <i class="bi bi-search"></i>

                                                    Revisar

                                                </a>
                                            }
                                            else if (tieneReembolsoPendiente)
                                            {
                                                <a asp-controller="Rendicion"
                                                   asp-action="DetalleAdmin"
                                                   asp-route-id="@item.IdRendicion"
                                                   class="btn btn-primary btn-sm">

                                                    <i class="bi bi-cash-coin"></i>

                                                    Registrar reembolso

                                                </a>
                                            }
                                            else
                                            {
                                                <a asp-controller="Rendicion"
                                                   asp-action="DetalleAdmin"
                                                   asp-route-id="@item.IdRendicion"
                                                   class="btn btn-outline-primary btn-sm">

                                                    <i class="bi bi-eye"></i>

                                                    Ver detalle

                                                </a>
                                            }


                                            @if (!string.IsNullOrWhiteSpace(item.ArchivoPdf))
                                            {
                                                <a href="@item.ArchivoPdf"
                                                   target="_blank"
                                                   rel="noopener"
                                                   class="btn btn-outline-danger btn-sm">

                                                    <i class="bi bi-file-earmark-pdf"></i>

                                                    PDF

                                                </a>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <!-- =============================================
                                 SIN REGISTROS
                                 ============================================= -->

                            <tr id="filaSinRegistros">

                                <td colspan="10"
                                    class="text-center text-muted py-5">

                                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>

                                    No hay liquidaciones registradas.

                                </td>

                            </tr>
                        }


                        <!-- =================================================
                             SIN RESULTADOS DE FILTRO
                             ================================================= -->

                        <tr id="filaSinResultados"
                            style="display:none;">

                            <td colspan="10"
                                class="text-center text-muted py-5">

                                <i class="bi bi-search fs-2 d-block mb-2"></i>

                                No se encontraron liquidaciones con los criterios seleccionados.

                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    <!-- =========================================================
         BOTÓN INFERIOR
         ========================================================= -->

    <div class="mt-4">

        <a asp-controller="Principal"
           asp-action="Index"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left me-1"></i>

            Regresar

        </a>

    </div>

</div>


@section Scripts {

    <script src="~/js/IndexLiquidacion.js"
            asp-append-version="true"></script>

}