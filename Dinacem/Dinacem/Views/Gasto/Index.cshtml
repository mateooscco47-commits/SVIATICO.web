@model List<Dinacem.Models.Gasto>

@{
    ViewData["Title"] = "Rendición de Gastos";
    Layout = "~/Views/Shared/_LayoutEmpleado.cshtml";

    var rendicion = ViewBag.Rendicion as Dinacem.Models.Rendicion;
    var tiposGasto = ViewBag.TiposGasto as List<Dinacem.Models.TipoGasto>;
    var tiposComprobante = ViewBag.TiposComprobante as List<Dinacem.Models.TipoComprobante>;

    var montoAprobado = rendicion?.Solicitud?.Monto ?? 0;
    var totalValorVenta = Model?.Sum(x => x.ValorVenta) ?? 0;
    var totalIgv = Model?.Sum(x => x.IGV) ?? 0;
    var totalRendido = rendicion?.Total ?? 0;
    var saldoOriginal = rendicion?.Saldo ?? 0;

    var devolucion = ViewBag.DevolucionSaldo as Dinacem.Models.DevolucionSaldo;

    decimal saldoPendiente = saldoOriginal;

    if (devolucion != null && saldoOriginal > 0)
    {
        saldoPendiente = saldoOriginal - devolucion.Monto;

        if (saldoPendiente < 0)
        {
            saldoPendiente = 0;
        }
    }

    var estadoTexto = rendicion?.IdEstadoRendicion switch
    {
        1 => "En proceso",
        2 => "Pendiente de revisión",
        3 => "Aprobada",
        4 => "Rechazada",
        _ => "Desconocido"
    };

    var estadoClase = rendicion?.IdEstadoRendicion switch
    {
        1 => "estado-proceso",
        2 => "estado-pendiente",
        3 => "estado-aprobada",
        4 => "estado-rechazada",
        _ => "estado-desconocido"
    };
}

<style>
    :root {
        --dinacen-primary: #0c4a8a;
        --dinacen-primary-dark: #083b70;
        --dinacen-primary-soft: #eaf2fb;
        --dinacen-border: #e2e8f0;
        --dinacen-border-soft: #edf1f5;
        --dinacen-bg: #f8fafc;
        --dinacen-text: #172033;
        --dinacen-muted: #64748b;
        --dinacen-success: #198754;
        --dinacen-warning: #d97706;
        --dinacen-danger: #dc3545;
    }

    .rendicion-wrapper {
        width: 100%;
        max-width: 1500px;
        margin: 0 auto;
        padding: 0 14px 36px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        background: #fff;
        border: 1px solid var(--dinacen-border);
        border-radius: 16px;
        padding: 20px 22px;
        margin-bottom: 18px;
        box-shadow: 0 4px 16px rgba(15,23,42,.05);
    }

    .page-header-content {
        display: flex;
        align-items: center;
        gap: 14px;
        min-width: 0;
        flex: 1 1 auto;
    }

        .page-header-content > div:last-child {
            min-width: 0;
        }

    .page-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--dinacen-primary-soft);
        color: var(--dinacen-primary);
        border-radius: 12px;
        font-size: 22px;
        flex: 0 0 48px;
    }

    .page-title {
        margin: 0;
        color: var(--dinacen-text);
        font-size: clamp(21px, 2vw, 26px);
        font-weight: 800;
        line-height: 1.15;
    }

    .page-description {
        margin: 5px 0 0;
        color: var(--dinacen-muted);
        font-size: 13px;
        line-height: 1.45;
    }

    .header-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: 8px;
    }

        .header-actions .btn {
            min-height: 40px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            white-space: nowrap;
            font-size: 12.5px;
            font-weight: 700;
            border-radius: 9px;
        }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 18px;
    }

    .summary-card {
        background: #fff;
        border: 1px solid var(--dinacen-border);
        border-radius: 12px;
        padding: 15px 16px;
        position: relative;
        overflow: hidden;
        min-width: 0;
        box-shadow: 0 2px 8px rgba(15,23,42,.03);
    }

        .summary-card::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 4px;
            background: var(--dinacen-primary);
        }

        .summary-card.green::before {
            background: var(--dinacen-success);
        }

        .summary-card.orange::before {
            background: #f59e0b;
        }

        .summary-card.blue::before {
            background: #0d6efd;
        }

    .summary-label {
        display: block;
        color: var(--dinacen-muted);
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .35px;
        margin-bottom: 5px;
    }

    .summary-value {
        color: var(--dinacen-text);
        font-size: clamp(18px, 2vw, 22px);
        font-weight: 800;
        line-height: 1.2;
        overflow-wrap: anywhere;
    }

    .summary-card.green .summary-value {
        color: var(--dinacen-success);
    }

    .summary-card.orange .summary-value {
        color: var(--dinacen-warning);
    }

    .summary-card.blue .summary-value {
        color: #0d6efd;
    }

    .content-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(320px, 360px);
        gap: 18px;
        align-items: start;
    }

    .main-column,
    .side-column {
        display: flex;
        flex-direction: column;
        gap: 18px;
        min-width: 0;
    }

    .panel {
        background: #fff;
        border: 1px solid var(--dinacen-border);
        border-radius: 14px;
        box-shadow: 0 3px 12px rgba(15,23,42,.04);
        overflow: hidden;
        min-width: 0;
    }

    .panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 15px 18px;
        border-bottom: 1px solid #e8edf3;
        color: var(--dinacen-text);
        font-size: 13.5px;
        font-weight: 800;
    }

    .panel-body {
        padding: 18px;
        min-width: 0;
    }

    .table-wrapper,
    .table-responsive {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .table-gastos {
        min-width: 980px;
        margin: 0;
    }

        .table-gastos thead th {
            background: var(--dinacen-bg);
            color: var(--dinacen-muted);
            border-bottom: 1px solid #dbe2ea;
            font-size: 10px;
            font-weight: 800;
            text-transform: uppercase;
            white-space: nowrap;
            padding: 12px 11px;
            vertical-align: middle;
        }

        .table-gastos tbody td {
            padding: 12px 11px;
            color: #334155;
            font-size: 12.5px;
            border-color: var(--dinacen-border-soft);
            vertical-align: middle;
        }

        .table-gastos tbody tr:hover {
            background: #fbfdff;
        }

    .badge-gasto {
        display: inline-block;
        background: #edf7ef;
        color: #166534;
        border: 1px solid #ccebd3;
        padding: 5px 8px;
        border-radius: 6px;
        font-size: 10.5px;
        font-weight: 700;
        white-space: nowrap;
    }

    .table-footer {
        padding: 11px 16px;
        border-top: 1px solid #e8edf3;
        color: var(--dinacen-muted);
        font-size: 11.5px;
        background: #fcfdff;
    }

    .mobile-hint {
        display: none;
        color: #94a3b8;
        font-size: 10px;
        font-weight: 600;
    }

    /* IMPORTANTE: nombres propios para no chocar con Bootstrap .col-* */
    .form-grid {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: 16px;
        width: 100%;
        align-items: start;
    }

    .form-col-3 {
        grid-column: span 3;
        min-width: 0;
        width: 100%;
    }

    .form-col-4 {
        grid-column: span 4;
        min-width: 0;
        width: 100%;
    }

    .form-col-6 {
        grid-column: span 6;
        min-width: 0;
        width: 100%;
    }

    .form-col-8 {
        grid-column: span 8;
        min-width: 0;
        width: 100%;
    }

    .form-col-12 {
        grid-column: span 12;
        min-width: 0;
        width: 100%;
    }

    .form-grid .form-control,
    .form-grid .form-select,
    .form-grid .input-group,
    .form-grid .tax-summary {
        width: 100%;
        max-width: none;
    }

    .form-label {
        display: block;
        color: #334155;
        font-size: 11.5px;
        font-weight: 700;
        margin-bottom: 6px;
    }

    .form-control,
    .form-select {
        min-height: 42px;
        border-color: #d7dee8;
        border-radius: 8px;
        font-size: 12.5px;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 .15rem rgba(13,110,253,.1);
        }

        .form-control[readonly] {
            background: #f8fafc;
        }

    .form-text {
        color: #94a3b8;
        font-size: 10.5px;
        line-height: 1.35;
        margin-top: 5px;
    }

    .input-group {
        width: 100%;
    }

        .input-group > .form-control,
        .input-group > .form-select {
            min-width: 0;
        }

        .input-group .btn {
            font-size: 12px;
            font-weight: 700;
            white-space: nowrap;
        }

    .tax-summary {
        height: 100%;
        background: var(--dinacen-bg);
        border: 1px solid var(--dinacen-border);
        border-radius: 10px;
        padding: 14px;
    }

    .tax-item {
        text-align: center;
    }

        .tax-item small {
            display: block;
            color: var(--dinacen-muted);
            font-size: 10.5px;
            margin-bottom: 3px;
        }

        .tax-item strong {
            color: var(--dinacen-text);
            font-size: 16px;
        }

        .tax-item.total strong {
            color: #0d6efd;
        }

    .btn-primary-custom {
        background: var(--dinacen-primary);
        border-color: var(--dinacen-primary);
        color: #fff;
        font-weight: 700;
        min-height: 42px;
        border-radius: 9px;
    }

        .btn-primary-custom:hover {
            background: var(--dinacen-primary-dark);
            border-color: var(--dinacen-primary-dark);
            color: #fff;
        }

    .info-table {
        margin: 0;
    }

        .info-table th,
        .info-table td {
            padding: 10px 11px;
            border-color: #e5eaf0;
            vertical-align: middle;
        }

        .info-table th {
            width: 42%;
            background: var(--dinacen-bg);
            color: var(--dinacen-muted);
            font-size: 10px;
            font-weight: 800;
            text-transform: uppercase;
        }

        .info-table td {
            color: #334155;
            font-size: 12.5px;
            overflow-wrap: anywhere;
        }

    .estado {
        display: inline-flex;
        align-items: center;
        padding: 5px 9px;
        border-radius: 20px;
        font-size: 10.5px;
        font-weight: 700;
        white-space: nowrap;
    }

    .estado-proceso {
        background: #eaf2ff;
        color: #0d6efd;
    }

    .estado-pendiente {
        background: #fff4d6;
        color: #9a6700;
    }

    .estado-aprobada {
        background: #e8f7ef;
        color: #198754;
    }

    .estado-rechazada {
        background: #fdecec;
        color: #dc3545;
    }

    .estado-desconocido {
        background: #eef1f4;
        color: #64748b;
    }

    .devolucion-box {
        border-left: 4px solid #ffc107;
    }

        .devolucion-box.ok {
            border-left-color: var(--dinacen-success);
        }

    .alert-custom {
        border-radius: 9px;
        font-size: 12.5px;
    }

    .action-stack {
        display: flex;
        flex-direction: column;
        gap: 9px;
    }

        .action-stack .btn {
            min-height: 41px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 12.5px;
            font-weight: 700;
            border-radius: 9px;
        }

    .action-note {
        margin: 0;
        color: var(--dinacen-danger);
        font-size: 10.5px;
    }

    .empty-state {
        text-align: center;
        padding: 38px 18px;
        color: #94a3b8;
    }

        .empty-state i {
            display: block;
            margin-bottom: 8px;
            font-size: 30px;
        }

    .voucher-link {
        font-size: 11px;
    }

    @@media (max-width: 1199px) {
        .content-grid {
            grid-template-columns: 1fr;
        }

        .side-column {
            display: grid;
            grid-template-columns: repeat(2, minmax(0,1fr));
            align-items: start;
        }

        .summary-grid {
            grid-template-columns: repeat(2, minmax(0,1fr));
        }
    }

    @@media (max-width: 991px) {
        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .header-actions {
            width: 100%;
            justify-content: flex-start;
        }

        .form-col-3,
        .form-col-4,
        .form-col-6 {
            grid-column: span 6;
        }

        .form-col-8,
        .form-col-12 {
            grid-column: span 12;
        }
    }

    @@media (max-width: 767px) {
        .rendicion-wrapper {
            padding: 0 10px 24px;
        }

        .page-header {
            padding: 16px;
            gap: 14px;
        }

        .page-header-content {
            align-items: flex-start;
        }

        .page-icon {
            width: 42px;
            height: 42px;
            flex-basis: 42px;
            font-size: 19px;
        }

        .page-description {
            font-size: 11.5px;
        }

        .header-actions {
            display: grid;
            grid-template-columns: 1fr;
        }

            .header-actions .btn {
                width: 100%;
            }

        .summary-grid {
            grid-template-columns: repeat(2, minmax(0,1fr));
            gap: 9px;
        }

        .summary-card {
            padding: 12px;
        }

        .summary-label {
            font-size: 8.5px;
        }

        .summary-value {
            font-size: 16px;
        }

        .side-column {
            display: flex;
        }

        .panel-header {
            align-items: flex-start;
            padding: 13px 14px;
        }

        .panel-body {
            padding: 14px;
        }

        .mobile-hint {
            display: block;
            text-align: right;
        }

        .form-grid {
            grid-template-columns: 1fr;
            gap: 13px;
        }

        .form-col-3,
        .form-col-4,
        .form-col-6,
        .form-col-8,
        .form-col-12 {
            grid-column: span 1;
        }

        #btnConsultarRuc {
            padding-left: 14px;
            padding-right: 14px;
        }

        .table-gastos {
            min-width: 880px;
        }

            .table-gastos thead th,
            .table-gastos tbody td {
                padding: 10px 9px;
                font-size: 11px;
            }

        .tax-summary {
            padding: 12px;
        }

        .action-stack .btn {
            width: 100%;
        }
    }

    @@media (max-width: 480px) {
        .summary-grid {
            grid-template-columns: 1fr;
        }

        .page-title {
            font-size: 20px;
        }

        .form-grid .input-group {
            flex-wrap: wrap;
            gap: 6px;
        }

            .form-grid .input-group .form-control {
                flex: 1 1 100%;
                border-radius: 8px !important;
            }

            .form-grid .input-group .btn {
                width: 100%;
                border-radius: 8px !important;
            }
    }
</style>

<div class="rendicion-wrapper">

    <div class="page-header">
        <div class="page-header-content">
            <div class="page-icon">
                <i class="bi bi-receipt-cutoff"></i>
            </div>
            <div>
                <h1 class="page-title">Rendición de gastos</h1>
                <p class="page-description">
                    Registre sus gastos y complete la rendición correspondiente a su comisión.
                </p>
            </div>
        </div>

        <div class="header-actions">

            @if (rendicion != null)
            {
                <a asp-controller="BitacoraVehiculo"
                   asp-action="Index"
                   asp-route-idRendicion="@rendicion.IdRendicion"
                   class="btn btn-outline-primary">
                    <i class="bi bi-car-front-fill me-1"></i>
                    Bitácora de vehículo
                </a>
            }

            <a asp-controller="Rendicion"
               asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Volver a rendiciones
            </a>

        </div>
    </div>

    @if (TempData["mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show alert-custom" role="alert">
            <i class="bi bi-check-circle me-1"></i>
            @TempData["mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show alert-custom" role="alert">
            <i class="bi bi-exclamation-circle me-1"></i>
            @Html.Raw(TempData["error"])
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="summary-grid">

        <div class="summary-card green">
            <span class="summary-label">Monto aprobado</span>
            <div class="summary-value">
                S/ @montoAprobado.ToString("N2")
            </div>
        </div>

        <div class="summary-card orange">
            <span class="summary-label">Total rendido</span>
            <div class="summary-value">
                S/ @totalRendido.ToString("N2")
            </div>
        </div>

        <div class="summary-card blue">
            <span class="summary-label">Saldo pendiente</span>
            <div class="summary-value">
                S/ @saldoPendiente.ToString("N2")
            </div>
        </div>

        <div class="summary-card">
            <span class="summary-label">Gastos registrados</span>
            <div class="summary-value">
                @(Model?.Count ?? 0)
            </div>
        </div>

    </div>

    <div class="content-grid">

        <div class="main-column">

            <div class="panel">

                <div class="panel-header">
                    <span>
                        <i class="bi bi-list-ul me-2 text-primary"></i>
                        Gastos registrados
                    </span>

                    <span class="mobile-hint">
                        Deslice horizontalmente para ver más.
                    </span>
                </div>

                <div class="table-wrapper">

                    <table class="table table-gastos align-middle">

                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Tipo</th>
                                <th>Comprobante</th>
                                <th>Detalle</th>
                                <th>Base</th>
                                <th>IGV</th>
                                <th>Total</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (Model != null && Model.Any())
                            {
                                foreach (var item in Model)
                                {
                                    <tr>

                                        <td>
                                            @item.Fecha.ToString("dd/MM/yyyy")
                                        </td>

                                        <td>
                                            <span class="badge-gasto">
                                                @(item.TipoGasto?.Nombre ?? "Sin tipo")
                                            </span>
                                        </td>

                                        <td>
                                            @(item.TipoComprobante?.Nombre ?? "Sin comprobante")

                                            @if (!string.IsNullOrWhiteSpace(item.Serie) ||
                                           !string.IsNullOrWhiteSpace(item.Numero))
                                            {
                                                <div class="text-muted mt-1">
                                                    @item.Serie - @item.Numero
                                                </div>
                                            }
                                        </td>

                                        <td>
                                            @(string.IsNullOrWhiteSpace(item.Detalle)
                                                ? "-"
                                                : item.Detalle)
                                        </td>

                                        <td>
                                            S/ @item.ValorVenta.ToString("N2")

                                            @if (item.ExoneracionIGV)
                                            {
                                                <div>
                                                    <span class="badge bg-info text-dark mt-1">
                                                        Exonerado
                                                    </span>
                                                </div>
                                            }
                                        </td>

                                        <td>
                                            S/ @item.IGV.ToString("N2")
                                        </td>

                                        <td>
                                            <strong>
                                                S/ @item.MontoTotal.ToString("N2")
                                            </strong>
                                        </td>

                                        <td>

                                            @if (rendicion?.IdEstadoRendicion == 1)
                                            {
                                                <form asp-controller="Gasto"
                                                      asp-action="Delete"
                                                      method="post">

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@item.IdGasto" />

                                                    <input type="hidden"
                                                           name="idRendicion"
                                                           value="@rendicion.IdRendicion" />

                                                    <button type="submit"
                                                            class="btn btn-outline-danger btn-sm"
                                                            onclick="return confirm('¿Eliminar este gasto?');">
                                                        <i class="bi bi-trash"></i>
                                                    </button>

                                                </form>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">
                                                    Bloqueado
                                                </span>
                                            }

                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8">
                                        <div class="empty-state">
                                            <i class="bi bi-receipt"></i>
                                            <div>No hay gastos registrados.</div>
                                            <small>Los gastos que agregue aparecerán aquí.</small>
                                        </div>
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

                <div class="table-footer">
                    <i class="bi bi-info-circle me-1"></i>
                    Mostrando @(Model?.Count ?? 0) gasto(s)
                </div>

                <div class="row g-3 p-3">

                    <div class="col-md-4">
                        <div class="tax-summary">
                            <div class="tax-item">
                                <small>Valor de venta</small>
                                <strong>S/ @totalValorVenta.ToString("N2")</strong>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="tax-summary">
                            <div class="tax-item">
                                <small>Total IGV</small>
                                <strong>S/ @totalIgv.ToString("N2")</strong>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="tax-summary">
                            <div class="tax-item total">
                                <small>Total rendido</small>
                                <strong>S/ @totalRendido.ToString("N2")</strong>
                            </div>
                        </div>
                    </div>

                </div>

            </div>

            @if (rendicion?.IdEstadoRendicion == 1)
            {
                <div class="panel">

                    <div class="panel-header">
                        <span>
                            <i class="bi bi-plus-circle me-2 text-primary"></i>
                            Registrar gasto
                        </span>
                    </div>

                    <div class="panel-body">

                        <form asp-controller="Gasto"
                              asp-action="Create"
                              method="post"
                              enctype="multipart/form-data"
                              id="formGasto">

                            <input type="hidden"
                                   name="IdRendicion"
                                   value="@rendicion.IdRendicion" />

                            <div class="form-grid">

                                <div class="form-col-4">
                                    <label class="form-label">Fecha del gasto</label>

                                    <input type="date"
                                           name="Fecha"
                                           class="form-control"
                                           min="@rendicion.FechaInicio.ToString("yyyy-MM-dd")"
                                           max="@rendicion.FechaFin.ToString("yyyy-MM-dd")"
                                           required />

                                    <div class="form-text">
                                        Del @rendicion.FechaInicio.ToString("dd/MM/yyyy")
                                        al @rendicion.FechaFin.ToString("dd/MM/yyyy")
                                    </div>
                                </div>

                                <div class="form-col-4">
                                    <label class="form-label">RUC</label>

                                    <div class="input-group">
                                        <input type="text"
                                               id="ruc"
                                               name="Ruc"
                                               class="form-control"
                                               maxlength="11"
                                               inputmode="numeric"
                                               pattern="[0-9]{11}"
                                               placeholder="20123456789"
                                               autocomplete="off"
                                               required />

                                        <button type="button"
                                                id="btnConsultarRuc"
                                                class="btn btn-outline-primary">
                                            <i class="bi bi-search me-1"></i>
                                            Buscar
                                        </button>
                                    </div>

                                    <div id="mensajeRuc" class="form-text"></div>
                                </div>

                                <div class="form-col-4">
                                    <label class="form-label">Razón social</label>

                                    <input type="text"
                                           id="razonSocial"
                                           name="RazonSocial"
                                           class="form-control"
                                           maxlength="200"
                                           readonly
                                           required />
                                </div>

                                <div class="form-col-12">
                                    <label class="form-label">Domicilio fiscal</label>

                                    <input type="text"
                                           id="domicilioFiscal"
                                           name="DomicilioFiscal"
                                           class="form-control"
                                           maxlength="300"
                                           placeholder="Ingrese o corrija el domicilio fiscal"
                                           required />

                                    <div class="form-text">
                                        Se completa automáticamente al consultar el RUC.
                                    </div>
                                </div>

                                <div class="form-col-4">
                                    <label class="form-label">Tipo de gasto</label>

                                    <select name="IdTipoGasto"
                                            class="form-select"
                                            required>

                                        <option value="">Seleccionar tipo</option>

                                        @if (tiposGasto != null)
                                        {
                                            foreach (var item in tiposGasto)
                                            {
                                                <option value="@item.IdTipoGasto">
                                                    @item.Nombre
                                                </option>
                                            }
                                        }

                                    </select>
                                </div>

                                <div class="form-col-4">
                                    <label class="form-label">Tipo de comprobante</label>

                                    <select name="IdTipoComprobante"
                                            class="form-select"
                                            required>

                                        <option value="">Seleccionar comprobante</option>

                                        @if (tiposComprobante != null)
                                        {
                                            foreach (var item in tiposComprobante)
                                            {
                                                <option value="@item.IdTipoComprobante">
                                                    @item.Nombre
                                                </option>
                                            }
                                        }

                                    </select>
                                </div>

                                <div class="form-col-4">
                                    <label class="form-label">Serie</label>

                                    <input name="Serie"
                                           class="form-control"
                                           maxlength="20"
                                           placeholder="F001" />
                                </div>

                                <div class="form-col-4">
                                    <label class="form-label">Número</label>

                                    <input name="Numero"
                                           class="form-control"
                                           maxlength="30"
                                           placeholder="000123" />
                                </div>

                                <div class="form-col-4">
                                    <label class="form-label">Detalle</label>

                                    <input name="Detalle"
                                           class="form-control"
                                           maxlength="300"
                                           placeholder="Ej. Almuerzo" />
                                </div>

                                <div class="form-col-4">
                                    <label class="form-label">Monto total</label>

                                    <div class="input-group">
                                        <span class="input-group-text">S/</span>

                                        <input type="number"
                                               id="montoTotal"
                                               name="MontoTotal"
                                               class="form-control"
                                               min="0.01"
                                               step="0.01"
                                               placeholder="0.00"
                                               required />
                                    </div>
                                </div>

                                <div class="form-col-4">
                                    <label class="form-label">Tipo de operación</label>

                                    <div class="form-check mt-2">
                                        <input type="checkbox"
                                               id="exoneracionIGV"
                                               name="ExoneracionIGV"
                                               value="true"
                                               class="form-check-input" />

                                        <label class="form-check-label"
                                               for="exoneracionIGV">
                                            Exonerado de IGV
                                        </label>
                                    </div>
                                </div>

                                <div class="form-col-4">
                                    <label class="form-label">Comprobante</label>

                                    <input type="file"
                                           name="archivo"
                                           class="form-control"
                                           accept=".pdf,.jpg,.jpeg,.png" />
                                </div>

                                <div class="form-col-4">
                                    <label class="form-label">Valor de venta</label>

                                    <div class="input-group">
                                        <span class="input-group-text">S/</span>

                                        <input type="number"
                                               id="valorVenta"
                                               name="ValorVenta"
                                               class="form-control"
                                               step="0.01"
                                               value="0.00"
                                               readonly />
                                    </div>
                                </div>

                                <div class="form-col-4">
                                    <label class="form-label">IGV (18 %)</label>

                                    <div class="input-group">
                                        <span class="input-group-text">S/</span>

                                        <input type="number"
                                               id="igvCalculado"
                                               name="IGV"
                                               class="form-control"
                                               step="0.01"
                                               value="0.00"
                                               readonly />
                                    </div>
                                </div>

                                <div class="form-col-8">
                                    <label class="form-label">Resumen del comprobante</label>

                                    <div class="tax-summary">
                                        <div class="row g-3">

                                            <div class="col-md-4">
                                                <div class="tax-item">
                                                    <small>Valor de venta</small>
                                                    <strong id="resumenValorVenta">S/ 0.00</strong>
                                                </div>
                                            </div>

                                            <div class="col-md-4">
                                                <div class="tax-item">
                                                    <small>IGV</small>
                                                    <strong id="resumenIgv">S/ 0.00</strong>
                                                </div>
                                            </div>

                                            <div class="col-md-4">
                                                <div class="tax-item total">
                                                    <small>Total</small>
                                                    <strong id="resumenTotal">S/ 0.00</strong>
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                </div>

                            </div>

                            <div class="mt-4 pt-3 border-top d-flex justify-content-end">
                                <button type="submit"
                                        class="btn btn-primary-custom px-4">
                                    <i class="bi bi-plus-circle me-1"></i>
                                    Registrar gasto
                                </button>
                            </div>

                        </form>

                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info alert-custom mb-0">
                    <i class="bi bi-lock me-1"></i>
                    Esta rendición ya fue enviada. No se pueden agregar ni eliminar gastos.
                </div>
            }

        </div>

        <div class="side-column">

            <div class="panel">

                <div class="panel-header">
                    <span>
                        <i class="bi bi-file-earmark-text me-2 text-primary"></i>
                        Información de la rendición
                    </span>
                </div>

                <div class="panel-body p-0">

                    <div class="table-responsive">
                        <table class="table table-bordered info-table">

                            <tr>
                                <th>Solicitud</th>
                                <td>@rendicion?.IdSolicitud</td>
                            </tr>

                            <tr>
                                <th>Destino</th>
                                <td>@(rendicion?.Solicitud?.Destino ?? "-")</td>
                            </tr>

                            <tr>
                                <th>Motivo</th>
                                <td>@(rendicion?.Solicitud?.Motivo ?? "-")</td>
                            </tr>

                            <tr>
                                <th>Fecha inicio</th>
                                <td>
                                    @(rendicion != null
                                        ? rendicion.FechaInicio.ToString("dd/MM/yyyy")
                                        : "-")
                                </td>
                            </tr>

                            <tr>
                                <th>Fecha fin</th>
                                <td>
                                    @(rendicion != null
                                        ? rendicion.FechaFin.ToString("dd/MM/yyyy")
                                        : "-")
                                </td>
                            </tr>

                            <tr>
                                <th>Monto aprobado</th>
                                <td>
                                    <strong>
                                        S/ @montoAprobado.ToString("N2")
                                    </strong>
                                </td>
                            </tr>

                            <tr>
                                <th>Estado</th>
                                <td>
                                    <span class="estado @estadoClase">
                                        @estadoTexto
                                    </span>
                                </td>
                            </tr>

                        </table>
                    </div>

                </div>
            </div>

            @if (rendicion != null &&
            rendicion.IdEstadoRendicion == 1 &&
            rendicion.Saldo > 0)
            {
                <div class="panel devolucion-box @(devolucion != null ? "ok" : "")">

                    <div class="panel-header">
                        <span>
                            <i class="bi bi-bank me-2"></i>
                            Devolución de saldo
                        </span>
                    </div>

                    <div class="panel-body">

                        @if (devolucion == null)
                        {
                            <div class="alert alert-warning alert-custom">
                                Tiene un saldo pendiente de devolución de
                                <strong>
                                    S/ @rendicion.Saldo.ToString("N2")
                                </strong>.
                                Registre el depósito antes de enviar la rendición.
                            </div>

                            <form asp-controller="DevolucionSaldo"
                                  asp-action="Registrar"
                                  method="post"
                                  enctype="multipart/form-data">

                                <input type="hidden"
                                       name="IdRendicion"
                                       value="@rendicion.IdRendicion" />

                                <div class="mb-3">
                                    <label class="form-label">Monto a devolver</label>

                                    <input type="number"
                                           name="Monto"
                                           class="form-control"
                                           value="@rendicion.Saldo.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                           step="0.01"
                                           readonly />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Fecha del depósito</label>

                                    <input type="date"
                                           name="Fecha"
                                           class="form-control"
                                           value="@DateTime.Now.ToString("yyyy-MM-dd")"
                                           required />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Banco</label>

                                    <input type="text"
                                           name="Banco"
                                           class="form-control"
                                           maxlength="100"
                                           placeholder="Ej. BCP, BBVA, Interbank"
                                           required />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Número de operación</label>

                                    <input type="text"
                                           name="NumeroOperacion"
                                           class="form-control"
                                           maxlength="100"
                                           required />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Voucher</label>

                                    <input type="file"
                                           name="voucher"
                                           class="form-control"
                                           accept=".pdf,.jpg,.jpeg,.png"
                                           required />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Observaciones</label>

                                    <textarea name="Observaciones"
                                              class="form-control"
                                              rows="3"
                                              maxlength="500"></textarea>
                                </div>

                                <button type="submit"
                                        class="btn btn-primary-custom w-100">
                                    <i class="bi bi-check2-circle me-1"></i>
                                    Registrar devolución
                                </button>

                            </form>
                        }
                        else
                        {
                            <div class="alert alert-success alert-custom">
                                <i class="bi bi-check-circle me-1"></i>
                                Devolución registrada correctamente.
                            </div>

                            <div class="table-responsive">
                                <table class="table table-bordered info-table">

                                    <tr>
                                        <th>Monto</th>
                                        <td>
                                            S/ @devolucion.Monto.ToString("N2")
                                        </td>
                                    </tr>

                                    <tr>
                                        <th>Fecha</th>
                                        <td>
                                            @devolucion.Fecha.ToString("dd/MM/yyyy")
                                        </td>
                                    </tr>

                                    <tr>
                                        <th>Banco</th>
                                        <td>@devolucion.Banco</td>
                                    </tr>

                                    <tr>
                                        <th>Operación</th>
                                        <td>@devolucion.NumeroOperacion</td>
                                    </tr>

                                    <tr>
                                        <th>Voucher</th>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(devolucion.Voucher))
                                            {
                                                <a href="@devolucion.Voucher"
                                                   target="_blank"
                                                   rel="noopener"
                                                   class="btn btn-outline-primary btn-sm voucher-link">
                                                    <i class="bi bi-file-earmark-arrow-up me-1"></i>
                                                    Ver voucher
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted">
                                                    Sin archivo
                                                </span>
                                            }
                                        </td>
                                    </tr>

                                    <tr>
                                        <th>Observaciones</th>
                                        <td>
                                            @(string.IsNullOrWhiteSpace(devolucion.Observaciones)
                                                ? "-"
                                                : devolucion.Observaciones)
                                        </td>
                                    </tr>

                                </table>
                            </div>

                            <form asp-controller="DevolucionSaldo"
                                  asp-action="Eliminar"
                                  method="post"
                                  class="mt-3">

                                <input type="hidden"
                                       name="id"
                                       value="@devolucion.IdDevolucionSaldo" />

                                <input type="hidden"
                                       name="idRendicion"
                                       value="@rendicion.IdRendicion" />

                                <button type="submit"
                                        class="btn btn-outline-danger w-100"
                                        onclick="return confirm('¿Desea eliminar la devolución registrada?');">
                                    <i class="bi bi-trash me-1"></i>
                                    Eliminar devolución
                                </button>

                            </form>
                        }

                    </div>
                </div>
            }

            <div class="panel">

                <div class="panel-header">
                    <span>
                        <i class="bi bi-lightning-charge me-2 text-primary"></i>
                        Acciones
                    </span>
                </div>

                <div class="panel-body">

                    <div class="action-stack">

                        @if (rendicion?.IdEstadoRendicion == 1)
                        {
                            var puedeEnviar =
                            rendicion.Total > 0 &&
                            (rendicion.Saldo <= 0 || devolucion != null);

                            <form asp-controller="Gasto"
                                  asp-action="EnviarRendicion"
                                  method="post">

                                <input type="hidden"
                                       name="idRendicion"
                                       value="@rendicion.IdRendicion" />

                                <button type="submit"
                                        class="btn btn-success w-100"
                                        disabled="@(puedeEnviar ? null : "disabled")"
                                        onclick="return confirm('¿Desea enviar esta rendición para revisión?');">

                                    <i class="bi bi-send-check me-1"></i>
                                    Finalizar y enviar
                                </button>

                            </form>

                            @if (rendicion.Total <= 0)
                            {
                                <p class="action-note">
                                    <i class="bi bi-exclamation-circle me-1"></i>
                                    Debe registrar al menos un gasto.
                                </p>
                            }
                            else if (rendicion.Saldo > 0 && devolucion == null)
                            {
                                <p class="action-note">
                                    <i class="bi bi-exclamation-circle me-1"></i>
                                    Debe registrar la devolución del saldo pendiente.
                                </p>
                            }
                        }

                        @if (rendicion != null)
                        {
                            <a asp-controller="BitacoraVehiculo"
                               asp-action="Index"
                               asp-route-idRendicion="@rendicion.IdRendicion"
                               class="btn btn-outline-primary">
                                <i class="bi bi-car-front-fill me-1"></i>
                                Bitácora de vehículo
                            </a>
                        }

                        <a asp-controller="Rendicion"
                           asp-action="MisRendiciones"
                           class="btn btn-outline-secondary">
                            <i class="bi bi-clock-history me-1"></i>
                            Historial de rendiciones
                        </a>

                        <a asp-controller="Rendicion"
                           asp-action="Index"
                           class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>
                            Volver a rendiciones
                        </a>

                    </div>

                </div>
            </div>

        </div>

    </div>

</div>

<script>
    document.addEventListener("DOMContentLoaded",function(){
        const ruc=document.getElementById("ruc");
        const btnRuc=document.getElementById("btnConsultarRuc");
        const razonSocial=document.getElementById("razonSocial");
        const domicilio=document.getElementById("domicilioFiscal");
        const mensajeRuc=document.getElementById("mensajeRuc");
        let ultimaConsulta="";

        async function consultarRuc(){
            const numero=ruc.value.trim();

            if(numero===ultimaConsulta)return;

            razonSocial.value="";
            domicilio.value="";
            mensajeRuc.textContent="";

            if(!/^\d{11}$/.test(numero)){
                mensajeRuc.textContent="Ingrese un RUC válido de 11 dígitos.";
                mensajeRuc.className="form-text text-danger";
                return;
            }

            btnRuc.disabled=true;
            btnRuc.innerHTML='<span class="spinner-border spinner-border-sm me-1"></span>Buscando...';

            try{
                const url='@Url.Action("ConsultarRuc", "Gasto")'+'?ruc='+encodeURIComponent(numero);

                const response=await fetch(url,{
                    method:"GET",
                    headers:{"Accept":"application/json"}
                });

                let data;

                try{
                    data=await response.json();
                }catch{
                    throw new Error("La respuesta del servidor no es válida.");
                }

                if(!response.ok){
                    throw new Error(data?.mensaje||"No se encontró el RUC.");
                }

                razonSocial.value=data?.razonSocial??"";
                domicilio.value=data?.domicilioFiscal??"";

                mensajeRuc.textContent=`Estado: ${data?.estado??"-"} | Condición: ${data?.condicion??"-"}`;
                mensajeRuc.className="form-text text-success";
                ultimaConsulta=numero;

            }catch(error){
                ultimaConsulta="";
                mensajeRuc.textContent=error.message||"No se pudo consultar el RUC.";
                mensajeRuc.className="form-text text-danger";
            }finally{
                btnRuc.disabled=false;
                btnRuc.innerHTML='<i class="bi bi-search me-1"></i>Buscar';
            }
        }

        if(ruc&&btnRuc){
            btnRuc.addEventListener("click",consultarRuc);

            ruc.addEventListener("blur",function(){
                if(/^\d{11}$/.test(ruc.value.trim())){
                    consultarRuc();
                }
            });

            ruc.addEventListener("input",function(){
                ruc.value=ruc.value.replace(/\D/g,"").slice(0,11);

                if(ruc.value!==ultimaConsulta){
                    ultimaConsulta="";
                    razonSocial.value="";
                    domicilio.value="";
                    mensajeRuc.textContent="";
                }
            });
        }

        const montoTotal=document.getElementById("montoTotal");
        const exoneracion=document.getElementById("exoneracionIGV");
        const valorVenta=document.getElementById("valorVenta");
        const igv=document.getElementById("igvCalculado");
        const resumenBase=document.getElementById("resumenValorVenta");
        const resumenIgv=document.getElementById("resumenIgv");
        const resumenTotal=document.getElementById("resumenTotal");

        function calcularIgv(){
            if(!montoTotal||!valorVenta||!igv)return;

            const total=parseFloat(montoTotal.value)||0;
            let base=0;
            let impuesto=0;

            if(total>0){
                if(exoneracion?.checked){
                    base=total;
                }else{
                    base=Math.round((total/1.18)*100)/100;
                    impuesto=Math.round((total-base)*100)/100;
                }
            }

            valorVenta.value=base.toFixed(2);
            igv.value=impuesto.toFixed(2);

            if(resumenBase)resumenBase.textContent=`S/ ${base.toFixed(2)}`;
            if(resumenIgv)resumenIgv.textContent=`S/ ${impuesto.toFixed(2)}`;
            if(resumenTotal)resumenTotal.textContent=`S/ ${total.toFixed(2)}`;
        }

        montoTotal?.addEventListener("input",calcularIgv);
        exoneracion?.addEventListener("change",calcularIgv);

        calcularIgv();
    });
</script>