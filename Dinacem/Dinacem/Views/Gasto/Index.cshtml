@model List<Dinacem.Models.Gasto>

@{
    ViewData["Title"] = "Rendición de Gastos";
    Layout = "~/Views/Shared/_LayoutEmpleado.cshtml";

    var rendicion = ViewBag.Rendicion as Dinacem.Models.Rendicion;
    var tiposGasto = ViewBag.TiposGasto as List<Dinacem.Models.TipoGasto>;
    var tiposComprobante = ViewBag.TiposComprobante as List<Dinacem.Models.TipoComprobante>;

    var montoAprobado = rendicion?.Solicitud?.Monto ?? 0;
    var totalValorVenta = Model?.Sum(x => x.ValorVenta) ?? 0;
    var totalIgv = Model?.Sum(x => x.IGV) ?? 0;
    var totalRendido = rendicion?.Total ?? 0;
    var saldoOriginal = rendicion?.Saldo ?? 0;

    var devolucion = ViewBag.DevolucionSaldo as Dinacem.Models.DevolucionSaldo;

    decimal saldoPendiente = saldoOriginal;

    if (devolucion != null && saldoOriginal > 0)
    {
        saldoPendiente = saldoOriginal - devolucion.Monto;

        if (saldoPendiente < 0)
        {
            saldoPendiente = 0;
        }
    }

    var estadoTexto = rendicion?.IdEstadoRendicion switch
    {
        1 => "En proceso",
        2 => "Pendiente de revisión",
        3 => "Aprobada",
        4 => "Rechazada",
        _ => "Desconocido"
    };

    var estadoClase = rendicion?.IdEstadoRendicion switch
    {
        1 => "estado-proceso",
        2 => "estado-pendiente",
        3 => "estado-aprobada",
        4 => "estado-rechazada",
        _ => "estado-desconocido"
    };
}

<style>
    .rendicion-wrapper{width:100%;max-width:1650px;margin:0 auto;padding-bottom:35px}
    .page-header{display:flex;justify-content:space-between;align-items:center;gap:20px;background:#fff;border:1px solid #e2e8f0;border-radius:14px;padding:22px 24px;margin-bottom:20px;box-shadow:0 3px 12px rgba(15,23,42,.04)}
    .page-header-content{display:flex;align-items:center;gap:14px}
    .page-icon{width:48px;height:48px;display:flex;align-items:center;justify-content:center;background:#eaf2fb;color:#0c4a8a;border-radius:12px;font-size:22px;flex-shrink:0}
    .page-title{margin:0;color:#172033;font-size:25px;font-weight:800}
    .page-description{margin:4px 0 0;color:#64748b;font-size:13px}
    .panel{background:#fff;border:1px solid #e2e8f0;border-radius:14px;box-shadow:0 3px 12px rgba(15,23,42,.04);overflow:hidden}
    .panel-header{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:16px 20px;border-bottom:1px solid #e8edf3;color:#172033;font-size:14px;font-weight:800}
    .panel-body{padding:20px}
    .summary-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:20px}
    .summary-card{background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:16px 18px;position:relative;overflow:hidden}
    .summary-card:before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px;background:#0c4a8a}
    .summary-card.green:before{background:#198754}
    .summary-card.orange:before{background:#f59e0b}
    .summary-card.blue:before{background:#0d6efd}
    .summary-label{display:block;color:#64748b;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.3px;margin-bottom:6px}
    .summary-value{color:#172033;font-size:22px;font-weight:800}
    .summary-card.green .summary-value{color:#198754}
    .summary-card.orange .summary-value{color:#d97706}
    .summary-card.blue .summary-value{color:#0d6efd}
    .content-grid{display:grid;grid-template-columns:minmax(0,1fr) 380px;gap:20px}
    .main-column,.side-column{display:flex;flex-direction:column;gap:20px}
    .table-wrapper{overflow-x:auto}
    .table-gastos{min-width:1050px;margin:0}
    .table-gastos thead th{background:#f8fafc;color:#64748b;border-bottom:1px solid #dbe2ea;font-size:11px;font-weight:800;text-transform:uppercase;white-space:nowrap;padding:13px 12px}
    .table-gastos tbody td{padding:13px 12px;color:#334155;font-size:13px;border-color:#edf1f5;vertical-align:middle}
    .table-gastos tbody tr:hover{background:#f8fafc}
    .badge-gasto{display:inline-block;background:#edf7ef;color:#166534;border:1px solid #ccebd3;padding:5px 9px;border-radius:6px;font-size:11px;font-weight:700;white-space:nowrap}
    .table-footer{padding:12px 18px;border-top:1px solid #e8edf3;color:#64748b;font-size:12px}
    .mobile-hint{display:none;color:#94a3b8;font-size:11px;font-weight:400}
    .form-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:16px}
    .col-3{grid-column:span 3}
    .col-4{grid-column:span 4}
    .col-6{grid-column:span 6}
    .col-8{grid-column:span 8}
    .col-12{grid-column:span 12}
    .form-label{display:block;color:#334155;font-size:12px;font-weight:700;margin-bottom:6px}
    .form-control,.form-select{min-height:42px;border-color:#d7dee8;border-radius:8px;font-size:13px}
    .form-control:focus,.form-select:focus{border-color:#0d6efd;box-shadow:0 0 0 .15rem rgba(13,110,253,.1)}
    .form-text{font-size:11px;color:#94a3b8}
    .input-group .btn{font-size:13px;font-weight:600}
    .tax-summary{height:100%;background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:15px}
    .tax-item{text-align:center}
    .tax-item small{display:block;color:#64748b;font-size:11px;margin-bottom:3px}
    .tax-item strong{color:#172033;font-size:17px}
    .tax-item.total strong{color:#0d6efd}
    .btn-primary-custom{background:#0c4a8a;border-color:#0c4a8a;color:#fff;font-weight:700;min-height:42px}
    .btn-primary-custom:hover{background:#083b70;border-color:#083b70;color:#fff}
    .info-table{margin:0}
    .info-table th{width:42%;background:#f8fafc;color:#64748b;font-size:11px;font-weight:700;text-transform:uppercase;vertical-align:middle}
    .info-table td{color:#334155;font-size:13px;vertical-align:middle}
    .info-table th,.info-table td{padding:11px 12px;border-color:#e5eaf0}
    .estado{display:inline-flex;align-items:center;padding:5px 10px;border-radius:20px;font-size:11px;font-weight:700}
    .estado-proceso{background:#eaf2ff;color:#0d6efd}
    .estado-pendiente{background:#fff4d6;color:#9a6700}
    .estado-aprobada{background:#e8f7ef;color:#198754}
    .estado-rechazada{background:#fdecec;color:#dc3545}
    .estado-desconocido{background:#eef1f4;color:#64748b}
    .devolucion-box{border-left:4px solid #ffc107}
    .devolucion-box.ok{border-left-color:#198754}
    .alert-custom{border-radius:9px;font-size:13px}
    .action-stack{display:flex;flex-direction:column;gap:10px}
    .action-stack .btn{min-height:42px;font-size:13px;font-weight:700}
    .action-note{margin:0;color:#dc3545;font-size:11px}
    .empty-state{text-align:center;padding:45px 20px;color:#94a3b8}
    .empty-state i{font-size:32px;display:block;margin-bottom:8px}
    .voucher-link{font-size:12px}
    @@media(max-width:1199px){
        .content-grid{grid-template-columns:1fr}
        .side-column{display:grid;grid-template-columns:1fr 1fr;align-items:start}
        .summary-grid{grid-template-columns:repeat(2,1fr)}
    }
    @@media(max-width:767px){
        .rendicion-wrapper{padding-bottom:20px}
        .page-header{padding:17px;align-items:flex-start;flex-direction:column}
        .page-header-content{align-items:flex-start}
        .page-icon{width:42px;height:42px;font-size:19px}
        .page-title{font-size:21px}
        .page-description{font-size:12px}
        .page-header>.btn{width:100%}
        .summary-grid{grid-template-columns:1fr 1fr;gap:10px}
        .summary-card{padding:13px}
        .summary-value{font-size:17px}
        .summary-label{font-size:9px}
        .side-column{display:flex}
        .panel-header{padding:14px 15px}
        .panel-body{padding:15px}
        .mobile-hint{display:block}
        .form-grid{display:grid;grid-template-columns:1fr;gap:14px}
        .col-3,.col-4,.col-6,.col-8,.col-12{grid-column:span 1}
        .action-stack .btn{width:100%}
    }
</style>

<div class="rendicion-wrapper">

    <div class="page-header">
        <div class="page-header-content">
            <div class="page-icon">
                <i class="bi bi-receipt-cutoff"></i>
            </div>
            <div>
                <h1 class="page-title">Rendición de gastos</h1>
                <p class="page-description">
                    Registre sus gastos y complete la rendición correspondiente a su comisión.
                </p>
            </div>
        </div>

        <a asp-controller="Rendicion"
           asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Volver a rendiciones
        </a>
    </div>

    @if (TempData["mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show alert-custom" role="alert">
            <i class="bi bi-check-circle me-1"></i>
            @TempData["mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show alert-custom" role="alert">
            <i class="bi bi-exclamation-circle me-1"></i>
            @Html.Raw(TempData["error"])
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="summary-grid">

        <div class="summary-card green">
            <span class="summary-label">Monto aprobado</span>
            <div class="summary-value">
                S/ @montoAprobado.ToString("N2")
            </div>
        </div>

        <div class="summary-card orange">
            <span class="summary-label">Total rendido</span>
            <div class="summary-value">
                S/ @totalRendido.ToString("N2")
            </div>
        </div>

        <div class="summary-card blue">
            <span class="summary-label">Saldo pendiente</span>
            <div class="summary-value">
                S/ @saldoPendiente.ToString("N2")
            </div>
        </div>

        <div class="summary-card">
            <span class="summary-label">Gastos registrados</span>
            <div class="summary-value">
                @(Model?.Count ?? 0)
            </div>
        </div>

    </div>

    <div class="content-grid">

        <div class="main-column">

            <div class="panel">

                <div class="panel-header">
                    <span>
                        <i class="bi bi-list-ul me-2 text-primary"></i>
                        Gastos registrados
                    </span>

                    <span class="mobile-hint">
                        Deslice horizontalmente para ver más.
                    </span>
                </div>

                <div class="table-wrapper">

                    <table class="table table-gastos align-middle">

                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Tipo</th>
                                <th>Comprobante</th>
                                <th>Detalle</th>
                                <th>Base</th>
                                <th>IGV</th>
                                <th>Total</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (Model != null && Model.Any())
                            {
                                foreach (var item in Model)
                                {
                                    <tr>

                                        <td>
                                            @item.Fecha.ToString("dd/MM/yyyy")
                                        </td>

                                        <td>
                                            <span class="badge-gasto">
                                                @(item.TipoGasto?.Nombre ?? "Sin tipo")
                                            </span>
                                        </td>

                                        <td>
                                            @(item.TipoComprobante?.Nombre ?? "Sin comprobante")

                                            @if (!string.IsNullOrWhiteSpace(item.Serie) ||
                                                 !string.IsNullOrWhiteSpace(item.Numero))
                                            {
                                                <div class="text-muted mt-1">
                                                    @item.Serie - @item.Numero
                                                </div>
                                            }
                                        </td>

                                        <td>
                                            @(string.IsNullOrWhiteSpace(item.Detalle)
                                                ? "-"
                                                : item.Detalle)
                                        </td>

                                        <td>
                                            S/ @item.ValorVenta.ToString("N2")

                                            @if (item.ExoneracionIGV)
                                            {
                                                <div>
                                                    <span class="badge bg-info text-dark mt-1">
                                                        Exonerado
                                                    </span>
                                                </div>
                                            }
                                        </td>

                                        <td>
                                            S/ @item.IGV.ToString("N2")
                                        </td>

                                        <td>
                                            <strong>
                                                S/ @item.MontoTotal.ToString("N2")
                                            </strong>
                                        </td>

                                        <td>

                                            @if (rendicion?.IdEstadoRendicion == 1)
                                            {
                                                <form asp-controller="Gasto"
                                                      asp-action="Delete"
                                                      method="post">

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@item.IdGasto" />

                                                    <input type="hidden"
                                                           name="idRendicion"
                                                           value="@rendicion.IdRendicion" />

                                                    <button type="submit"
                                                            class="btn btn-outline-danger btn-sm"
                                                            onclick="return confirm('¿Eliminar este gasto?');">
                                                        <i class="bi bi-trash"></i>
                                                    </button>

                                                </form>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">
                                                    Bloqueado
                                                </span>
                                            }

                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8">
                                        <div class="empty-state">
                                            <i class="bi bi-receipt"></i>
                                            <div>No hay gastos registrados.</div>
                                            <small>Los gastos que agregue aparecerán aquí.</small>
                                        </div>
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

                <div class="table-footer">
                    <i class="bi bi-info-circle me-1"></i>
                    Mostrando @(Model?.Count ?? 0) gasto(s)
                </div>

                <div class="row g-3 p-3">

                    <div class="col-md-4">
                        <div class="tax-summary">
                            <div class="tax-item">
                                <small>Valor de venta</small>
                                <strong>S/ @totalValorVenta.ToString("N2")</strong>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="tax-summary">
                            <div class="tax-item">
                                <small>Total IGV</small>
                                <strong>S/ @totalIgv.ToString("N2")</strong>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="tax-summary">
                            <div class="tax-item total">
                                <small>Total rendido</small>
                                <strong>S/ @totalRendido.ToString("N2")</strong>
                            </div>
                        </div>
                    </div>

                </div>

            </div>

            @if (rendicion?.IdEstadoRendicion == 1)
            {
                <div class="panel">

                    <div class="panel-header">
                        <span>
                            <i class="bi bi-plus-circle me-2 text-primary"></i>
                            Registrar gasto
                        </span>
                    </div>

                    <div class="panel-body">

                        <form asp-controller="Gasto"
                              asp-action="Create"
                              method="post"
                              enctype="multipart/form-data"
                              id="formGasto">

                            <input type="hidden"
                                   name="IdRendicion"
                                   value="@rendicion.IdRendicion" />

                            <div class="form-grid">

                                <div class="col-4">
                                    <label class="form-label">Fecha del gasto</label>

                                    <input type="date"
                                           name="Fecha"
                                           class="form-control"
                                           min="@rendicion.FechaInicio.ToString("yyyy-MM-dd")"
                                           max="@rendicion.FechaFin.ToString("yyyy-MM-dd")"
                                           required />

                                    <div class="form-text">
                                        Del @rendicion.FechaInicio.ToString("dd/MM/yyyy")
                                        al @rendicion.FechaFin.ToString("dd/MM/yyyy")
                                    </div>
                                </div>

                                <div class="col-4">
                                    <label class="form-label">RUC</label>

                                    <div class="input-group">
                                        <input type="text"
                                               id="ruc"
                                               name="Ruc"
                                               class="form-control"
                                               maxlength="11"
                                               inputmode="numeric"
                                               pattern="[0-9]{11}"
                                               placeholder="20123456789"
                                               autocomplete="off"
                                               required />

                                        <button type="button"
                                                id="btnConsultarRuc"
                                                class="btn btn-outline-primary">
                                            <i class="bi bi-search me-1"></i>
                                            Buscar
                                        </button>
                                    </div>

                                    <div id="mensajeRuc" class="form-text"></div>
                                </div>

                                <div class="col-4">
                                    <label class="form-label">Razón social</label>

                                    <input type="text"
                                           id="razonSocial"
                                           name="RazonSocial"
                                           class="form-control"
                                           maxlength="200"
                                           readonly
                                           required />
                                </div>

                                <div class="col-12">
                                    <label class="form-label">Domicilio fiscal</label>

                                    <input type="text"
                                           id="domicilioFiscal"
                                           name="DomicilioFiscal"
                                           class="form-control"
                                           maxlength="300"
                                           placeholder="Ingrese o corrija el domicilio fiscal"
                                           required />

                                    <div class="form-text">
                                        Se completa automáticamente al consultar el RUC.
                                    </div>
                                </div>

                                <div class="col-4">
                                    <label class="form-label">Tipo de gasto</label>

                                    <select name="IdTipoGasto"
                                            class="form-select"
                                            required>

                                        <option value="">Seleccionar tipo</option>

                                        @if (tiposGasto != null)
                                        {
                                            foreach (var item in tiposGasto)
                                            {
                                                <option value="@item.IdTipoGasto">
                                                    @item.Nombre
                                                </option>
                                            }
                                        }

                                    </select>
                                </div>

                                <div class="col-4">
                                    <label class="form-label">Tipo de comprobante</label>

                                    <select name="IdTipoComprobante"
                                            class="form-select"
                                            required>

                                        <option value="">Seleccionar comprobante</option>

                                        @if (tiposComprobante != null)
                                        {
                                            foreach (var item in tiposComprobante)
                                            {
                                                <option value="@item.IdTipoComprobante">
                                                    @item.Nombre
                                                </option>
                                            }
                                        }

                                    </select>
                                </div>

                                <div class="col-4">
                                    <label class="form-label">Serie</label>

                                    <input name="Serie"
                                           class="form-control"
                                           maxlength="20"
                                           placeholder="F001" />
                                </div>

                                <div class="col-4">
                                    <label class="form-label">Número</label>

                                    <input name="Numero"
                                           class="form-control"
                                           maxlength="30"
                                           placeholder="000123" />
                                </div>

                                <div class="col-4">
                                    <label class="form-label">Detalle</label>

                                    <input name="Detalle"
                                           class="form-control"
                                           maxlength="300"
                                           placeholder="Ej. Almuerzo" />
                                </div>

                                <div class="col-4">
                                    <label class="form-label">Monto total</label>

                                    <div class="input-group">
                                        <span class="input-group-text">S/</span>

                                        <input type="number"
                                               id="montoTotal"
                                               name="MontoTotal"
                                               class="form-control"
                                               min="0.01"
                                               step="0.01"
                                               placeholder="0.00"
                                               required />
                                    </div>
                                </div>

                                <div class="col-4">
                                    <label class="form-label">Tipo de operación</label>

                                    <div class="form-check mt-2">
                                        <input type="checkbox"
                                               id="exoneracionIGV"
                                               name="ExoneracionIGV"
                                               value="true"
                                               class="form-check-input" />

                                        <label class="form-check-label"
                                               for="exoneracionIGV">
                                            Exonerado de IGV
                                        </label>
                                    </div>
                                </div>

                                <div class="col-4">
                                    <label class="form-label">Comprobante</label>

                                    <input type="file"
                                           name="archivo"
                                           class="form-control"
                                           accept=".pdf,.jpg,.jpeg,.png" />
                                </div>

                                <div class="col-4">
                                    <label class="form-label">Valor de venta</label>

                                    <div class="input-group">
                                        <span class="input-group-text">S/</span>

                                        <input type="number"
                                               id="valorVenta"
                                               name="ValorVenta"
                                               class="form-control"
                                               step="0.01"
                                               value="0.00"
                                               readonly />
                                    </div>
                                </div>

                                <div class="col-4">
                                    <label class="form-label">IGV (18 %)</label>

                                    <div class="input-group">
                                        <span class="input-group-text">S/</span>

                                        <input type="number"
                                               id="igvCalculado"
                                               name="IGV"
                                               class="form-control"
                                               step="0.01"
                                               value="0.00"
                                               readonly />
                                    </div>
                                </div>

                                <div class="col-8">
                                    <label class="form-label">Resumen del comprobante</label>

                                    <div class="tax-summary">
                                        <div class="row g-3">

                                            <div class="col-md-4">
                                                <div class="tax-item">
                                                    <small>Valor de venta</small>
                                                    <strong id="resumenValorVenta">S/ 0.00</strong>
                                                </div>
                                            </div>

                                            <div class="col-md-4">
                                                <div class="tax-item">
                                                    <small>IGV</small>
                                                    <strong id="resumenIgv">S/ 0.00</strong>
                                                </div>
                                            </div>

                                            <div class="col-md-4">
                                                <div class="tax-item total">
                                                    <small>Total</small>
                                                    <strong id="resumenTotal">S/ 0.00</strong>
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                </div>

                            </div>

                            <div class="mt-4 pt-3 border-top">
                                <button type="submit"
                                        class="btn btn-primary-custom px-4">
                                    <i class="bi bi-plus-circle me-1"></i>
                                    Registrar gasto
                                </button>
                            </div>

                        </form>

                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info alert-custom mb-0">
                    <i class="bi bi-lock me-1"></i>
                    Esta rendición ya fue enviada. No se pueden agregar ni eliminar gastos.
                </div>
            }

        </div>

        <div class="side-column">

            <div class="panel">

                <div class="panel-header">
                    <span>
                        <i class="bi bi-file-earmark-text me-2 text-primary"></i>
                        Información de la rendición
                    </span>
                </div>

                <div class="panel-body p-0">

                    <div class="table-responsive">
                        <table class="table table-bordered info-table">

                            <tr>
                                <th>Solicitud</th>
                                <td>@rendicion?.IdSolicitud</td>
                            </tr>

                            <tr>
                                <th>Destino</th>
                                <td>@(rendicion?.Solicitud?.Destino ?? "-")</td>
                            </tr>

                            <tr>
                                <th>Motivo</th>
                                <td>@(rendicion?.Solicitud?.Motivo ?? "-")</td>
                            </tr>

                            <tr>
                                <th>Fecha inicio</th>
                                <td>
                                    @(rendicion != null
                                        ? rendicion.FechaInicio.ToString("dd/MM/yyyy")
                                        : "-")
                                </td>
                            </tr>

                            <tr>
                                <th>Fecha fin</th>
                                <td>
                                    @(rendicion != null
                                        ? rendicion.FechaFin.ToString("dd/MM/yyyy")
                                        : "-")
                                </td>
                            </tr>

                            <tr>
                                <th>Monto aprobado</th>
                                <td>
                                    <strong>
                                        S/ @montoAprobado.ToString("N2")
                                    </strong>
                                </td>
                            </tr>

                            <tr>
                                <th>Estado</th>
                                <td>
                                    <span class="estado @estadoClase">
                                        @estadoTexto
                                    </span>
                                </td>
                            </tr>

                        </table>
                    </div>

                </div>
            </div>

            @if (rendicion != null &&
                 rendicion.IdEstadoRendicion == 1 &&
                 rendicion.Saldo > 0)
            {
                <div class="panel devolucion-box @(devolucion != null ? "ok" : "")">

                    <div class="panel-header">
                        <span>
                            <i class="bi bi-bank me-2"></i>
                            Devolución de saldo
                        </span>
                    </div>

                    <div class="panel-body">

                        @if (devolucion == null)
                        {
                            <div class="alert alert-warning alert-custom">
                                Tiene un saldo pendiente de devolución de
                                <strong>
                                    S/ @rendicion.Saldo.ToString("N2")
                                </strong>.
                                Registre el depósito antes de enviar la rendición.
                            </div>

                            <form asp-controller="DevolucionSaldo"
                                  asp-action="Registrar"
                                  method="post"
                                  enctype="multipart/form-data">

                                <input type="hidden"
                                       name="IdRendicion"
                                       value="@rendicion.IdRendicion" />

                                <div class="mb-3">
                                    <label class="form-label">Monto a devolver</label>

                                    <input type="number"
                                           name="Monto"
                                           class="form-control"
                                           value="@rendicion.Saldo.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                           step="0.01"
                                           readonly />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Fecha del depósito</label>

                                    <input type="date"
                                           name="Fecha"
                                           class="form-control"
                                           value="@DateTime.Now.ToString("yyyy-MM-dd")"
                                           required />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Banco</label>

                                    <input type="text"
                                           name="Banco"
                                           class="form-control"
                                           maxlength="100"
                                           placeholder="Ej. BCP, BBVA, Interbank"
                                           required />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Número de operación</label>

                                    <input type="text"
                                           name="NumeroOperacion"
                                           class="form-control"
                                           maxlength="100"
                                           required />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Voucher</label>

                                    <input type="file"
                                           name="voucher"
                                           class="form-control"
                                           accept=".pdf,.jpg,.jpeg,.png"
                                           required />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Observaciones</label>

                                    <textarea name="Observaciones"
                                              class="form-control"
                                              rows="3"
                                              maxlength="500"></textarea>
                                </div>

                                <button type="submit"
                                        class="btn btn-primary-custom w-100">
                                    <i class="bi bi-check2-circle me-1"></i>
                                    Registrar devolución
                                </button>

                            </form>
                        }
                        else
                        {
                            <div class="alert alert-success alert-custom">
                                <i class="bi bi-check-circle me-1"></i>
                                Devolución registrada correctamente.
                            </div>

                            <div class="table-responsive">
                                <table class="table table-bordered info-table">

                                    <tr>
                                        <th>Monto</th>
                                        <td>
                                            S/ @devolucion.Monto.ToString("N2")
                                        </td>
                                    </tr>

                                    <tr>
                                        <th>Fecha</th>
                                        <td>
                                            @devolucion.Fecha.ToString("dd/MM/yyyy")
                                        </td>
                                    </tr>

                                    <tr>
                                        <th>Banco</th>
                                        <td>@devolucion.Banco</td>
                                    </tr>

                                    <tr>
                                        <th>Operación</th>
                                        <td>@devolucion.NumeroOperacion</td>
                                    </tr>

                                    <tr>
                                        <th>Voucher</th>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(devolucion.Voucher))
                                            {
                                                <a href="@devolucion.Voucher"
                                                   target="_blank"
                                                   rel="noopener"
                                                   class="btn btn-outline-primary btn-sm voucher-link">
                                                    <i class="bi bi-file-earmark-arrow-up me-1"></i>
                                                    Ver voucher
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted">
                                                    Sin archivo
                                                </span>
                                            }
                                        </td>
                                    </tr>

                                    <tr>
                                        <th>Observaciones</th>
                                        <td>
                                            @(string.IsNullOrWhiteSpace(devolucion.Observaciones)
                                                ? "-"
                                                : devolucion.Observaciones)
                                        </td>
                                    </tr>

                                </table>
                            </div>

                            <form asp-controller="DevolucionSaldo"
                                  asp-action="Eliminar"
                                  method="post"
                                  class="mt-3">

                                <input type="hidden"
                                       name="id"
                                       value="@devolucion.IdDevolucionSaldo" />

                                <input type="hidden"
                                       name="idRendicion"
                                       value="@rendicion.IdRendicion" />

                                <button type="submit"
                                        class="btn btn-outline-danger w-100"
                                        onclick="return confirm('¿Desea eliminar la devolución registrada?');">
                                    <i class="bi bi-trash me-1"></i>
                                    Eliminar devolución
                                </button>

                            </form>
                        }

                    </div>
                </div>
            }

            <div class="panel">

                <div class="panel-header">
                    <span>
                        <i class="bi bi-lightning-charge me-2 text-primary"></i>
                        Acciones
                    </span>
                </div>

                <div class="panel-body">

                    <div class="action-stack">

                        @if (rendicion?.IdEstadoRendicion == 1)
                        {
                            var puedeEnviar =
                                rendicion.Total > 0 &&
                                (rendicion.Saldo <= 0 || devolucion != null);

                            <form asp-controller="Gasto"
                                  asp-action="EnviarRendicion"
                                  method="post">

                                <input type="hidden"
                                       name="idRendicion"
                                       value="@rendicion.IdRendicion" />

                                <button type="submit"
                                        class="btn btn-success w-100"
                                        disabled="@(puedeEnviar ? null : "disabled")"
                                        onclick="return confirm('¿Desea enviar esta rendición para revisión?');">

                                    <i class="bi bi-send-check me-1"></i>
                                    Finalizar y enviar
                                </button>

                            </form>

                            @if (rendicion.Total <= 0)
                            {
                                <p class="action-note">
                                    <i class="bi bi-exclamation-circle me-1"></i>
                                    Debe registrar al menos un gasto.
                                </p>
                            }
                            else if (rendicion.Saldo > 0 && devolucion == null)
                            {
                                <p class="action-note">
                                    <i class="bi bi-exclamation-circle me-1"></i>
                                    Debe registrar la devolución del saldo pendiente.
                                </p>
                            }
                        }

                        <a asp-controller="Rendicion"
                           asp-action="MisRendiciones"
                           class="btn btn-outline-secondary">
                            <i class="bi bi-clock-history me-1"></i>
                            Historial de rendiciones
                        </a>

                        <a asp-controller="Rendicion"
                           asp-action="Index"
                           class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>
                            Volver a rendiciones
                        </a>

                    </div>

                </div>
            </div>

        </div>

    </div>

</div>

<script>
document.addEventListener("DOMContentLoaded",function(){
    const ruc=document.getElementById("ruc");
    const btnRuc=document.getElementById("btnConsultarRuc");
    const razonSocial=document.getElementById("razonSocial");
    const domicilio=document.getElementById("domicilioFiscal");
    const mensajeRuc=document.getElementById("mensajeRuc");
    let ultimaConsulta="";

    async function consultarRuc(){
        const numero=ruc.value.trim();

        if(numero===ultimaConsulta)return;

        razonSocial.value="";
        domicilio.value="";
        mensajeRuc.textContent="";

        if(!/^\d{11}$/.test(numero)){
            mensajeRuc.textContent="Ingrese un RUC válido de 11 dígitos.";
            mensajeRuc.className="form-text text-danger";
            return;
        }

        btnRuc.disabled=true;
        btnRuc.innerHTML='<span class="spinner-border spinner-border-sm me-1"></span>Buscando...';

        try{
            const url='@Url.Action("ConsultarRuc","Gasto")'+'?ruc='+encodeURIComponent(numero);

            const response=await fetch(url,{
                method:"GET",
                headers:{"Accept":"application/json"}
            });

            let data;

            try{
                data=await response.json();
            }catch{
                throw new Error("La respuesta del servidor no es válida.");
            }

            if(!response.ok){
                throw new Error(data?.mensaje||"No se encontró el RUC.");
            }

            razonSocial.value=data?.razonSocial??"";
            domicilio.value=data?.domicilioFiscal??"";

            mensajeRuc.textContent=`Estado: ${data?.estado??"-"} | Condición: ${data?.condicion??"-"}`;
            mensajeRuc.className="form-text text-success";
            ultimaConsulta=numero;

        }catch(error){
            ultimaConsulta="";
            mensajeRuc.textContent=error.message||"No se pudo consultar el RUC.";
            mensajeRuc.className="form-text text-danger";
        }finally{
            btnRuc.disabled=false;
            btnRuc.innerHTML='<i class="bi bi-search me-1"></i>Buscar';
        }
    }

    if(ruc&&btnRuc){
        btnRuc.addEventListener("click",consultarRuc);

        ruc.addEventListener("blur",function(){
            if(/^\d{11}$/.test(ruc.value.trim())){
                consultarRuc();
            }
        });

        ruc.addEventListener("input",function(){
            ruc.value=ruc.value.replace(/\D/g,"").slice(0,11);

            if(ruc.value!==ultimaConsulta){
                ultimaConsulta="";
                razonSocial.value="";
                domicilio.value="";
                mensajeRuc.textContent="";
            }
        });
    }

    const montoTotal=document.getElementById("montoTotal");
    const exoneracion=document.getElementById("exoneracionIGV");
    const valorVenta=document.getElementById("valorVenta");
    const igv=document.getElementById("igvCalculado");
    const resumenBase=document.getElementById("resumenValorVenta");
    const resumenIgv=document.getElementById("resumenIgv");
    const resumenTotal=document.getElementById("resumenTotal");

    function calcularIgv(){
        if(!montoTotal||!valorVenta||!igv)return;

        const total=parseFloat(montoTotal.value)||0;
        let base=0;
        let impuesto=0;

        if(total>0){
            if(exoneracion?.checked){
                base=total;
            }else{
                base=Math.round((total/1.18)*100)/100;
                impuesto=Math.round((total-base)*100)/100;
            }
        }

        valorVenta.value=base.toFixed(2);
        igv.value=impuesto.toFixed(2);

        if(resumenBase)resumenBase.textContent=`S/ ${base.toFixed(2)}`;
        if(resumenIgv)resumenIgv.textContent=`S/ ${impuesto.toFixed(2)}`;
        if(resumenTotal)resumenTotal.textContent=`S/ ${total.toFixed(2)}`;
    }

    montoTotal?.addEventListener("input",calcularIgv);
    exoneracion?.addEventListener("change",calcularIgv);

    calcularIgv();
});
</script>