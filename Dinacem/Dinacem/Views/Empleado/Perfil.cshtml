@model Dinacem.Models.Usuario

@{
    ViewData["Title"] = "Mi Perfil";
    Layout = "~/Views/Shared/_LayoutEmpleado.cshtml";
}

<style>
    .perfil-wrapper {
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        padding: 25px 30px 40px;
        color: #263238;
    }

    .perfil-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        padding: 22px;
        margin-bottom: 22px;
        background: #ffffff;
        border: 1px solid #dce8f2;
        border-radius: 12px;
        box-shadow: 0 3px 12px rgba(12, 74, 138, 0.07);
    }

    .perfil-title {
        margin: 0 0 5px;
        color: #174f7c;
        font-size: 27px;
        font-weight: 700;
        letter-spacing: -0.3px;
    }

    .perfil-description {
        margin: 0;
        color: #657786;
        font-size: 14px;
        line-height: 1.5;
    }

    .perfil-card {
        height: 100%;
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #dce5eb;
        border-radius: 12px;
        box-shadow: 0 4px 14px rgba(15, 23, 42, 0.06);
    }

    .perfil-card-header {
        padding: 17px 20px;
        background: #f3f8fc;
        border-bottom: 1px solid #dce8f2;
        color: #174f7c;
        font-size: 15px;
        font-weight: 700;
    }

    .perfil-card-header i {
        color: #3186dc;
        font-size: 17px;
    }

    .perfil-card-body {
        padding: 22px;
    }

    .form-label {
        margin-bottom: 7px;
        color: #40535e;
        font-size: 12.5px;
        font-weight: 700;
    }

    .form-control {
        min-height: 44px;
        padding: 9px 12px;
        border: 1px solid #d5dfe6;
        border-radius: 7px;
        color: #34454f;
        background: #ffffff;
        font-size: 13.5px;
        box-shadow: none;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .form-control::placeholder {
        color: #a2adb5;
    }

    .form-control:focus {
        border-color: #72b1ed;
        box-shadow: 0 0 0 3px rgba(77, 157, 245, 0.12);
    }

    .readonly-box {
        min-height: 44px;
        display: flex;
        align-items: center;
        padding: 9px 12px;
        background: #f3f7fa;
        border: 1px solid #d5dfe6;
        border-radius: 7px;
        color: #526572;
        font-size: 13.5px;
        font-weight: 600;
    }

    .perfil-info {
        display: flex;
        align-items: flex-start;
        gap: 11px;
        padding: 12px 14px;
        margin-bottom: 20px;
        background: #f8fbfd;
        border: 1px solid #dce8f2;
        border-left: 4px solid #3186dc;
        border-radius: 8px;
        color: #687983;
        font-size: 12.5px;
        line-height: 1.55;
    }

    .perfil-info i {
        margin-top: 1px;
        color: #3186dc;
        font-size: 17px;
        flex-shrink: 0;
    }

    .actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 22px;
        padding-top: 20px;
        border-top: 1px solid #e7edf1;
    }

    .password-help {
        display: block;
        margin-top: 5px;
        color: #8b989f;
        font-size: 11.5px;
    }

    .password-warning {
        margin-top: 18px;
        margin-bottom: 0;
        padding: 11px 13px;
        background: #fff8e5;
        border: 1px solid #f0dfaa;
        border-radius: 7px;
        color: #8a6a16;
        font-size: 12.5px;
        line-height: 1.5;
    }

    .btn-guardar {
        min-height: 42px;
        padding: 0 17px;
        border: none;
        border-radius: 7px;
        background: #4d9df5;
        color: #ffffff;
        font-size: 13px;
        font-weight: 600;
        transition: background 0.2s ease, transform 0.2s ease;
    }

    .btn-guardar:hover {
        background: #3186dc;
        color: #ffffff;
        transform: translateY(-1px);
    }

    .btn-password {
        min-height: 42px;
        padding: 0 17px;
        border: none;
        border-radius: 7px;
        background: #e5bd45;
        color: #ffffff;
        font-size: 13px;
        font-weight: 600;
        transition: background 0.2s ease, transform 0.2s ease;
    }

    .btn-password:hover {
        background: #d1a52e;
        color: #ffffff;
        transform: translateY(-1px);
    }

    .btn-regresar {
        min-height: 42px;
        padding: 0 16px;
        border: 1px solid #d5dfe5;
        border-radius: 7px;
        background: #ffffff;
        color: #5f6f79;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    }

    .btn-regresar:hover {
        background: #f4f7f9;
        border-color: #c6d1d8;
        color: #40515b;
    }

    .perfil-card .badge {
        padding: 6px 10px;
        border-radius: 6px;
        font-size: 11px;
    }

    .mensaje-sistema {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 15px;
        margin-bottom: 18px;
        border-radius: 8px;
        font-size: 13.5px;
        font-weight: 500;
    }

    .mensaje-sistema i {
        font-size: 18px;
        flex-shrink: 0;
    }

    .mensaje-sistema .btn-close {
        margin-left: auto;
    }

    .mensaje-exito {
        background: #edf9f0;
        border: 1px solid #c9e9d1;
        color: #327942;
    }

    .mensaje-error {
        background: #fff0f0;
        border: 1px solid #f0cccc;
        color: #b83b3b;
    }

    @@media (max-width: 767.98px) {
        .perfil-wrapper {
            padding: 18px 15px 30px;
        }

        .perfil-header {
            flex-direction: column;
            align-items: flex-start;
            padding: 18px;
        }

        .perfil-header .btn-regresar {
            width: 100%;
            text-align: center;
        }

        .perfil-title {
            font-size: 23px;
        }

        .perfil-description {
            font-size: 13px;
        }

        .perfil-card-body {
            padding: 16px;
        }

        .actions {
            display: grid;
            grid-template-columns: 1fr;
        }

        .actions .btn-regresar,
        .actions .btn-guardar,
        .actions .btn-password {
            width: 100%;
            text-align: center;
        }
    }
</style>

<div class="perfil-wrapper">

    <div class="perfil-header">

        <div>
            <h1 class="perfil-title">
                <i class="bi bi-person-circle me-2"></i>
                Mi Perfil
            </h1>

            <p class="perfil-description">
                Actualice sus datos personales y cambie su contraseña cuando lo necesite.
            </p>
        </div>

        <a asp-controller="Empleado"
           asp-action="Index"
           class="btn-regresar">
            <i class="bi bi-arrow-left me-1"></i>
            Volver al panel
        </a>

    </div>

    @if (TempData["mensaje"] != null)
    {
        <div class="mensaje-sistema mensaje-exito alert alert-dismissible fade show">

            <i class="bi bi-check-circle-fill"></i>

            <span>
                @TempData["mensaje"]
            </span>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>

        </div>
    }

    @if (TempData["error"] != null)
    {
        <div class="mensaje-sistema mensaje-error alert alert-dismissible fade show">

            <i class="bi bi-exclamation-triangle-fill"></i>

            <span>
                @TempData["error"]
            </span>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>

        </div>
    }

    <div class="row g-4">

        <!-- DATOS PERSONALES -->
        <div class="col-12 col-lg-7">

            <div class="perfil-card">

                <div class="perfil-card-header">
                    <i class="bi bi-person-lines-fill me-2"></i>
                    Datos personales
                </div>

                <div class="perfil-card-body">

                    <div class="perfil-info">

                        <i class="bi bi-info-circle-fill"></i>

                        <div>
                            Puede modificar sus datos personales.
                            El usuario de acceso, rol, zona y estado son administrados por el sistema.
                        </div>

                    </div>

                    <form asp-controller="Empleado"
                          asp-action="ActualizarPerfil"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div class="row g-3">

                            <!-- USUARIO -->
                            <div class="col-12 col-md-6">

                                <label class="form-label">
                                    Usuario de acceso
                                </label>

                                <div class="readonly-box">
                                    @(string.IsNullOrWhiteSpace(Model.UsuarioAcceso)
                                        ? "Sin usuario"
                                        : Model.UsuarioAcceso)
                                </div>

                            </div>

                            <!-- ROL -->
                            <div class="col-12 col-md-6">

                                <label class="form-label">
                                    Rol
                                </label>

                                <div class="readonly-box">
                                    @(Model.Rol?.Nombre ?? "Sin rol")
                                </div>

                            </div>

                            <!-- NOMBRES -->
                            <div class="col-12 col-md-6">

                                <label class="form-label">
                                    Nombres
                                </label>

                                <input type="text"
                                       name="nombres"
                                       class="form-control"
                                       maxlength="100"
                                       value="@Model.Nombres"
                                       required />

                            </div>

                            <!-- APELLIDOS -->
                            <div class="col-12 col-md-6">

                                <label class="form-label">
                                    Apellidos
                                </label>

                                <input type="text"
                                       name="apellidos"
                                       class="form-control"
                                       maxlength="100"
                                       value="@Model.Apellidos"
                                       required />

                            </div>

                            <!-- CORREO -->
                            <div class="col-12 col-md-6">

                                <label class="form-label">
                                    Correo
                                </label>

                                <input type="email"
                                       name="correo"
                                       class="form-control"
                                       maxlength="150"
                                       value="@Model.Correo"
                                       required />

                            </div>

                            <!-- CELULAR -->
                            <div class="col-12 col-md-6">

                                <label class="form-label">
                                    Celular
                                </label>

                                <input type="tel"
                                       name="celular"
                                       class="form-control"
                                       maxlength="20"
                                       value="@Model.Celular"
                                       placeholder="Ej. 999999999" />

                            </div>

                            <!-- ZONA -->
                            <div class="col-12">

                                <label class="form-label">
                                    Zona
                                </label>

                                <div class="readonly-box">
                                    @(Model.Zona?.CodigoZona ?? "Sin zona asignada")
                                </div>

                            </div>

                            <!-- ESTADO -->
                            <div class="col-12">

                                <label class="form-label">
                                    Estado
                                </label>

                                <div class="readonly-box">

                                    @if (Model.Estado)
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle-fill me-1"></i>
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            <i class="bi bi-x-circle-fill me-1"></i>
                                            Inactivo
                                        </span>
                                    }

                                </div>

                            </div>

                        </div>

                        <div class="actions">

                            

                            <button type="submit"
                                    class="btn-guardar">
                                <i class="bi bi-save-fill me-1"></i>
                                Guardar cambios
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

        <!-- CAMBIO DE CONTRASEÑA -->
        <div class="col-12 col-lg-5">

            <div class="perfil-card">

                <div class="perfil-card-header">
                    <i class="bi bi-shield-lock-fill me-2"></i>
                    Cambiar contraseña
                </div>

                <div class="perfil-card-body">

                    <form asp-controller="Empleado"
                          asp-action="CambiarContrasenia"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div class="mb-3">

                            <label class="form-label">
                                Contraseña actual
                            </label>

                            <input type="password"
                                   name="contraseniaActual"
                                   class="form-control"
                                   autocomplete="current-password"
                                   required />

                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Nueva contraseña
                            </label>

                            <input type="password"
                                   name="nuevaContrasenia"
                                   class="form-control"
                                   minlength="6"
                                   autocomplete="new-password"
                                   required />

                            <span class="password-help">
                                Debe tener al menos 6 caracteres.
                            </span>

                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Confirmar nueva contraseña
                            </label>

                            <input type="password"
                                   name="confirmarContrasenia"
                                   class="form-control"
                                   minlength="6"
                                   autocomplete="new-password"
                                   required />

                        </div>

                        <div class="password-warning">

                            <i class="bi bi-exclamation-triangle-fill me-1"></i>

                            La nueva contraseña debe ser diferente a la actual.

                        </div>

                        <div class="actions">

                            <button type="submit"
                                    class="btn-password">

                                <i class="bi bi-key-fill me-1"></i>

                                Cambiar contraseña

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>