@model Dinacem.Models.ReporteGeneral

@{
    ViewData["Title"] = "Reportes de Viáticos";
    Layout = "~/Views/Shared/_LayoutAdministrador.cshtml";
}


<style>

    /* ============================================================
           CONTENEDOR PRINCIPAL
           ============================================================ */

    .reportes-container {
        width: 100%;
        max-width: 1600px;
        margin: 0 auto;
    }


    /* ============================================================
           ENCABEZADO
           ============================================================ */

    .reportes-header {
        position: relative;
        overflow: hidden;
        background: linear-gradient( 135deg, #073763 0%, #0C4A8A 45%, #155E9E 75%, #1D4ED8 100% );
        color: #ffffff;
        border-radius: 20px;
        padding: 30px 32px;
        margin-bottom: 25px;
        box-shadow: 0 16px 40px rgba(12,74,138,.18);
    }


        .reportes-header::before {
            content: "";
            position: absolute;
            width: 300px;
            height: 300px;
            right: -110px;
            top: -170px;
            border-radius: 50%;
            background: rgba(255,255,255,.08);
        }


    .reportes-header-content {
        position: relative;
        z-index: 2;
    }


    .reportes-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 6px 11px;
        margin-bottom: 10px;
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.18);
        border-radius: 20px;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .6px;
        text-transform: uppercase;
    }


    .reportes-title {
        margin: 0;
        font-size: 29px;
        font-weight: 800;
        letter-spacing: -.5px;
    }


    .reportes-description {
        max-width: 700px;
        margin: 8px 0 0;
        color: rgba(255,255,255,.84);
        font-size: 14px;
        line-height: 1.55;
    }


    /* ============================================================
           FILTROS
           ============================================================ */

    .reportes-panel {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 17px;
        padding: 22px;
        box-shadow: 0 5px 18px rgba(15,23,42,.045);
    }


    .reportes-panel-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 18px;
    }


    .reportes-panel-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border-radius: 10px;
        color: #0C4A8A;
        background: #dbeafe;
        font-size: 17px;
    }


    .reportes-panel-title h2 {
        margin: 0;
        color: #0f172a;
        font-size: 16px;
        font-weight: 800;
    }


    .reportes-panel-title span {
        display: block;
        margin-top: 2px;
        color: #64748b;
        font-size: 11px;
    }


    .reportes-label {
        margin-bottom: 6px;
        color: #334155;
        font-size: 12px;
        font-weight: 700;
    }


    .reportes-input {
        height: 43px;
        border: 1px solid #dbe3ec;
        border-radius: 10px;
        font-size: 13px;
        transition: border-color .2s ease, box-shadow .2s ease;
    }


        .reportes-input:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37,99,235,.10);
        }


    .reportes-search-btn {
        height: 43px;
        border: 0;
        border-radius: 10px;
        background: #0C4A8A;
        font-size: 13px;
        font-weight: 700;
        transition: transform .2s ease, box-shadow .2s ease, background .2s ease;
    }


        .reportes-search-btn:hover {
            background: #083763;
            transform: translateY(-2px);
            box-shadow: 0 7px 16px rgba(12,74,138,.18);
        }


    /* ============================================================
           INDICADORES
           ============================================================ */

    .reportes-indicator {
        position: relative;
        height: 100%;
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 19px;
        box-shadow: 0 5px 16px rgba(15,23,42,.045);
        transition: transform .25s ease, box-shadow .25s ease;
    }


        .reportes-indicator:hover {
            transform: translateY(-4px);
            box-shadow: 0 13px 28px rgba(15,23,42,.08);
        }


    .reportes-indicator-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }


    .reportes-indicator-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        border-radius: 11px;
        font-size: 18px;
    }


    .reportes-indicator-label {
        display: block;
        margin-top: 14px;
        color: #64748b;
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .45px;
    }


    .reportes-indicator-value {
        display: block;
        margin-top: 4px;
        color: #0f172a;
        font-size: 25px;
        font-weight: 800;
    }


    .indicator-blue {
        color: #1d4ed8;
        background: #dbeafe;
    }


    .indicator-green {
        color: #15803d;
        background: #dcfce7;
    }


    .indicator-purple {
        color: #6d28d9;
        background: #ede9fe;
    }


    .indicator-red {
        color: #b91c1c;
        background: #fee2e2;
    }


    /* ============================================================
           TABLA
           ============================================================ */

    .reportes-table-wrapper {
        overflow-x: auto;
    }


    .reportes-table {
        margin: 0;
        font-size: 12px;
    }


        .reportes-table thead th {
            padding: 13px 11px;
            color: #475569;
            background: #f8fafc;
            border-bottom: 1px solid #e2e8f0;
            font-size: 10px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .3px;
            white-space: nowrap;
        }


        .reportes-table tbody td {
            padding: 13px 11px;
            color: #334155;
            border-color: #edf2f7;
            vertical-align: middle;
        }


        .reportes-table tbody tr {
            transition: background .2s ease;
        }


            .reportes-table tbody tr:hover {
                background: #f8fbff;
            }


    .reporte-codigo {
        color: #0C4A8A;
        font-weight: 800;
    }


    .reporte-monto {
        color: #0f172a;
        font-weight: 800;
        white-space: nowrap;
    }


    .reporte-estado {
        padding: 5px 9px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 700;
    }


    /* ============================================================
           ACCESOS A REPORTES
           ============================================================ */

    .reportes-section-title {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 15px;
    }


        .reportes-section-title h2 {
            margin: 0;
            color: #0f172a;
            font-size: 19px;
            font-weight: 800;
        }


        .reportes-section-title i {
            color: #0C4A8A;
            font-size: 20px;
        }


    .report-card {
        display: block;
        height: 100%;
        padding: 20px;
        color: inherit;
        text-decoration: none;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        box-shadow: 0 5px 16px rgba(15,23,42,.045);
        transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
    }


        .report-card:hover {
            color: inherit;
            transform: translateY(-5px);
            border-color: #bfdbfe;
            box-shadow: 0 15px 30px rgba(15,23,42,.09);
        }


    .report-card-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        border-radius: 13px;
        font-size: 21px;
    }


    .report-card h3 {
        margin: 15px 0 6px;
        color: #0f172a;
        font-size: 15px;
        font-weight: 800;
    }


    .report-card p {
        margin: 0;
        color: #64748b;
        font-size: 12px;
        line-height: 1.5;
    }


    .report-card-arrow {
        display: block;
        margin-top: 15px;
        color: #94a3b8;
        font-size: 12px;
        transition: color .2s ease, transform .2s ease;
    }


    .report-card:hover .report-card-arrow {
        color: #2563eb;
        transform: translateX(3px);
    }


    /* ============================================================
           RESPONSIVE
           ============================================================ */

    @@media (max-width: 767.98px) {

        .reportes-header {
            padding: 24px 20px;
            border-radius: 16px;
        }


        .reportes-title {
            font-size: 23px;
        }


        .reportes-description {
            font-size: 13px;
        }


        .reportes-panel {
            padding: 18px;
        }


        .reportes-indicator {
            padding: 17px;
        }
    }


    @@media (max-width: 575.98px) {

        .reportes-header {
            padding: 21px 17px;
        }


        .reportes-title {
            font-size: 21px;
        }


        .reportes-indicator-value {
            font-size: 22px;
        }


        .report-card {
            padding: 18px;
        }
    }

</style>


<div class="reportes-container">


    <!-- =========================================================
         ENCABEZADO
         ========================================================= -->

    <section class="reportes-header">

        <div class="reportes-header-content">

            <span class="reportes-badge">

                <i class="bi bi-bar-chart-line-fill"></i>

                Centro de reportes

            </span>


            <h1 class="reportes-title">

                Reportes de Viáticos

            </h1>

        </div>

    </section>


    <!-- =========================================================
         FILTROS
         ========================================================= -->

    <section class="dashboard-section">

        <div class="reportes-panel">

            <div class="reportes-panel-title">

                <div class="reportes-panel-icon">

                    <i class="bi bi-funnel-fill"></i>

                </div>

                <div>

                    <h2>
                        Filtros de búsqueda
                    </h2>

                    <span>
                        Seleccione el período que desea consultar
                    </span>

                </div>

            </div>


            <form method="get"
                  asp-action="Index">

                <div class="row g-3">


                    <div class="col-12 col-md-4">

                        <label class="reportes-label">
                            Fecha de inicio
                        </label>

                        <input type="date"
                               name="fechaInicio"
                               class="form-control reportes-input"
                               value="@Model.FechaInicio?.ToString("yyyy-MM-dd")" />

                    </div>


                    <div class="col-12 col-md-4">

                        <label class="reportes-label">
                            Fecha de fin
                        </label>

                        <input type="date"
                               name="fechaFin"
                               class="form-control reportes-input"
                               value="@Model.FechaFin?.ToString("yyyy-MM-dd")" />

                    </div>


                    <div class="col-12 col-md-4 d-flex align-items-end">

                        <button type="submit"
                                class="btn btn-primary reportes-search-btn w-100">

                            <i class="bi bi-search me-1"></i>

                            Consultar reporte

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </section>


    <!-- =========================================================
         INDICADORES
         ========================================================= -->

    <section class="dashboard-section">

        <div class="row g-3">


            <!-- SOLICITUDES -->

            <div class="col-12 col-sm-6 col-xl-3">

                <div class="reportes-indicator">

                    <div class="reportes-indicator-top">

                        <div class="reportes-indicator-icon indicator-blue">

                            <i class="bi bi-file-earmark-text-fill"></i>

                        </div>

                    </div>


                    <span class="reportes-indicator-label">

                        Solicitudes

                    </span>


                    <strong class="reportes-indicator-value">

                        @Model.TotalSolicitudes

                    </strong>

                </div>

            </div>


            <!-- APROBADAS -->

            <div class="col-12 col-sm-6 col-xl-3">

                <div class="reportes-indicator">

                    <div class="reportes-indicator-top">

                        <div class="reportes-indicator-icon indicator-green">

                            <i class="bi bi-check-circle-fill"></i>

                        </div>

                    </div>


                    <span class="reportes-indicator-label">

                        Solicitudes aprobadas

                    </span>


                    <strong class="reportes-indicator-value">

                        @Model.SolicitudesAprobadas

                    </strong>

                </div>

            </div>


            <!-- TOTAL SOLICITADO -->

            <div class="col-12 col-sm-6 col-xl-3">

                <div class="reportes-indicator">

                    <div class="reportes-indicator-top">

                        <div class="reportes-indicator-icon indicator-purple">

                            <i class="bi bi-cash-stack"></i>

                        </div>

                    </div>


                    <span class="reportes-indicator-label">

                        Total solicitado

                    </span>


                    <strong class="reportes-indicator-value">

                        S/ @Model.TotalSolicitado.ToString("N2")

                    </strong>

                </div>

            </div>


            <!-- SALDO -->

            <div class="col-12 col-sm-6 col-xl-3">

                <div class="reportes-indicator">

                    <div class="reportes-indicator-top">

                        <div class="reportes-indicator-icon indicator-red">

                            <i class="bi bi-wallet2"></i>

                        </div>

                    </div>


                    <span class="reportes-indicator-label">

                        Saldo pendiente

                    </span>


                    <strong class="reportes-indicator-value">

                        S/ @Model.SaldoPendiente.ToString("N2")

                    </strong>

                </div>

            </div>


        </div>

    </section>


    <!-- =========================================================
         DETALLE
         ========================================================= -->

    <section class="dashboard-section">

        <div class="reportes-panel">


            <div class="reportes-panel-title">

                <div class="reportes-panel-icon">

                    <i class="bi bi-list-ul"></i>

                </div>

                <div>

                    <h2>
                        Detalle de solicitudes
                    </h2>

                    <span>
                        Registros incluidos en el período seleccionado
                    </span>

                </div>

            </div>


            <div class="reportes-table-wrapper">

                <table class="table reportes-table align-middle">

                    <thead>

                        <tr>

                            <th>Código</th>

                            <th>Usuario</th>

                            <th>Motivo</th>

                            <th>Destino</th>

                            <th>Salida</th>

                            <th>Retorno</th>

                            <th>Monto</th>

                            <th>Estado</th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model.Detalles != null &&
                             Model.Detalles.Any())
                        {

                            foreach (var item in Model.Detalles)
                            {

                                <tr>

                                    <td>

                                        <span class="reporte-codigo">

                                            SOL-@item.IdSolicitud.ToString("000")

                                        </span>

                                    </td>


                                    <td>

                                        @item.Usuario

                                    </td>


                                    <td>

                                        @item.Motivo

                                    </td>


                                    <td>

                                        @item.Destino

                                    </td>


                                    <td>

                                        @item.FechaInicio.ToString("dd/MM/yyyy")

                                    </td>


                                    <td>

                                        @item.FechaFin.ToString("dd/MM/yyyy")

                                    </td>


                                    <td>

                                        <span class="reporte-monto">

                                            S/ @item.MontoSolicitado.ToString("N2")

                                        </span>

                                    </td>


                                    <td>

                                        @if (item.Estado == "Aprobado")
                                        {

                                            <span class="badge bg-success reporte-estado">

                                                @item.Estado

                                            </span>

                                        }
                                        else if (item.Estado == "Pendiente")
                                        {

                                            <span class="badge bg-warning text-dark reporte-estado">

                                                @item.Estado

                                            </span>

                                        }
                                        else if (item.Estado == "Rechazado")
                                        {

                                            <span class="badge bg-danger reporte-estado">

                                                @item.Estado

                                            </span>

                                        }
                                        else
                                        {

                                            <span class="badge bg-secondary reporte-estado">

                                                @item.Estado

                                            </span>

                                        }

                                    </td>

                                </tr>

                            }

                        }
                        else
                        {

                            <tr>

                                <td colspan="8"
                                    class="text-center text-muted py-4">

                                    <i class="bi bi-inbox fs-4 d-block mb-2"></i>

                                    No existen registros para el período seleccionado.

                                </td>

                            </tr>

                        }

                    </tbody>

                </table>

            </div>

        </div>

    </section>


    <!-- =========================================================
         ACCESOS A REPORTES
         ========================================================= -->

    <section class="dashboard-section">


        <div class="reportes-section-title">

            <i class="bi bi-grid-fill"></i>

            <h2>
                Reportes disponibles
            </h2>

        </div>


        <div class="row g-3">


            <!-- RENDICIONES -->

            <div class="col-12 col-md-6 col-xl-3">

                <a asp-controller="Reporte"
                   asp-action="Rendiciones"
                   class="report-card">

                    <div class="report-card-icon indicator-green">

                        <i class="bi bi-wallet2"></i>

                    </div>


                    <h3>
                        Rendiciones
                    </h3>


                    <p>
                        Control del dinero entregado,
                        rendido y liquidado.
                    </p>


                    <span class="report-card-arrow">

                        Ver reporte

                        <i class="bi bi-arrow-right"></i>

                    </span>

                </a>

            </div>


            <!-- GASTOS -->

            <div class="col-12 col-md-6 col-xl-3">

                <a asp-controller="Reporte"
                   asp-action="Gastos"
                   class="report-card">

                    <div class="report-card-icon indicator-purple">

                        <i class="bi bi-cash-stack"></i>

                    </div>


                    <h3>
                        Gastos por tipo
                    </h3>


                    <p>
                        Consulte alimentación,
                        transporte, hospedaje y otros gastos.
                    </p>


                    <span class="report-card-arrow">

                        Ver reporte

                        <i class="bi bi-arrow-right"></i>

                    </span>

                </a>

            </div>


            <!-- USUARIOS -->

            <div class="col-12 col-md-6 col-xl-3">

                <a asp-controller="Reporte"
                   asp-action="Usuarios"
                   class="report-card">

                    <div class="report-card-icon indicator-blue">

                        <i class="bi bi-people-fill"></i>

                    </div>


                    <h3>
                        Reporte por usuario
                    </h3>


                    <p>
                        Analice los viáticos y gastos
                        registrados por trabajador.
                    </p>


                    <span class="report-card-arrow">

                        Ver reporte

                        <i class="bi bi-arrow-right"></i>

                    </span>

                </a>

            </div>


            <!-- REEMBOLSOS -->

            <div class="col-12 col-md-6 col-xl-3">

                <a asp-controller="Reporte"
                   asp-action="Reembolsos"
                   class="report-card">

                    <div class="report-card-icon indicator-red">

                        <i class="bi bi-cash-coin"></i>

                    </div>


                    <h3>
                        Reembolsos
                    </h3>


                    <p>
                        Seguimiento de solicitudes,
                        pagos y operaciones de reembolso.
                    </p>


                    <span class="report-card-arrow">

                        Ver reporte

                        <i class="bi bi-arrow-right"></i>

                    </span>

                </a>

            </div>


        </div>

    </section>


    <!-- =========================================================
         EXPORTACIÓN
         ========================================================= -->

    <section class="dashboard-section">

        <div class="reportes-panel">

            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">

                <div>

                    <div class="reportes-panel-title mb-0">

                        <div class="reportes-panel-icon">

                            <i class="bi bi-file-earmark-pdf-fill"></i>

                        </div>

                        <div>

                            <h2>
                                Exportar información
                            </h2>

                            <span>
                                Genere el reporte general en formato PDF.
                            </span>

                        </div>

                    </div>

                </div>


                <div>

                    <a asp-controller="Reporte"
                       asp-action="ExportarGeneralPdf"
                       class="btn btn-danger rounded-pill px-4">

                        <i class="bi bi-file-earmark-pdf-fill me-1"></i>

                        Exportar PDF

                    </a>

                </div>

            </div>

        </div>

    </section>


</div>