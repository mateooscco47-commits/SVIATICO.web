@model Dinacem.Models.ReporteGeneral


@{
    ViewData["Title"] = "Reporte General de Viáticos";
    Layout = "~/Views/Shared/_LayoutAdministrador.cshtml";
}



<div class="container-fluid">


   <!-- ===========================================
    ENCABEZADO DEL MÓDULO DE REPORTES
=========================================== -->

<div class="card shadow-sm border-0 mb-4">

    <div class="card-body">

        <div class="d-flex justify-content-between align-items-center flex-wrap">

            <div>

                <span class="badge bg-primary mb-2">

                    MÓDULO DE REPORTES

                </span>

                <h2 class="fw-bold text-dark mb-1">

                    <i class="bi bi-bar-chart-line-fill text-primary me-2"></i>

                    Reporte General de Viáticos

                </h2>

                <p class="text-muted mb-0">

                    Consulte indicadores, estadísticas y el estado general de los viáticos registrados en el sistema DINACEN.

                </p>

            </div>

            <div class="mt-3 mt-md-0">

                <a asp-controller="Reporte"
                   asp-action="ExportarGeneralPdf"
                   class="btn btn-danger rounded-pill px-4">

                    <i class="bi bi-file-earmark-pdf-fill"></i>

                    Exportar PDF

                </a>

            </div>

        </div>

    </div>

</div>





    <!-- FILTROS -->

    <div class="card shadow-sm mb-4">


        <div class="card-header">

            <strong>

                Filtros de búsqueda

            </strong>


        </div>



        <div class="card-body">


            <form method="get"
                  asp-action="Index">


                <div class="row g-3">


                    <div class="col-md-4">


                        <label class="form-label">

                            Fecha inicio

                        </label>


                        <input type="date"
                               name="fechaInicio"
                               class="form-control"
                               value="@Model.FechaInicio?.ToString("yyyy-MM-dd")" />


                    </div>





                    <div class="col-md-4">


                        <label class="form-label">

                            Fecha fin

                        </label>


                        <input type="date"
                               name="fechaFin"
                               class="form-control"
                               value="@Model.FechaFin?.ToString("yyyy-MM-dd")" />


                    </div>





                    <div class="col-md-4 d-flex align-items-end">


                        <button class="btn btn-primary w-100">


                            <i class="bi bi-search"></i>

                            Buscar


                        </button>


                    </div>



                </div>


            </form>


        </div>


    </div>







    <!-- INDICADORES -->


    <div class="row g-4 mb-4">


        <div class="col-md-3">


            <div class="card shadow-sm border-0">


                <div class="card-body">


                    <small class="text-muted">

                        Solicitudes

                    </small>


                    <h3 class="fw-bold">

                        @Model.TotalSolicitudes

                    </h3>


                </div>


            </div>


        </div>





        <div class="col-md-3">


            <div class="card shadow-sm border-0">


                <div class="card-body">


                    <small class="text-muted">

                        Aprobadas

                    </small>


                    <h3 class="fw-bold text-success">

                        @Model.SolicitudesAprobadas

                    </h3>


                </div>


            </div>


        </div>





        <div class="col-md-3">


            <div class="card shadow-sm border-0">


                <div class="card-body">


                    <small class="text-muted">

                        Total solicitado

                    </small>


                    <h4 class="fw-bold">

                        S/
                        @Model.TotalSolicitado.ToString("N2")

                    </h4>


                </div>


            </div>


        </div>





        <div class="col-md-3">


            <div class="card shadow-sm border-0">


                <div class="card-body">


                    <small class="text-muted">

                        Saldo pendiente

                    </small>


                    <h4 class="fw-bold text-danger">

                        S/
                        @Model.SaldoPendiente.ToString("N2")

                    </h4>


                </div>


            </div>


        </div>



    </div>








    <!-- TABLA -->



    <div class="card shadow-sm">


        <div class="card-header">


            <strong>

                Detalle de solicitudes

            </strong>


        </div>



        <div class="card-body table-responsive">


            <table class="table table-hover align-middle">


                <thead class="table-light">


                    <tr>


                        <th>
                            Código
                        </th>


                        <th>
                            Usuario
                        </th>


                        <th>
                            Motivo
                        </th>


                        <th>
                            Destino
                        </th>


                        <th>
                            Salida
                        </th>


                        <th>
                            Retorno
                        </th>


                        <th>
                            Monto
                        </th>


                        <th>
                            Estado
                        </th>


                    </tr>


                </thead>



                <tbody>


                @if(Model.Detalles != null &&
                    Model.Detalles.Any())
                {


                    foreach(var item in Model.Detalles)
                    {

                        <tr>


                            <td>

                                SOL-@item.IdSolicitud.ToString("000")

                            </td>



                            <td>

                                @item.Usuario

                            </td>



                            <td>

                                @item.Motivo

                            </td>



                            <td>

                                @item.Destino

                            </td>



                            <td>

                                @item.FechaInicio.ToString("dd/MM/yyyy")

                            </td>



                            <td>

                                @item.FechaFin.ToString("dd/MM/yyyy")

                            </td>



                            <td>

                                S/
                                @item.MontoSolicitado.ToString("N2")

                            </td>



                            <td>


                                @if(item.Estado=="Aprobado")
                                {

                                    <span class="badge bg-success">

                                        @item.Estado

                                    </span>

                                }
                                else if(item.Estado=="Pendiente")
                                {

                                    <span class="badge bg-warning text-dark">

                                        @item.Estado

                                    </span>

                                }
                                else
                                {

                                    <span class="badge bg-secondary">

                                        @item.Estado

                                    </span>

                                }


                            </td>


                        </tr>

                    }


                }
                else
                {

                    <tr>

                        <td colspan="8"
                            class="text-center text-muted">

                            No existen registros

                        </td>


                    </tr>

                }


                </tbody>


            </table>


        </div>


    </div>



</div>
<!-- =======================================================
     ACCESOS RÁPIDOS A REPORTES
======================================================== -->

<div class="row mb-4">

    <div class="col-12">

        <h4 class="fw-bold text-primary mb-3">

            <i class="bi bi-grid"></i>

            Módulo de Reportes

        </h4>

    </div>

    <!-- DASHBOARD -->

    <div class="col-lg-4 col-md-6 mb-3">

        <a asp-controller="Reporte"
           asp-action="Dashboard"
           class="text-decoration-none">

            <div class="card shadow-sm border-0 h-100 report-card">

                <div class="card-body text-center">

                    <i class="bi bi-speedometer2 display-4 text-primary"></i>

                    <h5 class="mt-3">

                        Dashboard Ejecutivo

                    </h5>

                    <small class="text-muted">

                        Indicadores y gráficos generales.

                    </small>

                </div>

            </div>

        </a>

    </div>



    <!-- RENDICIONES -->

    <div class="col-lg-4 col-md-6 mb-3">

        <a asp-controller="Reporte"
           asp-action="Rendiciones"
           class="text-decoration-none">

            <div class="card shadow-sm border-0 h-100 report-card">

                <div class="card-body text-center">

                    <i class="bi bi-wallet2 display-4 text-success"></i>

                    <h5 class="mt-3">

                        Rendiciones

                    </h5>

                    <small class="text-muted">

                        Control del dinero entregado y rendido.

                    </small>

                </div>

            </div>

        </a>

    </div>



    <!-- GASTOS -->

    <div class="col-lg-4 col-md-6 mb-3">

        <a asp-controller="Reporte"
           asp-action="Gastos"
           class="text-decoration-none">

            <div class="card shadow-sm border-0 h-100 report-card">

                <div class="card-body text-center">

                    <i class="bi bi-cash-stack display-4 text-warning"></i>

                    <h5 class="mt-3">

                        Gastos por Tipo

                    </h5>

                    <small class="text-muted">

                        Alimentación, transporte, hospedaje, etc.

                    </small>

                </div>

            </div>

        </a>

    </div>



    <!-- USUARIOS -->

    <div class="col-lg-4 col-md-6 mb-3">

        <a asp-controller="Reporte"
           asp-action="Usuarios"
           class="text-decoration-none">

            <div class="card shadow-sm border-0 h-100 report-card">

                <div class="card-body text-center">

                    <i class="bi bi-people-fill display-4 text-info"></i>

                    <h5 class="mt-3">

                        Reporte por Usuario

                    </h5>

                    <small class="text-muted">

                        Estadísticas por trabajador.

                    </small>

                </div>

            </div>

        </a>

    </div>



    <!-- PENDIENTES -->

    <div class="col-lg-4 col-md-6 mb-3">

        <a asp-controller="Reporte"
           asp-action="Pendientes"
           class="text-decoration-none">

            <div class="card shadow-sm border-0 h-100 report-card">

                <div class="card-body text-center">

                    <i class="bi bi-hourglass-split display-4 text-danger"></i>

                    <h5 class="mt-3">

                        Solicitudes Pendientes

                    </h5>

                    <small class="text-muted">

                        Solicitudes que esperan aprobación.

                    </small>

                </div>

            </div>

        </a>

    </div>



    <!-- REEMBOLSOS -->

    <div class="col-lg-4 col-md-6 mb-3">

        <a asp-controller="Reporte"
           asp-action="Reembolsos"
           class="text-decoration-none">

            <div class="card shadow-sm border-0 h-100 report-card">

                <div class="card-body text-center">

                    <i class="bi bi-cash-coin display-4 text-secondary"></i>

                    <h5 class="mt-3">

                        Reembolsos

                    </h5>

                    <small class="text-muted">

                        Seguimiento de reembolsos realizados.

                    </small>

                </div>

            </div>

        </a>

    </div>

</div>