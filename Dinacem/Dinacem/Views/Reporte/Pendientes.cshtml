@model List<Dinacem.Models.Reporte.ReportePendiente>

@{
    ViewData["Title"] = "Solicitudes Pendientes";
    Layout = "~/Views/Shared/_LayoutAdministrador.cshtml";
}

<!-- ===========================================
    ENCABEZADO DEL REPORTE
=========================================== -->

<div class="d-flex justify-content-between align-items-center mb-4">

    <div class="d-flex align-items-center">

        <a asp-controller="Reporte"
           asp-action="Index"
           class="btn btn-outline-primary rounded-pill me-3">

            <i class="bi bi-arrow-left-circle"></i>

            Volver

        </a>

        <div>

            <h2 class="fw-bold text-primary mb-0">

                <i class="bi bi-hourglass-split me-2"></i>

                Solicitudes Pendientes

            </h2>

            <small class="text-muted">

                Sistema de Viáticos DINACEN

            </small>

        </div>

    </div>



    <div>

        <a asp-controller="Reporte"
           asp-action="ExportarPendientesPdf"
           class="btn btn-danger rounded-pill">

            <i class="bi bi-file-earmark-pdf-fill"></i>

            Exportar PDF

        </a>

    </div>

</div>

<hr class="mb-4" />


    <!-- KPIs -->

    <div class="row mb-4">

        <div class="col-md-3">

            <div class="card shadow-sm border-0">

                <div class="card-body">

                    <small class="text-muted">

                        Solicitudes Pendientes

                    </small>

                    <h3 class="fw-bold text-warning">

                        @Model.Count

                    </h3>

                </div>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card shadow-sm border-0">

                <div class="card-body">

                    <small class="text-muted">

                        Monto Total

                    </small>

                    <h3 class="fw-bold text-success">

                        S/ @(Model.Sum(x => x.Monto).ToString("N2"))

                    </h3>

                </div>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card shadow-sm border-0">

                <div class="card-body">

                    <small class="text-muted">

                        Promedio

                    </small>

                    <h3 class="fw-bold text-primary">

                        S/
                        @(Model.Any()
                            ? Model.Average(x => x.Monto).ToString("N2")
                            : "0.00")

                    </h3>

                </div>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card shadow-sm border-0">

                <div class="card-body">

                    <small class="text-muted">

                        Más Antiguo

                    </small>

                    <h3 class="fw-bold text-danger">

                        @(Model.Any()
                            ? Model.Min(x => x.Fecha).ToString("dd/MM/yyyy")
                            : "--")

                    </h3>

                </div>

            </div>

        </div>

    </div>



    <!-- TABLA -->

    <div class="card shadow-sm">

        <div class="card-header fw-bold">

            <i class="bi bi-list-check"></i>

            Solicitudes esperando aprobación

        </div>

        <div class="card-body table-responsive">

            <table class="table table-hover align-middle">

                <thead class="table-light">

                    <tr>

                        <th>Código</th>

                        <th>Solicitante</th>

                        <th>Destino</th>

                        <th>Monto</th>

                        <th>Fecha</th>

                        <th class="text-center">Estado</th>

                        <th class="text-center">Acciones</th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {

                            <tr>

                                <td>

                                    <strong>

                                        @item.Codigo

                                    </strong>

                                </td>

                                <td>

                                    @item.Solicitante

                                </td>

                                <td>

                                    @item.Destino

                                </td>

                                <td>

                                    <span class="fw-bold text-success">

                                        S/ @item.Monto.ToString("N2")

                                    </span>

                                </td>

                                <td>

                                    @item.Fecha.ToString("dd/MM/yyyy")

                                </td>

                                <td class="text-center">

                                    <span class="badge bg-warning text-dark">

                                        Pendiente

                                    </span>

                                </td>

                                <td class="text-center">

                                    <div class="btn-group">

                                        <a asp-controller="Solicitud"
                                           asp-action="Details"
                                           asp-route-id="@item.IdSolicitud"
                                           class="btn btn-primary btn-sm">

                                            <i class="bi bi-eye"></i>

                                        </a>

                                        <a asp-controller="Solicitud"
                                           asp-action="Aprobar"
                                           asp-route-id="@item.IdSolicitud"
                                           class="btn btn-success btn-sm">

                                            <i class="bi bi-check-circle"></i>

                                        </a>

                                        <a asp-controller="Solicitud"
                                           asp-action="Rechazar"
                                           asp-route-id="@item.IdSolicitud"
                                           class="btn btn-danger btn-sm">

                                            <i class="bi bi-x-circle"></i>

                                        </a>

                                    </div>

                                </td>

                            </tr>

                        }
                    }
                    else
                    {

                        <tr>

                            <td colspan="7"
                                class="text-center py-5">

                                <i class="bi bi-check-circle-fill text-success fs-1"></i>

                                <br />

                                <strong>

                                    No existen solicitudes pendientes.

                                </strong>

                            </td>

                        </tr>

                    }

                </tbody>

            </table>

        </div>

    </div>

</div>