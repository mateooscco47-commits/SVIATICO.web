@{
    Layout = null;
    ViewData["Title"] = "Administración";
}

<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>
        Administración | TelegramCatalogo
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>

        body {
            min-height: 100vh;
            background: #f4f7fb;
        }

        .login-container {
            min-height: 100vh;
        }

        .login-card {
            max-width: 430px;
            width: 100%;
            border-radius: 18px;
        }

        .telegram-logo {
            width: 75px;
            height: 75px;
        }

    </style>

</head>

<body>

    <div class="container">

        <div class="row
                    justify-content-center
                    align-items-center
                    login-container">

            <div class="col-md-6 col-lg-5">

                <div class="card
                            border-0
                            shadow
                            login-card
                            mx-auto">

                    <div class="card-body p-4 p-md-5">

                        <!-- LOGO -->

                        <div class="text-center mb-4">

                            <div class="telegram-logo
                                        rounded-circle
                                        bg-primary
                                        text-white
                                        d-flex
                                        justify-content-center
                                        align-items-center
                                        mx-auto
                                        mb-3">

                                <i class="bi bi-telegram fs-1"></i>

                            </div>

                            <h2 class="fw-bold">
                                Administración
                            </h2>

                            <p class="text-muted">
                                Ingresa para administrar el catálogo.
                            </p>

                        </div>


                        <!-- ERROR -->
                        @if (ViewBag.Error != null)
                        {
                            <div class="alert alert-danger">

                                <i class="bi bi-exclamation-circle me-1"></i>

                                @ViewBag.Error

                            </div>
                        }


                        <!-- FORMULARIO -->

                        <form method="post"
                              asp-controller="Admin"
                              asp-action="Login">

                            @Html.AntiForgeryToken()


                            <div class="mb-3">

                                <label class="form-label fw-semibold">
                                    Correo electrónico
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">

                                        <i class="bi bi-envelope"></i>

                                    </span>

                                    <input type="email"
                                           name="correo"
                                           class="form-control"
                                           placeholder="admin@telegramcatalogo.com"
                                           autocomplete="username"
                                           required />

                                </div>

                            </div>


                            <div class="mb-4">

                                <label class="form-label fw-semibold">
                                    Contraseña
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">

                                        <i class="bi bi-lock"></i>

                                    </span>

                                    <input type="password"
                                           name="contrasenia"
                                           class="form-control"
                                           placeholder="••••••••"
                                           autocomplete="current-password"
                                           required />

                                </div>

                            </div>


                            <button type="submit"
                                    class="btn
                                           btn-primary
                                           btn-lg
                                           w-100">

                                <i class="bi bi-box-arrow-in-right me-1"></i>

                                Iniciar sesión

                            </button>

                        </form>


                        <div class="text-center mt-4">

                            <a asp-controller="Home"
                               asp-action="Index"
                               class="text-decoration-none">

                                <i class="bi bi-arrow-left"></i>

                                Volver al catálogo

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</body>

</html>