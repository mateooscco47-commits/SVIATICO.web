@model IEnumerable<TelegramCatalogo.Models.Categoria>

@{
    ViewData["Title"] = "Administrar categorías";
}

<div class="container py-5">

    <div class="d-flex justify-content-between
                align-items-center mb-4">

        <div>

            <a asp-controller="Admin"
               asp-action="Index"
               class="text-decoration-none">

                <i class="bi bi-arrow-left"></i>
                Panel de administración

            </a>

            <h1 class="fw-bold mt-3 mb-1">
                Categorías
            </h1>

            <p class="text-muted mb-0">
                Administra las categorías del catálogo.
            </p>

        </div>

        <a asp-controller="AdminCategorias"
           asp-action="Crear"
           class="btn btn-primary">

            <i class="bi bi-plus-lg"></i>
            Nueva categoría

        </a>

    </div>


    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success">

            <i class="bi bi-check-circle me-1"></i>

            @TempData["Exito"]

        </div>
    }


    <div class="card border-0 shadow-sm">

        <div class="table-responsive">

            <table class="table
                          table-hover
                          align-middle
                          mb-0">

                <thead class="table-light">

                    <tr>

                        <th class="ps-4">
                            Categoría
                        </th>

                        <th>
                            Slug
                        </th>

                        <th>
                            Canales
                        </th>

                        <th>
                            Estado
                        </th>

                        <th class="text-end pe-4">
                            Acciones
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var categoria in Model)
                    {
                        <tr>

                            <td class="ps-4">

                                <div class="d-flex
                                            align-items-center
                                            gap-3">

                                    <div class="fs-4 text-primary">

                                        <i class="bi @categoria.Icono"></i>

                                    </div>

                                    <div>

                                        <div class="fw-semibold">
                                            @categoria.Nombre
                                        </div>

                                        <small class="text-muted">
                                            @categoria.Descripcion
                                        </small>

                                    </div>

                                </div>

                            </td>


                            <td>

                                <code>
                                    @categoria.Slug
                                </code>

                            </td>


                            <td>

                                <span class="badge
                                             bg-light
                                             text-dark">

                                    @(categoria.Canales?.Count ?? 0)

                                </span>

                            </td>


                            <td>

                                @if (categoria.Estado)
                                {
                                    <span class="badge bg-success">
                                        Activa
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Inactiva
                                    </span>
                                }

                            </td>


                            <td class="text-end pe-4">

                                <a asp-controller="AdminCategorias"
                                   asp-action="Editar"
                                   asp-route-id="@categoria.IdCategoria"
                                   class="btn btn-sm
                                          btn-outline-primary">

                                    <i class="bi bi-pencil"></i>

                                </a>


                                <form asp-controller="AdminCategorias"
                                      asp-action="CambiarEstado"
                                      asp-route-id="@categoria.IdCategoria"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-sm
                                                   btn-outline-secondary">

                                        @if (categoria.Estado)
                                        {
                                            <i class="bi bi-eye-slash"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-eye"></i>
                                        }

                                    </button>

                                </form>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>